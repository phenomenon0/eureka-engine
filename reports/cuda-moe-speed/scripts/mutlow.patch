+  for (; j + MOE_DN_NR <= nk; j += MOE_DN_NR) {
+    const u8* rw[MOE_DN_NR];
+    const float* xs[MOE_DN_NR];
+    #pragma unroll
+    for (u32 q = 0; q < MOE_DN_NR; q++) {
+      rw[q] = D + (u64)ids[j + q] * es + (u64)r * rbd; xs[q] = act + (u64)(j + q) * ef;
+    }
