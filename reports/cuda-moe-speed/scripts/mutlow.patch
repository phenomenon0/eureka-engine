+      const u32 oi = __shfl_xor_sync(0xffffffffu, bix, m);
+      if (ov > bv || (ov == bv && oi < bix)) {
+        bv = ov; bix = oi;
+      }
+    }
+    if (l == 0) {
+      rv[w] = bv; ri[w] = bix;
+    }
+    __syncthreads();
+    if (t == 0) {
+      float v = rv[0];
+      u32 x = ri[0];
+      for (u32 k = 1; k < 32; k++) {
+        if (rv[k] > v || (rv[k] == v && ri[k] < x)) {
+          v = rv[k]; x = ri[k];
+        }
+      }
+      ids[j] = x;
+      wt[j] = v;
+      pv[x] = -2.0f;
+    }
+    __syncthreads();
+  }
+  if (t == 0) {
+    float s = 0.0f;
+    for (u32 j = 0; j < nk; j++) {
