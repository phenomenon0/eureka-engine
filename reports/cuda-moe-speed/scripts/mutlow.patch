+    float v;
+    moe_dnv<1>(fd, rw, xs, cg, &v);
+    mo = j == 0 ? __fmul_rn(v, wt[0]) : __fadd_rn(mo, __fmul_rn(v, wt[j]));
+  }
+  if ((threadIdx.x & 31) == 0) {
+    y[r] = __fadd_rn(__fadd_rn(mo, __fmul_rn(hv, sgo[0])), x1[r]);
+  }
+}
