+            }
+          }
+        }
+      }
+    }
+  } else
+  // k rounds of a block argmax over the probabilities (first index on equal values); a chosen
+  // expert's slot is set to -2 (p >= 0), the chosen p kept in wt[j] until the renormalization
+  for (u32 j = 0; j < nk; j++) {
+    float bv = -1.0f;
+    u32 bix = 0xffffffffu;
+    for (u32 e = t; e < ne; e += 1024) {
+      const float v = pv[e];
+      if (v > bv) {
