+// flat.bend's k.silu: a[i] = K.silu1(g[i]) * u[i], silu1(v) = v / (1 +
+// K.exp32(-v)), the exp through F64 (attn_exp); a thread an element of n
+// (tools/payload-silu.patch's kernel, tools/interiors-ffn.patch)
+extern "C" __global__ void __launch_bounds__(256) llb_silu(
+  const float* __restrict__ g, const float* __restrict__ u,
+  float* __restrict__ a, u32 n) {
+  const u32 i = blockIdx.x * 256 + threadIdx.x;
+  if (i < n) {
+    const float v = g[i];
+    a[i] = __fmul_rn(__fdiv_rn(v, __fadd_rn(1.0f, attn_exp(-v))), u[i]);
+  }
