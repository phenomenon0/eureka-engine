+// K.output_gate (tools/payload-og.patch): y := x * sigmoid(g), the exp
+// through F64 (attn_exp), as silu / llb_silu.
+extern "C" __global__ void llb_outputgate(const float* __restrict__ x,
+  const float* __restrict__ g, float* __restrict__ y, u32 n) {
+  const u32 i = blockIdx.x * blockDim.x + threadIdx.x;
+  if (i < n) {
+    y[i] = __fmul_rn(x[i], __fdiv_rn(1.0f,
+      __fadd_rn(1.0f, attn_exp(-g[i]))));
+  }
+}
