+// The folded step's Q6_K embedding row (the 0.8B's tied table; G33's
+// tools/payload-q6k2560.patch, tools/payload-w1024.patch here): ggml's
+// dequantize_row_q6_K (ggml-quants.c), one element a thread: w = (d * sc) * q,
+// q = (ql nibble | 2 qh bits << 4) - 32, the same f32 ops as q6k_w. Column
+// 128 n + 32 quad + l: ql[64 n + 32 (quad & 1) + l] >> (quad >= 2 ? 4 : 0),
+// qh[128 + 32 n + l] >> 2 quad, sc[192 + 8 n + 2 quad + l / 16], d at 208
+extern "C" __global__ void llb_embed6(const u8* __restrict__ row, u32 c,
+  float* __restrict__ y) {
+  u32 i = blockIdx.x * blockDim.x + threadIdx.x;
+  if (i < c) {
+    const u8* B = row + (u64)(i >> 8) * 210;
+    u32 r = i & 255, n = r >> 7, rr = r & 127, quad = rr >> 5, l = rr & 31;
+    u32 ql = B[n * 64 + (quad & 1) * 32 + l], qh = B[128 + n * 32 + l];
+    u32 nsh = quad >= 2 ? 4u : 0u, qsh = 2 * quad;
+    int scv = (int)(signed char)B[192 + n * 8 + quad * 2 + (l >> 4)];
+    float ds = __fmul_rn(llb_f16(B[208] | B[209] << 8), (float)scv);
+    y[i] = __fmul_rn(ds, (float)(int)(((ql >> nsh) & 15) | (((qh >> qsh) & 3) << 4)) - 32.0f);
+  }
+}
