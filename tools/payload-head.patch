+// flat.bend's argmax twice over z[0 .. n), y := [v, i, w, j] (ids as exact
+// F32), the head bang's tail (tools/payload-head.patch). K.amax.pick (the
+// first NaN, else the first max) is the least by (not NaN, value, index), so
+// any tree yields its pick; the second pick reads slot i as -inf. flat.bend's
+// pad slots n .. 2^17 are -inf and never change a pick. One block of 1024.
+INLINE bool amax_lt(float a, u32 ia, float b, u32 ib) {
+  const bool na = a != a, nb = b != b;
+  if (na || nb) {
+    return na && (!nb || ia < ib);
+  }
+  return a > b || (a == b && ia < ib);
+}
+
+extern "C" __global__ void __launch_bounds__(1024) llb_amax(
+  const float* __restrict__ z, u32 n, float* __restrict__ y) {
+  __shared__ float sv[1024];
+  __shared__ u32   si[1024];
+  const u32 t    = threadIdx.x;
+  u32       skip = 0xFFFFFFFFu;
+  for (u32 k = 0; k < 2; k += 1) {
+    float bv = __uint_as_float(0xFF800000u);
+    u32   bi = 0xFFFFFFFFu;
+    for (u32 i = t; i < n; i += 1024) {
+      const float v = i == skip ? __uint_as_float(0xFF800000u) : z[i];
+      if (amax_lt(v, i, bv, bi)) {
+        bv = v;
+        bi = i;
+      }
+    }
+    sv[t] = bv;
+    si[t] = bi;
+    __syncthreads();
+    for (u32 st = 512; st > 0; st >>= 1) {
+      if (t < st && amax_lt(sv[t + st], si[t + st], sv[t], si[t])) {
+        sv[t] = sv[t + st];
+        si[t] = si[t + st];
+      }
+      __syncthreads();
+    }
+    if (t == 0) {
+      y[2 * k]     = sv[0];
+      y[2 * k + 1] = (float)si[0];
+    }
+    skip = si[0];
+    __syncthreads();
+  }
+}
