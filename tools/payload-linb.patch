+// The 32-element gated-delta middleware (tools/payload-linb.patch): beta :=
+// sigmoid(bpre); dec := exp(softplus(apre + dt) * ssm_a), through F64 exactly as
+// K.sigmoid1 / K.softplus1 / K.exp32 (flat.bend's sp.a / ex.a). One block of n
+// threads.
+__device__ __forceinline__ float mid_sp(float x) {
+  if (20.0f < x) {
+    return x;
+  }
+  const double xm = (double)(x < 88.0f ? x : 88.0f);
+  return (float)log(1.0 + exp(xm));
+}
+
+extern "C" __global__ void llb_mid32(
+  const float* __restrict__ bpre, const float* __restrict__ apre,
+  const float* __restrict__ dtp, const float* __restrict__ sap,
+  float* __restrict__ beta, float* __restrict__ dec, u32 n) {
+  const u32 i = threadIdx.x;
+  if (i < n) {
+    const float b = bpre[i];
+    beta[i] = __fdiv_rn(1.0f, __fadd_rn(1.0f, attn_exp(-b)));
+    const float gp = __fmul_rn(mid_sp(__fadd_rn(apre[i], dtp[i])), sap[i]);
+    dec[i] = attn_exp(gp);
+  }
+}
