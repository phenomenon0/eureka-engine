+// The whole-pass bang (tools/payload-pass.patch): ws (1) the layer weight
+// list, x (2), y (3, output), the lin / full Offs records flattened into the
+// task (4..23, 24..43), c = dT | pos << 5 (44), the Q8 row words rg (45, 4096
+// cols) and rd (46, 12288 cols), the first layer s (47) and the count k (48).
+// Each layer's blob gets the checks of the linb or fulb decode and the fbn's.
+__device__ static void pass_mail(Env e, Corpus H, Loc a, Mail* M, WarpOp* o, u32* bad) {
+  Term wl = H[a + 1], x = H[a + 2], y = H[a + 3];
+  u32  c = (u32)H[a + 44], rgw = (u32)H[a + 45], rdw = (u32)H[a + 46];
+  u32  s = (u32)H[a + 47], k = (u32)H[a + 48], dT = c & 31, pos = c >> 5;
+  bool rgt = rgw >> 30 & 1, rdt = rdw >> 30 & 1;
+  u32  rg = rgw & (rgt ? 0x0fffffffu : 0x7fffffffu);
+  u32  rd = rdw & (rdt ? 0x0fffffffu : 0x7fffffffu);
+  u32  fgm = rgt ? rgw >> 28 & 3 : (rgw >> 31 ? 2 : rg % 17 == 0);
+  u32  fdm = rdt ? rdw >> 28 & 3 : (rdw >> 31 ? 2 : rd % 17 == 0);
+  bool ok = fgm == 1 && fdm == 1 && rg % 17 == 0 && rd % 17 == 0
+    && dT >= 1 && dT <= 17 && pos < (1u << dT) && k >= 1 && s + k <= 32
+    && term_tag(x) != TAG_ARR && term_tag(y) != TAG_ARR
+    && blk_cls(x) == 12 && blk_cls(y) >= 12;
+  for (u32 f = 0; f < 40; f += 1) {
+    M->po[f] = (u32)H[a + 4 + f];
+  }
+  Term t = wl;
+  for (u32 i = 0; ok && i < s + k; i += 1) {
+    if (term_tag(t) != TAG_CTR || (u32)term_aux(t) != CID_CON) {
+      ok = false;
+      break;
+    }
+    Loc  l = term_peek_ro(e, t);
+    Term wbt = H[l];
+    t = H[l + 1];
+    if (i < s) {
+      continue;
+    }
+    StrParts q = str_peek_ro(e, wbt);
+    if (term_tag(wbt) != TAG_STR || str_nar(q) != 2) {
+      ok = false;
+      break;
+    }
+    const u8* base = (const u8*)(H + term_peek_ro(e, q.data)) + q.off;
+    const u32* p = M->po + ((i + 1) % 4 == 0 ? 20 : 0);
+    // fbn: post, fg, fu, fd at Offs words 1..4
+    ok = p[1] % 4 == 0 && ((u64)(base + p[2]) & 15) == 0
+      && ((u64)(base + p[3]) & 15) == 0 && ((u64)(base + p[4]) & 15) == 0
+      && (u64)p[1] + 4096 * 4 <= q.len
+      && (u64)p[2] + (u64)12288 * rg <= q.len
+      && (u64)p[3] + (u64)12288 * rg <= q.len
+      && (u64)p[4] + (u64)4096 * rd <= q.len;
+    if ((i + 1) % 4 == 0) {
+      // fulb: an 0, q 14, k 15, v 16, q-norm 17, k-norm 18, o 19
+      ok = ok && p[0] % 4 == 0 && p[17] % 4 == 0 && p[18] % 4 == 0
+        && ((u64)(base + p[14]) & 15) == 0 && ((u64)(base + p[15]) & 15) == 0
+        && ((u64)(base + p[16]) & 15) == 0 && ((u64)(base + p[19]) & 15) == 0
+        && (u64)p[0] + 4096 * 4 <= q.len && (u64)p[14] + (u64)8192 * rg <= q.len
+        && (u64)p[15] + (u64)1024 * rg <= q.len && (u64)p[16] + (u64)1024 * rg <= q.len
+        && (u64)p[19] + (u64)4096 * rg <= q.len
+        && (u64)p[17] + 256 * 4 <= q.len && (u64)p[18] + 256 * 4 <= q.len;
+    } else {
+      // linb: an 0, qkv 5, gate 6, beta 7, alpha 8, ssm_a 9, dt 10, conv 11,
+      // ssm_norm 12, ssm_out 13
+      ok = ok && ((u64)(base + p[6]) & 15) == 0 && ((u64)(base + p[7]) & 15) == 0
+        && ((u64)(base + p[8]) & 15) == 0 && ((u64)(base + p[13]) & 15) == 0
+        && (u64)p[0] + 4096 * 4 <= q.len
+        && (u64)p[5] + (u64)8192 * rg <= q.len
+        && (u64)p[6] + (u64)4096 * rg <= q.len
+        && (u64)p[7] + (u64)32 * rg <= q.len
+        && (u64)p[8] + (u64)32 * rg <= q.len
+        && (u64)p[13] + (u64)4096 * rg <= q.len
+        && (u64)p[9] + 32 * 4 <= q.len && (u64)p[10] + 32 * 4 <= q.len
+        && (u64)p[11] + 8192 * 4 * 4 <= q.len && (u64)p[12] + 128 * 4 <= q.len;
+    }
+    M->pw[i - s] = (u64)base;
+  }
+  if (!ok) {
+    *bad = *bad != 0 ? *bad : 5;
+    return;
+  }
+  o->kind = 23;
+  o->x = (u64)(H + blk_loc(H, x));
+  o->y = (u64)(H + blk_loc(H, y));
+  o->c = c; o->brg = rg; o->rb = rd; o->n = s; o->d = k; o->fm = 1;
+}
