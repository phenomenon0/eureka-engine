+// tools/payload-anyshape.patch: n past 8192 (<= 32768): thread t owns leaves t L .. t L + L - 1,
+// L the power of two >= n / 1024 (16 or more), +0 pad leaves, a balanced in-thread tree, then
+// rms_tree as the 8-leaf trees; x1 := x + z when z (rmsnorm_add's store)
+__device__ __noinline__ float rms_wide(const float* __restrict__ x, const float* __restrict__ z,
+  float* __restrict__ x1, u32 n, u32 t) {
+  u32 L = 16;
+  while (L * 1024 < n) {
+    L <<= 1;
+  }
+  float b[32];
+  for (u32 k = 0; k < L; k++) {
+    const u64 i = (u64)t * L + k;
+    const float v = i < n ? (z != nullptr ? __fadd_rn(x[i], z[i]) : x[i]) : 0.0f;
+    if (x1 != nullptr && i < n) {
+      x1[i] = v;
+    }
+    b[k] = i < n ? __fmul_rn(v, v) : 0.0f;
+  }
+  for (u32 s = 1; s < L; s <<= 1) {
+    for (u32 k = 0; k < L; k += 2 * s) {
+      b[k] = __fadd_rn(b[k], b[k + s]);
+    }
+  }
+  return b[0];
+}
