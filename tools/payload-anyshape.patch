+    const u8* row = W + (u64)r * rb;
+    float acc = 0.0f;
+    for (u32 g = l; g < cg; g += 32) {
+      float4 w;
+      if (fm == 1) {
+        w = q8_w(row, cg, g);
+      } else if (fm == 3) {
+        w = q4k_w(row, g);
+      } else if (fm == 4) {
+        w = q6k_w(row, g);
+      } else if (fm == 9) {
+        w = q5k_w(row, g);
+      } else {
