+// tools/payload-anyshape.patch: the any-width GEMV, where no tuned body applies (a K-quant row
+// of cols % 1024 != 0 past the tile body's depths, Q5_K below whole quads, Q8_0 / F32 outside
+// their tree depths): a warp a row, lane l sums the groups l, l + 32, .. of the cg = cols / 4,
+// then the xor butterfly. fm: 0 F32, 1 Q8_0 (row-split), 3 Q4_K, 4 Q6_K, 9 Q5_K. x is read to
+// cols only (no pad). Not the engine's fixed tree: tolerance-class, used by no shape the
+// tuned bodies cover
+extern "C" __global__ void __launch_bounds__(128) llb_gemv_any(
+  const u8* __restrict__ W, u32 rb, u32 fm, u32 cg, const float* __restrict__ x,
+  float* __restrict__ y, u32 n) {
+  const u32 l = threadIdx.x & 31, nw = gridDim.x * (blockDim.x >> 5);
