+// group g of a Q5_K row (GGUF block layout, 176 bytes a super-block: f16 d, dmin, sc[12],
+// qh[32], qs[128]): ggml's dequantize_row_q5_K, w = d1 * (nib + 16 hbit) - m1, the scales as
+// q4k_w; the fifth bit of column 64 b + 32 hi + l is bit 2 b + hi of qh[l]
+INLINE float4 q5k_w(const u8* __restrict__ row, u32 g) {
+  u32  c4 = 4 * g, blk = c4 >> 8, rr = c4 & 255;
+  u32  b = rr >> 6, r = rr & 63, l = r & 31, hi = r >> 5;
+  const u8* B = row + (u64)blk * 176;
+  float d  = llb_f16(*(const unsigned short*)(B + 0));
+  float dm = llb_f16(*(const unsigned short*)(B + 2));
+  const u8* sc = B + 4;
+  u32  sb = 2 * b + hi, dsc, msc;
+  if (sb < 4) {
+    dsc = sc[sb] & 63; msc = sc[sb + 4] & 63;
+  } else {
+    dsc = (sc[sb + 4] & 15) | ((u32)(sc[sb - 4] >> 6) << 4);
+    msc = (sc[sb + 4] >> 4) | ((u32)(sc[sb] >> 6) << 4);
+  }
+  float d1 = __fmul_rn(d, (float)dsc), m1 = __fmul_rn(dm, (float)msc);
+  const u8* qs = B + 48 + b * 32 + l;
+  const u8* qh = B + 16 + l;
+  float w[4];
+  #pragma unroll
+  for (u32 k = 0; k < 4; k++) {
+    u32 q = (hi ? qs[k] >> 4 : qs[k] & 15) | ((qh[k] >> sb) & 1) << 4;
+    w[k] = __fsub_rn(__fmul_rn(d1, (float)q), m1);
+  }
+  return make_float4(w[0], w[1], w[2], w[3]);
+}
