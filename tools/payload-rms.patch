+#if defined(BEND_RTC) && defined(LLB_WARP_FID)
+// flat.bend's rms over 2048: s = 1 / sqrt(sumsq / 2048 + eps), sumsq the
+// balanced tree of v * v (pairs, then halves up in shared memory); h = (x * s)
+// * w, w the norm's f32 words. One block of 1024.
+extern "C" __global__ void __launch_bounds__(1024) llb_rms(
+  const float* __restrict__ x, const float* __restrict__ w,
+  float* __restrict__ h) {
+  __shared__ float a[1024];
+  __shared__ float sv;
+  const u32 t = threadIdx.x;
+  a[t] = __fadd_rn(__fmul_rn(x[2 * t], x[2 * t]),
+    __fmul_rn(x[2 * t + 1], x[2 * t + 1]));
+  __syncthreads();
+  for (u32 st = 1; st < 1024; st <<= 1) {
+    if ((t & (2 * st - 1)) == 0) {
+      a[t] = __fadd_rn(a[t], a[t + st]);
+    }
+    __syncthreads();
+  }
+  if (t == 0) {
+    sv = __fdiv_rn(1.0f, __fsqrt_rn(__fadd_rn(__fdiv_rn(a[0], 2048.0f),
+      __uint_as_float(0x358637BDu))));
+  }
+  __syncthreads();
+  const float s = sv;
+  for (u32 i = t; i < 2048; i += 1024) {
+    h[i] = __fmul_rn(__fmul_rn(x[i], s), w[i]);
+  }
+}
+#endif
