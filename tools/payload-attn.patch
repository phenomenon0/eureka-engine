+INLINE float attn_exp(float x) {
+  return (float)exp((double)x);
+}
+
+// A balanced pairwise sum pushed leaf by leaf (lower index on the left): the
+// tree of flat.bend's dot / esum / vsum over 2^k leaves; sp: the stack depth.
+INLINE void attn_push(float* st, u32* sp, u32 t, float v) {
+  for (; t & 1; t >>= 1) {
+    v = __fadd_rn(st[--*sp], v);
+  }
+  st[(*sp)++] = v;
+}
+
+// flat.bend's k.score, k.prob and k.wsum of all 16 heads, a block a head: q
+// 16 x 128, kc / vc 2^dT slots of 256 (head h reads kv head h >> 3), c = dT
+// | pos << 5; att: 16 x 128. Slots t > pos are masked to -inf.
+extern "C" __global__ void __launch_bounds__(128) llb_attn(
+  const float* __restrict__ q, const float* __restrict__ kc,
+  const float* __restrict__ vc, float* __restrict__ att, u32 c) {
+  __shared__ float sc[1024];
+  __shared__ float pr[1024];
+  const u32 h = blockIdx.x, dT = c & 31, pos = c >> 5, T = 1u << dT;
+  const u32 g = (h >> 3) * 128;
+  const float scale = __fdiv_rn(1.0f, __fsqrt_rn(128.0f));
+  for (u32 t = threadIdx.x; t < T; t += blockDim.x) {
+    const float* k = kc + t * 256 + g;
+    const float* x = q + h * 128;
+    float st[8];
+    u32   sp = 0;
+    for (u32 i = 0; i < 128; i++) {
+      attn_push(st, &sp, i, __fmul_rn(k[i], x[i]));
+    }
+    sc[t] = __fmul_rn(st[0], scale);
+  }
+  __syncthreads();
+  if (threadIdx.x == 0) {
+    const float ninf = __uint_as_float(0xFF800000u);
+    float st[11];
+    u32   sp = 0;
+    for (u32 t = 0; t < T; t++) {
+      float v = t <= pos ? sc[t] : ninf;
+      u32   i = t;
+      for (; i & 1; i >>= 1) {
+        float a = st[--sp];
+        v = a < v ? v : a;
+      }
+      st[sp++] = v;
+    }
+    const float m = st[0];
+    sp = 0;
+    for (u32 t = 0; t < T; t++) {
+      pr[t] = attn_exp(__fsub_rn(t <= pos ? sc[t] : ninf, m));
+      attn_push(st, &sp, t, pr[t]);
+    }
+    const float z = st[0];
+    for (u32 t = 0; t < T; t++) {
+      pr[t] = __fdiv_rn(pr[t], z);
+    }
+  }
+  __syncthreads();
+  const u32 j = threadIdx.x;
+  float st[11];
+  u32   sp = 0;
+  for (u32 t = 0; t < T; t++) {
+    attn_push(st, &sp, t, __fmul_rn(vc[g + j + t * 256], pr[t]));
+  }
+  att[h * 128 + j] = st[0];
+}
