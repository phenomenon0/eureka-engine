+// K.vadd / K.vmul (tools/payload-vadd.patch): pure elementwise maps, so the
+// flat index kernel reproduces their tree leaf for leaf.
+extern "C" __global__ void llb_vadd(const float* __restrict__ x,
+  const float* __restrict__ z, float* __restrict__ y, u32 n) {
+  const u32 i = blockIdx.x * blockDim.x + threadIdx.x;
+  if (i < n) {
+    y[i] = __fadd_rn(x[i], z[i]);
+  }
+}
+
+extern "C" __global__ void llb_vmul(const float* __restrict__ x,
+  const float* __restrict__ z, float* __restrict__ y, u32 n) {
+  const u32 i = blockIdx.x * blockDim.x + threadIdx.x;
+  if (i < n) {
+    y[i] = __fmul_rn(x[i], z[i]);
+  }
+}
