+// f16 bits -> f32, exact for finite h: (implicit | m) * 2^(max(e, 1) - 25)
+INLINE float llb_f16(u32 h) {
+  u32   e   = (h >> 10) & 31, m = h & 1023;
+  float mag = __fmul_rn((float)(e ? m + 1024 : m),
+    __uint_as_float(((e ? e : 1) + 102) << 23));
+  return __uint_as_float(__float_as_uint(mag) | ((h >> 15) << 31));
+}
+
+// group g of a Q8_0 row (tools/q8_pack.py: [c int8 q][c/32 f16le d], c =
+// 4 cg): w = (f32)q * f32(d), ggml's dequantize_row_q8_0, exact (<= 19
+// significant bits), so each w is the F32 pack's word
+INLINE float4 q8_w(const u8* __restrict__ row, u32 cg, u32 g) {
+  u32   v = *(const u32*)(row + 4 * g);
+  float s = llb_f16(*(const unsigned short*)(row + 4 * cg + 2 * (g >> 3)));
+  return make_float4(__fmul_rn((float)(signed char)v, s),
+    __fmul_rn((float)(signed char)(v >> 8), s),
+    __fmul_rn((float)(signed char)(v >> 16), s),
+    __fmul_rn((float)(signed char)(v >> 24), s));
+}
+
+// llb_warp over Q8_0 rows of rb bytes (tools/merge3-q8.patch): the same
+// groups, leaf and tree, each weight dequantized on load; a copy, so the F32
+// kernel's code stays the gated one
+extern "C" __global__ void __launch_bounds__(128) llb_warp_q8(
+  const u8* __restrict__ W, u32 rb, u32 cg, const u32* __restrict__ x,
+  u32* __restrict__ y, u32 n, u32 d) {
+  const u32 l = threadIdx.x & 31, nw = gridDim.x * (blockDim.x >> 5);
+  const u32 ch = 1u << (d - 9);
+  float4 xv[16];
+  if (ch == 1) {
+    warp_x(xv, x, 0, l);
+  }
+  for (u32 r = blockIdx.x * (blockDim.x >> 5) + (threadIdx.x >> 5); r < n;
+    r += nw) {
+    const u8* row = W + (u64)r * rb;
+    float s[8];
+    for (u32 k = 0; k < ch; k++) {
+      if (ch > 1) {
+        warp_x(xv, x, k, l);
+      }
+      float4 w[16];
+      #pragma unroll
+      for (u32 i = 0; i < 16; i++) {
+        u32 g = 512 * k + 32 * i + l;
+        w[i] = g < cg ? q8_w(row, cg, g) : make_float4(0.f, 0.f, 0.f, 0.f);
+      }
+      float v[16];
+      #pragma unroll
+      for (u32 i = 0; i < 16; i++) {
+        float4 a = w[i], b = xv[i];
+        v[i] = __fadd_rn(__fadd_rn(__fmul_rn(a.x, b.x), __fmul_rn(a.y, b.y)),
+          __fadd_rn(__fmul_rn(a.z, b.z), __fmul_rn(a.w, b.w)));
+      }
+      #pragma unroll
+      for (u32 m = 1; m < 32; m <<= 1) {
+        #pragma unroll
+        for (u32 i = 0; i < 16; i++) {
+          float o = __shfl_xor_sync(0xffffffffu, v[i], m);
+          v[i] = (l & m) ? __fadd_rn(o, v[i]) : __fadd_rn(v[i], o);
+        }
+      }
+      #pragma unroll
+      for (u32 st = 1; st < 16; st <<= 1) {
+        #pragma unroll
+        for (u32 i = 0; i < 16; i += 2 * st) {
+          v[i] = __fadd_rn(v[i], v[i + st]);
+        }
+      }
+      s[k] = v[0];
+    }
+    for (u32 st = 1; st < ch; st <<= 1) {
+      for (u32 k = 0; k < ch; k += 2 * st) {
+        s[k] = __fadd_rn(s[k], s[k + st]);
+      }
+    }
+    if (l == 0) {
+      y[r] = __float_as_uint(s[0]);
+    }
+  }
+}
