+// vblocks only, so slot[3] = T8 (vblocks 0..7) and slot[NR == 10 ? 1 : 2] the
+// rest; the pad subtree (groups cg .. 2047, 0 * x) is one block-wide vote P
+// as llb_warp_q8_res's (NaN if any x there is inf / NaN, -0 if all signed,
+// else +0; merged pad subtrees give the same bits, receipts/fable-q27b/c1),
+// so y = T8 + (rest + P), the tree's own top. Every thread must enter (vote).
+template <u32 NR, bool CAT = false>
+__device__ __forceinline__ void warp_dq_q8_rwp(
+  const u8* __restrict__ W, u32 rb, u32 cg, const u32* __restrict__ x,
