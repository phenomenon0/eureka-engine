+// Launch fusion (tools/payload-fuse.patch): each value keeps its ops and
+// their order; only the launches and the shared-memory levels change.
+// rms_tree: the halving strides st = 1 .. 16 as __shfl_down (lane t + st's
+// partial lands on t: the same low + high pairs), then the warp sums in a[]
+// through the same strides; the block total is returned to every thread.
+// One block of 32 nw threads, nw a power of 2 up to 32.
+__device__ __forceinline__ float rms_tree(float v, float* a, u32 t, u32 nw) {
+  #pragma unroll
+  for (u32 st = 1; st < 32; st <<= 1) {
+    v = __fadd_rn(v, __shfl_down_sync(0xffffffffu, v, st));
+  }
+  if ((t & 31) == 0) {
+    a[t >> 5] = v;
+  }
+  __syncthreads();
+  if (t < 32) {
+    v = t < nw ? a[t] : 0.0f;
+    for (u32 st = 1; st < nw; st <<= 1) {
+      v = __fadd_rn(v, __shfl_down_sync(0xffffffffu, v, st));
+    }
+    if (t == 0) {
+      a[32] = v;
+    }
+  }
+  __syncthreads();
+  return a[32];
+}
