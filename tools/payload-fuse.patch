+// linb's mid32 (block 0) beside conv1d (blocks 1 ..): independent inputs
+extern "C" __global__ void __launch_bounds__(256) llb_midconv(
+  const float* __restrict__ bpre, const float* __restrict__ apre,
+  const float* __restrict__ dtp, const float* __restrict__ sap,
+  float* __restrict__ beta, float* __restrict__ dec, u32 nm,
+  const float* __restrict__ w, const float* __restrict__ x,
+  const float* __restrict__ h0, const float* __restrict__ h1,
+  const float* __restrict__ h2, float* __restrict__ y, u32 nch) {
+  if (blockIdx.x == 0) {
+    const u32 i = threadIdx.x;
+    if (i < nm) {
+      const float b = bpre[i];
+      beta[i] = __fdiv_rn(1.0f, __fadd_rn(1.0f, attn_exp(-b)));
+      const float gp = __fmul_rn(mid_sp(__fadd_rn(apre[i], dtp[i])), sap[i]);
+      dec[i] = attn_exp(gp);
+    }
+    return;
+  }
+  const u32 c = (blockIdx.x - 1) * 256 + threadIdx.x;
+  if (c >= nch) {
+    return;
+  }
+  const float a = __fadd_rn(__fmul_rn(h0[c], w[4 * c]), __fmul_rn(h1[c], w[4 * c + 1]));
+  const float b = __fadd_rn(__fmul_rn(h2[c], w[4 * c + 2]), __fmul_rn(x[c], w[4 * c + 3]));
+  const float u = __fadd_rn(a, b);
+  y[c] = __fdiv_rn(u, __fadd_rn(1.0f, attn_exp(-u)));
+}
