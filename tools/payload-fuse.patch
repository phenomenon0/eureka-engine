+// fbn's head: x1 := x + z (K.vadd), then llb_rmsnorm over x1 (n = 4096)
+extern "C" __global__ void __launch_bounds__(1024) llb_rmsnorm_add(
+  const float* __restrict__ x, const float* __restrict__ z,
+  const float* __restrict__ w, float* __restrict__ x1, float* __restrict__ y,
+  u32 n) {
+  __shared__ float a[33];
+  const u32 t = threadIdx.x;
+  const u64 o = (u64)t * 4;
+  float v[4];
+  #pragma unroll
+  for (u32 k = 0; k < 4; k++) {
+    v[k] = __fadd_rn(x[o + k], z[o + k]);
+    x1[o + k] = v[k];
+  }
+  const float acc = __fadd_rn(__fadd_rn(__fmul_rn(v[0], v[0]), __fmul_rn(v[1], v[1])),
+    __fadd_rn(__fmul_rn(v[2], v[2]), __fmul_rn(v[3], v[3])));
+  const float sum = rms_tree(acc, a, t, 32);
+  const float s = __fdiv_rn(1.0f, __fsqrt_rn(__fadd_rn(__fdiv_rn(sum, (float)n),
+    __uint_as_float(0x358637BDu))));
+  for (u32 i = t; i < n; i += 1024) {
+    y[i] = __fmul_rn(__fmul_rn(__fadd_rn(x[i], z[i]), s), w[i]);
+  }
+}
+
+// linb's four l2norms as one launch: q (scale sq) and k (scale 1) heads of
+// 128 from cnv / cnvk, each written to dst and its copy dst + 2048
+extern "C" __global__ void __launch_bounds__(64) llb_l2norm_qk(
+  const float* __restrict__ vq, const float* __restrict__ vk,
+  float* __restrict__ yq, float* __restrict__ yk, float sq, u32 heads) {
+  __shared__ float a[33];
+  const u32 kq = blockIdx.x >= heads, h = blockIdx.x - (kq ? heads : 0);
+  const u32 t = threadIdx.x;
+  const float sc = kq ? 1.0f : sq;
+  const float2 x = ((const float2*)((kq ? vk : vq) + ((u64)h << 7)))[t];
+  const float sum = rms_tree(__fadd_rn(__fmul_rn(x.x, x.x), __fmul_rn(x.y, x.y)),
+    a, t, 2);
+  const float rt = __fsqrt_rn(sum);
+  const float ep = __uint_as_float(0x358637BDu);
+  const float s = __fdiv_rn(__fdiv_rn(1.0f, (rt < ep ? ep : rt)), sc);
+  const float2 r = make_float2(__fmul_rn(x.x, s), __fmul_rn(x.y, s));
+  float* y = (kq ? yk : yq) + ((u64)h << 7);
+  ((float2*)y)[t] = r;
+  ((float2*)(y + 2048))[t] = r;
+}
