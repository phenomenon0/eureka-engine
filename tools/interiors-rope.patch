+// K.rope in place over y[0 .. n) at position pos (flat.bend's k.rope with
+// j = i - c: pair (2p, 2p + 1), theta index p & 63; K.pow32/cos32/sin32
+// through F64 as the interpreter's device lane); a thread a pair, blocks of 128
+extern "C" __global__ void llb_rope(float* y, u32 n, float pos) {
+  const u32 p = blockIdx.x * 128 + threadIdx.x;
+  if (2 * p >= n) {
+    return;
+  }
+  const float t  = __fmul_rn(pos, (float)pow((double)5000000.0f,
+    (double)__fdiv_rn(-(float)(2 * (p & 63)), 128.0f)));
+  const float co = (float)cos((double)t), si = (float)sin((double)t);
+  const float x0 = y[2 * p], x1 = y[2 * p + 1];
+  y[2 * p]     = __fsub_rn(__fmul_rn(x0, co), __fmul_rn(x1, si));
+  y[2 * p + 1] = __fadd_rn(__fmul_rn(x0, si), __fmul_rn(x1, co));
+}
