+// kvalues_iq4nl, ggml-common.h:1120 (tools/iq4xs.py). A __constant__ table is
+// read directly by the device code and compiles under both nvcc and nvrtc.
+__constant__ signed char llb_kv[16] = {
+  -127, -104, -83, -65, -49, -35, -22, -10, 1, 13, 25, 38, 53, 69, 89, 113
+};
+
+// group g of an IQ4_XS row (tools/iq4xs.py: GGUF block layout, 136 bytes a
+// super-block): dl = d * (ls - 32), w = dl * kvalues_iq4nl[code], ggml's
+// dequantize_row_iq4_xs. Every product is exact (f16 significand * 5-bit
+// (ls-32) * 7-bit codebook), so the two f32 multiplies are ggml's own, in
+// ggml's order, with no rounding. A group of four columns lies inside one
+// 16-wide half of a 32-weight sub-block, so one u32 qs load covers all four.
+// tools/iq4xs.patch
+INLINE float4 iq4xs_w(const u8* __restrict__ row, u32 g) {
+  u32  c4 = 4 * g, blk = c4 >> 8, rr = c4 & 255;
+  u32  ib = rr >> 5, r = rr & 31, l = r & 15, hi = r >> 4;
+  const u8* B = row + (u64)blk * 136;
+  float d = llb_f16(*(const unsigned short*)(B + 0));
+  u32  ls = ((u32)B[4 + (ib >> 1)] >> (4 * (ib & 1)) & 15u)
+    | ((((u32)(*(const unsigned short*)(B + 2)) >> (2 * ib)) & 3u) << 4);
+  float dl = __fmul_rn(d, (float)((int)ls - 32));
+  u32  v = *(const u32*)(B + 8 + ib * 16 + l) >> (hi * 4);
+  return make_float4(__fmul_rn(dl, (float)llb_kv[v & 15]),
+    __fmul_rn(dl, (float)llb_kv[(v >> 8) & 15]),
+    __fmul_rn(dl, (float)llb_kv[(v >> 16) & 15]),
+    __fmul_rn(dl, (float)llb_kv[(v >> 24) & 15]));
+}
