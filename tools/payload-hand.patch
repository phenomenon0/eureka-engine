+// (~0.5 ms a serve, payload stage 1). kind: 0 GEMV, 1 attention, 2 rms.
+typedef struct {
+  u64 w, x, y, k, v, wn;
+  u32 kind, n, d, rb, c, pad;
+} WarpOp;
+
+typedef struct Mail {
+  u32    front, err, done, m, bad;
+  WarpOp op[WARP_MAX];
+} Mail;
