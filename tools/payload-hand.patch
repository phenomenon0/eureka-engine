+// warp_serve's delivery, on the device, after the task launches: y to each
+// continuation, a join that completes reopens the frontier on ring 0
+extern "C" __global__ void llb_deliver(Corpus H, u32 m) {
+  u32 k = 0;
+  for (u32 j = 0; j < m; j += 1) {
+    Term t  = H[H_WARP + j];
+    Loc  tl = task_tail(t);
+    Term rv[WL_RESW];
+    rv[0]   = H[term_loc(t) + ((u32)term_aux(t) == LLB_ATTN_FID ? 6 : 3)];
+    Term c  = task_deliver(H, H[tl], (u32)(H[tl + 1] >> 32) & 0xFFFF, rv, 1);
+    if (c != 0) {
+      ring_push(H, 0, c);
+      k += 1;
+    }
+  }
+  a32_store(a32_at(H, H_WARP_N), 0);
+  a32_store(a32_at(H, H_CURSOR), k);
+}
