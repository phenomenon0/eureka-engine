+// group g of a Q3_K row (tools/q3k.py: GGUF block layout, 110 bytes a
+// super-block): w = d * (scales[is] - 32) * code, ggml's dequantize_row_q3_K;
+// both products are exact (f16 significand * 6-bit int, * 3-bit code), in
+// ggml's order. A group of four columns lies inside one 16-wide half (c = 4g),
+// so the four qs bytes and the four high-bit bytes are contiguous; 110 is not
+// 4-aligned, so they are loaded one at a time. tools/q3k.patch
+INLINE float4 q3k_w(const u8* __restrict__ row, u32 g) {
+  u32  c4 = 4 * g, blk = c4 >> 8, r = c4 & 255;
+  u32  n = r >> 7, rr = r & 127, j = rr >> 5, l = rr & 31;
+  u32  w16 = l >> 4, lb = l & 15;
+  const u8* B = row + (u64)blk * 110;
+  const u8* q = B + 32 + n * 32 + lb + 16 * w16;
+  const u8* h = B + lb + 16 * w16;
+  const u8* sc = B + 96;
+  float d = llb_f16(*(const unsigned short*)(B + 108));
+  u32  sh = 2 * j, bit = j + 4 * n;
+  u32  a0 = (u32)sc[0] | ((u32)sc[1] << 8) | ((u32)sc[2] << 16) | ((u32)sc[3] << 24);
+  u32  a1 = (u32)sc[4] | ((u32)sc[5] << 8) | ((u32)sc[6] << 16) | ((u32)sc[7] << 24);
+  u32  a2 = (u32)sc[8] | ((u32)sc[9] << 8) | ((u32)sc[10] << 16) | ((u32)sc[11] << 24);
+  u32  tmp = a2;
+  a2 = ((a0 >> 4) & 0x0f0f0f0fu) | (((tmp >> 4) & 0x03030303u) << 4);
+  u32  a3 = ((a1 >> 4) & 0x0f0f0f0fu) | (((tmp >> 6) & 0x03030303u) << 4);
+  a0 = (a0 & 0x0f0f0f0fu) | (((tmp >> 0) & 0x03030303u) << 4);
+  a1 = (a1 & 0x0f0f0f0fu) | (((tmp >> 2) & 0x03030303u) << 4);
+  u32  is = n * 8 + j * 2 + w16;
+  u32  word = is < 4 ? a0 : is < 8 ? a1 : is < 12 ? a2 : a3;
+  int  scv = (int)(signed char)((word >> ((is & 3) * 8)) & 0xFF);
+  float dl = __fmul_rn(d, (float)(scv - 32));
+  return make_float4(
+    __fmul_rn(dl, (float)(int)(((q[0] >> sh) & 3) - (((h[0] >> bit) & 1) ? 0 : 4))),
+    __fmul_rn(dl, (float)(int)(((q[1] >> sh) & 3) - (((h[1] >> bit) & 1) ? 0 : 4))),
+    __fmul_rn(dl, (float)(int)(((q[2] >> sh) & 3) - (((h[2] >> bit) & 1) ? 0 : 4))),
+    __fmul_rn(dl, (float)(int)(((q[3] >> sh) & 3) - (((h[3] >> bit) & 1) ? 0 : 4))));
+}
