+// group g of a Q6_K row (tools/q6k.py: GGUF block layout, 210 bytes a
+// super-block): w = (d * sc) * q, ggml's dequantize_row_q6_K. d*sc is exact
+// (f16 significand * 8-bit int) and (d*sc)*q with |q| <= 32 is exact too; both
+// f32 multiplies are in ggml's order. A group of four columns lies inside one
+// 32-wide quadrant (c = 4g, l a multiple of 4), so the four ql bytes are
+// ql[l..l+3] and the four qh bytes qh[l..l+3]. 210 is not 4-aligned, so the
+// bytes are loaded one at a time (a u32 load would be misaligned for every
+// block past the first; q4k_w could use u32 loads because 144 is 16-aligned).
+// tools/q6k.patch
+INLINE float4 q6k_w(const u8* __restrict__ row, u32 g) {
+  u32  c4 = 4 * g, blk = c4 >> 8, r = c4 & 255;
+  u32  n = r >> 7, rr = r & 127, quad = rr >> 5, l = rr & 31;
+  const u8* B = row + (u64)blk * 210;
+  const u8* ql = B + n * 64 + (quad & 1) * 32 + l;
+  const u8* qh = B + 128 + n * 32 + l;
+  float d = llb_f16(*(const unsigned short*)(B + 208));
+  u32  nsh = (quad >= 2) ? 4u : 0u, qsh = 2 * quad;
+  int  scv = (int)(signed char)B[192 + n * 8 + quad * 2 + (l >> 4)];
+  float ds = __fmul_rn(d, (float)scv);
+  return make_float4(
+    __fmul_rn(ds, (float)(int)(((ql[0] >> nsh) & 15) | (((qh[0] >> qsh) & 3) << 4)) - 32.0f),
+    __fmul_rn(ds, (float)(int)(((ql[1] >> nsh) & 15) | (((qh[1] >> qsh) & 3) << 4)) - 32.0f),
+    __fmul_rn(ds, (float)(int)(((ql[2] >> nsh) & 15) | (((qh[2] >> qsh) & 3) << 4)) - 32.0f),
+    __fmul_rn(ds, (float)(int)(((ql[3] >> nsh) & 15) | (((qh[3] >> qsh) & 3) << 4)) - 32.0f));
+}
