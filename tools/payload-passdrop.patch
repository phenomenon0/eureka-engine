+      Env pe = { H, H + ALC_OFF };
+      Loc pa = term_loc(t);
+      term_sink(pe, H[pa + 1]);
+      term_sink(pe, H[pa + 2]);
+      term_sink(pe, H[pa + 49]);
+      term_sink(pe, H[pa + 51]);
+      term_sink(pe, H[pa + 64]);
+      heap_free(pe, cls_fit(fid_arity(LLB_PASS_FID) + 2), pa);
+    }
   }
   a32_store(a32_at(H, H_WARP_N), 0);
   a32_store(a32_at(H, H_CURSOR), k);
