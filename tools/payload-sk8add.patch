+// SK8 owns private score/exp planes; never aliases the default sc/pr planes.
+extern "C" __global__ void __launch_bounds__(1024) llb_attn4_sk8(
+  const float* q, const float* kc, const float* vc, float* tmp,
+  float* scores, float* probs, u32 c, u32 grp, u32 nh) {
+  const u32 h=blockIdx.x%nh, split=blockIdx.x/nh, tid=threadIdx.x;
+  const u32 T=1u<<(c&31), pos=c>>5, n=pos<T?pos+1:T;
+  u32 T2=1; while(T2<n) T2<<=1;
+  const u32 span=(n+7)/8, begin=split*span;
+  const u32 active=begin<n ? (n-begin<span?n-begin:span) : 0;
+  u32 L=1; while(L<active) L<<=1;
+  const u32 ks=(nh/grp)*256, g=(h/grp)*256;
+  const float ni=__uint_as_float(0xff800000u);
+  float* sh=scores+(u64)h*(1u<<17)+split*16384;
+  float* ph=probs+(u64)h*(1u<<17)+split*16384;
+  float* dst=tmp+((u64)h*8+split)*258;
+  __shared__ float qs[256];
+  __shared__ float mx, sum;
+  if(tid<256) qs[tid]=q[(u64)h*256+tid];
+  __syncthreads();
+  // Reserved segment planes include padding up to the local power of two.
+  float* tree=ph;
+  const u32 sub=tid&7;
+  for(u32 tb=0;tb<L;tb+=blockDim.x/8) {
+    const u32 t=tb+(tid>>3); float v=0;
+    if(t<active) {
+      float st[6]; u32 sp=0;
+      for(u32 j=0;j<32;j++)
+        attn_push(st,&sp,j,__fmul_rn(kc[(u64)(begin+t)*ks+g+sub*32+j],qs[sub*32+j]));
+      v=st[0];
+    }
+    for(u32 m=1;m<8;m<<=1) v=__fadd_rn(v,__shfl_xor_sync(0xffffffffu,v,m));
+    if(sub==0 && t<L) {
+      const float x=t<active?__fmul_rn(v,__fdiv_rn(1.0f,__fsqrt_rn(256.0f))):ni;
+      tree[t]=x;
+      if(t<active) sh[t]=x;
+    }
+  }
+  __syncthreads();
+  for(u32 s=1;s<L;s<<=1) {
+    for(u32 t=tid*2*s;t<L;t+=blockDim.x*2*s) {
+      const float a=tree[t],b=tree[t+s]; tree[t]=a<b?b:a;
+    }
+    __syncthreads();
+  }
+  if(tid==0) mx=tree[0];
+  __syncthreads();
+  for(u32 t=tid;t<L;t+=blockDim.x) {
+    const float e=t<active?attn_exp(__fsub_rn(sh[t],mx)):0.0f;
+    tree[t]=sh[t]=e;
+  }
+  __syncthreads();
+  for(u32 s=1;s<L;s<<=1) {
+    for(u32 t=tid*2*s;t<L;t+=blockDim.x*2*s) sh[t]=__fadd_rn(sh[t],sh[t+s]);
+    __syncthreads();
+  }
+  if(tid==0) {sum=sh[0];dst[0]=mx;dst[1]=sum;}
+  __syncthreads();
+  if(tid<256) {
+    float st[18];u32 sp=0;
+    for(u32 t=0;t<L;t++) {
+      const float v=t<active?__fmul_rn(vc[(u64)(begin+t)*ks+g+tid],ph[t]):0.0f;
+      attn_push(st,&sp,t,v);
+    }
+    dst[2+tid]=st[0];
+  }
+}
+extern "C" __global__ void llb_attn4_sk8_combine(const float* tmp,float* out) {
+  const u32 h=blockIdx.x,j=threadIdx.x;
+  const float* p=tmp+(u64)h*8*258;
+  float m=__uint_as_float(0xff800000u);
+  for(u32 s=0;s<8;s++) if(p[s*258+1]>0 && p[s*258]>m) m=p[s*258];
+  float z=0,v=0;
+  for(u32 s=0;s<8;s++) {
+    const float r=p[s*258+1]>0?attn_exp(__fsub_rn(p[s*258],m)):0.0f;
+    z=__fadd_rn(z,__fmul_rn(p[s*258+1],r));
+    v=__fadd_rn(v,__fmul_rn(p[s*258+2+j],r));
+  }
+  out[(u64)h*256+j]=__fdiv_rn(v,z);
+}
