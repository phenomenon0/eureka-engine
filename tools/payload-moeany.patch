+// tools/payload-moeany.patch: the routed experts (llb_host.c llb_moe_run), any expert count / top-k /
+// width, the reference semantics of llama.cpp's build_moe_ffn for qwen35moe: softmax over every
+// expert's router logit, the top k, their weights renormalized to sum 1 (the sum clamped at
+// 6.103515625e-5 as ggml_clamp), each chosen expert down(silu(gate x) * (up x)), the weighted sum
+// in rank order, plus the shared expert times sigmoid(its gate), plus the residual.
+// The expert stacks keep the GGUF's bytes (llb_moe_load copies or maps them as they are), so Q8_0 is
+// ggml's block layout here ([f16 d][32 q] x cols / 32), not the trunk's row-split.
+INLINE float4 q8g_w(const u8* __restrict__ row, u32 g) {
+  const u8* B = row + (u64)(g >> 3) * 34;
+  float s = llb_f16((unsigned short)(B[0] | (u32)B[1] << 8));
+  const signed char* q = (const signed char*)(B + 2 + 4 * (g & 7));
+  return make_float4(__fmul_rn((float)q[0], s), __fmul_rn((float)q[1], s), __fmul_rn((float)q[2], s),
+    __fmul_rn((float)q[3], s));
+}
+
+// A row's dot: lane l sums the groups l, l + 32, .. of cg = cols / 4 (llb_gemv_any's leaf), then
+// the xor butterfly; formats 1 Q8_0 (GGUF blocks, q8g_w), 3 Q4_K, 4 Q6_K, 9 Q5_K
+__device__ __forceinline__ float moe_dot(const u8* __restrict__ row, u32 fm, u32 cg, const float* __restrict__ x) {
+  const u32 l = threadIdx.x & 31;
+  float acc = 0.0f;
+  for (u32 g = l; g < cg; g += 32) {
+    float4 w = fm == 1 ? q8g_w(row, g) : fm == 3 ? q4k_w(row, g) : fm == 4 ? q6k_w(row, g) : q5k_w(row, g);
+    const float* xv = x + 4 * (u64)g;
+    acc = __fadd_rn(acc, __fadd_rn(__fadd_rn(__fmul_rn(w.x, xv[0]), __fmul_rn(w.y, xv[1])),
+      __fadd_rn(__fmul_rn(w.z, xv[2]), __fmul_rn(w.w, xv[3]))));
+  }
+  #pragma unroll
+  for (u32 m = 16; m > 0; m >>= 1) {
+    acc = __fadd_rn(acc, __shfl_xor_sync(0xffffffffu, acc, m));
+  }
+  return acc;
+}
+
+// one block of 1024: lg the ne router logits, sg the shared expert's gate logit, pv ne floats of
+// scratch (the probabilities). Out: ids[k] / wt[k] the chosen experts by descending probability
+// (ties to the lower index: argsort's order on distinct values), sgo[0] = sigmoid(sg).
+// p = exp(l - max) / sum, the exp through F64 (attn_exp). Any ne and k (k <= ne)
+extern "C" __global__ void __launch_bounds__(1024) llb_moe_topk(const float* __restrict__ lg, u32 ne, u32 nk,
+  const float* __restrict__ sg, float* __restrict__ pv, u32* __restrict__ ids, float* __restrict__ wt,
+  float* __restrict__ sgo) {
+  __shared__ float rv[32];
+  __shared__ u32 ri[32];
+  __shared__ float bc;
+  const u32 t = threadIdx.x, l = t & 31, w = t >> 5;
+  // the max logit
+  float mx = __uint_as_float(0xFF800000u);
+  for (u32 e = t; e < ne; e += 1024) {
+    mx = fmaxf(mx, lg[e]);
+  }
+  #pragma unroll
+  for (u32 m = 16; m > 0; m >>= 1) {
+    mx = fmaxf(mx, __shfl_xor_sync(0xffffffffu, mx, m));
+  }
+  if (l == 0) {
+    rv[w] = mx;
+  }
+  __syncthreads();
+  if (t == 0) {
+    float v = rv[0];
+    for (u32 k = 1; k < 32; k++) {
+      v = fmaxf(v, rv[k]);
+    }
+    bc = v;
+  }
+  __syncthreads();
+  mx = bc;
+  // exp and the sum (ascending expert order within a thread, then the fixed trees)
+  float sm = 0.0f;
+  for (u32 e = t; e < ne; e += 1024) {
+    const float v = attn_exp(__fsub_rn(lg[e], mx));
+    pv[e] = v;
+    sm = __fadd_rn(sm, v);
+  }
+  #pragma unroll
+  for (u32 m = 16; m > 0; m >>= 1) {
+    sm = __fadd_rn(sm, __shfl_xor_sync(0xffffffffu, sm, m));
+  }
+  __syncthreads();
+  if (l == 0) {
+    rv[w] = sm;
+  }
+  __syncthreads();
+  if (t == 0) {
+    float v = 0.0f;
+    for (u32 k = 0; k < 32; k++) {
+      v = __fadd_rn(v, rv[k]);
+    }
+    bc = v;
+  }
+  __syncthreads();
+  const float inv = __fdiv_rn(1.0f, bc);
+  for (u32 e = t; e < ne; e += 1024) {
+    pv[e] = __fmul_rn(pv[e], inv);
+  }
+  __syncthreads();
+  // k rounds of a block argmax over the probabilities (first index on equal values); a chosen
+  // expert's slot is set to -2 (p >= 0), the chosen p kept in wt[j] until the renormalization
+  for (u32 j = 0; j < nk; j++) {
+    float bv = -1.0f;
+    u32 bix = 0xffffffffu;
+    for (u32 e = t; e < ne; e += 1024) {
+      const float v = pv[e];
+      if (v > bv) {
+        bv = v; bix = e;
+      }
+    }
+    #pragma unroll
+    for (u32 m = 16; m > 0; m >>= 1) {
+      const float ov = __shfl_xor_sync(0xffffffffu, bv, m);
+      const u32 oi = __shfl_xor_sync(0xffffffffu, bix, m);
+      if (ov > bv || (ov == bv && oi < bix)) {
+        bv = ov; bix = oi;
+      }
+    }
+    if (l == 0) {
+      rv[w] = bv; ri[w] = bix;
+    }
+    __syncthreads();
+    if (t == 0) {
+      float v = rv[0];
+      u32 x = ri[0];
+      for (u32 k = 1; k < 32; k++) {
+        if (rv[k] > v || (rv[k] == v && ri[k] < x)) {
+          v = rv[k]; x = ri[k];
+        }
+      }
+      ids[j] = x;
+      wt[j] = v;
+      pv[x] = -2.0f;
+    }
+    __syncthreads();
+  }
+  if (t == 0) {
+    float s = 0.0f;
+    for (u32 j = 0; j < nk; j++) {
+      s = __fadd_rn(s, wt[j]);
+    }
+    s = s < 6.103515625e-5f ? 6.103515625e-5f : s;
+    for (u32 j = 0; j < nk; j++) {
+      wt[j] = __fdiv_rn(wt[j], s);
+    }
+    sgo[0] = __fdiv_rn(1.0f, __fadd_rn(1.0f, attn_exp(-sg[0])));
+  }
+}
+
+// gate + up + silu for the k chosen experts: block (bx, j) = rows 4 bx .. 4 bx + 3 of expert ids[j],
+// a warp a row; act[j ef + r] = silu(gate . x) * (up . x) (llb_silu's formula). G / U the stacks'
+// bases, es the expert stride (bytes), rbg / rbu the row bytes (fused: U = G + ef rows, the same es)
+extern "C" __global__ void __launch_bounds__(128) llb_moe_gu(const u8* __restrict__ G, const u8* __restrict__ U,
+  u64 es, u32 rbg, u32 rbu, u32 fg, u32 fu, u32 cg, const float* __restrict__ x, const u32* __restrict__ ids,
+  float* __restrict__ act, u32 ef) {
+  const u32 r = blockIdx.x * 4 + (threadIdx.x >> 5), j = blockIdx.y;
+  if (r >= ef) {
+    return;
+  }
+  const u64 e = ids[j];
+  const float g = moe_dot(G + e * es + (u64)r * rbg, fg, cg, x);
+  const float u = moe_dot(U + e * es + (u64)r * rbu, fu, cg, x);
+  if ((threadIdx.x & 31) == 0) {
+    act[(u64)j * ef + r] = __fmul_rn(__fdiv_rn(g, __fadd_rn(1.0f, attn_exp(-g))), u);
+  }
+}
+
+// down for the k experts, weighted and summed in rank order, then + the gated shared expert, then
+// + the residual: y[r] = (sum_j wt[j] (down_ids[j] row r . act_j) + shd[r] sgo[0]) + x1[r]
+// (llama.cpp's order: moe_out + ffn_shexp, then + ffn_inp). A warp a row of dm
+extern "C" __global__ void __launch_bounds__(128) llb_moe_dn(const u8* __restrict__ D, u64 es, u32 rbd, u32 fd,
+  u32 cg, const float* __restrict__ act, const u32* __restrict__ ids, const float* __restrict__ wt, u32 nk, u32 ef,
+  const float* __restrict__ x1, const float* __restrict__ shd, const float* __restrict__ sgo,
+  float* __restrict__ y, u32 dm) {
+  const u32 r = blockIdx.x * 4 + (threadIdx.x >> 5);
+  if (r >= dm) {
+    return;
+  }
+  float mo = 0.0f;
+  for (u32 j = 0; j < nk; j++) {
+    const float v = moe_dot(D + (u64)ids[j] * es + (u64)r * rbd, fd, cg, act + (u64)j * ef);
+    mo = j == 0 ? __fmul_rn(v, wt[0]) : __fadd_rn(mo, __fmul_rn(v, wt[j]));
+  }
+  if ((threadIdx.x & 31) == 0) {
+    y[r] = __fadd_rn(__fadd_rn(mo, __fmul_rn(shd[r], sgo[0])), x1[r]);
+  }
+}
