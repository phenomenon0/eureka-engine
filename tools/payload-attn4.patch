+
+// Qwen3.5 attention: K.scores4 + K.probs + K.weighted4 of all 16 query heads,
+// a block a head (tools/payload-attn4.patch). q 16 x 256, kc / vc 2^dT slots of
+// 4 kv heads x 256 (head h reads kv head h >> 2), sc / pr the two scratch
+// planes of gpu_atts (16 slots of 2^17 floats each); att 16 x 256. Slots
+// t > pos are masked to -inf. c = dT | pos << 5; scale 1 / sqrt(256), as
+// K.scores4's sc. The trees are attn_push / attn_exp, flat.bend's.
+extern "C" __global__ void __launch_bounds__(256) llb_attn4(
+  const float* __restrict__ q, const float* __restrict__ kc,
+  const float* __restrict__ vc, float* __restrict__ att,
+  float* __restrict__ sc, float* __restrict__ pr, u32 c) {
+  const u32 h = blockIdx.x, dT = c & 31, pos = c >> 5, T = 1u << dT;
+  const u32 g = (h >> 2) * 256;
+  const float scale = __fdiv_rn(1.0f, __fsqrt_rn(256.0f));
+  const float ninf = __uint_as_float(0xFF800000u);
+  float* sh = sc + (u64)h * (1u << 17);
+  float* ph = pr + (u64)h * (1u << 17);
+  const float* qh = q + (u64)h * 256;
+  for (u32 t = threadIdx.x; t < T; t += blockDim.x) {
+    const float* k = kc + (u64)t * 1024 + g;
+    float st[9];
+    u32   sp = 0;
+    for (u32 i = 0; i < 256; i++) {
+      attn_push(st, &sp, i, __fmul_rn(k[i], qh[i]));
+    }
+    sh[t] = __fmul_rn(st[0], scale);
+  }
+  __syncthreads();
+  if (threadIdx.x == 0) {
+    float st[18];
+    u32   sp = 0;
+    for (u32 t = 0; t < T; t++) {
+      float v = t <= pos ? sh[t] : ninf;
+      u32   i = t;
+      for (; i & 1; i >>= 1) {
+        float a = st[--sp];
+        v = a < v ? v : a;
+      }
+      st[sp++] = v;
+    }
+    const float m = st[0];
+    sp = 0;
+    for (u32 t = 0; t < T; t++) {
+      ph[t] = attn_exp(__fsub_rn(t <= pos ? sh[t] : ninf, m));
+      attn_push(st, &sp, t, ph[t]);
+    }
+    const float z = st[0];
+    for (u32 t = 0; t < T; t++) {
+      ph[t] = __fdiv_rn(ph[t], z);
+    }
+  }
+  __syncthreads();
+  const u32 j = threadIdx.x;
+  float st[18];
+  u32   sp = 0;
+  for (u32 t = 0; t < T; t++) {
+    attn_push(st, &sp, t, __fmul_rn(vc[(u64)t * 1024 + g + j], ph[t]));
+  }
+  att[(u64)h * 256 + j] = st[0];
+}
