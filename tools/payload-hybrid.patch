+// Qwen3.5 hybrid kernels (tools/payload-hybrid.patch): each reproduces
+// kernels/ops.bend's balanced tree leaf for leaf with __f*_rn (no FMA),
+// transcendentals through F64 (attn_exp), exactly as llb_rms does.
+
+// K.dot/K.sumsq's balanced tree over 128 (pairs, then halves up)
+__device__ static float hyb_dot_128(const float* __restrict__ a,
+  const float* __restrict__ b) {
+  float p[64];
+  #pragma unroll
+  for (u32 i = 0; i < 64; i += 1) {
+    p[i] = __fadd_rn(__fmul_rn(a[2 * i], b[2 * i]),
+      __fmul_rn(a[2 * i + 1], b[2 * i + 1]));
+  }
+  #pragma unroll
+  for (u32 st = 1; st < 64; st <<= 1) {
+    #pragma unroll
+    for (u32 i = 0; i < 64; i += 2 * st) {
+      p[i] = __fadd_rn(p[i], p[i + st]);
+    }
+  }
+  return p[0];
+}
+
+// K.l2norm over heads heads of 128: y := v * (1 / max(sqrt(sumsq), eps)) / sc
+extern "C" __global__ void __launch_bounds__(64) llb_l2norm(
+  const float* __restrict__ v, float* __restrict__ y, float sc, u32 heads) {
+  __shared__ float a[64];
+  __shared__ float sv;
+  const u32 h = blockIdx.x, t = threadIdx.x;
+  if (h >= heads || t >= 64) {
+    return;
+  }
+  const float2 x = ((const float2*)(v + ((u64)h << 7)))[t];
+  a[t] = __fadd_rn(__fmul_rn(x.x, x.x), __fmul_rn(x.y, x.y));
+  __syncthreads();
+  #pragma unroll
+  for (u32 st = 1; st < 64; st <<= 1) {
+    if ((t & (2 * st - 1)) == 0) {
+      a[t] = __fadd_rn(a[t], a[t + st]);
+    }
+    __syncthreads();
+  }
+  if (t == 0) {
+    const float rt = __fsqrt_rn(a[0]);
+    const float ep = __uint_as_float(0x358637BDu);
+    sv = __fdiv_rn(__fdiv_rn(1.0f, (rt < ep ? ep : rt)), sc);
+  }
+  __syncthreads();
+  const float s = sv;
+  ((float2*)(y + ((u64)h << 7)))[t] = make_float2(__fmul_rn(x.x, s), __fmul_rn(x.y, s));
+}
+
+// K.conv1d (4-tap + SiLU) over nch channels; w [nch,4] F32
+extern "C" __global__ void __launch_bounds__(256) llb_conv1d(
+  const float* __restrict__ w, const float* __restrict__ x,
+  const float* __restrict__ h0, const float* __restrict__ h1,
+  const float* __restrict__ h2, float* __restrict__ y, u32 nch) {
+  const u32 c = blockIdx.x * 256 + threadIdx.x;
+  if (c >= nch) {
+    return;
+  }
+  const float a = __fadd_rn(__fmul_rn(h0[c], w[4 * c]), __fmul_rn(h1[c], w[4 * c + 1]));
+  const float b = __fadd_rn(__fmul_rn(h2[c], w[4 * c + 2]), __fmul_rn(x[c], w[4 * c + 3]));
+  const float u = __fadd_rn(a, b);
+  y[c] = __fdiv_rn(u, __fadd_rn(1.0f, attn_exp(-u)));
+}
+
+// K.gated_rmsnorm over heads heads of 128; w [128] shared
+extern "C" __global__ void __launch_bounds__(64) llb_gated_rmsnorm(
+  const float* __restrict__ o, const float* __restrict__ w,
+  const float* __restrict__ z, float* __restrict__ y, u32 heads) {
+  __shared__ float a[64];
+  __shared__ float sv;
+  const u32 h = blockIdx.x, t = threadIdx.x;
+  if (h >= heads || t >= 64) {
+    return;
+  }
+  const float2 x = ((const float2*)(o + ((u64)h << 7)))[t];
+  a[t] = __fadd_rn(__fmul_rn(x.x, x.x), __fmul_rn(x.y, x.y));
+  __syncthreads();
+  #pragma unroll
+  for (u32 st = 1; st < 64; st <<= 1) {
+    if ((t & (2 * st - 1)) == 0) {
+      a[t] = __fadd_rn(a[t], a[t + st]);
+    }
+    __syncthreads();
+  }
+  if (t == 0) {
+    sv = __fdiv_rn(1.0f, __fsqrt_rn(__fadd_rn(__fdiv_rn(a[0], 128.0f),
+      __uint_as_float(0x358637BDu))));
+  }
+  __syncthreads();
+  const float s = sv;
+  const float2 wv = ((const float2*)w)[t];
+  const float2 zz = ((const float2*)(z + ((u64)h << 7)))[t];
+  const float zx = __fdiv_rn(zz.x, __fadd_rn(1.0f, attn_exp(-zz.x)));
+  const float zy = __fdiv_rn(zz.y, __fadd_rn(1.0f, attn_exp(-zz.y)));
+  ((float2*)(y + ((u64)h << 7)))[t] = make_float2(
+    __fmul_rn(__fmul_rn(__fmul_rn(x.x, s), wv.x), zx),
+    __fmul_rn(__fmul_rn(__fmul_rn(x.y, s), wv.y), zy));
+}
+
+// K.gated_delta over heads value heads; S [heads,128,128] updated in place,
+// y the readout [heads,128]. One block a head, one thread a row.
+extern "C" __global__ void __launch_bounds__(128) llb_gated_delta(
+  float* __restrict__ S, const float* __restrict__ q, const float* __restrict__ kk,
+  const float* __restrict__ v, const float* __restrict__ dec,
+  const float* __restrict__ bet, float* __restrict__ y, u32 heads) {
+  const u32 h = blockIdx.x, j = threadIdx.x;
+  if (h >= heads) {
+    return;
+  }
+  float*       Srow = S + (((u64)h * 128 + j) << 7);
+  const float* kk_h = kk + ((u64)h << 7);
+  const float  decay = dec[h], beta = bet[h];
+  #pragma unroll
+  for (u32 i = 0; i < 128; i += 1) {
+    Srow[i] = __fmul_rn(Srow[i], decay);
+  }
+  const float kv = hyb_dot_128(Srow, kk_h);
+  const float delta = __fmul_rn(__fsub_rn(v[((u64)h << 7) + j], kv), beta);
+  #pragma unroll
+  for (u32 i = 0; i < 128; i += 1) {
+    Srow[i] = __fadd_rn(Srow[i], __fmul_rn(kk_h[i], delta));
+  }
+  y[((u64)h << 7) + j] = hyb_dot_128(Srow, q + ((u64)h << 7));
+}
