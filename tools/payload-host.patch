-// The whole-pass bang (tools/payload-pass.patch): layers s..s+k-1 of one
-// step, each the linb (SSM) or fulb (full, (i + 1) % 4 == 0) chain into a,
-// then the fbn chain (x, a) into the next x; the last into y. The layer state
-// lives here, not in the interpreter: per SSM layer a ring of four 8192 conv
-// buffers (h0, h1, h2, qkva = b[r .. r + 3 mod 4], r += 1 a step: lin.go's
-// (h1, h2, qkva) rotation; qkva's GEMV writes all 8192 rows before conv reads
-// it) and S (2^19); per full layer kc, vc (2^(dT + 10)). Zeroed at first use
-// as Array.new(F32, _, 0.0) was; each layer must then see pos, pos + 1, ...
-// a and the x ping-pong are fully written (4096 rows) before each read.
-// ponytail: commits 16 x 2^(dT + 10) f32 of caches up front (8 GB at dT 17);
-// allocate by pos if long contexts matter.
-static CUdeviceptr pass_b[32], pass_S[32], pass_kc[32], pass_vc[32], pass_x[3];
-static u32  pass_r[32], pass_pos[32], pass_dT;
-static bool pass_on[32];
-
-static CUdeviceptr pass_zero(size_t n) {
-  CUdeviceptr p = 0;
-  if (cuMemAlloc(&p, n * 4) != CUDA_SUCCESS || cuMemsetD32(p, 0, n) != CUDA_SUCCESS) {
-    err_fail("warp pass: cannot allocate the layer state");
-  }
-  return p;
-}
-
-static void llb_pass_run(volatile WarpOp* o, u64 yp, u32 grid) {
-  u32 c = o->c, dT = c & 31, pos = c >> 5, s = o->n, k = o->d;
-  if (pass_x[0] == 0) {
-    for (u32 b = 0; b < 3; b += 1) {
-      pass_x[b] = pass_zero(4096);
-    }
-    pass_dT = dT;
-  }
-  if (dT != pass_dT) {
-    err_fail("warp pass: dT changed");
-  }
-  u64 cur = o->x;
-  bool fold = o->w != 0;
-  if (fold) {
-    // the folded step: the token's embedding row into pass_x[0]
-    u64 er = o->w, x0 = pass_x[0];
-    u32 c4 = 4096;
-    void* ea[] = { &er, &c4, &x0 };
-    if (cuLaunchKernel(gpu_embed, 16, 1, 1, 256, 1, 1, 0, NULL, ea, NULL)
-      != CUDA_SUCCESS) {
-      err_fail("device launch failed");
-    }
-    cur = x0;
-  }
-  for (u32 j = 0; j < k; j += 1) {
-    u32  i = s + j;
-    bool full = (i + 1) % 4 == 0;
-    if (!pass_on[i]) {
-      if (pos != 0) {
-        err_fail("warp pass: a layer's state must start at pos 0");
-      }
-      if (full) {
-        pass_kc[i] = pass_zero((size_t)1 << (dT + 10));
-        pass_vc[i] = pass_zero((size_t)1 << (dT + 10));
-      } else {
-        pass_b[i] = pass_zero(4 * 8192);
-        pass_S[i] = pass_zero((size_t)1 << 19);
-      }
-      pass_on[i] = true;
-    } else if (pass_pos[i] + 1 != pos) {
-      err_fail("warp pass: a layer served out of order");
-    }
-    pass_pos[i] = pos;
-    u64 base = gpu_mail->pw[j];
-    volatile u32* p = gpu_mail->po + (full ? 20 : 0);
-    WarpOp at = {0};
-    at.w = base; at.x = cur; at.brg = o->brg; at.ban = p[0];
-    if (full) {
-      at.k = pass_kc[i]; at.v = pass_vc[i];
-      at.bq = p[14]; at.bg = p[15]; at.bb = p[16];
-      at.ba = p[17]; at.bsa = p[18]; at.bdt = p[19];
-      at.c = c; at.fm = 1;
-      llb_fulb_run(&at, pass_x[2], grid);
-    } else {
-      u32 r = pass_r[i];
-      pass_r[i] = r + 1;
-      at.k  = pass_b[i] + (u64)(r % 4) * 8192 * 4;
-      at.v  = pass_b[i] + (u64)((r + 1) % 4) * 8192 * 4;
-      at.wn = pass_b[i] + (u64)((r + 2) % 4) * 8192 * 4;
-      at.qk = pass_b[i] + (u64)((r + 3) % 4) * 8192 * 4;
-      at.r  = pass_S[i];
-      at.c = p[5]; at.bq = p[6]; at.bg = p[7]; at.bb = p[8]; at.ba = p[9];
-      at.bsa = p[10]; at.bdt = p[11]; at.bcv = p[12]; at.bsn = p[13];
-      llb_linb_run(&at, pass_x[2], grid);
-    }
-    WarpOp ff = {0};
-    ff.w = base + p[1]; ff.k = base + p[2]; ff.v = base + p[3]; ff.wn = base + p[4];
-    ff.x = cur; ff.r = pass_x[2]; ff.n = 4096; ff.rb = o->brg; ff.d = o->rb; ff.fm = 1;
-    u64 nxt = j + 1 == k && !fold ? yp : pass_x[cur == pass_x[0] ? 1 : 0];
-    llb_fbn_run(&ff, nxt, grid);
-    cur = nxt;
-  }
-  if (fold) {
-    // the head bang's chain (kind 14): rms_final -> gpu_headh, the head GEMV
-    // into gpu_logit, llb_amax's four words into y
-    u64 wn = o->k, wo = o->v, op2 = gpu_headh, lg = gpu_logit;
-    u32 n4 = 4096, nh = o->gm, rq = o->bq, cg = o->bq / 17 * 4, dh = 10;
-    void* ra[] = { &cur, &wn, &op2, &n4 };
-    void* ga[] = { &wo, &rq, &cg, &op2, &lg, &nh, &dh };
-    void* am[] = { &lg, &nh, &yp };
-    if (cuLaunchKernel(gpu_rnorm, 1, 1, 1, 1024, 1, 1, 0, NULL, ra, NULL)
-      != CUDA_SUCCESS
-      || cuLaunchKernel(gpu_warpq, grid, 1, 1, 128, 1, 1, 0, NULL, ga, NULL)
-        != CUDA_SUCCESS
-      || cuLaunchKernel(gpu_amaxp, AMAX_G, 1, 1, AMAX_T, 1, 1, 0, NULL, am, NULL)
-        != CUDA_SUCCESS
-      || cuLaunchKernel(gpu_amax, 1, 1, 1, AMAX_G, 1, 1, 0, NULL, am, NULL)
-        != CUDA_SUCCESS) {
-      err_fail("device launch failed");
-    }
-  }
-}
-#endif
