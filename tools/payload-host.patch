@@ -5,6 +5,17 @@
 import * as fs from "node:fs";
 
 import * as Bend from "./bend.ts";
+// The llb host chains live in host/llb_host.c (LLB_HOST_DIR, set by tools/build_gpu.sh),
+// neutral C over host/llb_backend.h; the CUDA build puts llb_backend_cuda.h first. Each
+// #include "llb_*.h" is inlined so the emitted C stays one file.
+const llb_host = (): string => {
+  const d = process.env.LLB_HOST_DIR;
+  if (!d) throw new Error("LLB_HOST_DIR unset: build with tools/build_gpu.sh");
+  const read = (f: string): string =>
+    fs.readFileSync(`${d}/${f}`, "utf8").replace(/\n$/, "")
+      .replace(/^#include "(llb_\w+\.h)"$/gm, (_, h: string) => read(h));
+  return `#if BEND_CUDA\n${read("llb_backend_cuda.h")}\n#endif\n${read("llb_host.c")}`;
+};
 
