+#if BEND_CUDA && defined(LLB_WARP_FID)
+// The parked warp GEMVs (warp_park), args (f, +wb, +x, y, +base, +n, +d, +rb)
+// as flat.bend's gemv: each runs as one llb_warp launch (LLB_WARP_GRID
+// blocks of 128, default 164), then y goes to its continuation; a join that
+// completes reopens the frontier on ring 0.
+static bool warp_serve(Corpus H) {
+  u32 m = a32_load(a32_at(H, H_WARP_N));
+  if (m == 0) {
+    return false;
+  }
+  const char* gs   = getenv("LLB_WARP_GRID");
+  u32         grid = gs != NULL && atoi(gs) > 0 ? (u32)atoi(gs) : 164;
+  Env         e    = { H, ALC[0] };
+  for (u32 j = 0; j < m; j += 1) {
+    Loc      a  = term_loc(H[H_WARP + j]);
+    Term     x  = H[a + 2], y = H[a + 3];
+    u32      bs = (u32)H[a + 4], n = (u32)H[a + 5], d = (u32)H[a + 6];
+    u32      rb = (u32)H[a + 7];
+    StrParts p  = str_peek_ro(e, H[a + 1]);
+    const u8* w = (const u8*)(H + term_peek_ro(e, p.data)) + p.off + bs;
+    if (term_tag(H[a + 1]) != TAG_STR || str_nar(p) != 2 || d < 9 || d > 12
+      || rb % 16 != 0 || ((uintptr_t)w & 15) != 0
+      || (u64)bs + (u64)n * rb > p.len || term_tag(x) == TAG_ARR
+      || term_tag(y) == TAG_ARR || blk_cls(x) < d + 2
+      || n > 1ull << blk_cls(y)) {
+      err_fail("warp GEMV: unsupported operands");
+    }
+    u32   rq = rb / 16, cg = rb / 16;
+    const u32* xp = (const u32*)(H + blk_loc(H, x));
+    u32*  yp = (u32*)(H + blk_loc(H, y));
+    void* args[] = { &w, &rq, &cg, &xp, &yp, &n, &d };
+    if (cuLaunchKernel(gpu_warp, grid, 1, 1, 128, 1, 1, 0, NULL, args, NULL)
+      != CUDA_SUCCESS) {
+      err_fail("device launch failed");
+    }
+  }
+  if (cuCtxSynchronize() != CUDA_SUCCESS) {
+    err_fail("device fault");
+  }
+  u32 k = 0;
+  for (u32 j = 0; j < m; j += 1) {
+    Term t  = H[H_WARP + j];
+    Loc  tl = task_tail(t);
+    Term rv[WL_RESW];
+    rv[0]   = H[term_loc(t) + 3];
+    Term c  = task_deliver(H, H[tl], (u32)(H[tl + 1] >> 32) & 0xFFFF, rv, 1);
+    if (c != 0) {
+      ring_push(H, 0, c);
+      k += 1;
+    }
+  }
+  a32_store(a32_at(H, H_WARP_N), 0);
+  a32_store(a32_at(H, H_CURSOR), k);
+  return true;
+}
+#else
+#define warp_serve(H) false
+#endif
