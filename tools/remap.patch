+// Warp GEMV
+// =========
+
+// A warp GEMV task (LLB_WARP_FID) is parked, not run: the host takes the
+// parked ones once the frontier drains, runs each as one launch (llb_warp)
+// and delivers y to its continuation.
+#define H_WARP_N (2 * LINE + 1)
+#define H_WARP   (3 * LINE + 1)
+#define WARP_MAX (LINE - 1)
