+INLINE void warp_park(Corpus H, Term t) {
+  u32 i = a32_add(a32_at(H, H_WARP_N), 1);
+  if (i >= WARP_MAX) {
+    err_post(H, ERR_RING);
+    return;
+  }
+  H[H_WARP + i] = t;
+}
