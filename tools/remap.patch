+#if defined(BEND_RTC) && defined(LLB_WARP_FID)
+// The contract GEMV (reports/llb-headprobe.md (c)): a warp per row; in each
+// chunk of 512 groups lane l owns groups 32i+l (one coalesced 512 B LDG.128
+// per warp per i); leaf (w0*x0 + w1*x1) + (w2*x2 + w3*x3), padding 0*x; group
+// bits 0..4 by xor butterfly, lower index on the left, bits 5..8 pairwise in
+// registers, chunk bits pairwise: ops.bend's balanced tree over 2^d groups.
+// W: rq float4 a row; cg groups are in the row; x: 4 << d f32 bits.
+INLINE void warp_x(float4* xv, const u32* __restrict__ x, u32 k, u32 l) {
+  #pragma unroll
+  for (u32 i = 0; i < 16; i++) {
+    u32 g = 4 * (512 * k + 32 * i + l);
+    xv[i] = make_float4(__uint_as_float(x[g]), __uint_as_float(x[g + 1]),
+      __uint_as_float(x[g + 2]), __uint_as_float(x[g + 3]));
+  }
+}
+
+extern "C" __global__ void __launch_bounds__(128) llb_warp(
+  const float4* __restrict__ W, u32 rq, u32 cg, const u32* __restrict__ x,
+  u32* __restrict__ y, u32 n, u32 d) {
+  const u32 l = threadIdx.x & 31, nw = gridDim.x * (blockDim.x >> 5);
+  const u32 ch = 1u << (d - 9);
+  float4 xv[16];
+  if (ch == 1) {
+    warp_x(xv, x, 0, l);
+  }
+  for (u32 r = blockIdx.x * (blockDim.x >> 5) + (threadIdx.x >> 5); r < n;
+    r += nw) {
+    const float4* row = W + (u64)r * rq;
+    float s[8];
+    for (u32 k = 0; k < ch; k++) {
+      if (ch > 1) {
+        warp_x(xv, x, k, l);
+      }
+      float4 w[16];
+      #pragma unroll
+      for (u32 i = 0; i < 16; i++) {
+        u32 g = 512 * k + 32 * i + l;
+        w[i] = g < cg ? row[g] : make_float4(0.f, 0.f, 0.f, 0.f);
+      }
+      float v[16];
+      #pragma unroll
+      for (u32 i = 0; i < 16; i++) {
+        float4 a = w[i], b = xv[i];
+        v[i] = __fadd_rn(__fadd_rn(__fmul_rn(a.x, b.x), __fmul_rn(a.y, b.y)),
+          __fadd_rn(__fmul_rn(a.z, b.z), __fmul_rn(a.w, b.w)));
+      }
+      #pragma unroll
+      for (u32 m = 1; m < 32; m <<= 1) {
+        #pragma unroll
+        for (u32 i = 0; i < 16; i++) {
+          float o = __shfl_xor_sync(0xffffffffu, v[i], m);
+          v[i] = (l & m) ? __fadd_rn(o, v[i]) : __fadd_rn(v[i], o);
+        }
+      }
+      #pragma unroll
+      for (u32 st = 1; st < 16; st <<= 1) {
+        #pragma unroll
+        for (u32 i = 0; i < 16; i += 2 * st) {
+          v[i] = __fadd_rn(v[i], v[i + st]);
+        }
+      }
+      s[k] = v[0];
+    }
+    for (u32 st = 1; st < ch; st <<= 1) {
+      for (u32 k = 0; k < ch; k += 2 * st) {
+        s[k] = __fadd_rn(s[k], s[k + st]);
+      }
+    }
+    if (l == 0) {
+      y[r] = __float_as_uint(s[0]);
+    }
+  }
+}
+#endif
