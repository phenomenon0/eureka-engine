+// fbn's residual folded into the K down GEMV's store (tools/payload-q4glue.patch):
+// y[r] = x1[r] + dd[r], llb_vadd's op on the row value. (silu in the up's
+// store is not here: its F64 exp on 2 lanes a warp cost more than llb_silu)
+struct KpRes {
+  static __device__ __forceinline__ float st(const float* x1, u32 r, float v) {
+    return __fadd_rn(x1[r], v);
+  }
+};
+
+// the pair body only: the host takes these where cg % 256 == 0 and d is 9..13
+extern "C" __global__ void __launch_bounds__(128, 4) llb_warp_q4k_res(
+  const u8* __restrict__ W, u32 rb, u32 cg, const u32* __restrict__ x,
+  u32* __restrict__ y, u32 n, u32 d, const float* __restrict__ x1) {
+  kp_warp<4, 1, KpRes>(W, rb, cg, x, y, n, d, blockIdx.x, gridDim.x, x1);
+}
+
+extern "C" __global__ void __launch_bounds__(128, 4) llb_warp_q6k_res(
