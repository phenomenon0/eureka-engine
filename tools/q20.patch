+// group g of a Q2_0 (qk = 64) or PQ2_0 (qk = 128) row (tools/q20.py): f16 d +
+// qs[qk/4], 18 or 34 bytes a block. Weight j = ((qs[j/4] >> (j%4)*2) & 3 - 1)
+// * d, ggml's dequantize_row_q2_0 / _pq2_0; (q-1)*d is exact. A group of four
+// columns is exactly one qs byte. tools/q20.patch
+INLINE float4 q20_w(const u8* __restrict__ row, u32 g, u32 qk) {
+  u32 c = 4 * g, blk = c / qk, rr = c % qk;
+  const u8* B = row + (u64)blk * (2 + qk / 4);
+  float d = llb_f16(*(const unsigned short*)B);
+  u32 v = B[2 + (rr >> 2)];
+  return make_float4(
+    __fmul_rn(d, (float)((int)(v & 3) - 1)),
+    __fmul_rn(d, (float)((int)((v >> 2) & 3) - 1)),
+    __fmul_rn(d, (float)((int)((v >> 4) & 3) - 1)),
+    __fmul_rn(d, (float)((int)((v >> 6) & 3) - 1)));
+}
