+// Qwen2.5 qk-norm (tools/qknorm.patch): per-head RMSNorm on v[rows][128] with
+// gain g[128]. For each row r: s = 1 / sqrt(sumsq / 128 + eps), sumsq the
+// balanced tree of v * v over 128 elements (64 pairs, then halves up in shared
+// memory); out = (v * s) * g. Block size 64, gridDim.x = rows.
+extern "C" __global__ void __launch_bounds__(64) llb_qknorm(
+  const float* __restrict__ v, const float* __restrict__ g,
+  float* __restrict__ out, u32 rows) {
+  __shared__ float a[64];
+  __shared__ float sv;
+  const u32 t = threadIdx.x;
+  for (u32 r = blockIdx.x; r < rows; r += gridDim.x) {
+    const float2* __restrict__ row2 = (const float2*)(v + r * 128);
+    const float2 x = row2[t];
+    const float x0 = x.x;
+    const float x1 = x.y;
+    a[t] = __fadd_rn(__fmul_rn(x0, x0), __fmul_rn(x1, x1));
+    __syncthreads();
+    #pragma unroll
+    for (u32 st = 1; st < 64; st <<= 1) {
+      if ((t & (2 * st - 1)) == 0) {
+        a[t] = __fadd_rn(a[t], a[t + st]);
+      }
+      __syncthreads();
+    }
+    if (t == 0) {
+      sv = __fdiv_rn(1.0f, __fsqrt_rn(__fadd_rn(__fdiv_rn(a[0], 128.0f),
+        __uint_as_float(0x358637BDu))));
+    }
+    __syncthreads();
+    const float s = sv;
+    const float2* __restrict__ g2 = (const float2*)g;
+    const float2 gv = g2[t];
+    float2* __restrict__ out2 = (float2*)(out + r * 128);
+    out2[t] = make_float2(
+      __fmul_rn(__fmul_rn(x0, s), gv.x),
+      __fmul_rn(__fmul_rn(x1, s), gv.y)
+    );
+    __syncthreads();
+  }
+}
