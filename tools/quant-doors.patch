+// llb_warp over Q4_K rows (tools/q4k.patch): the same groups, leaf and
+// tree, each weight dequantized on load; a copy, so the gated kernels stay
+// untouched
+__device__ __forceinline__ void warp_dq4k(
+  const u8* __restrict__ W, u32 rb, u32 cg, const u32* __restrict__ x,
+  u32* __restrict__ y, u32 n, u32 d) {
+  const u32 l = threadIdx.x & 31, nw = gridDim.x * (blockDim.x >> 5);
+  const u32 ch = 1u << (d - 9);
+  float4 xv[16];
+  if (ch == 1) {
+    warp_x(xv, x, 0, l);
+  }
+  for (u32 r = blockIdx.x * (blockDim.x >> 5) + (threadIdx.x >> 5); r < n;
+    r += nw) {
+    const u8* row = W + (u64)r * rb;
+    float s[4];
+    for (u32 k = 0; k < ch; k++) {
+      if (ch > 1) {
+        warp_x(xv, x, k, l);
+      }
+      float4 w[16];
+      #pragma unroll
+      for (u32 i = 0; i < 16; i++) {
+        u32 g = 512 * k + 32 * i + l;
+        w[i] = g < cg ? q4k_w(row, g)
+          : make_float4(0.f, 0.f, 0.f, 0.f);
+      }
+      float v[16];
+      #pragma unroll
+      for (u32 i = 0; i < 16; i++) {
+        float4 a = w[i], b = xv[i];
+        v[i] = __fadd_rn(__fadd_rn(__fmul_rn(a.x, b.x), __fmul_rn(a.y, b.y)),
+          __fadd_rn(__fmul_rn(a.z, b.z), __fmul_rn(a.w, b.w)));
+      }
+      #pragma unroll
+      for (u32 m = 1; m < 32; m <<= 1) {
+        #pragma unroll
+        for (u32 i = 0; i < 16; i++) {
+          float o = __shfl_xor_sync(0xffffffffu, v[i], m);
+          v[i] = (l & m) ? __fadd_rn(o, v[i]) : __fadd_rn(v[i], o);
+        }
+      }
+      #pragma unroll
+      for (u32 st = 1; st < 16; st <<= 1) {
+        #pragma unroll
+        for (u32 i = 0; i < 16; i += 2 * st) {
+          v[i] = __fadd_rn(v[i], v[i + st]);
+        }
+      }
+      s[k] = v[0];
+    }
+    for (u32 st = 1; st < ch; st <<= 1) {
+      for (u32 k = 0; k < ch; k += 2 * st) {
+        s[k] = __fadd_rn(s[k], s[k + st]);
+      }
+    }
+    if (l == 0) {
+      y[r] = __float_as_uint(s[0]);
+    }
+  }
+}
