+__device__ __forceinline__ void warp_dqpq2_0(
+  const u8* __restrict__ W, u32 rb, u32 cg, const u32* __restrict__ x,
+  u32* __restrict__ y, u32 n, u32 d) {
+  const u32 l = threadIdx.x & 31, nw = gridDim.x * (blockDim.x >> 5);
+  const u32 ch = 1u << (d - 9);
+  float4 xv[16];
+  if (ch == 1) {
+    warp_x(xv, x, 0, l);
+  }
+  for (u32 r = blockIdx.x * (blockDim.x >> 5) + (threadIdx.x >> 5); r < n;
+    r += nw) {
+    const u8* row = W + (u64)r * rb;
+    float s[4];
+    for (u32 k = 0; k < ch; k++) {
+      if (ch > 1) {
+        warp_x(xv, x, k, l);
+      }
+      float4 w[16];
+      #pragma unroll
+      for (u32 i = 0; i < 16; i++) {
+        u32 g = 512 * k + 32 * i + l;
+        w[i] = g < cg ? q20_w(row, g, 128u)
+          : make_float4(0.f, 0.f, 0.f, 0.f);
+      }
+      float v[16];
+      #pragma unroll
+      for (u32 i = 0; i < 16; i++) {
