+// The Q8_0 dp4a tier on q4dp2.cuh's two planes (tools/payload-dp4b.patch, LLB_Q4_DP4A
+// bit 16): llama.cpp's vec_dot_q8_0_q8_1 on x = e (127 q + q2). A repacked Q8_0 row
+// (rb bytes) is c int8 weights, then c / 32 f16 scales; one row a block of 128:
+// thread t takes the 16 weights at 2048 i + 16 t (i = 0, 1, ..) against both
+// planes' 16, s = w's f16, e = dx's of that block:
+//   acc = fma(s * e, (float)(127 dot(w, q) + dot(w, q2)), acc)    (|.| < 2^26)
+// then q4dp2_row's order: warps 1..3 into warp 0, the xor butterfly 16 .. 1.
+// Needs c % 256 == 0 (rb % 16 == 0). CPU twin: tools/q27c/q4dp2_ref.h ref_q8row2.
+__device__ __forceinline__ float q8dp2_rowsum(const u8* __restrict__ row, u32 c,
+  const signed char* __restrict__ qx, const float* __restrict__ dx) {
+  __shared__ float part[3][32];
+  const u32 t = threadIdx.x, l = t & 31, w = t >> 5;
+  float acc = 0.0f;
+  for (u32 o = 16 * t; o < c; o += 2048) {
+    const int4 wv = *(const int4*)(row + o);
+    const int4 u = *(const int4*)(qx + o);
+    const int4 v = *(const int4*)(qx + c + o);
+    const int a = __dp4a(wv.w, u.w, __dp4a(wv.z, u.z, __dp4a(wv.y, u.y, __dp4a(wv.x, u.x, 0))));
+    const int b = __dp4a(wv.w, v.w, __dp4a(wv.z, v.z, __dp4a(wv.y, v.y, __dp4a(wv.x, v.x, 0))));
+    const float s = llb_f16(*(const unsigned short*)(row + c + 2 * (o >> 5)));
+    acc = __fmaf_rn(__fmul_rn(s, dx[o >> 5]), (float)(127 * a + b), acc);
+  }
+  if (w > 0) part[w - 1][l] = acc;
+  __syncthreads();
+  if (w > 0) return 0.0f;
+  acc = __fadd_rn(acc, part[0][l]);
+  acc = __fadd_rn(acc, part[1][l]);
+  acc = __fadd_rn(acc, part[2][l]);
+  #pragma unroll
+  for (u32 m = 16; m > 0; m >>= 1) acc = __fadd_rn(acc, __shfl_xor_sync(0xffffffffu, acc, m));
+  return acc;
+}
+// y = W x (n rows of c = (rb / 17) * 16 cols), grid n
+extern "C" __global__ void __launch_bounds__(128) llb_q8dp2(const u8* __restrict__ W, u32 rb,
+  const signed char* __restrict__ qx, const float* __restrict__ dx, float* __restrict__ y, u32 n) {
+  const u32 r = blockIdx.x;
+  const float a = q8dp2_rowsum(W + (u64)r * rb, rb / 17 * 16, qx, dx);
+  if (threadIdx.x == 0) y[r] = a;
+}
+// llb_warp_q8_cat's members over one x, grid c.end[3]: block r is member k's row r - end[k - 1]
+extern "C" __global__ void __launch_bounds__(128) llb_q8dp2_cat(u32 rb,
+  const signed char* __restrict__ qx, const float* __restrict__ dx, Q8Cat cc) {
+  const u32 r = blockIdx.x, k = (r >= cc.end[0]) + (r >= cc.end[1]) + (r >= cc.end[2]);
+  // selects, not cc.W[k]: a dynamic index into the by-value param spills it to local memory
+  const u32 i = r - (k == 0 ? 0 : k == 1 ? cc.end[0] : k == 2 ? cc.end[1] : cc.end[2]);
+  const u8* W = k == 0 ? cc.W[0] : k == 1 ? cc.W[1] : k == 2 ? cc.W[2] : cc.W[3];
+  const float a = q8dp2_rowsum(W + (u64)i * rb, rb / 17 * 16, qx, dx);
+  u32* y = k == 0 ? cc.y[0] : k == 1 ? cc.y[1] : k == 2 ? cc.y[2] : cc.y[3];
+  if (threadIdx.x == 0) y[i] = __float_as_uint(a);
+}
+// The Q6_K dp4a tier on q4dp2.cuh's two planes (tools/payload-dp4b.patch,
+// LLB_Q4_DP4A bit 32): llama.cpp's vec_dot_q6_K_q8_1 on x = e (127 q + q2).
+// A row is c / 256 ggml block_q6_K's (210 bytes: ql 128, qh 64, sc 16, d f16;
+// 2-byte aligned, so 16-bit loads). Unit u = (superblock u / 8, half n, cols l..l+7,
+// l = 8 (u & 3)) is 24 bytes: ql[64 n + l] (quads 0 / 2), ql[64 n + 32 + l]
+// (1 / 3), qh[32 n + l]; quad q's 8 weights (q6 - 32) sit at col 256 b + 128 n +
+// 32 q + l against x block 8 b + 4 n + q (e) and its scale sc[8 n + 2 q + l / 16]:
+//   acc = fma((d * sc) * e, (float)(127 dot(w, q) + dot(w, q2)), acc)   (|.| < 2^24)
+// quads 0..3 in order; lane j takes units j, j + 32, ..; one warp a row (4 a
+// block of 128), the xor butterfly 16 .. 1. Needs c % 256 == 0. Twin: q4dp2_ref.h ref_q6row2.
+__device__ __forceinline__ u32 q6dp2_w4(const u8* __restrict__ p) {
+  return (u32)*(const unsigned short*)p | (u32)*(const unsigned short*)(p + 2) << 16;
+}
+extern "C" __global__ void __launch_bounds__(128) llb_q6dp2(const u8* __restrict__ W, u32 rb,
+  const signed char* __restrict__ qx, const float* __restrict__ dx, float* __restrict__ y, u32 n) {
+  const u32 r = blockIdx.x * 4 + (threadIdx.x >> 5), l32 = threadIdx.x & 31;
+  if (r >= n) return;
+  const u32 c = rb / 210 * 256, nu = c / 32;
+  const u8* row = W + (u64)r * rb;
+  float acc = 0.0f;
+  for (u32 u = l32; u < nu; u += 32) {
+    const u32 b = u >> 3, hn = (u >> 2) & 1, l = 8 * (u & 3);
+    const u8* B = row + 210 * b;
+    const u32 La[2] = { q6dp2_w4(B + 64 * hn + l), q6dp2_w4(B + 64 * hn + l + 4) };
+    const u32 Lb[2] = { q6dp2_w4(B + 64 * hn + 32 + l), q6dp2_w4(B + 64 * hn + 32 + l + 4) };
+    const u32 H[2] = { q6dp2_w4(B + 128 + 32 * hn + l), q6dp2_w4(B + 128 + 32 * hn + l + 4) };
+    const float d = llb_f16(*(const unsigned short*)(B + 208));
+    #pragma unroll
+    for (u32 q = 0; q < 4; q++) {
+      const u32 xb = 8 * b + 4 * hn + q;
+      const int2 xa = *(const int2*)(qx + 32 * xb + l), xc = *(const int2*)(qx + c + 32 * xb + l);
+      int a = 0, s2 = 0;
+      #pragma unroll
+      for (u32 k = 0; k < 2; k++) {
+        const u32 L = q & 1 ? Lb[k] : La[k];
+        const u32 v = ((q >= 2 ? L >> 4 : L) & 0x0f0f0f0fu) | ((H[k] >> (2 * q)) & 0x03030303u) << 4;
+        const int w = (int)__vsub4(v, 0x20202020u);
+        a = __dp4a(w, k ? xa.y : xa.x, a);
+        s2 = __dp4a(w, k ? xc.y : xc.x, s2);
+      }
+      const float sc = (float)(signed char)B[192 + 8 * hn + 2 * q + (l >> 4)];
+      acc = __fmaf_rn(__fmul_rn(__fmul_rn(d, sc), dx[xb]), (float)(127 * a + s2), acc);
+    }
+  }
+  #pragma unroll
+  for (u32 m = 16; m > 0; m >>= 1) acc = __fadd_rn(acc, __shfl_xor_sync(0xffffffffu, acc, m));
+  if (l32 == 0) y[r] = acc;
+}
