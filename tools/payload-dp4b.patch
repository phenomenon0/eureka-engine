+// Lever 3 (LLB_Q4_DP4A=9, bit 64): llb_q8x2 fused into its producer's store.
+// Each warp stores 32 consecutive elements (all lanes active: n % 256 == 0, a
+// strided loop warp-uniform), so a block of 32's amax is the warp's; q / q2 /
+// e are llb_q8x2's ops on the same float (byte-identical planes).
+__device__ __forceinline__ void q8x2_st(float v, signed char* __restrict__ qx,
+  float* __restrict__ dx, u32 n, u32 i) {
+  float a = fabsf(v);
+  int nf = (__float_as_uint(v) & 0x7f800000u) == 0x7f800000u;
+  #pragma unroll
+  for (u32 m = 16; m > 0; m >>= 1) a = fmaxf(a, __shfl_xor_sync(0xffffffffu, a, m));
+  nf = __any_sync(0xffffffffu, nf);
+  const float d = __fdiv_rn(a, 127.0f), e = __fdiv_rn(d, 127.0f);
+  int q = 0, q2 = 0;
+  if (!nf && d != 0.0f) q = max(-127, min(127, (int)roundf(__fdiv_rn(v, d))));
+  if (!nf && e != 0.0f) q2 = max(-127, min(127, (int)roundf(__fdiv_rn(__fmaf_rn(-d, (float)q, v), e))));
+  qx[i] = (signed char)q;
+  qx[n + i] = (signed char)q2;
+  if ((i & 31) == 0) dx[i >> 5] = nf ? __uint_as_float(0x7fffffffu) : e;
+}
