+// The folded step's embedding row (tools/payload-fold.patch): y[i] = q[i] *
+// d[i >> 5] over a Q8_0 row of c columns ([c int8 q][c/32 f16le d]), exact
+// as flat.bend's q8.load (<= 19 significant bits).
+extern "C" __global__ void llb_embed(const u8* __restrict__ row, u32 c,
+  float* __restrict__ y) {
+  u32 i = blockIdx.x * blockDim.x + threadIdx.x;
+  if (i < c) {
+    y[i] = __fmul_rn((float)(signed char)row[i],
+      llb_f16(*(const unsigned short*)(row + c + 2 * (i >> 5))));
+  }
+}
