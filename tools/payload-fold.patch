+// The top two in two launches (tools/payload-fold.patch): llb_amax_part's
+// AMAX_G blocks keep each thread's top two of its stride, merge them per
+// block and park [v, i, w, j] in z's tail past n (gpu_logit holds 2^18);
+// llb_amax merges the AMAX_G pairs. The order is total, so the top two of
+// the union is the top two of the parts: the same picks as twice over z.
+INLINE void amax_put(float v, u32 i, float* b1, u32* j1, float* b2, u32* j2) {
+  if (amax_lt(v, i, *b1, *j1)) {
+    *b2 = *b1; *j2 = *j1; *b1 = v; *j1 = i;
+  } else if (amax_lt(v, i, *b2, *j2)) {
+    *b2 = v; *j2 = i;
+  }
+}
+
+// merge the T pairs in shared memory into slot 0 (T a power of two)
+INLINE void amax_tree(float* s1, u32* x1, float* s2, u32* x2, u32 t, u32 T) {
+  __syncthreads();
+  for (u32 st = T / 2; st > 0; st >>= 1) {
+    if (t < st) {
+      float b1 = s1[t], b2 = s2[t];
+      u32   j1 = x1[t], j2 = x2[t];
+      amax_put(s1[t + st], x1[t + st], &b1, &j1, &b2, &j2);
+      amax_put(s2[t + st], x2[t + st], &b1, &j1, &b2, &j2);
+      s1[t] = b1; x1[t] = j1; s2[t] = b2; x2[t] = j2;
