+// K.qg.go / K.kr.go (tools/payload-qkr.patch): per-head qk-norm (rms over 256
+// with the 256 gain) then the partial NEOX rope (nd 64, base 1e7, the first 64
+// dims of each head). qk 1: 2^d = 16 heads of [q(256), gate(256)], rope q and
+// copy gate; qk 0: 2^d = 4 k heads of 256. One block a head, 256 threads.
+// sumsq is K.sumsq's balanced tree: a[t] = x[t]^2 then the shared strides.
+extern "C" __global__ void __launch_bounds__(256) llb_qkr(
+  const float* __restrict__ x, const float* __restrict__ w,
+  float* __restrict__ y, u32 n, u32 qk, u32 pos) {
+  __shared__ float a[256];
+  __shared__ float sv;
+  const u32 t = threadIdx.x;
+  const u64 off = (u64)blockIdx.x * (qk != 0 ? 512 : 256);
+  const float* xr = x + off;
+  float* yr = y + off;
+  const float xv = xr[t];
+  const float xb = xr[t + 32];
+  const float xg = qk != 0 ? xr[256 + t] : 0.0f;
+  a[t] = __fmul_rn(xv, xv);
+  __syncthreads();
+  #pragma unroll
+  for (u32 st = 1; st < 256; st <<= 1) {
+    if ((t & (2 * st - 1)) == 0) {
+      a[t] = __fadd_rn(a[t], a[t + st]);
+    }
+    __syncthreads();
+  }
+  if (t == 0) {
+    sv = __fdiv_rn(1.0f, __fsqrt_rn(__fadd_rn(__fdiv_rn(a[0], 256.0f),
+      __uint_as_float(0x358637BDu))));
+  }
+  __syncthreads();
+  const float s = sv;
+  const float v = __fmul_rn(__fmul_rn(xv, s), w[t]);
+  if (t < 32) {
+    const float th = __fmul_rn((float)pos, (float)pow((double)10000000.0f,
+      (double)__fdiv_rn(-(float)(2 * t), 64.0f)));
+    const float co = (float)cos((double)th), si = (float)sin((double)th);
+    const float b = __fmul_rn(__fmul_rn(xb, s), w[t + 32]);
+    // neox.pairs returns ANode{a', b'} per pair: the 64 rotated leaves come
+    // out interleaved [a0', b0', a1', b1', ...], not at (i, i + 32)
+    const float r0 = __fsub_rn(__fmul_rn(v, co), __fmul_rn(b, si));
+    const float r1 = __fadd_rn(__fmul_rn(v, si), __fmul_rn(b, co));
+    yr[2 * t]     = r0;
+    yr[2 * t + 1] = r1;
+  } else if (t >= 64) {
+    yr[t] = v;
+  }
+  if (qk != 0) {
+    yr[256 + t] = xg;
+  }
+}
