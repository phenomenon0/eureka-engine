+// K.rms_norm over n = 2^d (d = 11 or 12): s = 1 / sqrt(sumsq / n + eps),
+// h = (x * s) * w. sumsq is the balanced tree of x*x: a balanced local tree
+// over the n / 1024 elements a thread owns, then the shared halving strides --
+// the same order as K.sumsq and llb_rms (tools/payload-rmsnorm.patch).
+extern "C" __global__ void __launch_bounds__(1024) llb_rmsnorm(
+  const float* __restrict__ x, const float* __restrict__ w,
+  float* __restrict__ y, u32 n) {
+  __shared__ float a[1024];
+  __shared__ float sv;
+  const u32 t = threadIdx.x;
+  const u32 q = n >> 10;
+  const float* xp = x + (u64)t * q;
+  float acc;
+  if (q == 4) {
+    const float a0 = __fmul_rn(xp[0], xp[0]), a1 = __fmul_rn(xp[1], xp[1]);
+    const float a2 = __fmul_rn(xp[2], xp[2]), a3 = __fmul_rn(xp[3], xp[3]);
+    acc = __fadd_rn(__fadd_rn(a0, a1), __fadd_rn(a2, a3));
+  } else {
+    acc = __fadd_rn(__fmul_rn(xp[0], xp[0]), __fmul_rn(xp[1], xp[1]));
+  }
+  a[t] = acc;
+  __syncthreads();
+  for (u32 st = 1; st < 1024; st <<= 1) {
+    if ((t & (2 * st - 1)) == 0) {
+      a[t] = __fadd_rn(a[t], a[t + st]);
+    }
+    __syncthreads();
+  }
+  if (t == 0) {
+    sv = __fdiv_rn(1.0f, __fsqrt_rn(__fadd_rn(__fdiv_rn(a[0], (float)n),
+      __uint_as_float(0x358637BDu))));
+  }
+  __syncthreads();
+  const float s = sv;
+  for (u32 i = t; i < n; i += 1024) {
+    y[i] = __fmul_rn(__fmul_rn(x[i], s), w[i]);
+  }
+}
