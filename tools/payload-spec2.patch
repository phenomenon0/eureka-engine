+// MTP28 lever 1 (tools/payload-spec2.patch): T-row twins of the spec cycle's small
+// kernels, row r = blockIdx.y (gridDim.y = T). Each body is its kernel's, the same
+// ops in the same order; only the pointers move by the row (row r of a T launch ==
+// the kernel on row r's buffers), so the per-row loops of llb_host.c are one launch
+extern "C" __global__ void __launch_bounds__(1024) llb_t_rnaddq(
+  const float* __restrict__ x, const float* __restrict__ z,
+  const float* __restrict__ w, float* __restrict__ x1, float* __restrict__ y,
+  u32 n, signed char* __restrict__ qx, float* __restrict__ dx) {
+  __shared__ float a[33];
+  const u64 rw = blockIdx.y;
+  x += rw * n; z += rw * n; x1 += rw * n; y += rw * n; qx += rw * 2 * n; dx += rw * (n / 32);
+  const u32 t = threadIdx.x;
+  float acc;
+  if (n <= 4096) {
+    const u64 o = (u64)t * 4;
+    float v[4];
+    #pragma unroll
+    for (u32 k = 0; k < 4; k++) {
+      v[k] = __fadd_rn(x[o + k], z[o + k]);
+      x1[o + k] = v[k];
+    }
+    acc = __fadd_rn(__fadd_rn(__fmul_rn(v[0], v[0]), __fmul_rn(v[1], v[1])),
+      __fadd_rn(__fmul_rn(v[2], v[2]), __fmul_rn(v[3], v[3])));
+  } else {
+    float b[8];
+    #pragma unroll
+    for (u32 k = 0; k < 8; k++) {
+      const u64 i = (u64)t * 8 + k;
+      const float v = i < n ? __fadd_rn(x[i], z[i]) : 0.0f;
+      if (i < n) {
+        x1[i] = v;
+      }
+      b[k] = i < n ? __fmul_rn(v, v) : 0.0f;
+    }
+    acc = __fadd_rn(__fadd_rn(__fadd_rn(b[0], b[1]), __fadd_rn(b[2], b[3])),
+      __fadd_rn(__fadd_rn(b[4], b[5]), __fadd_rn(b[6], b[7])));
+  }
+  const float sum = rms_tree(acc, a, t, 32);
+  const float s = __fdiv_rn(1.0f, __fsqrt_rn(__fadd_rn(__fdiv_rn(sum, (float)n),
+    __uint_as_float(0x358637BDu))));
+  for (u32 i = t; i < n; i += 1024) {
+    const float r = __fmul_rn(__fmul_rn(__fadd_rn(x[i], z[i]), s), w[i]);
+    y[i] = r;
+    q8x2_st(r, qx, dx, n, i);
+  }
+}
+
+extern "C" __global__ void __launch_bounds__(1024) llb_t_rnormq(
+  const float* __restrict__ x, const float* __restrict__ w,
+  float* __restrict__ y, u32 n, signed char* __restrict__ qx, float* __restrict__ dx) {
+  __shared__ float a[1024];
+  const u64 rw = blockIdx.y;
+  x += rw * n; y += rw * n; qx += rw * 2 * n; dx += rw * (n / 32);
+  const u32 t = threadIdx.x;
+  const u32 q = n >> 10;
+  const float* xp = x + (u64)t * q;
+  float acc;
+  if (q == 4) {
+    const float a0 = __fmul_rn(xp[0], xp[0]), a1 = __fmul_rn(xp[1], xp[1]);
+    const float a2 = __fmul_rn(xp[2], xp[2]), a3 = __fmul_rn(xp[3], xp[3]);
+    acc = __fadd_rn(__fadd_rn(a0, a1), __fadd_rn(a2, a3));
+  } else if (n > 4096) {
+    float b[8];
+    #pragma unroll
+    for (u32 k = 0; k < 8; k++) {
+      const u64 i = (u64)t * 8 + k;
+      b[k] = i < n ? __fmul_rn(x[i], x[i]) : 0.0f;
+    }
+    acc = __fadd_rn(__fadd_rn(__fadd_rn(b[0], b[1]), __fadd_rn(b[2], b[3])),
+      __fadd_rn(__fadd_rn(b[4], b[5]), __fadd_rn(b[6], b[7])));
+  } else {
+    acc = __fadd_rn(__fmul_rn(xp[0], xp[0]), __fmul_rn(xp[1], xp[1]));
+  }
+  const float sum = rms_tree(acc, a, t, 32);
+  const float s = __fdiv_rn(1.0f, __fsqrt_rn(__fadd_rn(__fdiv_rn(sum, (float)n),
+    __uint_as_float(0x358637BDu))));
+  for (u32 i = t; i < n; i += 1024) {
+    const float r = __fmul_rn(__fmul_rn(x[i], s), w[i]);
+    y[i] = r;
+    q8x2_st(r, qx, dx, n, i);
+  }
+}
