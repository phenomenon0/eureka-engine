+extern "C" __global__ void __launch_bounds__(256) llb_t_siluq(
+  const float* __restrict__ g, const float* __restrict__ u,
+  float* __restrict__ a, u32 n, signed char* __restrict__ qx, float* __restrict__ dx) {
+  const u64 rw = blockIdx.y;
+  g += rw * n; u += rw * n; a += rw * n; qx += rw * 2 * n; dx += rw * (n / 32);
+  const u32 i = blockIdx.x * 256 + threadIdx.x;
+  const float v = g[i];
+  const float r = __fmul_rn(__fdiv_rn(v, __fadd_rn(1.0f, attn_exp(-v))), u[i]);
+  a[i] = r;
+  q8x2_st(r, qx, dx, n, i);
+}
+
+extern "C" __global__ void __launch_bounds__(256) llb_t_q8x2(const float* __restrict__ x,
+  signed char* __restrict__ qx, float* __restrict__ dx, u32 n) {
+  const u64 rw = blockIdx.y;
+  x += rw * n; qx += rw * 2 * n; dx += rw * (n / 32);
+  const u32 i = blockIdx.x * 256 + threadIdx.x;
+  if (i >= n) return;
+  const float v = x[i];
+  float a = fabsf(v);
+  int nf = (__float_as_uint(v) & 0x7f800000u) == 0x7f800000u;
+  #pragma unroll
+  for (u32 m = 16; m > 0; m >>= 1) a = fmaxf(a, __shfl_xor_sync(0xffffffffu, a, m));
+  nf = __any_sync(0xffffffffu, nf);
+  const float d = __fdiv_rn(a, 127.0f), e = __fdiv_rn(d, 127.0f);
+  int q = 0, q2 = 0;
+  if (!nf && d != 0.0f) q = max(-127, min(127, (int)roundf(__fdiv_rn(v, d))));
+  if (!nf && e != 0.0f) q2 = max(-127, min(127, (int)roundf(__fdiv_rn(__fmaf_rn(-d, (float)q, v), e))));
+  qx[i] = (signed char)q;
+  qx[n + i] = (signed char)q2;
+  if ((threadIdx.x & 31) == 0) dx[i >> 5] = nf ? __uint_as_float(0x7fffffffu) : e;
+}
+
+// llb_outputgate then llb_q8x2 (n % 256 == 0): the gated value goes straight to
+// q8x2_st (its planes are llb_q8x2's); x [T][n], g row r at g + 2 n r, qx / dx row r's
+extern "C" __global__ void __launch_bounds__(256) llb_t_ogq(const float* __restrict__ x,
+  const float* __restrict__ g, u32 n, signed char* __restrict__ qx, float* __restrict__ dx) {
+  const u64 rw = blockIdx.y;
+  x += rw * n; g += rw * 2 * n; qx += rw * 2 * n; dx += rw * (n / 32);
+  const u32 i = blockIdx.x * 256 + threadIdx.x;
+  const float r = __fmul_rn(x[i], __fdiv_rn(1.0f, __fadd_rn(1.0f, attn_exp(-g[i]))));
+  q8x2_st(r, qx, dx, n, i);
+}
