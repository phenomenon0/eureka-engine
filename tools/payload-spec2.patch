+// llb_attn4: q rows of 2 nh 256 (sp_qg), att rows of nh 256, row r at pos + r; sc / pr
+// planes of 2^dT floats per (row, head) (the trees touch t < T2 <= 2^dT only)
+extern "C" __global__ void __launch_bounds__(1024) llb_t_attn4(
+  const float* __restrict__ q, const float* __restrict__ kc,
+  const float* __restrict__ vc, float* __restrict__ att,
+  float* __restrict__ sc, float* __restrict__ pr, u32 c, u32 grp) {
+  const u32 h = blockIdx.x, dT = c & 31, pos = (c >> 5) + blockIdx.y, T = 1u << dT;
+  q += (u64)blockIdx.y * gridDim.x * 512; att += (u64)blockIdx.y * gridDim.x * 256;
+  const u32 g = (h / grp) * 256;
+  const float scale = __fdiv_rn(1.0f, __fsqrt_rn(256.0f));
+  const float ninf = __uint_as_float(0xFF800000u);
+  float* sh = sc + ((u64)(blockIdx.y * gridDim.x + h) << dT);
+  float* ph = pr + ((u64)(blockIdx.y * gridDim.x + h) << dT);
+  const float* qh = q + (u64)h * 256;
+  __shared__ float qs[256];
+  if (threadIdx.x < 256) {
+    qs[threadIdx.x] = qh[threadIdx.x];
+  }
+  __syncthreads();
+  const u32 n = pos < T ? pos + 1 : T;
+  u32 T2 = 1;
+  while (T2 < n) {
+    T2 <<= 1;
+  }
+  const u32 sub = threadIdx.x & 7;
+  for (u32 tb = 0; tb < T2; tb += blockDim.x >> 3) {
+    const u32 t = tb + (threadIdx.x >> 3);
+    float v = 0.0f;
+    if (t < n) {
+      const float* k = kc + (u64)t * 1024 + g + sub * 32;
+      const float* qq = qs + sub * 32;
+      float st[6];
+      u32   sp = 0;
+      for (u32 i0 = 0; i0 < 32; i0 += 16) {
+        float kk[16];
+#pragma unroll
+        for (u32 u = 0; u < 16; u++) {
+          kk[u] = k[i0 + u];
+        }
+#pragma unroll
+        for (u32 u = 0; u < 16; u++) {
+          attn_push(st, &sp, i0 + u, __fmul_rn(kk[u], qq[i0 + u]));
+        }
+      }
+      v = st[0];
+    }
+#pragma unroll
+    for (u32 m = 1; m < 8; m <<= 1) {
+      v = __fadd_rn(v, __shfl_xor_sync(0xffffffffu, v, m));
+    }
+    if (sub == 0 && t < T2) {
+      ph[t] = sh[t] = t < n ? __fmul_rn(v, scale) : ninf;
+    }
+  }
+  __syncthreads();
+  for (u32 s = 1; s < T2; s <<= 1) {
+    for (u32 t = threadIdx.x * 2 * s; t < T2; t += blockDim.x * 2 * s) {
+      const float a = ph[t], v = ph[t + s];
+      ph[t] = a < v ? v : a;
+    }
+    __syncthreads();
+  }
+  const float m = ph[0];
+  __syncthreads();
+  for (u32 t = threadIdx.x; t < T2; t += blockDim.x) {
+    ph[t] = sh[t] = attn_exp(__fsub_rn(sh[t], m));
+  }
+  __syncthreads();
+  for (u32 s = 1; s < T2; s <<= 1) {
+    for (u32 t = threadIdx.x * 2 * s; t < T2; t += blockDim.x * 2 * s) {
+      sh[t] = __fadd_rn(sh[t], sh[t + s]);
+    }
+    __syncthreads();
+  }
+  const float z = T2 < T ? __fadd_rn(sh[0], 0.0f) : sh[0];
+  for (u32 t = threadIdx.x; t < T2; t += blockDim.x) {
+    ph[t] = __fdiv_rn(ph[t], z);
+  }
+  __syncthreads();
+  __shared__ float vq[4][256];
+  const u32 j = threadIdx.x & 255, pq = threadIdx.x >> 8;
+  const u32 PQ = T2 >= 4 ? 4 : 1, L = T2 / PQ, t0 = pq * L;
+  if (pq < PQ) {
+    float st[18];
+    u32   sp = 0;
+    u32   t = 0;
+    for (; t + 16 <= L; t += 16) {
+      float vv[16], pp[16];
+#pragma unroll
+      for (u32 u = 0; u < 16; u++) {
+        vv[u] = vc[(u64)(t0 + t + u) * 1024 + g + j];
+        pp[u] = ph[t0 + t + u];
+      }
+#pragma unroll
+      for (u32 u = 0; u < 16; u++) {
+        attn_push(st, &sp, t + u, __fmul_rn(vv[u], pp[u]));
+      }
+    }
+    for (; t < L; t++) {
+      attn_push(st, &sp, t, __fmul_rn(vc[(u64)(t0 + t) * 1024 + g + j], ph[t0 + t]));
+    }
+    vq[pq][j] = st[0];
+  }
+  __syncthreads();
+  if (threadIdx.x < 256) {
+    const float o = PQ == 4 ? __fadd_rn(__fadd_rn(vq[0][j], vq[1][j]),
+      __fadd_rn(vq[2][j], vq[3][j])) : vq[0][j];
+    att[(u64)h * 256 + j] = T2 < T ? __fadd_rn(o, 0.0f) : o;
+  }
+}
