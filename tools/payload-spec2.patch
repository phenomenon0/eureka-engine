+// llb_amax_part / llb_amax on row r's logits z + r 2^18 (each row's tail its own), y rows of 4
+extern "C" __global__ void __launch_bounds__(AMAX_T) llb_t_amaxp(
+  float* __restrict__ z, u32 n) {
+  __shared__ float s1[AMAX_T], s2[AMAX_T];
+  __shared__ u32   x1[AMAX_T], x2[AMAX_T];
+  z += (u64)blockIdx.y << 18;
+  const u32 t = threadIdx.x;
+  float b1 = __uint_as_float(0xFF800000u), b2 = b1;
+  u32   j1 = 0xFFFFFFFFu, j2 = 0xFFFFFFFFu;
+  for (u32 i = blockIdx.x * AMAX_T + t; i < n; i += AMAX_G * AMAX_T) {
+    amax_put(z[i], i, &b1, &j1, &b2, &j2);
+  }
+  s1[t] = b1; x1[t] = j1; s2[t] = b2; x2[t] = j2;
+  amax_tree(s1, x1, s2, x2, t, AMAX_T);
+  if (t == 0) {
+    float* p = z + (1u << 18) - 4 * AMAX_G + 4 * blockIdx.x;
+    p[0] = s1[0]; p[1] = __uint_as_float(x1[0]);
+    p[2] = s2[0]; p[3] = __uint_as_float(x2[0]);
+  }
+}
+
+extern "C" __global__ void __launch_bounds__(AMAX_G) llb_t_amax(
+  const float* __restrict__ z, u32 n, float* __restrict__ y) {
+  __shared__ float s1[AMAX_G], s2[AMAX_G];
+  __shared__ u32   x1[AMAX_G], x2[AMAX_G];
+  z += (u64)blockIdx.y << 18; y += (u64)blockIdx.y * 4;
+  const u32 t = threadIdx.x;
+  const float* p = z + (1u << 18) - 4 * AMAX_G + 4 * t;
+  s1[t] = p[0]; x1[t] = __float_as_uint(p[1]);
+  s2[t] = p[2]; x2[t] = __float_as_uint(p[3]);
+  amax_tree(s1, x1, s2, x2, t, AMAX_G);
+  if (t == 0) {
+    y[0] = s1[0]; y[1] = (float)x1[0]; y[2] = s2[0]; y[3] = (float)x2[0];
+  }
+}
