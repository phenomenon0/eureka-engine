+// llb_spec_gdl over the T rows in order, the state in registers: row r reads ring slot
+// (sc + r) % R (row r - 1's store, the same bits) and stores slot (sc + r + 1) % R.
+// S the ring (slots of ssz floats); q / kk rows of 2 heads 128, v rows of vs,
+// dec / bet rows of heads, y rows of heads 128
+extern "C" __global__ void __launch_bounds__(128) llb_t_gdl(
+  float* __restrict__ S, u64 ssz, u32 sc, u32 R, u32 T, const float* __restrict__ q,
+  const float* __restrict__ kk, const float* __restrict__ v, u32 vs, const float* __restrict__ dec,
+  const float* __restrict__ bet, float* __restrict__ y, u32 heads) {
+  const u32 h = blockIdx.x, l = threadIdx.x & 31;
+  const u32 j = blockIdx.y * 4 + (threadIdx.x >> 5);
+  if (h >= heads) {
+    return;
+  }
+  const u64 so = ((u64)h * 128 + j) << 7, hs = (u64)heads << 7;
+  float4 s4 = ((const float4*)(S + sc * ssz + so))[l];
+  for (u32 r = 0; r < T; r++) {
+    const float4 k4 = ((const float4*)(kk + r * 2 * hs + ((u64)h << 7)))[l];
+    const float4 q4 = ((const float4*)(q + r * 2 * hs + ((u64)h << 7)))[l];
+    const float  decay = dec[(u64)r * heads + h], beta = bet[(u64)r * heads + h];
+    s4.x = __fmul_rn(s4.x, decay);
+    s4.y = __fmul_rn(s4.y, decay);
+    s4.z = __fmul_rn(s4.z, decay);
+    s4.w = __fmul_rn(s4.w, decay);
+    const float kv = gd_dot(s4, k4);
+    const float delta = __fmul_rn(__fsub_rn(v[(u64)r * vs + ((u64)h << 7) + j], kv), beta);
+    s4.x = __fadd_rn(s4.x, __fmul_rn(k4.x, delta));
+    s4.y = __fadd_rn(s4.y, __fmul_rn(k4.y, delta));
+    s4.z = __fadd_rn(s4.z, __fmul_rn(k4.z, delta));
+    s4.w = __fadd_rn(s4.w, __fmul_rn(k4.w, delta));
+    ((float4*)(S + (sc + r + 1) % R * ssz + so))[l] = s4;
+    const float yv = gd_dot(s4, q4);
+    if (l == 0) {
+      y[r * hs + ((u64)h << 7) + j] = yv;
+    }
+  }
+}
