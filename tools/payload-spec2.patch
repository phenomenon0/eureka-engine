+// llb_midconv: bpre / apre / beta / dec rows of nm, y rows of nch; row r's conv
+// reads the 16-slot ring at p0 + r and the three before it
+extern "C" __global__ void __launch_bounds__(256) llb_t_midconv(
+  const float* __restrict__ bpre, const float* __restrict__ apre,
+  const float* __restrict__ dtp, const float* __restrict__ sap,
+  float* __restrict__ beta, float* __restrict__ dec, u32 nm,
+  const float* __restrict__ w, const float* __restrict__ ring, u32 p0,
+  float* __restrict__ y, u32 nch) {
+  const u32 pr = p0 + blockIdx.y;
+  if (blockIdx.x == 0) {
+    const u64 o = (u64)blockIdx.y * nm;
+    const u32 i = threadIdx.x;
+    if (i < nm) {
+      const float b = bpre[o + i];
+      beta[o + i] = __fdiv_rn(1.0f, __fadd_rn(1.0f, attn_exp(-b)));
+      const float gp = __fmul_rn(mid_sp(__fadd_rn(apre[o + i], dtp[i])), sap[i]);
+      dec[o + i] = attn_exp(gp);
+    }
+    return;
+  }
+  const u32 c = (blockIdx.x - 1) * 256 + threadIdx.x;
+  if (c >= nch) {
+    return;
+  }
+  const float* x = ring + (u64)(pr & 15) * nch;
+  const float* h0 = ring + (u64)((pr - 3) & 15) * nch;
+  const float* h1 = ring + (u64)((pr - 2) & 15) * nch;
+  const float* h2 = ring + (u64)((pr - 1) & 15) * nch;
+  y += (u64)blockIdx.y * nch;
+  const float a = __fadd_rn(__fmul_rn(h0[c], w[4 * c]), __fmul_rn(h1[c], w[4 * c + 1]));
+  const float b = __fadd_rn(__fmul_rn(h2[c], w[4 * c + 2]), __fmul_rn(x[c], w[4 * c + 3]));
+  const float u = __fadd_rn(a, b);
+  y[c] = __fdiv_rn(u, __fadd_rn(1.0f, attn_exp(-u)));
+}
+
+// llb_l2norm_qk: vq / vk rows of xs, yq / yk rows of ys
+extern "C" __global__ void __launch_bounds__(64) llb_t_l2qk(
+  const float* __restrict__ vq, const float* __restrict__ vk,
+  float* __restrict__ yq, float* __restrict__ yk, float sq, u32 heads, u32 rep, u32 xs, u32 ys) {
+  __shared__ float a[33];
+  const u64 rw = blockIdx.y;
+  vq += rw * xs; vk += rw * xs; yq += rw * ys; yk += rw * ys;
+  const u32 kq = blockIdx.x >= heads, h = blockIdx.x - (kq ? heads : 0);
+  const u32 t = threadIdx.x;
+  const float sc = kq ? 1.0f : sq;
+  const float2 x = ((const float2*)((kq ? vk : vq) + ((u64)h << 7)))[t];
+  const float sum = rms_tree(__fadd_rn(__fmul_rn(x.x, x.x), __fmul_rn(x.y, x.y)),
+    a, t, 2);
+  const float rt = __fsqrt_rn(sum);
+  const float ep = __uint_as_float(0x358637BDu);
+  const float s = __fdiv_rn(__fdiv_rn(1.0f, (rt < ep ? ep : rt)), sc);
+  const float2 r = make_float2(__fmul_rn(x.x, s), __fmul_rn(x.y, s));
+  float* y = (kq ? yk : yq) + ((u64)h << 7);
+  for (u32 c = 0; c < rep; c++) {
+    ((float2*)(y + (u64)c * heads * 128))[t] = r;
+  }
+}
