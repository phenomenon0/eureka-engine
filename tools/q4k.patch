+// group g of a Q4_K row (tools/q4k.py: GGUF block layout, 144 bytes a
+// super-block): w = d * sc * nib - dmin * m, ggml's dequantize_row_q4_K. The
+// products d*sc and dmin*m are exact (f16 significand * 6-bit int); d1*nib is
+// exact (4-bit int); only d1*nib - m1 rounds, the same f32 subtract as ggml.
+// tools/q4k.patch
+INLINE float4 q4k_w(const u8* __restrict__ row, u32 g) {
+  u32  c4 = 4 * g, blk = c4 >> 8, rr = c4 & 255;
+  u32  b = rr >> 6, r = rr & 63, l = r & 31, hi = r >> 5;
+  const u8* B = row + (u64)blk * 144;
+  float d  = llb_f16(*(const unsigned short*)(B + 0));
+  float dm = llb_f16(*(const unsigned short*)(B + 2));
+  const u8* sc = B + 4;
+  u32  sb = 2 * b + hi, dsc, msc;
+  if (sb < 4) {
+    dsc = sc[sb] & 63; msc = sc[sb + 4] & 63;
+  } else {
+    dsc = (sc[sb + 4] & 15) | ((u32)(sc[sb - 4] >> 6) << 4);
+    msc = (sc[sb + 4] >> 4) | ((u32)(sc[sb] >> 6) << 4);
+  }
+  float d1 = __fmul_rn(d, (float)dsc), m1 = __fmul_rn(dm, (float)msc);
+  u32  v = *(const u32*)(B + 16 + b * 32 + l) >> (hi * 4);
+  return make_float4(__fsub_rn(__fmul_rn(d1, (float)(v & 15)), m1),
+    __fsub_rn(__fmul_rn(d1, (float)((v >> 8) & 15)), m1),
+    __fsub_rn(__fmul_rn(d1, (float)((v >> 16) & 15)), m1),
+    __fsub_rn(__fmul_rn(d1, (float)((v >> 24) & 15)), m1));
+}
