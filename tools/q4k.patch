+  const u8* __restrict__ W, u32 rb, u32 cg, const u32* __restrict__ x,
+  u32* __restrict__ y, u32 n, u32 d) {
+  warp_dq4k(W, rb, cg, x, y, n, d);
+}
 #endif
 
