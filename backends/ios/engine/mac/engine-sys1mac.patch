+# SYS1-MAC (LLB_SYS1 set, docs/sys1mac-registration.md): SYS1-DUAL's srv loop
+# on the Mac engine. One load, then requests from S.sys1.next until EOF; each
+# from pos 0 on fresh states through the exact prompt path (the host's
+# m26_reset zeroes its layer state at pos 0), one dT for the run (argv
+# "0 --steps C" sizes it)
+@unsafe
+def srv.one(ok: Bool, ts: List<&2, U32>, +st: U32, +m: Model, +b: Nat, +em: U32, +dT: Nat, k: Unit -> IO(Unit)) -> IO(Unit):
+  match ok:
+    case True{}:
+      do IO<Unit>:
+        prompt(ts, U32.to_nat((st - 1 : U32)), m, b, em, dT, (1 << dT : U32), 0, 0, states(m.nl(m), dT), st)
+        S.sys1.done()
+        k(Unit{})
+    case False{}:
+      IO.die(Unit, 2, "sys1: bad request command")
+
+@unsafe
+def srv.chk(+ts: List<&2, U32>, +st: U32, +m: Model, +b: Nat, +em: U32, +dT: Nat, k: Unit -> IO(Unit)) -> IO(Unit):
+  srv.one(Bool.and(ok_ids(ts), (st >= 1 : U32)), ts, st, m, b, em, dT, k)
+
+@unsafe
+def srv.run(c: List<&2, U32> & U32 & U32 & U32 & U32 & U32, +m: Model, +b: Nat, +em: U32, +dT: Nat, k: Unit -> IO(Unit)) -> IO(Unit):
+  (ts, sl) = c
+  (st, rest) = sl
+  srv.chk(ts, st, m, b, em, dT, k)
+
+@unsafe
+def srv.go(q: List<String>, +m: Model, +b: Nat, +em: U32, +dT: Nat, k: Unit -> IO(Unit)) -> IO(Unit):
+  match q:
+    case Nil{}:
+      IO.pure(Unit, Unit{})
+    case Con{w, ws}:
+      srv.run(cfg(w <> ws, Nil{}, 0, 0, 4294967295, 64, 0, 0, True{}), m, b, em, dT, k)
 
 @unsafe
+def srv(+dir: String, +m: Model, +b: Nat, +em: U32, +dT: Nat) -> IO(Unit):
+  do IO<Unit>:
+    q : List<String> <- S.sys1.next(dir, (1 << dT : U32))
+    srv.go(q, m, b, em, dT, u => srv(dir, m, b, em, dT))
+
+@unsafe
+def srv.or(on: Bool, +dir: String, ts: List<&2, U32>, +m: Model, +b: Nat, +em: U32, +dT: Nat, +st: U32, +fd: U32) -> IO(Unit):
+  match on:
+    case True{}:
+      srv(dir, m, b, em, dT)
