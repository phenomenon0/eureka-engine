+  // (IMGFAST) the session's prefix snapshots (llb_px_*, below): a first chunk whose leading ids (and image) match a
+  // kept prefix restores that prefix's layer state and runs only the rest; a first chunk that passes a wanted prefix
+  // end (the wrapper's llb_px_want) is split there and the state at that point is kept
+  if (pos0 == 0 && llb_px_enabled() && llb_hidden_path == NULL) {
+    u32 p = llb_px_restore(ids, nt, dT, S0);
