+      u32 w = llb_px_want[k];
+      if (w > p && w < nt && !llb_px_have(ids, w, dT)) {
+        f27_body(en, ids + p, w - p, ep, ek4, ek6, dT, p, S0, pw, po, tw);
+        en = llb_px_sync();
