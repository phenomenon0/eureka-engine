 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
+#include <sys/mman.h>
 #include <sys/stat.h>
 #include <unistd.h>
 
@@ -512,6 +513,25 @@
 static int gg_state;  // 0 unopened, 1 open, -1 failed
 static char gg_err0[256];
 static pthread_mutex_t gg_mu = PTHREAD_MUTEX_INITIALIZER;
+static char* gg_man;  // LLB_GGUF_VERIFY's manifest, read once a run
+
+// (ENGINE-REPEAT) after a run: the GGUF closed, its tables freed, gg_state
+// back to unopened, so the next run opens LLB_GGUF again (another model, too)
+static int gguf_close(void) {
+  pthread_mutex_lock(&gg_mu);
+  if (gg_file.fd > 0) close(gg_file.fd);
+  for (size_t i = 0; gg_file.t && i < gg_file.nt; i++) free(gg_file.t[i].name);
+  free(gg_file.t);
+  free(gg_file.lo);
+  free(gg_file.hi);
+  memset(&gg_file, 0, sizeof gg_file);
+  gg_state = 0;
+  gg_err0[0] = 0;
+  free(gg_man);
+  gg_man = NULL;
+  pthread_mutex_unlock(&gg_mu);
+  return 0;
+}
 
