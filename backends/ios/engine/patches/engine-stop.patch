+# (ENGINE-EARLYSTOP, patches/engine-stop.patch) --stop ID (any number of them): the ids that end the reply
+def stop.has(sp: List<&2, U32>, +t: U32) -> Bool:
+  match sp:
+    case Con{h, rest}:
+      Bool.or(U32.is_eq(h, t), stop.has(rest, t))
+    case Nil{}:
+      False{}
+
+# (ENGINE-EARLYSTOP) n is a maximum: a stop id is printed and ends the run (no step after it). go: tok is not
+# a stop id (the caller's stop.go)
+def stop.go(sp: List<&2, U32>, +t: U32) -> Bool:
+  Bool.not(stop.has(sp, t))
+
