+// (PHONECAM) a new sequence (pos 0) in a session: the image map and rows back to "no image", then the rows llbv
+// holds for this job (llbv_prepare*), if any, into the session area. The wrapper checks n <= cap before the job
+static void llb_img_seq(u32 d) {
+  if (llb_img_cap == 0 || llb_img_at == 0) {
+    return;
+  }
+  memset(llb_mr, 0, sizeof llb_mr);
+  llb_img_n = 0; llb_img_nx = 0; llb_img_ny = 0; llb_img_seen = 0; llb_img_s0 = 0;
+  if (!llbv_requested()) {
+    return;
+  }
+  float* r = NULL;
+  u32 n = 0, nx = 0, ny = 0;
+  char err[256] = {0};
+  if (d != llb_img_d || llbv_rows(d, &r, &n, &nx, &ny, err) != 0) {
+    fprintf(stderr, "vision: %s\n", d != llb_img_d ? "the session area's width differs" : err);
+    err_fail("vision: no image rows");
+  }
+  if (n > llb_img_cap) {
+    free(r);
+    err_fail("vision: more image rows than the session area holds");
+  }
+  memcpy((u8*)[gpu_scr contents] + (llb_img_at - SA_SCR), r, (size_t)n * d * 4);
+  free(r);
+  llb_img_n = n; llb_img_nx = nx; llb_img_ny = ny;
+  fprintf(stderr, "vision: session rows %u (%u x %u), d %u\n", n, nx, ny, d);
 }
 
+// (PHONECAM) the readout: the head's logits[ids[0]], logits[ids[1]] at prompt pos llb_ro_pos (the last prompt id:
+// the logits the first new id is the argmax of), read from the head's logits row (M9_LOGIT) once the round's command
+// buffer has completed (the point ENGINE-PREFILL's gate-logits instrument read the same row); printed as
+// "ro <pos> <bits0> <bits1>" and kept in llb_ro_v for the in-process wrapper. Armed by the wrapper
+// (llb_ro_on = true) or, in the CLI, LLB_READOUT=<id0>,<id1>,<pos>. Off: nothing is read
+static bool llb_ro_on, llb_ro_init, llb_ro_pend;
+static u32  llb_ro_ids[2], llb_ro_pos, llb_ro_got;
+static f32  llb_ro_v[2];
+static void llb_ro_mark(u32 pos) {
+  if (!llb_ro_init) {
+    llb_ro_init = true;
+    const char* r = getenv("LLB_READOUT");
+    unsigned a = 0, b = 0, p = 0;
+    if (r != NULL && sscanf(r, "%u,%u,%u", &a, &b, &p) == 3 && a < 248320 && b < 248320) {
+      llb_ro_ids[0] = a; llb_ro_ids[1] = b; llb_ro_pos = p; llb_ro_on = true;
+    }
+  }
+  if (llb_ro_on && pos == llb_ro_pos) {
+    llb_ro_pend = true;
+  }
+}
+static void llb_ro_flush(void) {
+  if (!llb_ro_pend) {
+    return;
+  }
+  llb_ro_pend = false;
+  const f32* row = (const f32*)((const u8*)[gpu_scr contents] + (M9_LOGIT & ~SA_SCR));
+  llb_ro_v[0] = row[llb_ro_ids[0]];
+  llb_ro_v[1] = row[llb_ro_ids[1]];
+  llb_ro_got += 1;
+  u32 b0, b1;
+  memcpy(&b0, &llb_ro_v[0], 4); memcpy(&b1, &llb_ro_v[1], 4);
+  fprintf(stderr, "ro %u %08x %08x\n", llb_ro_pos, b0, b1);
+}
