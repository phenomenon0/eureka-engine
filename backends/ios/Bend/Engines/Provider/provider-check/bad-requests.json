{
  "note": "IOS-FOLD F1 gate: five bad requests; every response must be the canonical envelope with the listed status.",
  "cases": [
    {
      "name": "unknown route",
      "method": "POST",
      "path": "/v1/nope",
      "api_key": "valid",
      "body": "{}",
      "expect": {
        "status": 404,
        "code": 404,
        "type": "not_found_error"
      }
    },
    {
      "name": "wrong method",
      "method": "GET",
      "path": "/v1/decide",
      "api_key": "valid",
      "body": "",
      "expect": {
        "status": 405,
        "code": 405,
        "type": "invalid_request_error"
      }
    },
    {
      "name": "bad key",
      "method": "POST",
      "path": "/v1/speak",
      "api_key": "wrong",
      "body": "{\"text\":\"hi\"}",
      "expect": {
        "status": 401,
        "code": 401,
        "type": "authentication_error",
        "message": "Invalid API Key"
      }
    },
    {
      "name": "body too large",
      "method": "POST",
      "path": "/v1/chat/completions",
      "api_key": "valid",
      "body": "(8 MiB + 1)",
      "expect": {
        "status": 413,
        "code": 413,
        "type": "invalid_request_error"
      }
    },
    {
      "name": "bad decide type",
      "method": "POST",
      "path": "/v1/decide",
      "api_key": "valid",
      "body": {
        "state": "x",
        "questions": {
          "severity": {
            "type": "int",
            "instructions": "1-5"
          }
        }
      },
      "expect": {
        "status": 400,
        "code": 400,
        "type": "invalid_request_error",
        "param": "questions.severity.type"
      }
    }
  ]
}
