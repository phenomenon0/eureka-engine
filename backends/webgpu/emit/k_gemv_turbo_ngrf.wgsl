    let r = idx >> 2u; let m = idx & 3u;
    var s = 0.0;
    for (var k = 0u; k < 8u; k += 1u) { s += cube_q5k4096__u[r * 32u + m * 8u + k]; }
    cube_q5k4096__v[idx] = s;
  }
  workgroupBarrier();
  if (l < 4u) { cube_q5k4096__out[tk * cube_q5k4096__sc[5u] + (row0 + l)] = cube_q5k4096__v[l * 4u] + cube_q5k4096__v[l * 4u + 1u] + cube_q5k4096__v[l * 4u + 2u] + cube_q5k4096__v[l * 4u + 3u]; }
}

// Cube gu (turbo): gate + up + swiglu, 4 rows/WG, 160 threads
@group(0) @binding(0) var<storage, read> cube_gu0_wb: array<vec4<u32>>;
@group(0) @binding(1) var<storage, read> cube_gu1_wb: array<vec4<u32>>;
@group(0) @binding(2) var<storage, read> cube_gu_xb: array<vec4<f32>>;
@group(0) @binding(3) var<storage, read_write> cube_gu__out: array<f32>;
@group(0) @binding(4) var<storage, read> cube_gu__sc: array<u32>;
var<workgroup> cube_gu__t: array<f32, 1280>;
var<workgroup> cube_gu__u: array<f32, 256>;
var<workgroup> cube_gu__v: array<f32, 32>;

fn leaf_gu0(rv: u32, i: u32, x0: vec4<f32>, x1: vec4<f32>, x2: vec4<f32>, x3: vec4<f32>, sx: f32) -> f32 {
  let cc = i * 16u;
  let bv = rv + (cc >> 8u) * 9u;
  let rr = cc & 255u;
  let b = rr >> 6u;
  let hi = (rr >> 5u) & 1u;
  let l = rr & 16u;
  let hdr = cube_gu0_wb[bv];
  let qsv = cube_gu0_wb[bv + 1u + b * 2u + (l >> 4u)];
  let dd = unpack2x16float(hdr.x);
  let sb = b * 2u + hi;
  var scv: u32; var mnv: u32;
  if (sb < 4u) {
    scv = (sc12(hdr, sb)) & 63u; mnv = (sc12(hdr, sb + 4u)) & 63u;
  } else {
    scv = (sc12(hdr, sb + 4u) & 15u) | ((sc12(hdr, sb - 4u) >> 6u) << 4u);
    mnv = (sc12(hdr, sb + 4u) >> 4u) | ((sc12(hdr, sb) >> 6u) << 4u);
  }
  let sh = hi * 4u;
  let n = (qsv >> vec4<u32>(sh)) & vec4<u32>(0x0F0F0F0Fu);
  let a = vec4<f32>(f32(n.x & 255u), f32((n.x >> 8u) & 255u), f32((n.x >> 16u) & 255u), f32(n.x >> 24u));
  let bq = vec4<f32>(f32(n.y & 255u), f32((n.y >> 8u) & 255u), f32((n.y >> 16u) & 255u), f32(n.y >> 24u));
  let cq = vec4<f32>(f32(n.z & 255u), f32((n.z >> 8u) & 255u), f32((n.z >> 16u) & 255u), f32(n.z >> 24u));
  let dq = vec4<f32>(f32(n.w & 255u), f32((n.w >> 8u) & 255u), f32((n.w >> 16u) & 255u), f32(n.w >> 24u));
  let dot = dot(a, x0) + dot(bq, x1) + dot(cq, x2) + dot(dq, x3);
  return fma(dd.x * f32(scv), dot, -(dd.y * f32(mnv)) * sx);
}

fn leaf_gu1(rv: u32, i: u32, x0: vec4<f32>, x1: vec4<f32>, x2: vec4<f32>, x3: vec4<f32>, sx: f32) -> f32 {
  let cc = i * 16u;
  let bv = rv + (cc >> 8u) * 9u;
  let rr = cc & 255u;
  let b = rr >> 6u;
  let hi = (rr >> 5u) & 1u;
  let l = rr & 16u;
  let hdr = cube_gu1_wb[bv];
  let qsv = cube_gu1_wb[bv + 1u + b * 2u + (l >> 4u)];
  let dd = unpack2x16float(hdr.x);
  let sb = b * 2u + hi;
  var scv: u32; var mnv: u32;
  if (sb < 4u) {
    scv = (sc12(hdr, sb)) & 63u; mnv = (sc12(hdr, sb + 4u)) & 63u;
  } else {
    scv = (sc12(hdr, sb + 4u) & 15u) | ((sc12(hdr, sb - 4u) >> 6u) << 4u);
    mnv = (sc12(hdr, sb + 4u) >> 4u) | ((sc12(hdr, sb) >> 6u) << 4u);
  }
  let sh = hi * 4u;
  let n = (qsv >> vec4<u32>(sh)) & vec4<u32>(0x0F0F0F0Fu);
  let a = vec4<f32>(f32(n.x & 255u), f32((n.x >> 8u) & 255u), f32((n.x >> 16u) & 255u), f32(n.x >> 24u));
  let bq = vec4<f32>(f32(n.y & 255u), f32((n.y >> 8u) & 255u), f32((n.y >> 16u) & 255u), f32(n.y >> 24u));
  let cq = vec4<f32>(f32(n.z & 255u), f32((n.z >> 8u) & 255u), f32((n.z >> 16u) & 255u), f32(n.z >> 24u));
  let dq = vec4<f32>(f32(n.w & 255u), f32((n.w >> 8u) & 255u), f32((n.w >> 16u) & 255u), f32(n.w >> 24u));
  let dot = dot(a, x0) + dot(bq, x1) + dot(cq, x2) + dot(dq, x3);
  return fma(dd.x * f32(scv), dot, -(dd.y * f32(mnv)) * sx);
}

@compute @workgroup_size(160)
fn cube_gu_main(@builtin(local_invocation_index) l: u32,
  @builtin(workgroup_id) g: vec3<u32>, @builtin(num_workgroups) ng: vec3<u32>) {
  let tk = g.y; let row0 = g.x * 4u;   // webprefill2: token slot, row group
  if (row0 >= cube_gu__sc[0u]) {
    return;
  }
  let bg = cube_gu__sc[1u]; let bu = cube_gu__sc[2u];
  var acc: array<f32, 8>;
  for (var a = 0u; a < 8u; a += 1u) { acc[a] = 0.0; }
  let i = l;
  let x0 = cube_gu_xb[tk * cube_gu__sc[3u] + (i * 4u)]; let x1 = cube_gu_xb[tk * cube_gu__sc[3u] + (i * 4u + 1u)]; let x2 = cube_gu_xb[tk * cube_gu__sc[3u] + (i * 4u + 2u)]; let x3 = cube_gu_xb[tk * cube_gu__sc[3u] + (i * 4u + 3u)];
  let sx = dot(x0 + x1 + x2 + x3, vec4<f32>(1.0));
  for (var r = 0u; r < 4u; r += 1u) {
    acc[r] += leaf_gu0((bg + (row0 + r) * 1440u) >> 4u, i, x0, x1, x2, x3, sx);
    acc[4u + r] += leaf_gu1((bu + (row0 + r) * 1440u) >> 4u, i, x0, x1, x2, x3, sx);
  }
  for (var a = 0u; a < 8u; a += 1u) { cube_gu__t[a * 160u + l] = acc[a]; }
  workgroupBarrier();
  for (var idx = l; idx < 256u; idx += 160u) {
    let r = idx >> 5u; let k = idx & 31u;
    var s = 0.0;
    for (var j = k; j < 160u; j += 32u) { s += cube_gu__t[r * 160u + j]; }
    cube_gu__u[idx] = s;
  }
  workgroupBarrier();
  if (l < 32u) {
    let r = l >> 2u; let m = l & 3u;
    var s = 0.0;
    for (var k = 0u; k < 8u; k += 1u) { s += cube_gu__u[r * 32u + m * 8u + k]; }
    cube_gu__v[l] = s;
  }
  workgroupBarrier();
  if (l < 4u) {
    let gsum = cube_gu__v[l * 4u] + cube_gu__v[l * 4u + 1u] + cube_gu__v[l * 4u + 2u] + cube_gu__v[l * 4u + 3u];
    let usum = cube_gu__v[(4u + l) * 4u] + cube_gu__v[(4u + l) * 4u + 1u] + cube_gu__v[(4u + l) * 4u + 2u] + cube_gu__v[(4u + l) * 4u + 3u];
    cube_gu__out[tk * cube_gu__sc[4u] + (row0 + l)] = (gsum / (1.0 + exp(-gsum))) * usum;
  }
}
