  return fma(dd.x * f32(scv), dot, -(dd.y * f32(mnv)) * sx);
}

fn leaf_gu1(rv: u32, i: u32, x0: vec4<f32>, x1: vec4<f32>, x2: vec4<f32>, x3: vec4<f32>, sx: f32) -> f32 {
  let cc = i * 16u;
  let bv = rv + (cc >> 8u) * 9u;
  let rr = cc & 255u;
  let b = rr >> 6u;
  let hi = (rr >> 5u) & 1u;
  let l = rr & 16u;
  let hdr = cube_gu1_wb[bv];
  let qsv = cube_gu1_wb[bv + 1u + b * 2u + (l >> 4u)];
  let dd = unpack2x16float(hdr.x);
  let sb = b * 2u + hi;
  var scv: u32; var mnv: u32;
  if (sb < 4u) {
    scv = (sc12(hdr, sb)) & 63u; mnv = (sc12(hdr, sb + 4u)) & 63u;
  } else {
    scv = (sc12(hdr, sb + 4u) & 15u) | ((sc12(hdr, sb - 4u) >> 6u) << 4u);
    mnv = (sc12(hdr, sb + 4u) >> 4u) | ((sc12(hdr, sb) >> 6u) << 4u);
  }
  let sh = hi * 4u;
  let n = (qsv >> vec4<u32>(sh)) & vec4<u32>(0x0F0F0F0Fu);
  let a = vec4<f32>(f32(n.x & 255u), f32((n.x >> 8u) & 255u), f32((n.x >> 16u) & 255u), f32(n.x >> 24u));
  let bq = vec4<f32>(f32(n.y & 255u), f32((n.y >> 8u) & 255u), f32((n.y >> 16u) & 255u), f32(n.y >> 24u));
  let cq = vec4<f32>(f32(n.z & 255u), f32((n.z >> 8u) & 255u), f32((n.z >> 16u) & 255u), f32(n.z >> 24u));
  let dq = vec4<f32>(f32(n.w & 255u), f32((n.w >> 8u) & 255u), f32((n.w >> 16u) & 255u), f32(n.w >> 24u));
  let dot = dot(a, x0) + dot(bq, x1) + dot(cq, x2) + dot(dq, x3);
  return fma(dd.x * f32(scv), dot, -(dd.y * f32(mnv)) * sx);
}

@compute @workgroup_size(160)
fn cube_gu_main(@builtin(local_invocation_index) l: u32,
  @builtin(workgroup_id) g: vec3<u32>, @builtin(num_workgroups) ng: vec3<u32>,
  @builtin(subgroup_invocation_id) sgi: u32, @builtin(subgroup_id) sgid: u32, @builtin(num_subgroups) nsg: u32) {
  let row0 = (g.y * ng.x + g.x) * 4u;
  if (row0 >= cube_gu__sc[0u]) {
    return;
  }
  let bg = cube_gu__sc[1u]; let bu = cube_gu__sc[2u];
  var acc: array<f32, 8>;
  for (var a = 0u; a < 8u; a += 1u) { acc[a] = 0.0; }
  let i = l;
  let x0 = cube_gu_xb[i * 4u]; let x1 = cube_gu_xb[i * 4u + 1u]; let x2 = cube_gu_xb[i * 4u + 2u]; let x3 = cube_gu_xb[i * 4u + 3u];
  let sx = dot(x0 + x1 + x2 + x3, vec4<f32>(1.0));
  for (var r = 0u; r < 4u; r += 1u) {
    acc[r] += leaf_gu0((bg + (row0 + r) * 1440u) >> 4u, i, x0, x1, x2, x3, sx);
    acc[4u + r] += leaf_gu1((bu + (row0 + r) * 1440u) >> 4u, i, x0, x1, x2, x3, sx);
  }
  for (var a = 0u; a < 8u; a += 1u) { acc[a] = subgroupAdd(acc[a]); }
  if (sgi == 0u) { for (var a = 0u; a < 8u; a += 1u) { cube_gu__p[a * 16u + sgid] = acc[a]; } }
  workgroupBarrier();
  if (l < 4u) {
    var sg_ = 0.0; var su = 0.0;
    for (var k = 0u; k < nsg; k += 1u) { sg_ += cube_gu__p[l * 16u + k]; su += cube_gu__p[(4u + l) * 16u + k]; }
    cube_gu__out[row0 + l] = (sg_ / (1.0 + exp(-sg_))) * su;
  }
}
