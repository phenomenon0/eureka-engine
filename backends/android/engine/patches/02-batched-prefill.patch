+// ---- batched prefill (layer-major) ---------------------------------------
+// Y[t][r] = dot_fmt(row r, X[t]) for t < T. A row is dequantized once (deq_row
+// yields exactly the factor dot_fmt multiplies by, in the same column order),
+// then dotted with 32 tokens at a time as vector lanes: every (r, t) sum is
+// c = 0..cols-1 with a separate multiply and add, as in dot_fmt. Bit-identical.
+#define TBL 32
+typedef float v8f __attribute__((vector_size(32)));
+static float *gXT;
+static size_t gXTcap;
+
+static void gemm(int id, const float *X, float *Yo, int T) {
+  if (T == 1) { gemv(id, tptr(id), X, Yo); return; }
+  int rows = trows(id), cols = tcols(id), fmt = tfmt(id);
+  int rb = (fmt == 0) ? cols * 4 : trb(id);
+  int nb = (T + TBL - 1) / TBL;
+  size_t need = (size_t)nb * cols * TBL;
+  if (need > gXTcap) {
+    free(gXT);
+    gXT = (float *)aligned_alloc(64, need * 4);
+    if (!gXT) { fprintf(stderr, "gemm: alloc %zu failed\n", need * 4); exit(1); }
+    gXTcap = need;
+  }
+  // XT[b][c][j] = X[b*TBL + j][c], zero-padded past T
+  for (int b = 0; b < nb; b++)
+    for (int c = 0; c < cols; c++)
+      for (int j = 0; j < TBL; j++) {
+        int t = b * TBL + j;
+        gXT[((size_t)b * cols + c) * TBL + j] = t < T ? X[(size_t)t * cols + c] : 0.0f;
+      }
+  const uint8_t *W = tptr(id);
+  #pragma omp parallel
+  {
+    float *w = (float *)malloc((size_t)cols * 4);
+    #pragma omp for schedule(static)
+    for (int r = 0; r < rows; r++) {
+      deq_row(fmt, W + (size_t)r * rb, cols, w);
+      for (int b = 0; b < nb; b++) {
+        const v8f *xt = (const v8f *)(gXT + (size_t)b * cols * TBL);
+        v8f a0 = {0}, a1 = {0}, a2 = {0}, a3 = {0};
+        for (int c = 0; c < cols; c++) {
+          v8f wc = (v8f){0} + w[c];
+          a0 += xt[4 * c + 0] * wc; a1 += xt[4 * c + 1] * wc;
+          a2 += xt[4 * c + 2] * wc; a3 += xt[4 * c + 3] * wc;
+        }
+        float acc[TBL];
+        memcpy(acc, &a0, 32); memcpy(acc + 8, &a1, 32); memcpy(acc + 16, &a2, 32); memcpy(acc + 24, &a3, 32);
+        for (int j = 0; j < TBL && b * TBL + j < T; j++) Yo[(size_t)(b * TBL + j) * rows + r] = acc[j];
+      }
+    }
+    free(w);
+  }
+}
+
+// Batch buffers for up to PFB prompt tokens per chunk.
+#define PFB 64
+static float *PX, *PH, *PA, *PB, *PC, *PD, *PE, *PO;
+
+static void prefill_alloc(void) {
+  size_t wa = (size_t)(CONVD > 2 * HDIM * H ? CONVD : 2 * HDIM * H);
+  size_t wf = (size_t)(dff > VDC ? dff : VDC);
+  if (wf < (size_t)H * HDIM) wf = (size_t)H * HDIM;
+  PX = (float *)malloc((size_t)PFB * D * 4); PH = (float *)malloc((size_t)PFB * D * 4);
+  PA = (float *)malloc(PFB * wa * 4);       PB = (float *)malloc(PFB * wf * 4);
+  PC = (float *)malloc((size_t)PFB * (TR > KV * HDIM ? TR : KV * HDIM) * 4);
+  PD = (float *)malloc((size_t)PFB * (TR > KV * HDIM ? TR : KV * HDIM) * 4);
+  PE = (float *)malloc(PFB * wf * 4);       PO = (float *)malloc((size_t)PFB * D * 4);
+  if (!PX || !PH || !PA || !PB || !PC || !PD || !PE || !PO) { fprintf(stderr, "prefill alloc failed\n"); exit(1); }
+}
+
+// forward_token for T consecutive tokens, layer by layer: the same per-token
+// ops in the same order (a token only depends on earlier tokens of its own
+// layer), with every projection batched through gemm. Leaves X = last token.
+static void prefill_chunk(const int *tok, int T, int pos0) {
+  int id; char p[32], nm[80];
+  int emb = find("token_embd.weight");
+  for (int t = 0; t < T; t++) row_f32(emb, tok[t], PX + (size_t)t * D);
+  for (int il = 0; il < L; il++) {
+    snprintf(p, sizeof p, "blk.%d.", il);
+#define N(s) (snprintf(nm, sizeof nm, "%s%s", p, s), id = find(nm))
+    N("attn_norm.weight");
+    for (int t = 0; t < T; t++) rms_norm(PH + (size_t)t * D, PX + (size_t)t * D, fvec(id), D);
+    if (gFull[il]) {
+      int nq = 2 * HDIM * H, nk = KV * HDIM;
+      N("attn_q.weight"); gemm(id, PH, PA, T);
+      N("attn_k.weight"); gemm(id, PH, PC, T);
+      N("attn_v.weight"); gemm(id, PH, PD, T);
+      for (int t = 0; t < T; t++) {
+        full_core(il, p, PA + (size_t)t * nq, PC + (size_t)t * nk, PD + (size_t)t * nk, pos0 + t);
+        memcpy(PB + (size_t)t * H * HDIM, ATTN, (size_t)H * HDIM * 4);
+      }
+      N("attn_output.weight"); gemm(id, PB, PO, T);
+    } else {
+      N("attn_qkv.weight"); gemm(id, PH, PA, T);
+      N("attn_gate.weight"); gemm(id, PH, PB, T);
+      N("ssm_beta.weight"); gemm(id, PH, PC, T);
+      N("ssm_alpha.weight"); gemm(id, PH, PD, T);
+      for (int t = 0; t < T; t++) {
+        linear_core(il, p, PA + (size_t)t * CONVD, PB + (size_t)t * VDC, PC + (size_t)t * TR, PD + (size_t)t * TR);
+        memcpy(PE + (size_t)t * VDC, OUT0, (size_t)VDC * 4);
+      }
+      N("ssm_out.weight"); gemm(id, PE, PO, T);
+    }
+    N("post_attention_norm.weight");
+    for (int t = 0; t < T; t++) {
+      float *x = PX + (size_t)t * D, *o = PO + (size_t)t * D;
+      for (int i = 0; i < D; i++) x[i] += o[i];
+      rms_norm(PH + (size_t)t * D, x, fvec(id), D);
+    }
+    N("ffn_gate.weight"); gemm(id, PH, PB, T);
+    N("ffn_up.weight"); gemm(id, PH, PE, T);
+    for (size_t i = 0; i < (size_t)T * dff; i++) PB[i] = hf_silu(PB[i]) * PE[i];
+    N("ffn_down.weight"); gemm(id, PB, PO, T);
+    for (size_t i = 0; i < (size_t)T * D; i++) PX[i] += PO[i];
+#undef N
+    if (gMapSz) madvise((void *)gPack, gMapSz, MADV_DONTNEED);
+  }
+  memcpy(X, PX + (size_t)(T - 1) * D, (size_t)D * 4);
+}
+
+static void prefill(const int *tok, int n) {
+  for (int t0 = 0; t0 < n; t0 += PFB) prefill_chunk(tok + t0, n - t0 < PFB ? n - t0 : PFB, t0);
+}
