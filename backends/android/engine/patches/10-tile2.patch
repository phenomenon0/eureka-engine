+  const uint8x16_t m4 = vdupq_n_u8(0xF);
+  for (int b = 0; b < nb; b++) {
+    const uint8_t *blk[2] = {row + (size_t)b * 144, row + rb + (size_t)b * 144};
+    int sd[2][8], sm[2][8];
+    int32x4_t sv[2][GNT];
+    for (int i = 0; i < 2; i++) {
+      for (int j = 0; j < 8; j++) gsm4(j, blk[i] + 4, &sd[i][j], &sm[i][j]);
+      for (int t = 0; t < GNT; t++) sv[i][t] = vdupq_n_s32(0);
+    }
+    for (int g = 0; g < 4; g++) {
+      int8x16_t lo0[2], lo1[2], hi0[2], hi1[2];
+      for (int i = 0; i < 2; i++) {
+        const uint8_t *qs = blk[i] + 16 + g * 32;
+        uint8x16_t w0 = vld1q_u8(qs), w1 = vld1q_u8(qs + 16);
+        lo0[i] = vreinterpretq_s8_u8(vandq_u8(w0, m4)); lo1[i] = vreinterpretq_s8_u8(vandq_u8(w1, m4));
+        hi0[i] = vreinterpretq_s8_u8(vshrq_n_u8(w0, 4)); hi1[i] = vreinterpretq_s8_u8(vshrq_n_u8(w1, 4));
+      }
+      for (int t = 0; t < GNT; t++) {
+        const i8 *xa = qx + (size_t)t * cols + b * 256 + g * 64;
+        int8x16_t x0 = vld1q_s8(xa), x1 = vld1q_s8(xa + 16), x2 = vld1q_s8(xa + 32), x3 = vld1q_s8(xa + 48);
+        for (int i = 0; i < 2; i++) {
+          int32x4_t z = vdupq_n_s32(0);
+          int32x4_t ia = vdotq_s32(vdotq_s32(z, lo0[i], x0), lo1[i], x1);
+          int32x4_t ib = vdotq_s32(vdotq_s32(z, hi0[i], x2), hi1[i], x3);
+          sv[i][t] = vmlaq_n_s32(vmlaq_n_s32(sv[i][t], ia, sd[i][2 * g]), ib, sd[i][2 * g + 1]);
+        }
+      }
+    }
+    for (int i = 0; i < 2; i++) {
+      float d = h2f(blk[i]), dmin = h2f(blk[i] + 2);
+      for (int t = 0; t < GNT; t++) {
+        const int16_t *bt = bs + (size_t)t * (cols / 32) + b * 8;
+        int32_t s1 = vaddvq_s32(sv[i][t]), s2 = 0;
+        for (int j = 0; j < 8; j++) s2 += sm[i][j] * bt[j];
+        float x = xd[(size_t)t * nb + b];
+        float dd = d * x, dm = dmin * x;
+        acc[i][t] += dd * (float)s1;
+        acc[i][t] -= dm * (float)s2;
+      }
+    }
+  }
+  for (int t = 0; t < GNT; t++) { o0[t] = acc[0][t]; o1[t] = acc[1][t]; }
+}
