+    for (int i = 0; i < 2; i++) for (int t = 0; t < GNT; t++) sv[i][t] = vdupq_n_s32(0);
+    for (int half = 0; half < 2; half++) {
+      uint8x16_t hh0[2], hh1[2];
+      for (int i = 0; i < 2; i++) { hh0[i] = vld1q_u8(blk[i] + 128 + half * 32); hh1[i] = vld1q_u8(blk[i] + 128 + half * 32 + 16); }
