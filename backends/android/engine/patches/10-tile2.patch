+// rows of one tensor in pairs; an odd last row goes alone
+static void gemm8_pair(int fmt, const uint8_t *W, int cols, int rows, size_t rb, int pr, int T, float *Yo) {
+  int r = 2 * pr;
+  if (r + 1 < rows) gemm8_row2(fmt, W + (size_t)r * rb, rb, cols, rows, r, T, Yo);
+  else gemm8_row(fmt, W + (size_t)r * rb, cols, rows, r, T, Yo);
+}
