+// output rows r and r+1 (r+1 < rows): one 2-row tile on sdot, two gemm8_row calls otherwise
+static void gemm8_row2(int fmt, const uint8_t *row, size_t rb, int cols, int rows, int r, int T, float *Yo) {
+#if DOT8_SDOT
+  int nb = cols / 256, ns = cols / 32;
+  for (int t0 = 0; t0 < T; t0 += GNT) {
+    float o0[GNT], o1[GNT];
+    if (fmt == 3) gemm8_q4k2(row, rb, cols, gQX + (size_t)t0 * cols, gXD + (size_t)t0 * nb, gBS + (size_t)t0 * ns, o0, o1);
+    else gemm8_q6k2(row, rb, cols, gQX + (size_t)t0 * cols, gXD + (size_t)t0 * nb, o0, o1);
+    for (int t = 0; t < GNT && t0 + t < T; t++) {
+      Yo[(size_t)(t0 + t) * rows + r] = o0[t];
+      Yo[(size_t)(t0 + t) * rows + r + 1] = o1[t];
+    }
+  }
+#else
+  gemm8_row(fmt, row, cols, rows, r, T, Yo);
+  gemm8_row(fmt, row + rb, cols, rows, r + 1, T, Yo);
+#endif
+}
