@@ -499,6 +499,28 @@
 static const uint8_t *gPack = NULL;
 static size_t gMapSz = 0;  // nonzero: gPack is an mmap; drop its pages per layer (RSS <= one layer)
 static const char *gDumpLayers = NULL;
+// LLB_RESIDENT=1: keep the mapped pack resident across layers/tokens instead of dropping it per layer.
+// Clean file pages stay reclaimable; each layer end re-checks MemAvailable and drops below the floor.
+static int gResident = 0, gDrops = 0;
+static long gFloorKB = 0, gMinAvailKB = -1;
+static long mem_avail_kb(void) {
+  FILE *f = fopen("/proc/meminfo", "r");
+  char ln[128]; long v = -1;
+  if (!f) return -1;
+  while (fgets(ln, sizeof ln, f)) if (sscanf(ln, "MemAvailable: %ld", &v) == 1) break;
+  fclose(f);
+  return v;
+}
+static void pack_release(void) {
+  if (!gMapSz) return;
+  if (gResident) {
+    long a = mem_avail_kb();
+    if (a >= 0 && (gMinAvailKB < 0 || a < gMinAvailKB)) gMinAvailKB = a;
+    if (a >= gFloorKB) return;
+    gDrops++;
+  }
+  madvise((void *)gPack, gMapSz, MADV_DONTNEED);
+}
 
 static int L, D, H, KV, HDIM, dff, V, INTERVAL, KC, SZ, GK, TR, VHD, KDC, VDC, CONVD, ROPEDIM;
 static float EPS, ROPE_BASE;
