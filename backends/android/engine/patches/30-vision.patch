+// ---- vision (30-vision.patch): one image per request. gImgN == 0 (no image) leaves every path bit-identical.
+// The image's gImgN rows replace the embeddings of KV slots [gImgS0, gImgS0+gImgN); slots and the causal mask are
+// unchanged, only the rope angle moves (IMRoPE, Qwen3-VL): pair i takes t/h/w by i%3; image row r = (S0, S0+r/nx,
+// S0+r%nx); text after the image resumes at slot - (n - max(nx,ny)).
+static int gImgS0, gImgN, gImgNx, gImgSh;
+static float *gImgE;
+static void rope_im(float *x, int slot, int nd, int hd, float base) {
+  if (!gImgN) { rope_neox(x, slot, nd, hd, base); return; }
+  int pt = slot, ph = slot, pw = slot;
+  if (slot >= gImgS0 + gImgN) pt = ph = pw = slot - gImgSh;
+  else if (slot >= gImgS0) { int r = slot - gImgS0; pt = gImgS0; ph = gImgS0 + r / gImgNx; pw = gImgS0 + r % gImgNx; }
+  int half = nd / 2;
+  for (int i = 0; i < half; i++) {
+    int pos = i % 3 == 0 ? pt : i % 3 == 1 ? ph : pw;
+    float theta = (float)((double)pos * pow((double)base, -2.0 * i / nd));
+    float c = hf_cos(theta), s = hf_sin(theta);
+    float a = x[i], b = x[i + half];
+    x[i] = a * c - b * s;
+    x[i + half] = a * s + b * c;
+  }
+}
