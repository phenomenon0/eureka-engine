 static void gemm(int id, const float *X, float *Yo, int T) {
   if (T == 1) { gemv(id, tptr(id), X, Yo); return; }
   int rows = trows(id), cols = tcols(id), fmt = tfmt(id);
   int rb = (fmt == 0) ? cols * 4 : trb(id);
 #ifdef LLB_DOT8
   if (fmt == 3 || fmt == 4) {
+#ifdef LLB_DOT8_GEMM
+    gemm8(fmt, tptr(id), X, rows, cols, rb, T, Yo);
+    return;
+#endif
     quant_need((size_t)T * cols);
     for (int t = 0; t < T; t++) quant_x8(X + (size_t)t * cols, cols, gQX + (size_t)t * cols, gXD + (size_t)t * (cols / 256));
     const uint8_t *W8 = tptr(id);
@@ -1201,7 +1372,7 @@
   fprintf(stderr, "cpu: omp threads %d (rows split, per-row order serial)\n", omp_get_max_threads());
 #endif
 #ifdef LLB_DOT8
-  fprintf(stderr, "order: dot8-%s (OPT-IN: int8 activations for Q4_K/Q6_K, NOT the byte contract)\n", DOT8_KIND);
+  fprintf(stderr, "order: dot8-%s%s (OPT-IN: int8 activations for Q4_K/Q6_K, NOT the byte contract)\n", DOT8_KIND, DOT8G_KIND);
