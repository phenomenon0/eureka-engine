 static float *gXT;
 static size_t gXTcap;
 
+#if defined(LLB_DOT8) && defined(LLB_DOT8_GEMM)
+// ---- OPT-IN "dot8-gemm" (build with -DLLB_DOT8 -DLLB_DOT8_GEMM) -----------
+// Same arithmetic order as dot8 per (row, token): the integer block sums are
+// exact (so regrouping them is free) and the float combine per 256-block is
+// dot8's, verbatim. Only the loads change: a weight block is unpacked once
+// and dotted against GNT tokens; x sub-block sums come precomputed (bsums).
+// sdot on arm, plain C elsewhere (-DLLB_DOT8_SCALAR forces C). Must equal
+// g3 / g3ref bit for bit.
+#ifndef GNT
+#define GNT 4
+#endif
+#define G8S_(x) #x
+#define G8S(x) G8S_(x)
+#define DOT8G_KIND "-gemm" G8S(GNT)
+static int16_t *gBS;
+static size_t gBScap;
+
+static void gemm8_q4k(const uint8_t *row, int cols, const i8 *qx, const float *xd, const int16_t *bs, float *out) {
+  int nb = cols / 256;
+  float acc[GNT] = {0};
+  for (int b = 0; b < nb; b++) {
+    const uint8_t *blk = row + (size_t)b * 144;
+    float d = h2f(blk), dmin = h2f(blk + 2);
+    const uint8_t *sc = blk + 4, *qs = blk + 16;
+    int sd[8], sm[8];
+    int32_t s1[GNT];
+    for (int j = 0; j < 8; j++) gsm4(j, sc, &sd[j], &sm[j]);
+#if DOT8_SDOT
+    const uint8x16_t m4 = vdupq_n_u8(0xF);
+    int32x4_t sv[GNT];
+    for (int t = 0; t < GNT; t++) sv[t] = vdupq_n_s32(0);
+    for (int g = 0; g < 4; g++) {
+      uint8x16_t w0 = vld1q_u8(qs + g * 32), w1 = vld1q_u8(qs + g * 32 + 16);
+      int8x16_t lo0 = vreinterpretq_s8_u8(vandq_u8(w0, m4)), lo1 = vreinterpretq_s8_u8(vandq_u8(w1, m4));
+      int8x16_t hi0 = vreinterpretq_s8_u8(vshrq_n_u8(w0, 4)), hi1 = vreinterpretq_s8_u8(vshrq_n_u8(w1, 4));
+      for (int t = 0; t < GNT; t++) {
+        const i8 *xa = qx + (size_t)t * cols + b * 256 + g * 64;
+        int32x4_t z = vdupq_n_s32(0);
+        int32x4_t ia = vdotq_s32(vdotq_s32(z, lo0, vld1q_s8(xa)), lo1, vld1q_s8(xa + 16));
+        int32x4_t ib = vdotq_s32(vdotq_s32(z, hi0, vld1q_s8(xa + 32)), hi1, vld1q_s8(xa + 48));
+        sv[t] = vmlaq_n_s32(vmlaq_n_s32(sv[t], ia, sd[2 * g]), ib, sd[2 * g + 1]);
+      }
+    }
+    for (int t = 0; t < GNT; t++) s1[t] = vaddvq_s32(sv[t]);
+#else
+    i8 w[256];
+    for (int g = 0; g < 4; g++)
+      for (int l = 0; l < 32; l++) { w[g * 64 + l] = qs[g * 32 + l] & 0xF; w[g * 64 + 32 + l] = qs[g * 32 + l] >> 4; }
+    for (int t = 0; t < GNT; t++) {
+      const i8 *xb = qx + (size_t)t * cols + b * 256;
+      int32_t s = 0;
+      for (int j = 0; j < 8; j++) {
+        int32_t is = 0;
+        for (int l = 0; l < 32; l++) is += w[j * 32 + l] * xb[j * 32 + l];
+        s += sd[j] * is;
+      }
+      s1[t] = s;
+    }
+#endif
+    for (int t = 0; t < GNT; t++) {
+      const int16_t *bt = bs + (size_t)t * (cols / 32) + b * 8;
+      int32_t s2 = 0;
+      for (int j = 0; j < 8; j++) s2 += sm[j] * bt[j];
+      float x = xd[(size_t)t * nb + b];
+      float dd = d * x, dm = dmin * x;
+      acc[t] += dd * (float)s1[t];
+      acc[t] -= dm * (float)s2;
+    }
+  }
+  for (int t = 0; t < GNT; t++) out[t] = acc[t];
+}
+
+static void gemm8_q6k(const uint8_t *row, int cols, const i8 *qx, const float *xd, float *out) {
+  int nb = cols / 256;
+  float acc[GNT] = {0};
+  for (int b = 0; b < nb; b++) {
+    const uint8_t *blk = row + (size_t)b * 210;
+    const uint8_t *ql = blk, *qh = blk + 128;
+    const int8_t *scb = (const int8_t *)(blk + 192);
+    float d = h2f(blk + 208);
+    int32_t s1[GNT];
+#if DOT8_SDOT
+    const uint8x16_t m4 = vdupq_n_u8(0xF), m3 = vdupq_n_u8(3);
+    int32x4_t sv[GNT];
+    for (int t = 0; t < GNT; t++) sv[t] = vdupq_n_s32(0);
+    for (int half = 0; half < 2; half++) {
+      const uint8_t *qlh = ql + half * 64, *qhh = qh + half * 32;
+      uint8x16_t hh0 = vld1q_u8(qhh), hh1 = vld1q_u8(qhh + 16);
+      for (int qd = 0; qd < 4; qd++) {
+        const uint8_t *qq = qlh + (qd & 1) * 32;
+        uint8x16_t l0 = vld1q_u8(qq), l1 = vld1q_u8(qq + 16);
+        if (qd >= 2) { l0 = vshrq_n_u8(l0, 4); l1 = vshrq_n_u8(l1, 4); }
+        l0 = vandq_u8(l0, m4); l1 = vandq_u8(l1, m4);
+        int8x16_t sh = vdupq_n_s8(-2 * qd);
+        uint8x16_t h0 = vandq_u8(vshlq_u8(hh0, sh), m3), h1 = vandq_u8(vshlq_u8(hh1, sh), m3);
+        int8x16_t c0 = vsubq_s8(vreinterpretq_s8_u8(vorrq_u8(l0, vshlq_n_u8(h0, 4))), vdupq_n_s8(32));
+        int8x16_t c1 = vsubq_s8(vreinterpretq_s8_u8(vorrq_u8(l1, vshlq_n_u8(h1, 4))), vdupq_n_s8(32));
+        int sc0 = scb[half * 8 + 2 * qd], sc1 = scb[half * 8 + 2 * qd + 1];
+        for (int t = 0; t < GNT; t++) {
+          const i8 *xq = qx + (size_t)t * cols + b * 256 + half * 128 + qd * 32;
+          int32x4_t z = vdupq_n_s32(0);
+          sv[t] = vmlaq_n_s32(vmlaq_n_s32(sv[t], vdotq_s32(z, c0, vld1q_s8(xq)), sc0), vdotq_s32(z, c1, vld1q_s8(xq + 16)), sc1);
+        }
+      }
+    }
+    for (int t = 0; t < GNT; t++) s1[t] = vaddvq_s32(sv[t]);
+#else
+    // w[k] for k = half*128 + qd*32 + l; 16-wide sub-block k/16 has scale scb[k/16]
+    i8 w[256];
+    for (int half = 0; half < 2; half++)
+      for (int qd = 0; qd < 4; qd++)
+        for (int l = 0; l < 32; l++) {
+          int q = ql[half * 64 + (qd & 1) * 32 + l];
+          int nib = (qd < 2) ? (q & 0xF) : (q >> 4);
+          w[half * 128 + qd * 32 + l] = (i8)((nib | (((qh[half * 32 + l] >> (2 * qd)) & 3) << 4)) - 32);
+        }
+    for (int t = 0; t < GNT; t++) {
+      const i8 *xb = qx + (size_t)t * cols + b * 256;
+      int32_t s = 0;
+      for (int k = 0; k < 16; k++) {
+        int32_t is = 0;
+        for (int l = 0; l < 16; l++) is += w[k * 16 + l] * xb[k * 16 + l];
+        s += scb[k] * is;
+      }
+      s1[t] = s;
+    }
+#endif
+    for (int t = 0; t < GNT; t++) acc[t] += (d * xd[(size_t)t * nb + b]) * (float)s1[t];
+  }
+  for (int t = 0; t < GNT; t++) out[t] = acc[t];
+}
+
+// Quantizes X[T] (per token, as gemv's quant_x8), pads to GNT with zero tokens,
+// then Yo[t][r] as gemm.
+static void gemm8(int fmt, const uint8_t *W, const float *X, int rows, int cols, int rb, int T, float *Yo) {
+  int Tp = (T + GNT - 1) / GNT * GNT, nb = cols / 256, ns = cols / 32;
+  quant_need((size_t)Tp * cols);
+  if ((size_t)Tp * ns > gBScap) {
+    free(gBS); gBS = (int16_t *)malloc((size_t)Tp * ns * 2);
+    if (!gBS) { fprintf(stderr, "gemm8 alloc failed\n"); exit(1); }
+    gBScap = (size_t)Tp * ns;
+  }
+  #pragma omp parallel for schedule(static)
+  for (int t = 0; t < Tp; t++) {
+    i8 *q = gQX + (size_t)t * cols;
+    if (t < T) quant_x8(X + (size_t)t * cols, cols, q, gXD + (size_t)t * nb);
+    else { memset(q, 0, cols); for (int b = 0; b < nb; b++) gXD[(size_t)t * nb + b] = 0.0f; }
+    for (int i = 0; i < ns; i++) {
+      int s = 0;
+      for (int l = 0; l < 32; l++) s += q[i * 32 + l];
+      gBS[(size_t)t * ns + i] = (int16_t)s;
+    }
+  }
+  #pragma omp parallel for schedule(static)
+  for (int r = 0; r < rows; r++)
+    for (int t0 = 0; t0 < T; t0 += GNT) {
+      float o[GNT];
+      const uint8_t *row = W + (size_t)r * rb;
+      if (fmt == 3) gemm8_q4k(row, cols, gQX + (size_t)t0 * cols, gXD + (size_t)t0 * nb, gBS + (size_t)t0 * ns, o);
+      else gemm8_q6k(row, cols, gQX + (size_t)t0 * cols, gXD + (size_t)t0 * nb, o);
+      for (int t = 0; t < GNT && t0 + t < T; t++) Yo[(size_t)(t0 + t) * rows + r] = o[t];
+    }
+}
+#else
+#define DOT8G_KIND ""
+#endif
