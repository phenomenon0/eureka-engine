+// run argv, its stdout captured (stderr passed through); 0 = it ran (exit status in *rc)
+static int run_capture(char *const argv[], char **out, size_t *on, int *rc) {
+    int pp[2];
+    if (pipe(pp)) return -1;
+    pid_t pid = fork();
+    if (pid < 0) return close(pp[0]), close(pp[1]), -1;
+    if (!pid) {
+        dup2(pp[1], 1);
+        close(pp[0]), close(pp[1]);
+        execv(argv[0], argv);
