+    for (;;) {
+        ssize_t k = read(pp[0], buf, sizeof buf);
+        if (k < 0 && errno == EINTR) continue;
+        if (k <= 0) break;
+        sb_addn(&o, buf, (size_t)k);
+    }
+    close(pp[0]);
+    int st = 0;
