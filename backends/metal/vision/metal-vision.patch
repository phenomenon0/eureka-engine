+// (ENGINE-VISION2 V5) the batch's pad rows := the image rows (llb_m_slott, <= 1024
+// columns a launch: d 4096 = 4 x 1024, d 2560 = 1024 + 1024 + 512), then (LLB_VIS_DUMPX)
+// every batch row of the chunk to the dump rows at its slot
+static void llb_img_splice(id<MTLComputeCommandEncoder> en, const u32* ids, u32 nt, u32 pos0, u32 d) {
+  for (u32 r = 0; r < nt;) {
+    if (ids[r] != LLB_IMG_PAD) {
+      r += 1;
+      continue;
+    }
+    u32 r1 = r;
+    while (r1 < nt && ids[r1] == LLB_IMG_PAD) {
+      r1 += 1;
+    }
+    if (llb_img_n == 0) {
+      err_fail("vision: an <|image_pad|> row but no image (LLB_VIS_IMAGE / LLB_VIS_EMBD)");
+    }
+    if (llb_img_seen == 0) {
+      llb_img_s0 = pos0 + r;
+      llb_mr_set(llb_img_s0, llb_img_n, llb_img_nx, llb_img_ny);
+      fprintf(stderr, "vision: image rows at slots %u .. %u, grid %u x %u, rope map {s0 %u, n %u, nx %u, sh %u}\n",
+        llb_img_s0, llb_img_s0 + llb_img_n - 1, llb_img_nx, llb_img_ny, llb_mr[0], llb_mr[1], llb_mr[2], llb_mr[3]);
+    }
+    if (pos0 + r != llb_img_s0 + llb_img_seen || llb_img_seen + (r1 - r) > llb_img_n) {
+      err_fail("vision: the <|image_pad|> ids must be one run of exactly the image's rows");
+    }
+    for (u32 c = 0; c < d; c += 1024) {
+      HybTArgs T;
+      f27_targs(&T, d - c < 1024 ? d - c : 1024, 0, 0, 0.0f);
+      T.a[0] = llb_img_at + ((u64)llb_img_seen * d + c) * 4; T.s[0] = (u64)d * 4;
+      T.a[1] = f27_base + F27_X * 4 + (u64)r * F27_TS + (u64)c * 4; T.s[1] = F27_TS;
+      f27_go(en, gpu_t27_slot, &T, sizeof T, 1, r1 - r, d - c < 1024 ? d - c : 1024);
+    }
+    llb_img_seen += r1 - r;
+    r = r1;
+  }
+  if (llb_img_dcap != 0 && pos0 < llb_img_dcap) {
+    u32 m = pos0 + nt <= llb_img_dcap ? nt : llb_img_dcap - pos0;
+    for (u32 c = 0; c < d; c += 1024) {
+      HybTArgs T;
+      f27_targs(&T, d - c < 1024 ? d - c : 1024, 0, 0, 0.0f);
+      T.a[0] = f27_base + F27_X * 4 + (u64)c * 4; T.s[0] = F27_TS;
+      T.a[1] = llb_img_dump + ((u64)pos0 * d + c) * 4; T.s[1] = (u64)d * 4;
+      f27_go(en, gpu_t27_slot, &T, sizeof T, 1, m, d - c < 1024 ? d - c : 1024);
+    }
+    llb_img_dn = pos0 + m > llb_img_dn ? pos0 + m : llb_img_dn;
+  }
+}
