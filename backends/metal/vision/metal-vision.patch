+// (ENGINE-VISION2 V5, patches/metal-vision.patch) embedding injection. The
+// prompt carries the image as a run of n <|image_pad|> ids (LLB_IMG_PAD) where
+// mtmd puts its n embedding rows (<|vision_start|> pads <|vision_end|>). The
+// rows come from vision/host/llbv.c (linked only in a VISION=1 build): the
+// in-process tower (LLB_VIS_IMAGE + LLB_VIS_MMPROJ) or a file (LLB_VIS_EMBD),
+// loaded at the pass reserve into a region of gpu_scr past the chunk area
+// (llb_img_at). f27_chunk gathers every row by id as before (llb_f27_embt; a
+// pad id is an in-range row), then llb_img_splice overwrites the pad rows of
+// the batch (F27_X) with the image rows, in order, and at the first pad sets
+// the rope's image map (llb_mr_set: s0 = that slot). Image rows go through the
+// fast chunk only: a pad at the exact step, or a pad run that is not exactly
+// the image's n rows, is refused. No image asked = nothing allocated, nothing
+// launched: the text-only path as before. LLB_VIS_DUMPX=<file>: the batch rows
+// (after the splice) of the first LLB_IMG_DCAP slots, written at exit (the
+// V5 gate's row-for-row receipt)
+#define LLB_IMG_PAD 248056u
+extern int llbv_requested(void);
+extern int llbv_rows(u32 d, float** rows, u32* n, u32* nx, u32* ny, char* err);
+static u32 llb_img_n, llb_img_nx, llb_img_ny, llb_img_seen, llb_img_s0, llb_img_dn, llb_img_dcap, llb_img_d;
+static u64 llb_img_at, llb_img_dump;
+static float* llb_img_rows;
+static id<MTLBuffer> llb_img_buf;
+
+static void llb_img_atexit(void) {
+  const char* f = getenv("LLB_VIS_DUMPX");
+  FILE* o = f != NULL && llb_img_buf != nil ? fopen(f, "wb") : NULL;
+  if (o != NULL) {
+    fwrite((const u8*)[llb_img_buf contents] + (llb_img_dump - SA_SCR), 4,
+      (size_t)llb_img_dn * llb_img_d, o);
+    fclose(o);
+    fprintf(stderr, "vision: batch rows 0 .. %u (d %u) -> %s\n", llb_img_dn, llb_img_d, f);
+  }
+}
+
+// the bytes the reserve adds (0: no image asked); loads the rows the first time
+static u64 llb_img_bytes(u32 d) {
+  if (!llbv_requested()) {
+    return 0;
+  }
+  if (llb_img_rows == NULL) {
+    char err[256] = {0};
+    if (d % 256 != 0 || llbv_rows(d, &llb_img_rows, &llb_img_n, &llb_img_nx, &llb_img_ny, err) != 0) {
+      fprintf(stderr, "vision: %s\n", d % 256 != 0 ? "the model width is not a multiple of 256" : err);
+      err_fail("vision: no image rows");
+    }
+    llb_img_d = d;
+    llb_img_dcap = getenv("LLB_VIS_DUMPX") != NULL ? llb_img_n + 512 : 0;
+  }
+  return ((u64)llb_img_n + llb_img_dcap) * d * 4;
+}
+
+// the region's place once the reserve allocated g (off = its byte offset in g)
+static void llb_img_place(id<MTLBuffer> g, u64 off) {
+  llb_img_at = SA_SCR + off;
+  memcpy((u8*)[g contents] + off, llb_img_rows, (size_t)llb_img_n * llb_img_d * 4);
+  if (llb_img_dcap != 0) {
+    llb_img_dump = llb_img_at + (u64)llb_img_n * llb_img_d * 4;
+    llb_img_buf = g;
+    atexit(llb_img_atexit);
+  }
+}
