+// (ENGINE-VISION2 V4) the image map every rope launch carries (LLB_MRP): zero
+// = text only; set by an image prompt (llb_mr_set), cleared when it ends
+static u32 llb_mr[4];
+
+static void llb_mr_set(u32 s0, u32 n, u32 nx, u32 ny) {
+  llb_mr[0] = s0; llb_mr[1] = n; llb_mr[2] = nx;
+  llb_mr[3] = n == 0 ? 0 : n - (nx > ny ? nx : ny);
+}
