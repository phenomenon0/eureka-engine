+      simdgroup_float8x8 mqk = make_filled_simdgroup_matrix<float, 8>(0.0f);
+      for (short i = 0; i < DK8; ++i) {
+        simdgroup_half8x8 mk;
+        simdgroup_load(mk, pk + 8*i, DK, 0, true);
+        simdgroup_multiply_accumulate(mqk, mq[i], mk, mqk);
+      }
+      simdgroup_store(mqk, ss + 8*cc, C, 0, false);
+    }
+    simdgroup_barrier(mem_flags::mem_threadgroup);
+
+    float msl = 0.0f;  // ms of this lane's row fm
+    for (short j = 0; j < R; ++j) {
+      const float m = M[j];
+      float2 s2 = ss2[j*C/2 + tiisg]*a.scale;
+      if (ic + C > a.n) {
+        const int c0 = ic + 2*tiisg;
+        s2 += float2(c0 < a.n ? 0.0f : -VT_MAXHALF, c0 + 1 < a.n ? 0.0f : -VT_MAXHALF);
+      }
+      M[j] = simd_max(max(M[j], max(s2[0], s2[1])));
+      const float  ms  = exp(m  - M[j]);
+      const float2 vs2 = exp(s2 - M[j]);
+      S[j] = S[j]*ms + simd_sum(vs2[0] + vs2[1]);
+      ss2[j*C/2 + tiisg] = vs2;
+      if (j == fm) msl = ms;
+    }
+    simdgroup_barrier(mem_flags::mem_threadgroup);
