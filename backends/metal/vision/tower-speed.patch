+// per simdgroup: S [8][64] F32 = 2048 bytes (Q's staging aliases it).
+kernel void vt_fa3(constant VtFaArgs & a [[buffer(0)]],
+                   device const float * q [[buffer(1)]],
+                   device const half * k [[buffer(2)]],
+                   device const half * v [[buffer(3)]],
+                   device float * dst [[buffer(4)]],
+                   threadgroup char * shmem [[threadgroup(0)]],
+                   uint3 tgpig [[threadgroup_position_in_grid]],
+                   ushort tiisg [[thread_index_in_simdgroup]],
+                   ushort sgitg [[simdgroup_index_in_threadgroup]],
+                   ushort nsg [[simdgroups_per_threadgroup]]) {
+  constexpr short DK = 72, DV = 72, C = 64, NW = 32, DK4 = DK/4, DK8 = DK/8, DV8 = DV/8, R = 8;
