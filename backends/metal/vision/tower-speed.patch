+// (TOWER-SPEED, V7-PLAN G-E) LLB_VIS_MAXTOK=<n>: the serve-mode cap on tokens per image. An image (or LLB_VIS_EMBD rows)
+// over it is refused before the tower encodes, with the count and the cap in the reason. Unset = no cap (today's build)
+static int vis_cap(long *cap, char *err) {
+  const char *s = getenv("LLB_VIS_MAXTOK");
+  char *e = NULL;
+  *cap = 0;
+  if (s == NULL) return 0;
+  const long v = strtol(s, &e, 10);
+  if (*s == 0 || *e != 0 || v < 1) {
+    snprintf(err, 256, "LLB_VIS_MAXTOK=%s: want a token count >= 1", s);
+    return 1;
+  }
+  *cap = v;
+  return 0;
