+// ---------------------------------------------------------------- (TOWER-SPEED) vt_fa2: a twin of vt_fa, opt-in VITM_FA2
+// The same per-row arithmetic as vt_fa, op for op (Q/K/V half, the 8x8 QK MMAs over the 9 DK chunks in order, the F32
+// online softmax with 2 keys per lane, O += P V over the 8 key chunks in key order, O rescaled in threadgroup memory),
+// but each simdgroup owns R = 8*QT whole query rows end to end (no threadgroup barriers), and P V computes only the 72
+// real output columns (vt_fa, as ggml, computes 128 = PV and drops 56). Threadgroup memory per simdgroup: O [R][72] F32,
+// S [R][64] F32 = R*544 bytes (the Q staging, [R][72] half, aliases S: Q lives in registers before S is written).
+template <short QT>
+kernel void vt_fa2(constant VtFaArgs & a [[buffer(0)]],
+                   device const float * q [[buffer(1)]],
+                   device const half * k [[buffer(2)]],
+                   device const half * v [[buffer(3)]],
+                   device float * dst [[buffer(4)]],
+                   threadgroup char * shmem [[threadgroup(0)]],
+                   uint3 tgpig [[threadgroup_position_in_grid]],
+                   ushort tiisg [[thread_index_in_simdgroup]],
+                   ushort sgitg [[simdgroup_index_in_threadgroup]],
+                   ushort nsg [[simdgroups_per_threadgroup]]) {
+  constexpr short DK = 72, DV = 72, C = 64, NW = 32, DK4 = DK/4, DK8 = DK/8, DV4 = DV/4, DV8 = DV/8, R = 8*QT;
+  const int h = tgpig.y;
+  const int iq1 = ((int)tgpig.x*nsg + sgitg)*R;
+  threadgroup float  * so  = (threadgroup float *)(shmem + (int)sgitg*R*544);
+  threadgroup float4 * so4 = (threadgroup float4 *)so;
+  threadgroup float  * ss  = so + R*DV;
+  threadgroup float2 * ss2 = (threadgroup float2 *)ss;
+  threadgroup half   * sq  = (threadgroup half *)ss;
+  threadgroup half4  * sq4 = (threadgroup half4 *)sq;
+
+  for (short j = 0; j < R; ++j) {
+    device const float4 * q4 = (device const float4 *)(q + (ulong)(iq1 + j)*a.ldq + h*DK);
+    for (short i = tiisg; i < DK4; i += NW) sq4[j*DK4 + i] = (iq1 + j < a.n) ? (half4)q4[i] : (half4)0;
+    for (short i = tiisg; i < DV4; i += NW) so4[j*DV4 + i] = 0;
+  }
+  simdgroup_barrier(mem_flags::mem_threadgroup);
+  simdgroup_half8x8 mq[QT][DK8];
+  for (short t = 0; t < QT; ++t)
+    for (short i = 0; i < DK8; ++i) simdgroup_load(mq[t][i], sq + t*8*DK + 8*i, DK);
+  simdgroup_barrier(mem_flags::mem_threadgroup);  // Q is in registers; S may now overwrite the staging
+
+  float S[R], M[R];
+  for (short j = 0; j < R; ++j) S[j] = 0.0f, M[j] = -FLT_MAX/2;
+  device const half * kh = k + (ulong)h*a.npad*DK;
+  device const half * vh = v + (ulong)h*a.npad*DV;
+
+  for (int ic = 0; ic < a.n; ic += C) {
+    // S = Q K^T: key tile cc = keys ic+8cc..
+    for (short cc = 0; cc < C/8; ++cc) {
+      device const half * pk = kh + (ulong)(ic + 8*cc)*DK;
+      simdgroup_float8x8 mqk[QT];
+      for (short t = 0; t < QT; ++t) mqk[t] = make_filled_simdgroup_matrix<float, 8>(0.0f);
+      for (short i = 0; i < DK8; ++i) {
+        simdgroup_half8x8 mk;
+        simdgroup_load(mk, pk + 8*i, DK, 0, true);
+        for (short t = 0; t < QT; ++t) simdgroup_multiply_accumulate(mqk[t], mq[t][i], mk, mqk[t]);
+      }
+      for (short t = 0; t < QT; ++t) simdgroup_store(mqk[t], ss + t*8*C + 8*cc, C, 0, false);
+    }
+    simdgroup_barrier(mem_flags::mem_threadgroup);
+
+    // online softmax, F32, 2 keys per lane (vt_fa's expressions)
+    for (short j = 0; j < R; ++j) {
+      const float m = M[j];
+      float2 s2 = ss2[j*C/2 + tiisg]*a.scale;
+      if (ic + C > a.n) {
+        const int c0 = ic + 2*tiisg;
+        s2 += float2(c0 < a.n ? 0.0f : -VT_MAXHALF, c0 + 1 < a.n ? 0.0f : -VT_MAXHALF);
+      }
+      M[j] = simd_max(max(M[j], max(s2[0], s2[1])));
+      const float  ms  = exp(m  - M[j]);
+      const float2 vs2 = exp(s2 - M[j]);
+      S[j] = S[j]*ms + simd_sum(vs2[0] + vs2[1]);
+      ss2[j*C/2 + tiisg] = vs2;
+      for (short i = tiisg; i < DV4; i += NW) so4[j*DV4 + i] *= ms;
+    }
+    simdgroup_barrier(mem_flags::mem_threadgroup);
+
+    // O += P V over the 72 real columns; per output tile the 8 key chunks in key order (= vt_fa's order)
+    {
+      simdgroup_float8x8 vs[QT][C/8];
+      for (short t = 0; t < QT; ++t)
+        for (short cc = 0; cc < C/8; ++cc) simdgroup_load(vs[t][cc], ss + t*8*C + 8*cc, C, 0, false);
+      for (short t2 = 0; t2 < DV8; ++t2) {
+        simdgroup_float8x8 lo[QT];
+        for (short t = 0; t < QT; ++t) simdgroup_load(lo[t], so + t*8*DV + 8*t2, DV, 0, false);
+        device const half * pv = vh + (ulong)ic*DV + 8*t2;
+        for (short cc = 0; cc < C/8; ++cc) {
+          simdgroup_half8x8 mv;
+          simdgroup_load(mv, pv + cc*8*DV, DV, 0, false);
+          for (short t = 0; t < QT; ++t) simdgroup_multiply_accumulate(lo[t], vs[t][cc], mv, lo[t]);
+        }
+        for (short t = 0; t < QT; ++t) simdgroup_store(lo[t], so + t*8*DV + 8*t2, DV, 0, false);
+      }
+    }
+    simdgroup_barrier(mem_flags::mem_threadgroup);
+  }
+
+  for (short j = 0; j < R; ++j) {
+    if (iq1 + j >= a.n) break;
+    device float4 * dst4 = (device float4 *)(dst + (ulong)(iq1 + j)*a.ldo + h*DV);
+    const float scale = S[j] == 0.0 ? 0.0f : 1.0f/S[j];
+    for (short i = tiisg; i < DV4; i += NW) dst4[i] = (float4)so4[j*DV4 + i]*scale;
+#ifdef VT_SAB
+    if (j == 0 && tiisg == 0) dst4[0].x = as_type<float>(as_type<uint>(dst4[0].x) ^ 1u);  // sabotage: one ulp
+#endif
+  }
+}
