+// ---- (METAL-MOE) the general MoE FFN, host side -------------------------------------------------------------------
+// A qwen35moe model of any shape on the generic pass (m9_pass_run): every layer's FFN is mx_ffn_run instead of
+// m9_fbn_run. Admission: the table (gguf2pack --sidecar-only on a qwen35moe GGUF) carries the MoE words in every
+// row: 24 MX_MAGIC, 25 n_experts, 26 n_experts_used, 27 the expert ff, 28 the shared ff, 29 bit 0 a fused
+// ffn_gate_up_exps; words 21 / 22 the router (F32 ne x d) and the shared gate (F32 d) in the layer blob. The
+// registered 35B pack (experts.idx at task word 50, no MoE words) keeps its own arm (m24_pass_arm), unchanged.
+//
+// The routed experts never enter the heap. mx_pool maps LLB_GGUF read-only and takes one of two modes:
+// - resident: each expert tensor is cut into chunks of epc experts, each chunk a no-copy MTLBuffer over the mapped
+//   file no longer than the device's largest buffer (LLB_MX_SPLIT=N forces N experts a chunk); the kernels reach a
+//   chunk through the pointer table (gpuAddress) and the encoder declares the layer's chunks (useResources);
+// - streamed, when the experts do not fit the GPU's working set with the heap (or LLB_MX_STREAM=1): per layer the
+//   command buffer is committed after the routing, the host reads the k chosen ids and copies only those experts'
+//   bytes from the map into a staging buffer (k experts a tensor), and the layer goes on from there. The file's
+//   pages of the other experts are never touched.
+// Both modes run the same kernels on the same bytes: streamed and resident give the same bits.
+#define MX_MAGIC 0x3147584Du
+#define MX_F32  0u
+#define MX_F16  1u
+#define MX_BF16 2u
+#define MX_Q8   3u
+#define MX_Q8R  4u
+#define MX_Q4K  5u
+#define MX_Q5K  6u
+#define MX_Q6K  7u
+static id<MTLComputePipelineState> gpu_mx_rdot, gpu_mx_route, gpu_mx_gu, gpu_mx_dn;
+// per layer and routed tensor (gate or gate_up, up, down): the GGUF offset, expert stride, row bytes, format, the
+// offset inside an expert (the fused up rows), the first pointer-table entry and experts a chunk
+typedef struct {
+  u64 src, es, wo;
+  u32 rb, f, t, epc;
+} MxTen;
+static MxTen*        mx_ten;
+static id<MTLBuffer> mx_tab, mx_scr, mx_stage[3];
+static NSMutableArray<id<MTLBuffer>>* mx_chunks;
+static u32*  mx_lch;      // layer i's chunks are mx_chunks[mx_lch[i] .. mx_lch[i + 1])
+static u32   mx_nl, mx_mut, mx_ne, mx_k, mx_ef;
+static bool  mx_stream, mx_fused;
+static u8*   mx_map;
+static u64   mx_maplen, mx_scrn;
+static char  mx_path[1024];
+
+typedef struct {
+  u64 x, out;
+  u64 s[3];
+  u64 wr, wrs;
+  u64 es[3], wo[3];
+  u64 lg, rt, xs, act;
+  u32 t[3], epc[3];
+  u32 f[3], fs[3];
+  u32 rb[3], rbs[3];
+  u32 d, eff, sff, ne, k, mut, mode, pad;
+} MxArgs;
+
+int llb_gg_moe_pool(const char *path, int nl, uint64_t *src, uint32_t *ty, uint64_t *bytes, uint64_t *shp,
+                    int *fused, char *err);
+
+// the table row's MoE words, or false (a dense / legacy table). tw: layer 0's row
+static bool mx_words(const u32* tw, u32* ne, u32* k, u32* ef, u32* sf, u32* fu) {
+  if (tw == NULL || tw[24] != MX_MAGIC) {
+    return false;
+  }
+  *ne = tw[25]; *k = tw[26]; *ef = tw[27]; *sf = tw[28]; *fu = tw[29] & 1;
+  return true;
+}
+
+// the MoE words checked, the Shape given the shared ff (the engine's rd word, checked by the caller); x1 / h2 / the FFN out
+// (3 d floats) placed in M9_BLK past both places the next layer's rmsnorm writes (m28_ndst), so the final addrms
+// never reads what it writes. Everything else of the MoE lives in its own buffer, sized from these words
+static bool mx_shape(M9Rows* R, u32 ne, u32 k, u32 ef, u32 sf, u32 fu) {
+  const char* why = NULL;
+  u32 lk = R->lkh * 128, lv = R->lvh * 128, cv = 2 * lk + lv, end = 4 * lv + 4 * R->lvh + cv;
+  u64 nl = end > 39040 ? end : 39040, nf = 2ull * R->nh * 256;
+  u64 b = (nl + R->d > nf + R->d ? nl + R->d : nf + R->d);
+  b = (b + 63) & ~63ull;
+  if (ne == 0) {
+    why = "n_experts (at least 1)";
+  } else if (k == 0 || k > ne) {
+    why = "n_experts_used (1 .. n_experts)";
+  } else if (ef == 0 || ef % 32 != 0) {
+    why = "expert_feed_forward_length (a multiple of 32: whole blocks a row)";
+  } else if (sf == 0 || sf % 32 != 0) {
+    why = "expert_shared_feed_forward_length (a multiple of 32)";
+  } else if (b + 3ull * R->d > 81920) {
+    why = "d_model (x1, h2 and the FFN output in M9_BLK)";
+  }
+  if (why != NULL) {
+    fprintf(stderr, "warp pass: unsupported qwen35moe shape d %u experts %u top %u expert ff %u shared ff %u: %s\n",
+      R->d, ne, k, ef, sf, why);
+    return false;
+  }
+  R->gen = true;
+  R->f = sf;
+  R->mxe = ne; R->mxk = k; R->mxf = ef; R->mxfl = fu; R->mxb = (u32)b;
+  return true;
+}
+
+// a ggml type id as an MX format and its block (elements, bytes); false if the kernels do not read it
+static bool mx_fmt(u32 ty, u32* f, u32* el, u32* bb) {
+  switch (ty) {
+    case 0: *f = MX_F32; *el = 1; *bb = 4; return true;
+    case 1: *f = MX_F16; *el = 1; *bb = 2; return true;
+    case 30: *f = MX_BF16; *el = 1; *bb = 2; return true;
+    case 8: *f = MX_Q8; *el = 32; *bb = 34; return true;
+    case 12: *f = MX_Q4K; *el = 256; *bb = 144; return true;
+    case 13: *f = MX_Q5K; *el = 256; *bb = 176; return true;
+    case 14: *f = MX_Q6K; *el = 256; *bb = 210; return true;
+  }
+  return false;
+}
+
+// a heap tensor's table format (LLB_FM_*) as an MX format (the heap's Q8_0 is row-split)
+static u32 mx_hfmt(u32 fm) {
+  return fm == LLB_FM_Q8_0 ? MX_Q8R : fm == LLB_FM_Q4_K ? MX_Q4K : fm == LLB_FM_Q5_K ? MX_Q5K
+    : fm == LLB_FM_Q6_K ? MX_Q6K : MX_F32;
+}
+
+static FILE* mx_dumpf;
+static void mx_close(void) {
+  if (mx_dumpf != NULL) {
+    fclose(mx_dumpf);
+  }
+  mx_dumpf = NULL;
+  mx_chunks = nil;
+  mx_tab = nil; mx_scr = nil;
+  mx_stage[0] = nil; mx_stage[1] = nil; mx_stage[2] = nil;
+  free(mx_ten);
+  free(mx_lch);
+  mx_ten = NULL;
+  mx_lch = NULL;
+  if (mx_map != NULL) {
+    munmap(mx_map, mx_maplen);
+  }
+  mx_map = NULL;
+  mx_maplen = 0;
+  mx_nl = 0;
+  mx_scrn = 0;
+  mx_path[0] = 0;
+  gpu_mx_rdot = nil; gpu_mx_route = nil; gpu_mx_gu = nil; gpu_mx_dn = nil;
+}
+
+static u64 mx_envu(const char* k) {
+  const char* v = getenv(k);
+  return v != NULL && *v != 0 ? strtoull(v, NULL, 10) : 0;
+}
+
+// the expert pool for layers 0 .. nl - 1 (once a model): every routed tensor checked (format, shape [ne][rows]
+// [cols], whole blocks a row), then the resident chunks or the streamed staging (above)
+static void mx_pool(const M9Rows* R) {
+  const char* path = getenv("LLB_GGUF");
+  if (mx_nl == R->nl && path != NULL && strcmp(path, mx_path) == 0) {
+    return;
+  }
+  if (path == NULL || *path == 0 || strlen(path) >= sizeof mx_path) {
+    err_fail("qwen35moe: the general MoE path maps its experts from LLB_GGUF (unset)");
+  }
+  mx_close();
+  gpu_mx_rdot  = warp_pipe("llb_mx_rdot");
+  gpu_mx_route = warp_pipe("llb_mx_route");
+  gpu_mx_gu    = warp_pipe("llb_mx_gu");
+  gpu_mx_dn    = warp_pipe("llb_mx_dn");
+  if (gpu_mx_rdot.maxTotalThreadsPerThreadgroup < 128 || gpu_mx_route.maxTotalThreadsPerThreadgroup < 1024
+    || gpu_mx_gu.maxTotalThreadsPerThreadgroup < 256 || gpu_mx_dn.maxTotalThreadsPerThreadgroup < 256) {
+    err_fail("qwen35moe: a MoE kernel's threadgroup does not fit");
+  }
+  const char* mt = getenv("LLB_MX_MUT");
+  mx_mut = mt != NULL && strcmp(mt, "no_renorm") == 0 ? 1u : 0u;
+  if (mt != NULL && *mt != 0 && mx_mut == 0) {
+    err_fail("LLB_MX_MUT: unknown mutant (no_renorm)");
+  }
+  if (mx_mut != 0) {
+    fprintf(stderr, "mx: MUTANT %s\n", mt);
+  }
+  u32 nl = R->nl;
+  u64* src = calloc((size_t)nl * 3, 8);
+  u64* by  = calloc((size_t)nl * 3, 8);
+  u64* sh  = calloc((size_t)nl * 9, 8);
+  u32* ty  = calloc((size_t)nl * 3, 4);
+  int* fu  = calloc((size_t)nl, sizeof(int));
+  mx_ten = calloc((size_t)nl * 3, sizeof *mx_ten);
+  mx_lch = calloc((size_t)nl + 1, sizeof *mx_lch);
+  char err[256] = "";
+  if (src == NULL || by == NULL || sh == NULL || ty == NULL || fu == NULL || mx_ten == NULL || mx_lch == NULL) {
+    err_fail("qwen35moe: out of memory (expert pool)");
+  }
+  if (llb_gg_moe_pool(path, (int)nl, src, ty, by, sh, fu, err) != 0) {
+    fprintf(stderr, "qwen35moe: %s\n", err);
+    err_fail("qwen35moe: the GGUF's routed experts are refused");
+  }
+  static const char* nm[3] = { "gate", "up", "down" };
+  u64 tot = 0, maxes[3] = { 0, 0, 0 };
+  for (u32 i = 0; i < nl; i += 1) {
+    for (u32 r = 0; r < 3; r += 1) {
+      bool fz = fu[i] != 0 && r == 1;
+      u32 tj = fz ? i * 3 : i * 3 + r;
+      u32 f, el, bb;
+      u64 cols = sh[tj * 3], rows = sh[tj * 3 + 1], ne = sh[tj * 3 + 2];
+      u64 wr = r == 2 ? R->d : fu[i] != 0 ? 2ull * R->mxf : R->mxf, wc = r == 2 ? R->mxf : R->d;
+      if (!mx_fmt(ty[tj], &f, &el, &bb)) {
+        fprintf(stderr, "qwen35moe: layer %u expert %s: ggml type %u (the general MoE path reads F32 F16 BF16 Q8_0"
+          " Q4_K Q5_K Q6_K)\n", i, fz ? "gate_up" : nm[r], ty[tj]);
+        err_fail("qwen35moe: an expert format is refused");
+      }
+      if (ne != R->mxe || rows != wr || cols != wc || cols % el != 0 || cols % 32 != 0 || by[tj] % ne != 0
+        || by[tj] / ne != rows * (cols / el * bb)) {
+        fprintf(stderr, "qwen35moe: layer %u expert %s: shape [%llu][%llu][%llu], want [%u][%llu][%llu] (whole"
+          " %u-element blocks a row)\n", i, nm[r], (unsigned long long)ne, (unsigned long long)rows,
+          (unsigned long long)cols, R->mxe, (unsigned long long)wr, (unsigned long long)wc, el);
+        err_fail("qwen35moe: an expert tensor's shape is refused");
+      }
+      MxTen* T = &mx_ten[i * 3 + r];
+      T->src = src[tj];
+      T->es = by[tj] / ne;
+      T->rb = (u32)(cols / el * bb);
+      T->f = f;
+      T->wo = fz ? (u64)R->mxf * T->rb : 0;
+      tot += fz ? 0 : by[tj];
+      maxes[r] = T->es > maxes[r] ? T->es : maxes[r];
+    }
+  }
+  int fd = open(path, O_RDONLY);
+  struct stat st;
+  if (fd < 0 || fstat(fd, &st) != 0) {
+    err_fail("qwen35moe: cannot open LLB_GGUF");
+  }
+  u64 pg = 16384, flen = ((u64)st.st_size + pg - 1) & ~(pg - 1);
+  u8* F = mmap(NULL, flen, PROT_READ, MAP_SHARED, fd, 0);
+  close(fd);
+  if (F == MAP_FAILED) {
+    err_fail("qwen35moe: cannot map LLB_GGUF");
+  }
+  mx_map = F;
+  mx_maplen = flen;
+  mx_ne = R->mxe; mx_k = R->mxk; mx_ef = R->mxf; mx_fused = fu[0] != 0;
+  // the mode: streamed when the experts and the heap do not fit the working set together, or when asked
+  u64 ws = (u64)[gpu_dev recommendedMaxWorkingSetSize], heap = gpu_buf != nil ? (u64)[gpu_buf length] : 0;
+  u64 lim = (u64)[gpu_dev maxBufferLength], split = mx_envu("LLB_MX_SPLIT");
+  mx_stream = mx_envu("LLB_MX_STREAM") != 0 || tot + heap > ws;
+  // the MoE scratch: logits ne + 1 (rounded), the route 3 k + 1 (ids, weights, gs, the streamed ids), the shared act, the routed act or the
+  // probabilities (whichever is longer)
+  u64 lg = 0, rt = ((u64)R->mxe + 1 + 63) & ~63ull, xs = rt + ((3ull * R->mxk + 1 + 63) & ~63ull);
+  u64 act = xs + (((u64)R->f + 63) & ~63ull), an = (u64)R->mxk * R->mxf > R->mxe ? (u64)R->mxk * R->mxf : R->mxe;
+  (void)lg;
+  mx_scrn = act + an;
+  mx_scr = [gpu_dev newBufferWithLength:mx_scrn * 4 options:MTLResourceStorageModeShared];
+  if (mx_scr == nil) {
+    err_fail("qwen35moe: cannot allocate the MoE scratch");
+  }
+  mx_chunks = [NSMutableArray array];
+  u32 ntab = 0;
+  struct timespec t0, t1;
+  clock_gettime(CLOCK_MONOTONIC, &t0);
+  if (mx_stream) {
+    // staging: k experts a tensor; the table's three entries point at them (epc = k: the slot is the expert)
+    for (u32 r = 0; r < 3; r += 1) {
+      if (r == 1 && mx_fused) {
+        continue;
+      }
+      if (maxes[r] * R->mxk > lim) {
+        err_fail("qwen35moe: k experts of one tensor exceed the device's largest buffer (streamed mode)");
+      }
+      mx_stage[r] = [gpu_dev newBufferWithLength:maxes[r] * R->mxk options:MTLResourceStorageModeShared];
+      if (mx_stage[r] == nil) {
+        err_fail("qwen35moe: cannot allocate the expert staging");
+      }
+    }
+    mx_tab = [gpu_dev newBufferWithLength:3 * 8 options:MTLResourceStorageModeShared];
+    u64* tb = (u64*)[mx_tab contents];
+    for (u32 r = 0; r < 3; r += 1) {
+      tb[r] = (u64)[mx_stage[r == 1 && mx_fused ? 0 : r] gpuAddress];
+    }
+    for (u32 i = 0; i < nl; i += 1) {
+      for (u32 r = 0; r < 3; r += 1) {
+        mx_ten[i * 3 + r].t = r;
+        mx_ten[i * 3 + r].epc = R->mxk;
+      }
+      mx_lch[i + 1] = 0;
+    }
+    ntab = 3;
+  } else {
+    // resident: chunks of epc experts, each window (page-aligned) within the largest buffer
+    u64 cap = 1;
+    for (u32 i = 0; i < nl; i += 1) {
+      for (u32 r = 0; r < 3; r += 1) {
+        const MxTen* T = &mx_ten[i * 3 + r];
+        u64 e = (lim - 2 * pg) / T->es;
+        if (e == 0) {
+          err_fail("qwen35moe: one expert exceeds the device's largest buffer");
+        }
+        if (split != 0 && split < e) {
+          e = split;
+        }
+        cap += (R->mxe + e - 1) / e;
+      }
+    }
+    mx_tab = [gpu_dev newBufferWithLength:cap * 8 options:MTLResourceStorageModeShared];
+    u64* tb = (u64*)[mx_tab contents];
+    for (u32 i = 0; i < nl; i += 1) {
+      mx_lch[i] = (u32)[mx_chunks count];
+      for (u32 r = 0; r < 3; r += 1) {
+        MxTen* T = &mx_ten[i * 3 + r];
+        if (r == 1 && fu[i] != 0) {
+          T->t = mx_ten[i * 3].t;
+          T->epc = mx_ten[i * 3].epc;
+          continue;
+        }
+        u64 e = (lim - 2 * pg) / T->es;
+        if (split != 0 && split < e) {
+          e = split;
+        }
+        T->epc = (u32)(e < R->mxe ? e : R->mxe);
+        T->t = ntab;
+        for (u64 c = 0; c < R->mxe; c += T->epc) {
+          u64 n = R->mxe - c < T->epc ? R->mxe - c : T->epc;
+          u64 a = T->src + c * T->es, lo = a & ~(pg - 1), hi = (a + n * T->es + pg - 1) & ~(pg - 1);
+          if (hi > flen) {
+            err_fail("qwen35moe: an expert chunk lies past the GGUF's end");
+          }
+          madvise(F + lo, hi - lo, MADV_WILLNEED);
+          id<MTLBuffer> b = [gpu_dev newBufferWithBytesNoCopy:F + lo length:hi - lo
+            options:MTLResourceStorageModeShared | MTLResourceHazardTrackingModeUntracked deallocator:nil];
+          if (b == nil) {
+            err_fail("qwen35moe: cannot wrap an expert chunk in a buffer");
+          }
+          [mx_chunks addObject:b];
+          tb[ntab++] = (u64)[b gpuAddress] + (a - lo);
+        }
+      }
+    }
+    mx_lch[nl] = (u32)[mx_chunks count];
+    // the pages once, up front (the load time); skipped under LLB_MX_NOTOUCH
+    if (mx_envu("LLB_MX_NOTOUCH") == 0) {
+      volatile u64 sink = 0;
+      for (u32 i = 0; i < nl; i += 1) {
+        for (u32 r = 0; r < 3; r += 1) {
+          const MxTen* T = &mx_ten[i * 3 + r];
+          if (r == 1 && fu[i] != 0) {
+            continue;
+          }
+          for (u64 q = T->src & ~(pg - 1); q < T->src + (u64)R->mxe * T->es; q += pg) {
+            sink += F[q];
+          }
+        }
+      }
+      (void)sink;
+    }
+  }
+  clock_gettime(CLOCK_MONOTONIC, &t1);
+  f64 s = (f64)(t1.tv_sec - t0.tv_sec) + (f64)(t1.tv_nsec - t0.tv_nsec) * 1e-9;
+  fprintf(stderr, "mx pool: %u layers, %u experts top %u, expert ff %u (%s), %llu bytes of experts mapped from %s;"
+    " %s (%u chunk buffers, %u experts a chunk in layer 0's gate; working set %.1f GiB, heap %.1f GiB), %.2f s\n",
+    nl, R->mxe, R->mxk, R->mxf, mx_fused ? "fused gate_up" : "gate, up", (unsigned long long)tot, path,
+    mx_stream ? "streamed: the chosen experts copied each token" : "resident", (u32)[mx_chunks count],
+    mx_ten[0].epc, (f64)ws / (1ull << 30), (f64)heap / (1ull << 30), s);
+  free(src); free(by); free(sh); free(ty); free(fu);
+  mx_nl = nl;
+  snprintf(mx_path, sizeof mx_path, "%s", path);
+}
+
+static void mx_go(id<MTLComputeCommandEncoder> en, id<MTLComputePipelineState> p, const MxArgs* A,
+  u32 gx, u32 gy, u32 threads) {
+  [en setBuffer:gpu_scr offset:0 atIndex:1];
+  [en setBuffer:mx_tab offset:0 atIndex:3];
+  [en setBuffer:mx_scr offset:0 atIndex:4];
+  [en setComputePipelineState:p];
+  [en setBytes:A length:sizeof *A atIndex:2];
+  [en dispatchThreadgroups:MTLSizeMake(gx, gy, 1) threadsPerThreadgroup:MTLSizeMake(threads, 1, 1)];
+  m28_bar(en);
+}
+
+// end and run the command buffer so far; a new one goes on (m30_cb / m30_en, as m30_split leaves them)
+static id<MTLComputeCommandEncoder> mx_cut(void) {
+  [m30_en endEncoding];
+  [m30_cb commit];
+  [m30_cb waitUntilCompleted];
+  if ([m30_cb error]) {
+    gpu_fail([m30_cb error]);
+  }
+  m30_cb = [gpu_que commandBuffer];
+  m30_en = [m30_cb computeCommandEncoderWithDispatchType:MTLDispatchTypeConcurrent];
+  [m30_en setBuffer:gpu_buf offset:0 atIndex:0];
+  [m30_en setBuffer:gpu_att offset:0 atIndex:1];
+  [m30_en setBuffer:gpu_buf offset:0 atIndex:3];
+  return m30_en;
+}
+
+// (diagnostic) LLB_MX_DUMP=FILE: after every MoE layer the command buffer is cut and the layer's record appended:
+// u32 layer, d, k; f32 h2[d] (the FFN input), out[d] (the FFN output before the residual); u32 ids[k]; f32 w[k], gs.
+// reports/metal-moe's mx_ref.py recomputes each record from the GGUF in float64 (the MoE FFN's own oracle)
+static void mx_dump(u32 i, const M9Rows* R, u64 h2b, u64 ffo, u64 rt) {
+  if (mx_dumpf == NULL) {
+    mx_dumpf = fopen(getenv("LLB_MX_DUMP"), "ab");
+    if (mx_dumpf == NULL) {
+      err_fail("LLB_MX_DUMP: cannot open the file");
+    }
+  }
+  u32 hd[3] = { i, R->d, R->mxk };
+  const u8* S = (const u8*)[gpu_scr contents];
+  const u8* W = (const u8*)[mx_scr contents];
+  fwrite(hd, 4, 3, mx_dumpf);
+  fwrite(S + (h2b & ~SA_SCR), 4, R->d, mx_dumpf);
+  fwrite(S + (ffo & ~SA_SCR), 4, R->d, mx_dumpf);
+  fwrite(W + rt * 4, 4, 2 * R->mxk + 1, mx_dumpf);
+  fflush(mx_dumpf);
+}
+
+// streamed mode: end and run the command buffer so far (through the routing), then copy the k chosen experts of
+// layer i into the staging and point the route's ids at the staging slots; a new command buffer goes on
+static id<MTLComputeCommandEncoder> mx_sync(u32 i, u64 rt) {
+  id<MTLComputeCommandEncoder> en = mx_cut();
+  u32* ids = (u32*)((u8*)[mx_scr contents] + rt * 4);
+  for (u32 s = 0; s < mx_k; s += 1) {
+    if (ids[s] >= mx_ne) {
+      err_fail("qwen35moe: the routing chose no expert (non-finite logits?)");
+    }
+    for (u32 r = 0; r < 3; r += 1) {
+      const MxTen* T = &mx_ten[i * 3 + r];
+      if (r == 1 && mx_fused) {
+        continue;
+      }
+      memcpy((u8*)[mx_stage[r] contents] + (u64)s * T->es, mx_map + T->src + (u64)ids[s] * T->es, T->es);
+    }
+  }
+  // the kernels address the staging by slot; the chosen ids are kept past the weights (W[rt + 2k + 1 ..]) for a dump
+  for (u32 s = 0; s < mx_k; s += 1) {
+    ids[2 * mx_k + 1 + s] = ids[s];
+    ids[s] = s;
+  }
+  return en;
+}
+
+// layer i's MoE FFN (the place of m9_fbn_run): x1 = x + a and h2 = rms(x1) post in one addrms; the router and the
+// shared gate; the routing; the routed and the shared gate / up / SiLU; down + combine; y = x1 + ffn_out (with the
+// next rmsnorm when nw, as m9_fbn_run's lever 6). b: the layer blob, p: its Offs words, row: its table row. Returns
+// the encoder to go on with (a new one after a streamed layer's sync)
+static id<MTLComputeCommandEncoder> mx_ffn_run(id<MTLComputeCommandEncoder> en, u64 b, const u32* p, const u32* row,
+  const M9Rows* R, u32 i, u64 x, u64 at, u64 y, u64 nw, u64 nh) {
+  const u32 dm = R->d, ne = R->mxe, k = R->mxk, ef = R->mxf, sf = R->f;
+  const u64 x1b = M9_BLK + (u64)R->mxb * 4, h2b = x1b + dm * 4, ffo = h2b + dm * 4;
+  HybArgs HA;
+  m9_args(&HA, x, at, h2b, x1b, b + p[1], 0, 0, dm, 0, 0, 0.0f);
+  m9_go(en, gpu_m_addrms, &HA, 1, 1024);
+  MxArgs A;
+  memset(&A, 0, sizeof A);
+  A.x = h2b; A.out = ffo;
+  A.lg = 0; A.rt = ((u64)ne + 1 + 63) & ~63ull; A.xs = A.rt + ((3ull * k + 1 + 63) & ~63ull);
+  A.act = A.xs + (((u64)sf + 63) & ~63ull);
+  A.wr = b + (row[21] & 0x0fffffffu); A.wrs = b + (row[22] & 0x0fffffffu);
+  for (u32 r = 0; r < 3; r += 1) {
+    const MxTen* T = &mx_ten[i * 3 + r];
+    A.es[r] = T->es; A.wo[r] = T->wo; A.t[r] = T->t; A.epc[r] = T->epc; A.f[r] = T->f; A.rb[r] = T->rb;
+    A.s[r] = b + p[2 + r]; A.fs[r] = mx_hfmt(R->fm[2 + r]); A.rbs[r] = R->rb[2 + r];
+  }
+  A.d = dm; A.eff = ef; A.sff = sf; A.ne = ne; A.k = k; A.mut = mx_mut;
+  mx_go(en, gpu_mx_rdot, &A, (ne + 1 + 3) / 4, 1, 128);
+  mx_go(en, gpu_mx_route, &A, 1, 1, 1024);
+  if (mx_stream) {
+    if (en != m30_en) {
+      err_fail("qwen35moe: the streamed experts need the serve's own encoder");
+    }
+    en = mx_sync(i, A.rt);
+    [en useResource:mx_stage[0] usage:MTLResourceUsageRead];
+    if (mx_stage[1] != nil) {
+      [en useResource:mx_stage[1] usage:MTLResourceUsageRead];
+    }
+    [en useResource:mx_stage[2] usage:MTLResourceUsageRead];
+  } else {
+    u32 c0 = mx_lch[i], c1 = mx_lch[i + 1];
+    for (u32 c = c0; c < c1; c += 1) {
+      [en useResource:mx_chunks[c] usage:MTLResourceUsageRead];
+    }
+  }
+  A.mode = 0;
+  mx_go(en, gpu_mx_gu, &A, (ef + 7) / 8, k, 256);
+  A.mode = 1;
+  mx_go(en, gpu_mx_gu, &A, (sf + 7) / 8, 1, 256);
+  A.pad = (u64)k * ef + sf <= 8192 ? 1u : 0u;
+  mx_go(en, gpu_mx_dn, &A, (dm + 7) / 8, 1, 256);
+  [en setBuffer:gpu_buf offset:0 atIndex:3];
+  if (getenv("LLB_MX_DUMP") != NULL) {
+    if (en != m30_en) {
+      err_fail("LLB_MX_DUMP: needs the serve's own encoder");
+    }
+    en = mx_cut();
+    if (mx_stream) {
