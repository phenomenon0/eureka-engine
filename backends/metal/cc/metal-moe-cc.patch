+// ---- (METAL-MOE) the general MoE FFN (any qwen35moe shape) --------------------------------------------------------
+// llama.cpp's (and the WebGPU trunk's) arithmetic order: router = ffn_gate_inp . x; softmax over every expert;
+// top-k (ties to the lowest id); the k weights renormalized (sum clamped at 2^-14); expert e's output =
+// down_e(silu(gate_e . x) * (up_e . x)); moe = w_0 y_0 + w_1 y_1 + .. in rank order; the shared expert the same
+// SwiGLU on ffn_*_shexp, times sigmoid(ffn_gate_inp_shexp . x), added last. The routed experts are the GGUF's own
+// bytes, reached through a pointer table (buffer 3: one entry a chunk of epc experts of a tensor, each chunk its own
+// no-copy buffer over the mapped file, or the staging buffer the host copies the chosen experts into); the shared
+// expert and the router are the heap's (its Q8_0 row-split). The MoE scratch W (buffer 4) is sized from the model:
+// logits [ne + 1], the route [ids k | weights k | gs], the shared act [sff], the routed act [k][eff].
+// A row dot: one simdgroup, lane l takes the 32-column chunks l, l + 32, ..; each chunk dequantized in place (the
+// GGUF block layouts), the lanes joined by simd_sum. The numerics-changing class (reports/metal-moe).
+#define MX_F32  0u
+#define MX_F16  1u
+#define MX_BF16 2u
+#define MX_Q8   3u
+#define MX_Q8R  4u
+#define MX_Q4K  5u
+#define MX_Q5K  6u
+#define MX_Q6K  7u
+
+struct MxPtr {
+  device const u8* p;
+};
+
+struct MxArgs {
+  u64 x, out;              // serve addresses: the FFN input h2, the FFN output
+  u64 s[3];                // shared gate / up / down (serve addresses)
+  u64 wr, wrs;             // router [ne][d] and shared gate [d] (F32, serve addresses)
+  u64 es[3], wo[3];        // routed: expert stride (bytes), offset inside an expert (the fused tensor's up rows)
+  u64 lg, rt, xs, act;     // W offsets (floats)
+  u32 t[3], epc[3];        // routed: the tensor's first pointer-table entry, experts a chunk
+  u32 f[3], fs[3];         // formats (MX_*)
+  u32 rb[3], rbs[3];       // row bytes
+  u32 d, eff, sff, ne, k, mut, mode, pad;   // pad: llb_mx_dn's staging flag
+};
+
+INLINE float mx_hf(device const u8* p) {
+  return (float)as_type<half>((ushort)((ushort)p[0] | ((ushort)p[1] << 8)));
+}
+
+// K-quant scale and min j of a superblock's 12 packed bytes (ggml's get_scale_min_k4)
+INLINE void mx_sm(device const u8* q, u32 j, thread float* sc, thread float* mn) {
+  if (j < 4) {
+    *sc = (float)(q[j] & 63);
+    *mn = (float)(q[j + 4] & 63);
+  } else {
+    *sc = (float)((q[j + 4] & 15) | ((q[j - 4] >> 6) << 4));
+    *mn = (float)((q[j + 4] >> 4) | ((q[j] >> 6) << 4));
+  }
+}
+
+// the sum over chunk c (columns 32 c .. 32 c + 31) of a row r of cols columns in format f, times x (x in device or
+// threadgroup memory: XP)
+template <typename XP>
+INLINE float mx_chunk(device const u8* r, u32 f, u32 cols, u32 c, XP x) {
+  float a = 0.0f;
+  if (f == MX_F32) {
+    device const float* w = (device const float*)r + 32 * c;
+    for (u32 i = 0; i < 32; i += 1) {
+      a += w[i] * x[i];
+    }
+    return a;
+  }
+  if (f == MX_F16) {
+    device const half* w = (device const half*)r + 32 * c;
+    for (u32 i = 0; i < 32; i += 1) {
+      a += (float)w[i] * x[i];
+    }
+    return a;
+  }
+  if (f == MX_BF16) {
+    device const ushort* w = (device const ushort*)r + 32 * c;
+    for (u32 i = 0; i < 32; i += 1) {
+      a += as_type<float>((uint)w[i] << 16) * x[i];
+    }
+    return a;
+  }
+  if (f == MX_Q8 || f == MX_Q8R) {
+    device const u8* q = f == MX_Q8 ? r + 34 * c + 2 : r + 32 * c;
+    const float d = mx_hf(f == MX_Q8 ? r + 34 * c : r + cols + 2 * c);
+    for (u32 i = 0; i < 32; i += 1) {
+      a += (float)(char)q[i] * x[i];
+    }
+    return a * d;
+  }
+  const u32 j = c & 7;
+  if (f == MX_Q4K || f == MX_Q5K) {
+    device const u8* b = r + (u64)(c >> 3) * (f == MX_Q4K ? 144 : 176);
+    float sc, mn, sq = 0.0f, sx = 0.0f;
+    mx_sm(b + 4, j, &sc, &mn);
+    const u32 g = j >> 1, hi = j & 1;
+    device const u8* q = b + (f == MX_Q4K ? 16 : 48) + 32 * g;
+    device const u8* qh = b + 16;
+    const u32 bit = 1u << (2 * g + hi);
+    for (u32 i = 0; i < 32; i += 1) {
+      u32 v = hi ? q[i] >> 4 : q[i] & 15;
+      if (f == MX_Q5K && (qh[i] & bit) != 0) {
+        v += 16;
+      }
+      sq += (float)v * x[i];
+      sx += x[i];
+    }
+    return mx_hf(b) * sc * sq - mx_hf(b + 2) * mn * sx;
+  }
+  // Q6_K: ql[128] qh[64] scales[16] d; chunk j: half n = j / 4, quarter cc = j % 4 (ggml's dequantize_row_q6_K)
+  device const u8* b = r + (u64)(c >> 3) * 210;
+  const u32 n = j >> 2, cc = j & 3;
+  device const u8* ql = b + 64 * n + (cc & 1) * 32;
+  device const u8* qh = b + 128 + 32 * n;
+  device const u8* sc = b + 192 + 8 * n + 2 * cc;
+  const u32 sh = 2 * cc;
+  float s0 = 0.0f, s1 = 0.0f;
+  for (u32 i = 0; i < 32; i += 1) {
+    const u32 lo = cc < 2 ? ql[i] & 15 : ql[i] >> 4;
+    const int v = (int)(lo | (((qh[i] >> sh) & 3) << 4)) - 32;
+    if (i < 16) {
+      s0 += (float)v * x[i];
+    } else {
+      s1 += (float)v * x[i];
+    }
+  }
+  return mx_hf(b + 208) * ((float)(char)sc[0] * s0 + (float)(char)sc[1] * s1);
+}
+
+template <typename XP>
+INLINE float mx_dot(device const u8* r, u32 f, u32 cols, XP x, u32 l) {
+  float a = 0.0f;
+  for (u32 c = l; c < cols / 32; c += 32) {
+    a += mx_chunk(r, f, cols, c, x + 32 * c);
+  }
+  return simd_sum(a);
+}
+
+INLINE device const u8* mx_sa(device u8* C, device u8* S, u64 a) {
+  return (device const u8*)sa_f(C, S, a);
+}
+
+// routed tensor r's row of expert e: its chunk's pointer, the expert inside the chunk, the row
+INLINE device const u8* mx_row(device const MxPtr* T, constant MxArgs& A, u32 r, u64 e, u32 row) {
+  const u32 epc = A.epc[r];
+  return T[A.t[r] + (u32)(e / epc)].p + (e % epc) * A.es[r] + A.wo[r] + (u64)row * A.rb[r];
+}
+
+// 1. the router's ne rows and the shared gate (row ne): lg[row] = w_row . x (F32), 4 rows a group of 128
+kernel void llb_mx_rdot(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant MxArgs& A [[buffer(2)]], device float* W [[buffer(4)]], uint g [[threadgroup_position_in_grid]],
+  ushort sg [[simdgroup_index_in_threadgroup]], ushort l [[thread_index_in_simdgroup]]) {
+  const u32 row = g * 4 + sg;
+  if (row > A.ne) {
+    return;
+  }
+  device const u8* w = row < A.ne ? mx_sa(C, S, A.wr) + (u64)row * A.d * 4 : mx_sa(C, S, A.wrs);
+  const float v = mx_dot(w, MX_F32, A.d, (device const float*)sa_f(C, S, A.x), l);
+  if (l == 0) {
+    W[A.lg + row] = v;
+  }
+}
+
+// 2. the routing: one group of 1024, thread i holding experts i, i + 1024, ..: softmax over the ne logits, k argmax
+// rounds (ties to the lowest id), the k weights renormalized; the shared gate's sigmoid. W[rt ..]: ids[k] (u32),
+// weights[k], gs. The probabilities are kept in W[act ..] (the routed act's space, written only later)
+kernel void llb_mx_route(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant MxArgs& A [[buffer(2)]], device float* W [[buffer(4)]], uint i [[thread_position_in_threadgroup]]) {
+  threadgroup float red[1024];
+  threadgroup uint ri[1024];
+  device const float* lg = W + A.lg;
+  device float* pv = W + A.act;
+  device uint* ids = (device uint*)(W + A.rt);
+  device float* wt = W + A.rt + A.k;
+  const float ninf = as_type<float>(0xFF800000u);
+  float m = ninf;
+  for (u32 e = i; e < A.ne; e += 1024) {
+    m = max(m, lg[e]);
+  }
+  red[i] = m;
+  for (u32 w = 512; w > 0; w >>= 1) {
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (i < w) {
+      red[i] = max(red[i], red[i + w]);
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  m = red[0];
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  float z = 0.0f;
+  for (u32 e = i; e < A.ne; e += 1024) {
+    const float p = attn_exp(lg[e] - m);
+    pv[e] = p;
+    z += p;
+  }
+  red[i] = z;
+  for (u32 w = 512; w > 0; w >>= 1) {
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (i < w) {
+      red[i] = red[i] + red[i + w];
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  z = red[0];
+  for (u32 e = i; e < A.ne; e += 1024) {
+    pv[e] = pv[e] / z;
+  }
+  for (u32 s = 0; s < A.k; s += 1) {
+    threadgroup_barrier(mem_flags::mem_device);
+    float bv = -1.0f;
+    uint bi = 0xFFFFFFFFu;
+    for (u32 e = i; e < A.ne; e += 1024) {
+      if (pv[e] > bv) {
+        bv = pv[e];
+        bi = e;
+      }
+    }
+    red[i] = bv;
+    ri[i] = bi;
+    for (u32 w = 512; w > 0; w >>= 1) {
+      threadgroup_barrier(mem_flags::mem_threadgroup);
+      if (i < w) {
+        const float b = red[i + w];
+        if (b > red[i] || (b == red[i] && ri[i + w] < ri[i])) {
+          red[i] = b;
+          ri[i] = ri[i + w];
+        }
+      }
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (i == 0) {
+      ids[s] = ri[0];
+      wt[s] = red[0];
+      pv[ri[0]] = -1.0f;
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_device);
+  if (i == 0) {
+    float sum = 0.0f;
+    for (u32 s = 0; s < A.k; s += 1) {
+      sum += wt[s];
+    }
+    sum = max(sum, 6.103515625e-5f);
+    if ((A.mut & 1) == 0) {
+      for (u32 s = 0; s < A.k; s += 1) {
+        wt[s] = wt[s] / sum;
+      }
+    }
+    wt[A.k] = 1.0f / (1.0f + attn_exp(-lg[A.ne]));
+  }
+}
+
+// 3. gate / up / SiLU: act[slot eff + row] = silu(gate . x) * (up . x). mode 0: slot = the grid's y, expert ids[slot]
+// through the pointer table; mode 1: the shared expert (heap tensors) into xs
+kernel void llb_mx_gu(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant MxArgs& A [[buffer(2)]], device const MxPtr* T [[buffer(3)]], device float* W [[buffer(4)]],
+  uint2 g [[threadgroup_position_in_grid]], ushort sg [[simdgroup_index_in_threadgroup]],
+  ushort l [[thread_index_in_simdgroup]], ushort tx [[thread_index_in_threadgroup]]) {
+  // x (d <= 8192 floats: the trunk's own bound) staged once a group of 8 rows
+  threadgroup float x[8192];
+  device const float* xd = sa_f(C, S, A.x);
+  for (u32 j = tx; j < A.d; j += 256) {
+    x[j] = xd[j];
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  const u32 row = g.x * 8 + sg, rows = A.mode == 0 ? A.eff : A.sff;
+  if (row >= rows) {
+    return;
+  }
+  float gv, uv;
+  if (A.mode == 0) {
+    const u64 e = ((device const uint*)(W + A.rt))[g.y];
+    gv = mx_dot(mx_row(T, A, 0, e, row), A.f[0], A.d, (threadgroup const float*)x, l);
+    uv = mx_dot(mx_row(T, A, 1, e, row), A.f[1], A.d, (threadgroup const float*)x, l);
+  } else {
+    gv = mx_dot(mx_sa(C, S, A.s[0]) + (u64)row * A.rbs[0], A.fs[0], A.d, (threadgroup const float*)x, l);
+    uv = mx_dot(mx_sa(C, S, A.s[1]) + (u64)row * A.rbs[1], A.fs[1], A.d, (threadgroup const float*)x, l);
+  }
+  if (l == 0) {
+    W[A.mode == 0 ? A.act + (u64)g.y * A.eff + row : A.xs + row] = (gv / (1.0f + attn_exp(-gv))) * uv;
+  }
+}
+
+// 4. down + combine: out[row] = (w_0 down_0 . act_0 + w_1 down_1 . act_1 + ..) + gs (shared down . xs)
+// A.pad = 1: the routed act and the shared act (k eff + sff <= 8192 floats) staged in threadgroup memory
+kernel void llb_mx_dn(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant MxArgs& A [[buffer(2)]], device const MxPtr* T [[buffer(3)]], device float* W [[buffer(4)]],
+  uint g [[threadgroup_position_in_grid]], ushort sg [[simdgroup_index_in_threadgroup]],
+  ushort l [[thread_index_in_simdgroup]], ushort tx [[thread_index_in_threadgroup]]) {
+  threadgroup float xa[8192];
+  const u32 na = A.k * A.eff;
+  if (A.pad != 0) {
+    for (u32 j = tx; j < na; j += 256) {
+      xa[j] = W[A.act + j];
+    }
+    for (u32 j = tx; j < A.sff; j += 256) {
+      xa[na + j] = W[A.xs + j];
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+  }
+  const u32 row = g * 8 + sg;
+  if (row >= A.d) {
+    return;
+  }
+  device const uint* ids = (device const uint*)(W + A.rt);
+  device const float* wt = W + A.rt + A.k;
+  float acc = 0.0f, sh;
+  for (u32 s = 0; s < A.k; s += 1) {
+    device const u8* r = mx_row(T, A, 2, ids[s], row);
+    const float v = A.pad != 0 ? mx_dot(r, A.f[2], A.eff, (threadgroup const float*)xa + s * A.eff, l)
+      : mx_dot(r, A.f[2], A.eff, (device const float*)W + A.act + (u64)s * A.eff, l);
+    acc += wt[s] * v;
+  }
+  device const u8* rs = mx_sa(C, S, A.s[2]) + (u64)row * A.rbs[2];
+  sh = A.pad != 0 ? mx_dot(rs, A.fs[2], A.sff, (threadgroup const float*)xa + na, l)
+    : mx_dot(rs, A.fs[2], A.sff, (device const float*)W + A.xs, l);
+  if (l == 0) {
+    sa_f(C, S, A.out)[row] = acc + sh * wt[A.k];
+  }
+}
