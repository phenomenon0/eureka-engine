+// 2. the routing of token g (llb_mx_route2's body on the token's block)
+kernel void llb_mx_croute(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant MxArgs& A [[buffer(2)]], uint g [[threadgroup_position_in_grid]],
+  uint i [[thread_position_in_threadgroup]], uint nt [[threads_per_threadgroup]],
+  ushort l [[thread_index_in_simdgroup]], ushort sg [[simdgroup_index_in_threadgroup]]) {
+  threadgroup float pv[4096];
+  threadgroup float red[32];
+  threadgroup float tw[1024];
+  threadgroup uint ti[1024];
+  device float* b = mxc_blk(C, S, A, g);
+  mx2_route(b + A.clg, (device uint*)(b + A.crt), b + A.crt + A.k, A.ne, A.k, A.mut, i, nt, l, sg, pv, red, tw, ti);
+}
+
+// 3. the grouping, one group of 1024: per expert its entries q (in q order), their offsets, and the tiles of <= MXC_TT
+// entries (expert, first position, count); G[cnt ..] counts, G[off ..] offsets, G[nti] the tile count, G[til ..] the
+// tiles, G[lst ..] the entries
+kernel void llb_mx_cgroup(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant MxArgs& A [[buffer(2)]], device u32* G [[buffer(5)]], uint i [[thread_position_in_threadgroup]]) {
+  threadgroup ushort ib[8192];
+  const u32 nq = A.cnt * A.k;
+  for (u32 q = i; q < nq; q += 1024) {
+    ib[q] = (ushort)((device const uint*)(mxc_blk(C, S, A, q / A.k) + A.crt))[q % A.k];
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  for (u32 e = i; e < A.ne; e += 1024) {
+    u32 c = 0;
+    for (u32 q = 0; q < nq; q++) {
+      c += ib[q] == e ? 1u : 0u;
+    }
+    G[A.cgc + e] = c;
+  }
+  threadgroup_barrier(mem_flags::mem_device);
+  if (i == 0) {
+    u32 o = 0, t = 0;
+    for (u32 e = 0; e < A.ne; e++) {
+      const u32 c = G[A.cgc + e];
+      G[A.cgo + e] = o;
+      G[A.cgt + e] = t;
+      o += c;
+      t += (c + MXC_TT - 1) / MXC_TT;
+    }
+    G[A.cgn] = t;
+  }
+  threadgroup_barrier(mem_flags::mem_device);
+  for (u32 e = i; e < A.ne; e += 1024) {
+    const u32 c = G[A.cgc + e], o = G[A.cgo + e], t0 = G[A.cgt + e];
+    u32 p = o;
+    for (u32 q = 0; q < nq && p < o + c; q++) {
+      if (ib[q] == e) {
+        G[A.cgl + p] = q;
+        p += 1;
+      }
+    }
+    for (u32 j = 0; MXC_TT * j < c; j++) {
+      device u32* tl = G + A.cgi + 3 * (t0 + j);
+      tl[0] = e;
+      tl[1] = o + MXC_TT * j;
+      tl[2] = c - MXC_TT * j < MXC_TT ? c - MXC_TT * j : MXC_TT;
+    }
+  }
+}
+
+// 4. the grouped expert GEMM (f27_mm's tile, gathered): tile tg.x of the list (expert e, entries p0 .. p0 + n), weight
+// rows 64 tg.y ..: A.mode 0: gate | up (2 eff rows: gate's, then up's) against the entries' tokens' h2 into GU[q];
+// A.mode 1: down (d rows) against ACT[q] into DN[q]. QT: 8 Q8_0 (GGUF blocks), 4 Q4_K, 5 Q5_K, 6 Q6_K
+template <short QT>
+INLINE void mxc_mm(device u8* C, device u8* S, constant MxArgs& A, device const MxPtr* T, device float* CB,
+  uint3 tg, ushort ti, ushort sg, threadgroup float* shm) {
+  device const u32* G = (device const u32*)CB;
+  if (tg.x >= G[A.cgn]) {
+    return;
+  }
+  device const u32* tl = G + A.cgi + 3 * tg.x;
+  const u32 e = tl[0], p0 = tl[1], n = tl[2];
+  threadgroup float* sa = shm;
+  threadgroup float* sb = shm + 2048;
+  const bool dn = A.mode != 0;
+  const int M = dn ? (int)A.d : 2 * (int)A.eff;
+  const u32 K = dn ? A.eff : A.d;
+  const int r0 = tg.y * 64;
+  const short nr0 = M - r0 < 64 ? (short)(M - r0) : 64;
+  const short nr1 = (short)n;
+  const short lr0 = (short)(ti / 2) < nr0 ? (short)(ti / 2) : nr0 - 1;
+  const short il0 = ti % 2;
+  const u32 rr = (u32)(r0 + lr0);
+  device const u8* wr = dn ? mx_row(T, A, 2, e, rr) : rr < A.eff ? mx_row(T, A, 0, e, rr) : mx_row(T, A, 1, e, rr - A.eff);
+  const short lr1 = (short)(ti / 4) < nr1 ? (short)(ti / 4) : nr1 - 1;
+  const short ix = 8 * (ti % 4);
+  const u32 q1 = G[A.cgl + p0 + lr1];
+  device const float* xp = (dn ? CB + A.cac + (u64)q1 * A.eff : mxc_blk(C, S, A, q1 / A.k) + A.ch2) + ix;
+  simdgroup_float8x8 ma[4];
+  simdgroup_float8x8 mb[2];
+  simdgroup_float8x8 mc[8];
+  F27_UNROLL (short i = 0; i < 8; i++) {
+    mc[i] = make_filled_simdgroup_matrix<float, 8>(0.f);
+  }
+  const short sya = (ti / 2) / 8, lxa = (ti / 2) % 8;
+  const short syb = (ti / 4) / 8, lyb = (ti / 4) % 8, sxb = ti % 4;
+  for (uint k = 0; k < K; k += 32) {
+    float v[16];
+    if (QT == 8) {
+      device const u8* bk = wr + (k / 32) * 34;
+      const uint4 qq = kq_ld16_a2(bk + 2 + 16 * il0);
+      const float d = mx_hf(bk);
+      const uint qw[4] = {qq.x, qq.y, qq.z, qq.w};
+      F27_UNROLL (short i = 0; i < 16; i++) {
+        v[i] = (float)as_type<char4>(qw[i / 4])[i % 4] * d;
+      }
+    } else if (QT == 4) {
+      f27_deq4(wr + (k >> 8) * 144, (short)((k & 255) + 16 * il0), v);
+    } else if (QT == 5) {
+      f27_deq5(wr + (k >> 8) * 176, (short)((k & 255) + 16 * il0), v);
+    } else {
+      f27_deq6(wr + (k >> 8) * 210, (short)((k & 255) + 16 * il0), v);
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    F27_UNROLL (short i = 0; i < 16; i++) {
+      const short sx = 2 * il0 + i / 8, ly = i % 8;
+      sa[64 * (8 * sx + sya) + 8 * ly + lxa] = v[i];
+    }
+    *(threadgroup float2x4*)(sb + 64 * (4 * sxb + syb) + 8 * lyb) = *(device const float2x4*)xp;
+    xp += 32;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    threadgroup const float* lsma = sa + 4 * 64 * (sg % 2);
+    threadgroup const float* lsmb = sb + 2 * 64 * (sg / 2);
+    F27_UNROLL (short ik = 0; ik < 4; ik++) {
+      simdgroup_barrier(mem_flags::mem_none);
+      F27_UNROLL (short i = 0; i < 4; i++) {
+        simdgroup_load(ma[i], lsma + 64 * i, 8, 0, false);
+      }
+      simdgroup_barrier(mem_flags::mem_none);
+      F27_UNROLL (short i = 0; i < 2; i++) {
+        simdgroup_load(mb[i], lsmb + 64 * i, 8, 0, false);
+      }
+      simdgroup_barrier(mem_flags::mem_none);
+      F27_UNROLL (short i = 0; i < 8; i++) {
+        simdgroup_multiply_accumulate(mc[i], mb[i / 4], ma[i % 4], mc[i]);
+      }
+      lsma += 8 * 64;
+      lsmb += 4 * 64;
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  threadgroup float* ts = shm + 32 * (sg & 1) + (16 * (sg >> 1)) * 64;
+  F27_UNROLL (short i = 0; i < 8; i++) {
+    simdgroup_store(mc[i], ts + 8 * (i % 4) + 8 * 64 * (i / 4), 64, 0, false);
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  const u64 ys = dn ? A.d : 2 * A.eff;
+  device float* Y = CB + (dn ? A.cdn : A.cgu);
+  for (int x = ti; x < 32 * 64; x += 128) {
+    const short t = x / 64, r = x % 64;
+    if (t < nr1 && r < nr0) {
+      Y[(u64)G[A.cgl + p0 + t] * ys + r0 + r] = shm[x];
+    }
+  }
+}
