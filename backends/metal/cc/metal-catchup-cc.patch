+#define MXC_MM(QT) \
+kernel void llb_mx_cmm##QT(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]], \
+  constant MxArgs& A [[buffer(2)]], device const MxPtr* T [[buffer(3)]], device float* CB [[buffer(5)]], \
+  uint3 tg [[threadgroup_position_in_grid]], ushort ti [[thread_index_in_threadgroup]], \
+  ushort sg [[simdgroup_index_in_threadgroup]]) { \
+  threadgroup float shm[3072]; \
+  mxc_mm<QT>(C, S, A, T, CB, tg, ti, sg, shm); \
+}
+MXC_MM(8) MXC_MM(4) MXC_MM(5) MXC_MM(6)
