+// 7. (LLB_MX_DUMP) layer cpad1's records of the chunk's tokens into D: per token u32 layer, d, k; h2[d]; the FFN output
+// [d]; ids[k]; weights[k], gs (mx_dump's record), token-major within the layer
+kernel void llb_mx_cdump(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant MxArgs& A [[buffer(2)]], device float* CB [[buffer(5)]], device u32* D [[buffer(6)]],
+  uint2 p [[thread_position_in_grid]]) {
+  const u32 r = p.x, t = p.y;
+  if (t >= A.cnt) {
+    return;
+  }
+  const u64 rec = 3 + 2ull * A.d + 2ull * A.k + 1;
+  device u32* o = D + ((u64)A.cpad1 * A.cnt + t) * rec;
+  device const float* b = mxc_blk(C, S, A, t);
+  if (r == 0) {
+    o[0] = A.cpad1; o[1] = A.d; o[2] = A.k;
+  }
+  if (r < A.d) {
+    o[3 + r] = as_type<u32>(b[A.ch2 + r]);
+    o[3 + A.d + r] = as_type<u32>(CB[A.cdn + (u64)t * A.k * A.d + r]);
+  }
+  if (r < 2 * A.k + 1) {
+    o[3 + 2 * A.d + r] = as_type<u32>(b[A.crt + r]);
+  }
+}
