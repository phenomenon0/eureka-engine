+// 5. ACT[q][j] = silu(GU[q][j]) GU[q][eff + j]
+kernel void llb_mx_csilu(constant MxArgs& A [[buffer(2)]], device float* CB [[buffer(5)]],
+  uint2 p [[thread_position_in_grid]]) {
+  const u32 j = p.x, q = p.y;
+  if (j >= A.eff || q >= A.cnt * A.k) {
+    return;
+  }
+  const float gv = CB[A.cgu + (u64)q * 2 * A.eff + j], uv = CB[A.cgu + (u64)q * 2 * A.eff + A.eff + j];
+  CB[A.cac + (u64)q * A.eff + j] = (gv / (1.0f + mx2_exp(-gv))) * uv;
+}
+
+// 6. x = x1 + sum_s w_s DN[t k + s] + gs (the shared expert's output), token p.y, column p.x
+kernel void llb_mx_ccomb(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant MxArgs& A [[buffer(2)]], device float* CB [[buffer(5)]], uint2 p [[thread_position_in_grid]]) {
+  const u32 r = p.x, t = p.y;
+  if (r >= A.d || t >= A.cnt) {
+    return;
+  }
+  device float* b = mxc_blk(C, S, A, t);
+  device const float* wt = b + A.crt + A.k;
+  float acc = 0.0f;
+  for (u32 s = 0; s < A.k; s++) {
+    acc += wt[s] * CB[A.cdn + ((u64)t * A.k + s) * A.d + r];
+  }
+  const float f = acc + wt[A.k] * b[A.cdd + r];
+  b[A.cxo + r] = b[A.cx1 + r] + f;
+  if (A.cpad0 != 0) {
+    CB[A.cdn + (u64)t * A.k * A.d + r] = f;
+  }
+}
