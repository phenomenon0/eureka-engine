+// ---- (METAL-CATCHUP) the MoE FFN's decode kernels, v2 ---------------------------------------------------------------
+// The same arithmetic (llama.cpp's order of operations per expert; the sums' association differs: numerics-changing,
+// reports/metal-catchup). A row dot is cut into 256-column units; a unit is 8 lanes (lane l & 7), so a simdgroup
+// works 4 units at once (lane group l >> 3) and joins its lanes with one simd_sum. The K-quant units decode with the
+// dense path's fused leaves (kq_fused45 / kq_fused6: one uint4 of quants against 8 float4 of x a lane); Q8_0 (the
+// GGUF's 34-byte blocks and the heap's row-split rows) a 32-column block a lane; F32 / F16 / BF16 through mx_chunk.
+// Every x float4 a lane loads is shared by the R rows it decodes.
+#define MX_GEN 15u
+
+// the v2 kernels' exp: the hardware's precise::exp (the SHIMS #define), not attn_exp's exact float64 emulation
+INLINE float mx2_exp(float x) {
+  return exp(x);
+}
+
+// lane l's x for unit u of a row of format F (xl: the lane's first 16 columns, xh: its other 16)
+template <u32 F>
+INLINE void mx2_ldx(device const float* x, u32 u, u32 l, thread float4* xl, thread float4* xh) {
+  u32 o, oh;
+  if (F == MX_Q4K || F == MX_Q5K) {
+    o = 256 * u + 64 * ((l >> 1) & 3) + 16 * (l & 1);
+    oh = o + 32;
+  } else if (F == MX_Q6K) {
+    const u32 j = l & 7;
+    o = 256 * u + 16 * ((j & 3) + 8 * (j >> 2));
+    oh = o + 64;
+  } else {
+    o = 256 * u + 32 * (l & 7);
+    oh = o + 16;
+  }
+  for (u32 t = 0; t < 4; t++) {
+    xl[t] = *(device const float4*)(x + o + 4 * t);
+    xh[t] = *(device const float4*)(x + oh + 4 * t);
+  }
+}
+
+// lane l's part of unit u of row r (cols columns) against its x (mx2_ldx); 0 past the row's end
+template <u32 F>
+INLINE float mx2_part(device const u8* r, u32 f, u32 cols, u32 u, u32 l, thread const float4* xl,
+  thread const float4* xh) {
+  if (F == MX_Q4K) {
+    device const u8* B = r + (u64)u * 144;
+    const float2 s = kq_fused45<false>(*(device const uint4*)B,
+      *(device const uint4*)(B + 16 + 32 * ((l >> 1) & 3) + 16 * (l & 1)), uint4(0), l, xl, xh);
+    return s.x + s.y;
+  }
+  if (F == MX_Q5K) {
+    device const u8* B = r + (u64)u * 176;
+    const float2 s = kq_fused45<true>(*(device const uint4*)B,
+      *(device const uint4*)(B + 48 + 32 * ((l >> 1) & 3) + 16 * (l & 1)),
+      *(device const uint4*)(B + 16 + 16 * (l & 1)), l, xl, xh);
+    return s.x + s.y;
+  }
+  if (F == MX_Q6K) {
+    device const u8* B = r + (u64)u * 210;
+    const u32 j = l & 7, s = (j & 3) + 8 * (j >> 2);
+    const float2 v = kq_fused6(kq_ld16_a2(B + 16 * j), kq_ld16_a2(B + 128 + 32 * (j >> 2) + 16 * (j & 1)),
+      B[192 + s], B[196 + s], *(device const ushort*)(B + 208), l, xl, xh);
+    return v.x + v.y;
+  }
+  const u32 c = 8 * u + (l & 7);
+  if (c >= cols / 32) {
+    return 0.0f;
+  }
+  if (F == MX_Q8R || F == MX_Q8) {
+    uint4 q0, q1;
+    float d;
+    if (F == MX_Q8R) {
+      q0 = *(device const uint4*)(r + 32 * c);
+      q1 = *(device const uint4*)(r + 32 * c + 16);
+      d = mx_hf(r + cols + 2 * c);
+    } else {
+      q0 = kq_ld16_a2(r + 34 * (u64)c + 2);
+      q1 = kq_ld16_a2(r + 34 * (u64)c + 18);
+      d = mx_hf(r + 34 * (u64)c);
+    }
+    const uint qa[8] = { q0.x, q0.y, q0.z, q0.w, q1.x, q1.y, q1.z, q1.w };
+    float a = 0.0f, b = 0.0f;
+    for (u32 t = 0; t < 4; t++) {
+      a += kq_leaf4(float4(as_type<char4>(qa[t])), xl[t]);
+      b += kq_leaf4(float4(as_type<char4>(qa[4 + t])), xh[t]);
+    }
+    return (a + b) * d;
+  }
+  // F32 / F16 / BF16: the generic chunk (x re-read)
+  float xs[32];
+  for (u32 t = 0; t < 4; t++) {
+    xs[4 * t] = xl[t].x; xs[4 * t + 1] = xl[t].y; xs[4 * t + 2] = xl[t].z; xs[4 * t + 3] = xl[t].w;
+    xs[16 + 4 * t] = xh[t].x; xs[17 + 4 * t] = xh[t].y; xs[18 + 4 * t] = xh[t].z; xs[19 + 4 * t] = xh[t].w;
+  }
+  return mx_chunk(r, f, cols, c, (thread const float*)xs - 32 * c);
+}
+
+// 2. the routing, one group (NT = min(1024, ne rounded up to 32) threads): the max and the sum by simd + one
+// threadgroup step each; the top k by rank (expert e's rank = the experts before it in (probability desc, id asc):
+// the k argmax rounds' order, ties to the lowest id) with no reduction rounds; renormalized in rank order (sum clamped
+// at 2^-14); the shared gate's sigmoid. W[rt ..]: ids[k], weights[k], gs. ne <= 4096 (the probabilities in
+// threadgroup memory; the host keeps llb_mx_route past that)
+INLINE void mx2_route(device const float* lg, device uint* ids, device float* wt, u32 ne, u32 k, u32 mut, uint i,
+  uint nt, ushort l, ushort sg, threadgroup float* pv, threadgroup float* red, threadgroup float* tw,
+  threadgroup uint* ti) {
+  const u32 nsg = (nt + 31) / 32;
+  float m = as_type<float>(0xFF800000u);
+  for (u32 e = i; e < ne; e += nt) {
+    m = max(m, lg[e]);
+  }
+  m = simd_max(m);
+  if (l == 0) {
+    red[sg] = m;
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  m = red[0];
+  for (u32 s = 1; s < nsg; s++) {
+    m = max(m, red[s]);
+  }
+  float z = 0.0f;
+  for (u32 e = i; e < ne; e += nt) {
+    const float p = mx2_exp(lg[e] - m);
+    pv[e] = p;
+    z += p;
+  }
+  z = simd_sum(z);
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (l == 0) {
+    red[sg] = z;
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  z = 0.0f;
+  for (u32 s = 0; s < nsg; s++) {
+    z += red[s];
+  }
+  // the probabilities, padded to whole float4 with -1 (below every probability: never counted)
+  const u32 n4 = (ne + 3) / 4;
+  for (u32 e = i; e < 4 * n4; e += nt) {
+    pv[e] = e < ne ? pv[e] / z : -1.0f;
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  threadgroup const float4* p4 = (threadgroup const float4*)pv;
+  for (u32 e = i; e < ne; e += nt) {
+    const float v = pv[e];
+    u32 r0 = 0, r1 = 0, r2 = 0, r3 = 0;
+    for (u32 j4 = 0; j4 < n4; j4++) {
+      const float4 w = p4[j4];
+      const u32 j = 4 * j4;
+      r0 += (w.x > v || (w.x == v && j < e)) ? 1u : 0u;
+      r1 += (w.y > v || (w.y == v && j + 1 < e)) ? 1u : 0u;
+      r2 += (w.z > v || (w.z == v && j + 2 < e)) ? 1u : 0u;
+      r3 += (w.w > v || (w.w == v && j + 3 < e)) ? 1u : 0u;
+    }
+    const u32 r = (r0 + r1) + (r2 + r3);
+    if (r < k) {
+      ti[r] = e;
+      tw[r] = v;
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  float sum = 0.0f;
+  for (u32 s = 0; s < k; s += 1) {
+    sum += tw[s];
+  }
+  sum = max(sum, 6.103515625e-5f);
+  for (u32 s = i; s < k; s += nt) {
+    ids[s] = ti[s];
+    wt[s] = (mut & 1) == 0 ? tw[s] / sum : tw[s];
+  }
+  if (i == 0) {
+    wt[k] = 1.0f / (1.0f + mx2_exp(-lg[ne]));
+  }
+}
+
+kernel void llb_mx_route2(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant MxArgs& A [[buffer(2)]], device float* W [[buffer(4)]], uint i [[thread_position_in_threadgroup]],
+  uint nt [[threads_per_threadgroup]], ushort l [[thread_index_in_simdgroup]],
+  ushort sg [[simdgroup_index_in_threadgroup]]) {
+  threadgroup float pv[4096];
+  threadgroup float red[32];
+  threadgroup float tw[1024];
+  threadgroup uint ti[1024];
+  mx2_route(W + A.lg, (device uint*)(W + A.rt), W + A.rt + A.k, A.ne, A.k, A.mut, i, nt, l, sg, pv, red, tw, ti);
+}
+
+// 3. gate / up / SiLU, R rows a simdgroup: act[row] = silu(gate . x) * (up . x). A.mode 0: the k routed experts (task
+// t: slot t / ceil(eff / R), rows R (t % ..)), expert ids[slot] through the pointer table; mode 1: the shared expert
+// (heap tensors) into xs. Gate and up of one row share every x load.
+template <u32 F, u32 R>
+kernel void llb_mx_gu2(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant MxArgs& A [[buffer(2)]], device const MxPtr* T [[buffer(3)]], device float* W [[buffer(4)]],
+  uint g [[threadgroup_position_in_grid]], ushort sg [[simdgroup_index_in_threadgroup]],
+  ushort nsg [[simdgroups_per_threadgroup]], ushort l [[thread_index_in_simdgroup]]) {
+  const u32 task = g * nsg + sg;
+  const bool sh = A.mode != 0;
+  const u32 rows = sh ? A.sff : A.eff, nr = (rows + R - 1) / R;
+  const u32 slot = sh ? 0 : task / nr, r0 = (task - slot * nr) * R;
+  if (slot >= (sh ? 1 : A.k)) {
+    return;
+  }
+  device const float* x = (device const float*)sa_f(C, S, A.x);
+  device const u8* gr[R];
+  device const u8* ur[R];
+  u32 fg, fu;
+  if (sh) {
+    fg = A.fs[0]; fu = A.fs[1];
+    for (u32 j = 0; j < R; j++) {
+      const u32 row = min(r0 + j, rows - 1);
+      gr[j] = mx_sa(C, S, A.s[0]) + (u64)row * A.rbs[0];
+      ur[j] = mx_sa(C, S, A.s[1]) + (u64)row * A.rbs[1];
+    }
+  } else {
+    fg = A.f[0]; fu = A.f[1];
+    const u64 e = ((device const uint*)(W + A.rt))[slot];
+    for (u32 j = 0; j < R; j++) {
+      const u32 row = min(r0 + j, rows - 1);
+      gr[j] = mx_row(T, A, 0, e, row);
+      ur[j] = mx_row(T, A, 1, e, row);
+    }
+  }
+  float ga[R], ua[R];
+  for (u32 j = 0; j < R; j++) {
+    ga[j] = 0.0f;
+    ua[j] = 0.0f;
+  }
+  const u32 nu = (A.d + 255) / 256;
+  for (u32 u = l >> 3; u < nu; u += 4) {
+    float4 xl[4], xh[4];
+    mx2_ldx<F>(x, u, l, xl, xh);
+    for (u32 j = 0; j < R; j++) {
+      ga[j] += mx2_part<F>(gr[j], fg, A.d, u, l, xl, xh);
+      ua[j] += mx2_part<F>(ur[j], fu, A.d, u, l, xl, xh);
+    }
+  }
+  for (u32 j = 0; j < R; j++) {
+    const float gv = simd_sum(ga[j]), uv = simd_sum(ua[j]);
+    if (l == 0 && r0 + j < rows) {
+      W[sh ? A.xs + r0 + j : A.act + (u64)slot * A.eff + r0 + j] = (gv / (1.0f + mx2_exp(-gv))) * uv;
+    }
+  }
+}
+
+// 4. down, R output rows a simdgroup. A.mode 1: the shared expert, W[sho + row] = shared down . xs. A.mode 0: out[row]
+// = sum over the k slots of w_s (down_s . act_s) + gs W[sho + row]; the k slots' units are one stream (slot s, unit
+// u), lane group l >> 3 taking every fourth
+template <u32 F, u32 R>
+kernel void llb_mx_dn2(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant MxArgs& A [[buffer(2)]], device const MxPtr* T [[buffer(3)]], device float* W [[buffer(4)]],
+  uint g [[threadgroup_position_in_grid]], ushort sg [[simdgroup_index_in_threadgroup]],
+  ushort nsg [[simdgroups_per_threadgroup]], ushort l [[thread_index_in_simdgroup]]) {
+  const u32 r0 = (g * nsg + sg) * R;
+  if (r0 >= A.d) {
+    return;
+  }
+  float acc[R];
+  for (u32 j = 0; j < R; j++) {
+    acc[j] = 0.0f;
+  }
+  const u64 sho = A.sho;
+  if (A.mode != 0) {
+    const u32 nu = (A.sff + 255) / 256;
+    device const float* x = W + A.xs;
+    for (u32 u = l >> 3; u < nu; u += 4) {
+      float4 xl[4], xh[4];
+      mx2_ldx<F>(x, u, l, xl, xh);
+      for (u32 j = 0; j < R; j++) {
+        acc[j] += mx2_part<F>(mx_sa(C, S, A.s[2]) + (u64)min(r0 + j, A.d - 1) * A.rbs[2], A.fs[2], A.sff, u, l, xl, xh);
+      }
+    }
+    for (u32 j = 0; j < R; j++) {
+      const float v = simd_sum(acc[j]);
+      if (l == 0 && r0 + j < A.d) {
+        W[sho + r0 + j] = v;
+      }
+    }
+    return;
+  }
+  device const uint* ids = (device const uint*)(W + A.rt);
+  device const float* wt = W + A.rt + A.k;
+  const u32 nu = (A.eff + 255) / 256, nt = A.k * nu;
+  for (u32 t = l >> 3; t < nt; t += 4) {
+    const u32 s = t / nu, u = t - s * nu;
+    float4 xl[4], xh[4];
+    mx2_ldx<F>(W + A.act + (u64)s * A.eff, u, l, xl, xh);
+    const float w = wt[s];
+    const u64 e = ids[s];
+    for (u32 j = 0; j < R; j++) {
+      acc[j] += w * mx2_part<F>(mx_row(T, A, 2, e, min(r0 + j, A.d - 1)), A.f[2], A.eff, u, l, xl, xh);
+    }
+  }
+  for (u32 j = 0; j < R; j++) {
+    const float v = simd_sum(acc[j]);
+    if (l == 0 && r0 + j < A.d) {
+      sa_f(C, S, A.out)[r0 + j] = v + wt[A.k] * W[sho + r0 + j];
+    }
+  }
+}
+
+#define MX2_INST(F, R) \
+  template [[host_name("llb_mx_gu2_f" #F "_r" #R)]] kernel void llb_mx_gu2<F, R>(device u8*, device u8*, \
+    constant MxArgs&, device const MxPtr*, device float*, uint, ushort, ushort, ushort); \
+  template [[host_name("llb_mx_dn2_f" #F "_r" #R)]] kernel void llb_mx_dn2<F, R>(device u8*, device u8*, \
+    constant MxArgs&, device const MxPtr*, device float*, uint, ushort, ushort, ushort);
+MX2_INST(3, 2) MX2_INST(4, 2) MX2_INST(5, 2) MX2_INST(6, 2) MX2_INST(7, 2) MX2_INST(15, 2)
+
+// 5. (METAL-CATCHUP) the trunk's GEMVs of a MoE model (the dense models keep their bit-exact bodies): y = W x, R rows a
+// simdgroup on the same 256-column units and leaves (W: a heap matrix, Q8_0 row-split or a K-quant; F32 through the
+// generic chunk). Serve addresses (sa_f), as the MoE kernels.
+struct MxGv {
+  u64 w, x, y;
+  u32 rb, cols, n, f;
+};
+template <u32 F, u32 R>
+kernel void llb_mx_gv(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]], constant MxGv& A [[buffer(2)]],
+  uint g [[threadgroup_position_in_grid]], ushort sg [[simdgroup_index_in_threadgroup]],
+  ushort nsg [[simdgroups_per_threadgroup]], ushort l [[thread_index_in_simdgroup]]) {
+  const u32 r0 = (g * nsg + sg) * R;
+  if (r0 >= A.n) {
+    return;
+  }
+  device const float* x = (device const float*)sa_f(C, S, A.x);
+  device const u8* w = mx_sa(C, S, A.w);
+  device const u8* rw[R];
+  float acc[R];
+  for (u32 j = 0; j < R; j++) {
+    rw[j] = w + (u64)min(r0 + j, A.n - 1) * A.rb;
+    acc[j] = 0.0f;
+  }
+  const u32 nu = (A.cols + 255) / 256;
+  for (u32 u = l >> 3; u < nu; u += 4) {
+    float4 xl[4], xh[4];
+    mx2_ldx<F>(x, u, l, xl, xh);
+    for (u32 j = 0; j < R; j++) {
+      acc[j] += mx2_part<F>(rw[j], A.f, A.cols, u, l, xl, xh);
+    }
+  }
+  device float* y = sa_f(C, S, A.y);
+  for (u32 j = 0; j < R; j++) {
+    const float v = simd_sum(acc[j]);
+    if (l == 0 && r0 + j < A.n) {
+      y[r0 + j] = v;
+    }
+  }
+}
+#define MXGV_INST(F, R) \
+  template [[host_name("llb_mx_gv_f" #F "_r" #R)]] kernel void llb_mx_gv<F, R>(device u8*, device u8*, \
+    constant MxGv&, uint, ushort, ushort, ushort);
+MXGV_INST(4, 4) MXGV_INST(5, 4) MXGV_INST(6, 4) MXGV_INST(7, 4) MXGV_INST(15, 4)
+
+// ---- (METAL-CATCHUP) the MoE FFN of the fast prefill chunk (nt tokens a layer) ---------------------------------------
+// Token t's f27 block at A.cxb + t A.cxs floats holds its h2 / x1 (the FFN input and the residual), its router logits
+// (ne + 1: the shared gate's last), its route (ids k, weights k, gs) and the shared expert's output; the chunk's MoE
+// buffer (buffer 5) the grouping (counts, offsets, the tile list, the entry list) and the routed rows: GU [q][2 eff]
+// (gate | up), ACT [q][eff], DN [q][d], q = t k + slot. The routed GEMMs are f27_mm's tiles (64 weight rows x 32
+// entries, f32 operands, simdgroup MMA) over each expert's entries (gather by expert); numerics-changing.
+#define MXC_TT 32u
+
+INLINE device float* mxc_blk(device u8* C, device u8* S, constant MxArgs& A, u32 t) {
+  return sa_f(C, S, A.cxb) + (u64)t * A.cxs;
+}
+
+// 1. the router and the shared gate for 8 tokens a simdgroup row: lg[row] = w_row . h2 (F32)
+kernel void llb_mx_crdot(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant MxArgs& A [[buffer(2)]], uint2 g [[threadgroup_position_in_grid]],
+  ushort sg [[simdgroup_index_in_threadgroup]], ushort l [[thread_index_in_simdgroup]]) {
+  const u32 row = g.x * 4 + sg, t0 = g.y * 8;
+  if (row > A.ne || t0 >= A.cnt) {
+    return;
+  }
+  const u32 nr = A.cnt - t0 < 8 ? A.cnt - t0 : 8;
+  device const float* w = row < A.ne ? (device const float*)mx_sa(C, S, A.wr) + (u64)row * A.d
+    : (device const float*)mx_sa(C, S, A.wrs);
+  device const float* xb = mxc_blk(C, S, A, t0) + A.ch2;
+  float acc[8];
+  for (u32 j = 0; j < 8; j++) {
+    acc[j] = 0.0f;
+  }
+  for (u32 c = 4 * l; c < A.d; c += 128) {
+    const float4 wv = *(device const float4*)(w + c);
+    for (u32 j = 0; j < 8; j++) {
+      if (j < nr) {
+        acc[j] += dot(wv, *(device const float4*)(xb + (u64)j * A.cxs + c));
+      }
+    }
+  }
+  for (u32 j = 0; j < 8; j++) {
+    const float v = simd_sum(acc[j]);
+    if (l == 0 && j < nr) {
+      mxc_blk(C, S, A, t0 + j)[A.clg + row] = v;
+    }
+  }
+}
