+// The GEMM: lane m21's llb_f_mm (llama.cpp kernel_mul_mm's non-tensor tiling:
+// 128 threads, 4 simdgroups 2 x 2, 64 weight rows x 32 tokens, K steps of 32;
+// f32 operands in threadgroup memory, simdgroup_float8x8 accumulation) with
+// the weight format a template: QT 0 Q8_0 row-split (row: K int8 then K / 32
+// f16), 4 Q4_K, 6 Q6_K (GGUF superblocks, A.rb a row's bytes). Y[t][r] =
+// sum_k X[t][k] W[r][k]; op 1 adds into Y.
+template <short QT>
+INLINE void f27_mm(device u8* C, device u8* S, constant FMArgs& A, uint3 tg,
+  ushort ti, ushort sg, threadgroup float* shm) {
+  threadgroup float* sa = shm;
+  threadgroup float* sb = shm + 2048;
+  u32 sgm = 0, ty = tg.y;
+  while (sgm + 1 < A.nseg && ty >= (A.M[sgm] + 63) / 64) {
+    ty -= (A.M[sgm] + 63) / 64;
+    sgm += 1;
+  }
+  const int M = (int)A.M[sgm];
+  const int r0 = ty * 64, r1 = tg.x * 32;
+  const short nr0 = M - r0 < 64 ? (short)(M - r0) : 64;
+  const short nr1 = (int)A.N - r1 < 32 ? (short)((int)A.N - r1) : 32;
+  const short lr0 = (short)(ti / 2) < nr0 ? (short)(ti / 2) : nr0 - 1;
+  const short il0 = ti % 2;
+  device const u8* wr = C + A.w[sgm] + (u64)(r0 + lr0) * A.rb;
+  const short lr1 = (short)(ti / 4) < nr1 ? (short)(ti / 4) : nr1 - 1;
+  const short ix = 8 * (ti % 4);
+  device const float* xp = (device const float*)(S + A.x)
+    + (u64)(r1 + lr1) * A.xs + ix;
+  simdgroup_float8x8 ma[4];
+  simdgroup_float8x8 mb[2];
+  simdgroup_float8x8 mc[8];
+  F27_UNROLL (short i = 0; i < 8; i++) {
+    mc[i] = make_filled_simdgroup_matrix<float, 8>(0.f);
+  }
+  const short sya = (ti / 2) / 8, lxa = (ti / 2) % 8;
+  const short syb = (ti / 4) / 8, lyb = (ti / 4) % 8, sxb = ti % 4;
+  for (uint k = 0; k < A.K; k += 32) {
+    float v[16];
+    if (QT == 0) {
+      const uint4 qq = *(device const uint4*)(wr + k + 16 * il0);
+      const float d = (float)((device const half*)(wr + A.K))[k / 32];
+      const uint qw[4] = {qq.x, qq.y, qq.z, qq.w};
+      F27_UNROLL (short i = 0; i < 16; i++) {
+        v[i] = (float)as_type<char4>(qw[i / 4])[i % 4] * d;
+      }
+    } else if (QT == 4) {
+      f27_deq4(wr + (k >> 8) * 144, (short)((k & 255) + 16 * il0), v);
+    } else if (QT == 5) {
+      f27_deq5(wr + (k >> 8) * 176, (short)((k & 255) + 16 * il0), v);
+    } else {
+      f27_deq6(wr + (k >> 8) * 210, (short)((k & 255) + 16 * il0), v);
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    F27_UNROLL (short i = 0; i < 16; i++) {
+      const short sx = 2 * il0 + i / 8, ly = i % 8;
+      sa[64 * (8 * sx + sya) + 8 * ly + lxa] = v[i];
+    }
+    *(threadgroup float2x4*)(sb + 64 * (4 * sxb + syb) + 8 * lyb) =
+      *(device const float2x4*)xp;
+    xp += 32;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    threadgroup const float* lsma = sa + 4 * 64 * (sg % 2);
+    threadgroup const float* lsmb = sb + 2 * 64 * (sg / 2);
+    F27_UNROLL (short ik = 0; ik < 4; ik++) {
+      simdgroup_barrier(mem_flags::mem_none);
+      F27_UNROLL (short i = 0; i < 4; i++) {
+        simdgroup_load(ma[i], lsma + 64 * i, 8, 0, false);
+      }
+      simdgroup_barrier(mem_flags::mem_none);
+      F27_UNROLL (short i = 0; i < 2; i++) {
+        simdgroup_load(mb[i], lsmb + 64 * i, 8, 0, false);
+      }
+      simdgroup_barrier(mem_flags::mem_none);
+      F27_UNROLL (short i = 0; i < 8; i++) {
+        simdgroup_multiply_accumulate(mc[i], mb[i / 4], ma[i % 4], mc[i]);
+      }
+      lsma += 8 * 64;
+      lsmb += 4 * 64;
+    }
+  }
+  device float* Y = (device float*)(S + A.y[sgm]);
+  if (A.op == 0 && nr0 == 64 && nr1 == 32) {
+    device float* Cp = Y + (r0 + 32 * (sg & 1)) + (u64)(r1 + 16 * (sg >> 1)) * A.ys;
+    F27_UNROLL (short i = 0; i < 8; i++) {
+      simdgroup_store(mc[i], Cp + 8 * (i % 4) + (u64)8 * A.ys * (i / 4), A.ys, 0,
+        false);
+    }
+    return;
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  threadgroup float* ts = shm + 32 * (sg & 1) + (16 * (sg >> 1)) * 64;
+  F27_UNROLL (short i = 0; i < 8; i++) {
+    simdgroup_store(mc[i], ts + 8 * (i % 4) + 8 * 64 * (i / 4), 64, 0, false);
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  for (int e = ti; e < 32 * 64; e += 128) {
+    const short t = e / 64, r = e % 64;
+    if (t < nr1 && r < nr0) {
+      device float* yp = Y + (u64)(r1 + t) * A.ys + r0 + r;
+      *yp = A.op == 1 ? *yp + shm[e] : shm[e];
+    }
+  }
+}
