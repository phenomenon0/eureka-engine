+  if (aux == LLB_PASS_FID) {
+    // the whole-pass bang (tools/metal-pass.patch; CUDA's kind 23): ws (1) the
+    // layer weight list, x (2), y (3), the lin / full Offs records flattened
+    // into the task (4..23, 24..43), c = dT | pos << 5 (44), the Q8 row words
+    // rg (45, 4096 cols) and rd (46, 12288 cols), the first layer s (47) and
+    // the count k (48). CUDA's pass_mail decode on the host: each layer blob
+    // gets the linb or fulb arm's checks and the fbn arm's. One task a round
+    // (gpu_blk scratch; the gpu_scr reserve before anything binds it).
+    Term wl = H[a + 1], x = H[a + 2], y = H[a + 3];
+    u32  c = (u32)H[a + 44], rgw = (u32)H[a + 45], rdw = (u32)H[a + 46];
+    u32  s = (u32)H[a + 47], k = (u32)H[a + 48], dT = c & 31, pos = c >> 5;
