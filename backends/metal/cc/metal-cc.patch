+// ---- glibc expf (MOE-1 gx_expf<2>) on SD. 2^(j/32) as (mantissa bits of the double), exponent 0.
+XCONST ulong XS_T[32] = {
+0x0000000000000ull, 0x059b0d3158574ull, 0x0b5586cf9890full, 0x11301d0125b51ull, 0x172b83c7d517bull, 0x1d4873168b9aaull,
+0x2387a6e756238ull, 0x29e9df51fdee1ull, 0x306fe0a31b715ull, 0x371a7373aa9cbull, 0x3dea64c123422ull, 0x44e086061892dull,
