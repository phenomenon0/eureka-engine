+#define MP_TWICE 8192        // timing probe only: run thread 0's sum/inv block twice
+#define MP_NOTOP8 16384      // timing probe only: skip the top-8 rounds
+#define MP_NORENORM 32768    // timing probe only: skip the renorm block
