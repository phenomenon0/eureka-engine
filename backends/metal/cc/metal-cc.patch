+}
+XI float fx_expf(float x) { bool ok; const float r = fx_expf_try(x, ok); return ok ? r : sx_expf(x); }
+
+// float a * b, exact: 48-bit integer product, one RNE; normal operands and result, else xs_fmul
+XI float fx_fmul(float a, float b) {
+  const uint ua = X_ASU(a), ub = X_ASU(b), ea = (ua >> 23) & 255, eb = (ub >> 23) & 255;
+  if (ea == 0 || eb == 0 || ea == 255 || eb == 255) return xs_fmul(a, b);
+  const ulong P = xs_m32((ua & 0x7fffffu) | 0x800000u, (ub & 0x7fffffu) | 0x800000u);   // in [2^46, 2^48)
+  const int top = (P >> 47) ? 1 : 0, drop = 23 + top;
+  ulong m = P >> drop; const ulong low = P & ((1ull << drop) - 1), mid = 1ull << (drop - 1);
+  if (low > mid || (low == mid && (m & 1))) m += 1;
+  int fe = (int)ea + (int)eb - 254 + top;
+  if (m == (1ull << 24)) { m >>= 1; fe += 1; }
+  if (fe < -126 || fe > 127) return xs_fmul(a, b);
+  return X_ASF(((ua ^ ub) & 0x80000000u) | ((uint)(fe + 127) << 23) | (uint)(m & 0x7fffff));
+}
+// float a / b: candidate q, ACCEPTED only if exact integer arithmetic proves q = RN(a/b): with q = mq 2^eq (mq 24-bit,
+// not a power of two), a/b lies strictly inside (q - ulp/2, q + ulp/2), or on a midpoint with mq even. Else xs_fdiv.
+XI bool fx_fdiv_ok(float a, float b, float q) {
+  const uint ua = X_ASU(a), ub = X_ASU(b), uq = X_ASU(q);
+  const uint ea = (ua >> 23) & 255, eb = (ub >> 23) & 255, eq = (uq >> 23) & 255;
+  if (ea == 0 || eb == 0 || eq == 0 || ea == 255 || eb == 255 || eq == 255 || ((ua ^ ub ^ uq) & 0x80000000u)) return false;
+  const ulong ma = (ua & 0x7fffffu) | 0x800000u, mb = (ub & 0x7fffffu) | 0x800000u, mq = (uq & 0x7fffffu) | 0x800000u;
+  if (mq == 0x800000u) return false;
+  // a = ma 2^(ea-150), b q (2mq -/+ 1)/(2mq) = mb (2mq -/+ 1) 2^(eb + eq - 301): compare ma 2^d with mb (2mq -/+ 1)
+  const int d = (int)ea + 151 - (int)eb - (int)eq;
+  if (d < 0 || d > 30) return false;
+  const ulong Av = ma << d, L = mb * (2 * mq - 1), H = mb * (2 * mq + 1);
+  if (Av > L && Av < H) return true;
+  if ((Av == L || Av == H) && !(mq & 1)) return true;
+  return false;
+}
+XI float fx_fdiv_chk(float a, float b, float q) { return fx_fdiv_ok(a, b, q) ? q : xs_fdiv(a, b); }
+XI float fx_fdiv(float a, float b) { return fx_fdiv_chk(a, b, a / b); }
+// (float)(1.0 / S), S = N * 2^-52: candidates around the hardware 1/RN_f(S) (it is within ~1 ulp); the first that
+// passes fx_inv_chk is RN_f(RN_d(1/S)) (the accepted intervals are disjoint); none passes -> exact sd_div.
+XI bool fx_inv_ok(ulong N, float c) {
+  const uint uc = X_ASU(c), ec = (uc >> 23) & 255; const ulong mc = (uc & 0x7fffffu) | 0x800000u;
+  if (ec == 0 || ec == 255 || mc == 0x800000u || (uc >> 31)) return false;
+  const int pw = 243 - (int)ec;
+  if (pw < 64 || pw > 127) return false;
+  U128 lim; lim.hi = 1ull << (pw - 64); lim.lo = 0;
+  const uint nh = (uint)(N >> 32), nl = (uint)N;
+  for (int side = 0; side < 2; side++) {
+    const uint M = (uint)(side == 0 ? 2 * mc - 1 : 2 * mc + 1);
+    U128 P; P.hi = xs_m32(nh, M) >> 32; P.lo = xs_m32(nh, M) << 32;
+    U128 Q; Q.hi = 0; Q.lo = xs_m32(nl, M); P = u128_add(P, Q);
+    const U128 P40 = u128_shl(P, 40);
+    if (side == 0) { const U128 X = u128_add(P40, P); if (u128_ge(X, lim)) return false; }        // need X < lim
+    else { const U128 X = u128_sub(P40, P); if (u128_ge(lim, X)) return false; }                  // need X > lim
+  }
+  return true;
+}
+XSLOW float xs_inv_slow(SD S) { return sd_to_float(sd_div(sd_one(), S)); }
+XI float fx_inv(ulong N) {
+  const SD S = xs_fix_to_sd(N);
+  const float c0 = 1.0f / sd_to_float(S);
+  const uint u0 = X_ASU(c0);
+  if (fx_inv_ok(N, c0)) return c0;
+  if (fx_inv_ok(N, X_ASF(u0 - 1))) return X_ASF(u0 - 1);
+  if (fx_inv_ok(N, X_ASF(u0 + 1))) return X_ASF(u0 + 1);
+  return xs_inv_slow(S);
+}
