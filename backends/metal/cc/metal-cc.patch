+// The 27B FAST chunk's own kernels (lane m26, tools/metal-f27.patch). NOT
+// byte-exact with the token-by-token pass.
+#define F27_UNROLL _Pragma("clang loop unroll(full)") for
+
+// ggml's dequantize_row_q4_K for the 16 columns r0 .. r0 + 15 (r0 % 16 == 0)
+// of the 144 B superblock sb: d1 = d sc, m1 = dmin m, w = d1 q - m1 (as
+// llb_m_embk4 / q4k.w)
+// byte i of the 16-byte header h
+INLINE u32 f27_hb(uint4 h, u32 i) {
+  const u32 w = i < 4 ? h.x : i < 8 ? h.y : i < 12 ? h.z : h.w;
+  return (w >> (8 * (i & 3))) & 255u;
+}
+
+INLINE void f27_deq4(device const u8* sb, short r0, thread float* v) {
+  const u32 j = (u32)r0 >> 5, b = j >> 1, hi = j & 1;
+  // the header (d, dmin, scales[12]) as one 16-byte load
+  const uint4 hh = *(device const uint4*)sb;
+  const float d  = llb_f16(hh.x & 0xffffu);
+  const float dn = llb_f16(hh.x >> 16);
+  const u32 sc = j < 4 ? f27_hb(hh, 4 + j) & 63
+    : (f27_hb(hh, 8 + j) & 15) | (f27_hb(hh, j) >> 6) << 4;
+  const u32 mn = j < 4 ? f27_hb(hh, 8 + j) & 63
+    : (f27_hb(hh, 8 + j) >> 4) | (f27_hb(hh, 4 + j) >> 6) << 4;
+  const float d1 = d * (float)sc, m1 = dn * (float)mn;
+  const uint4 qq = *(device const uint4*)(sb + 16 + 32 * b + (r0 & 31));
+  const uint qw[4] = {qq.x, qq.y, qq.z, qq.w};
+  // (lane m31, lever K1b) four nibbles a uint op; fma exact (d1 q exact)
+  F27_UNROLL (short g = 0; g < 4; g++) {
+    const float4 w = fma(float4(d1), float4(as_type<uchar4>((qw[g] >> (4 * hi)) & 0x0F0F0F0Fu)),
+      float4(-m1));
+    v[4 * g] = w.x; v[4 * g + 1] = w.y; v[4 * g + 2] = w.z; v[4 * g + 3] = w.w;
+  }
+}
+
+// (lane m31, tools/f9_edit.py) ggml's dequantize_row_q5_K for the 16 columns
+// r0 .. r0 + 15 of the 176 B superblock sb (d, dmin, scales[12], qh[32],
+// qs[128]): sub-block j = r0 / 32 as Q4_K's (d1 = d sc, m1 = dmin m), the 5th
+// bit of column r is bit j of qh[r % 32]: w = d1 (q + 16 h) - m1
+INLINE void f27_deq5(device const u8* sb, short r0, thread float* v) {
+  const u32 j = (u32)r0 >> 5, b = j >> 1, hi = j & 1;
+  const uint4 hh = *(device const uint4*)sb;
+  const float d  = llb_f16(hh.x & 0xffffu);
+  const float dn = llb_f16(hh.x >> 16);
+  const u32 sc = j < 4 ? f27_hb(hh, 4 + j) & 63
+    : (f27_hb(hh, 8 + j) & 15) | (f27_hb(hh, j) >> 6) << 4;
+  const u32 mn = j < 4 ? f27_hb(hh, 8 + j) & 63
+    : (f27_hb(hh, 8 + j) >> 4) | (f27_hb(hh, 4 + j) >> 6) << 4;
+  const float d1 = d * (float)sc, m1 = dn * (float)mn;
+  const uint4 qq = *(device const uint4*)(sb + 48 + 32 * b + (r0 & 31));
+  const uint4 qh = *(device const uint4*)(sb + 16 + (r0 & 31));
+  const uint qw[4] = {qq.x, qq.y, qq.z, qq.w};
+  const uint hw[4] = {qh.x, qh.y, qh.z, qh.w};
+  // (lane m31, lever K1b) four values a uint op; fma exact (d1 q exact)
+  F27_UNROLL (short g = 0; g < 4; g++) {
+    const uint q4 = ((qw[g] >> (4 * hi)) & 0x0F0F0F0Fu) | ((hw[g] >> j) & 0x01010101u) << 4;
+    const float4 w = fma(float4(d1), float4(as_type<uchar4>(q4)), float4(-m1));
+    v[4 * g] = w.x; v[4 * g + 1] = w.y; v[4 * g + 2] = w.z; v[4 * g + 3] = w.w;
+  }
+}
+
+// ggml's dequantize_row_q6_K for the 16 columns r0 .. r0 + 15 of the 210 B
+// superblock sb (ql 128, qh 64, scales 16 int8, d f16): w = (d sc) q
+INLINE void f27_deq6(device const u8* sb, short r0, thread float* v) {
+  const u32 n = (u32)r0 >> 7, r = (u32)r0 & 127, qd = r >> 5, l0 = r & 31;
+  const float d = llb_f16((u32)sb[208] | (u32)sb[209] << 8);
+  const float ds = d * (float)(char)sb[192 + 8 * n + (l0 >> 4) + 2 * qd];
+  device const u8* ql = sb + 64 * n + 32 * (qd & 1) + l0;
+  device const u8* qh = sb + 128 + 32 * n + l0;
+  const u32 sl = 4 * (qd >> 1), sh = 2 * qd;
+  // (lane m31, lever K6) 2-byte loads, four values a uint op; the same q, one mul
+  device const ushort* l2 = (device const ushort*)ql;
+  device const ushort* h2 = (device const ushort*)qh;
+  F27_UNROLL (short g = 0; g < 4; g++) {
+    const uint lw = (uint)l2[2 * g] | (uint)l2[2 * g + 1] << 16;
+    const uint hw = (uint)h2[2 * g] | (uint)h2[2 * g + 1] << 16;
+    const uint q4 = ((lw >> sl) & 0x0F0F0F0Fu) | ((hw >> sh) & 0x03030303u) << 4;
+    const int4 q = int4(as_type<uchar4>(q4)) - 32;
+    v[4 * g] = ds * (float)q.x; v[4 * g + 1] = ds * (float)q.y;
+    v[4 * g + 2] = ds * (float)q.z; v[4 * g + 3] = ds * (float)q.w;
+  }
+}
