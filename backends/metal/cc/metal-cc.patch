+// ---- 1. router + shexp gate dots: lane l owns cols 64l .. 64l+63 (16 groups): in-lane (s0 + s1) + (s2 + s3), then
+// the xor butterfly over lanes = the perfect tree over 512 groups. NR rows (simdgroups) per threadgroup.
+kernel void moe_rdot(device const float* Wr [[buffer(0)]], device const float* Wsg [[buffer(1)]],
+  device const float* x [[buffer(2)]], device MoeBuf* B [[buffer(3)]],
+  uint gid [[threadgroup_position_in_grid]], uint l [[thread_index_in_simdgroup]],
+  uint sg [[simdgroup_index_in_threadgroup]], uint ns [[simdgroups_per_threadgroup]]) {
+  const u32 row = gid * ns + sg;
+  if (row > MOE_NE) return;
+  device const float* w = (row < MOE_NE ? Wr + (u64)row * MOE_D : Wsg) + 64 * l;
+  device const float* xl = x + 64 * l;
+  float s0 = moe_f32_span16(w, xl), s1 = moe_f32_span16(w + 16, xl + 16), s2 = moe_f32_span16(w + 32, xl + 32),
+        s3 = moe_f32_span16(w + 48, xl + 48);
+  float v = moe_bfly_all((s0 + s1) + (s2 + s3), l);
+  if (l == 0) B->logits[row] = v;
+}
