+//   Strides: Q4_K gate/up 589,824 B; Q5_K gate/up 720,896; Q5_K down 720,896; Q6_K down 860,160 (= tensor bytes / 256).
+// Timing (M3 Ultra, 40 layers' distinct experts in ONE command buffer): 77.3 us/layer (rdot 5.2, tail 14.3 alone /
+// ~23.6 in the chain, gate/up 28.7, down 18.7).
+// Every dot is the fixed tree: 4-wide leaf (w0x0 + w1x1) + (w2x2 + w3x3), perfect adjacent-pair tree over the 2^d groups in
+// column order (d 9 = 2048 cols, d 7 = 512), plain fmul/fadd. Scalars in MOE-0 mode-B's op order. MUT template bits:
+// MM_* = gate mutants/controls, MP_* = timing probes (results invalid); production = 0.
+#define MOE_D 2048
+#define MOE_FF 512
+#define MOE_NE 256
+#define MOE_EU 8
+// mutants (Stage 2 gates: each must break the byte gate) and controls
+#define MM_TIE_HIGH 1
+#define MM_NO_RENORM 2
+#define MM_SHARED_FIRST 4
+#define MM_NO_CLAMP 8
+#define MM_SEQ_SUM 16        // control: always take the sequential soft-double sum (must stay byte-identical)
+#define MM_FAST_ALWAYS 32    // mutant: integer sum without the exactness check
+#define MM_NO_SIGMOID 64
+#define MM_STRIDE 128        // expert stride minus one row
+#define MM_Q5_AS_Q4 256      // Q5_K decoded with the fifth bit ignored
+#define MP_HWEXP 1024        // timing probe only: precise::exp in the softmax
