+      if (!have || tw == NULL || co == bq.len) {
+        if (term_tag(t2) != TAG_CTR || (u32)term_aux(t2) != CID_CON) {
+          ok = false;
+          break;
+        }
+        Loc  l = term_peek_ro(e, t2);
+        Term wbt = H[l];
+        t2 = H[l + 1];
+        bq = str_peek_ro(e, wbt);
+        if (term_tag(wbt) != TAG_STR || str_nar(bq) != 2) {
+          ok = false;
+          break;
+        }
+        bb = (const u8*)(H + term_peek_ro(e, bq.data)) + bq.off;
+        co = 0;
+        have = true;
+      }
+      u64 lb = tw != NULL ? tw[i * 32] : bq.len;
+      if (lb == 0 || co + lb > bq.len) {
+        ok = false;
+        break;
+      }
+      const u8* base = bb + co;
+      co += lb;
+      if (i < s) {
+        continue;
+      }
+      StrParts q = bq;
+      q.len = (u32)lb;
+      const u32* p = po + ((i + 1) % 4 == 0 ? 20 : 0);
+      // (tools/metal-kquant.patch) with a table: the layer's offsets and
+      // per-tensor formats from its row; word 0 must be the blob's length;
+      // the present tensors' formats: a GEMV is Q8_0 or a K-quant with a
+      // body, the rest F32. PRB(f) = rb[f]: tensor f's row bytes (4096 cols,
+      // ffn_down 12288); the Q8 record keeps rg / rd
+      u32    tp[20];
+      M9Rows R = S0;
+      if (tw != NULL) {
+        bool full = (i + 1) % 4 == 0;
+        u32  has = full ? 0xFC01Fu : 0x3FFFu, gv = full ? 0x9C01Cu : 0x21FCu;
+        u64  sz = 0;
+        ok = tw[i * 32] == q.len;
+        for (u32 f = 0; f < 20; f += 1) {
+          u32 w = tw[i * 32 + 1 + f], fm = w >> 28;
+          tp[f] = w & 0x0fffffffu;
+          R.fm[f] = fm;
+          R.rb[f] = LLB_FM_RB(fm, m9_cols(&R, f));
+          // (SYS1-MAC) Clef's F32 ssm_beta / ssm_alpha (linear slots 7, 8):
+          // m9_gemv's F32 arm (llb_warp, float4 stride rb / 16) serves them
+          ok = ok && (!(has >> f & 1) || (gv >> f & 1
+            ? fm == LLB_FM_Q8_0 || LLB_FM_KQ(fm)
+              || (!full && (f == 7 || f == 8) && fm == LLB_FM_F32)
+            : fm == LLB_FM_F32));
+          sz += has >> f & 1 ? m9_tsz(&R, f) : 0;
+        }
