+        && ((uintptr_t)(base + p[3]) & 15) == 0
+        && ((uintptr_t)(base + p[4]) & 15) == 0
+        && (u64)p[1] + m9_n(&R, 1) * 4 <= q.len
+        && (u64)p[2] + m9_n(&R, 2) * R.rb[2] <= q.len
+        && (u64)p[3] + m9_n(&R, 3) * R.rb[3] <= q.len
+        && (u64)p[4] + m9_n(&R, 4) * R.rb[4] <= q.len;
+      if ((i + 1) % 4 == 0) {
+        // fulb: an 0, q 14, k 15, v 16, q-norm 17, k-norm 18, o 19
+        ok = ok && p[0] % 4 == 0 && p[17] % 4 == 0 && p[18] % 4 == 0
+          && ((uintptr_t)(base + p[14]) & 15) == 0
+          && ((uintptr_t)(base + p[15]) & 15) == 0
+          && ((uintptr_t)(base + p[16]) & 15) == 0
+          && ((uintptr_t)(base + p[19]) & 15) == 0
+          && (u64)p[0] + m9_n(&R, 0) * 4 <= q.len
+          && (u64)p[14] + m9_n(&R, 14) * R.rb[14] <= q.len
+          && (u64)p[15] + m9_n(&R, 15) * R.rb[15] <= q.len
+          && (u64)p[16] + m9_n(&R, 16) * R.rb[16] <= q.len
+          && (u64)p[19] + m9_n(&R, 19) * R.rb[19] <= q.len
+          && (u64)p[17] + 256 * 4 <= q.len && (u64)p[18] + 256 * 4 <= q.len;
+      } else {
