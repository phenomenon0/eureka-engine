+  }
+  if (f35_base == 0 || nt < 1 || nt > F35_CH) {
+    err_fail("35B fast chunk: no chunk area (the first 35B bang was not a chunk) / nt out of range");
+  }
+  f35_pipes();
+  for (u32 j0 = 0; j0 < nt; j0 += 512) {
+    const u32 n = nt - j0 < 512 ? nt - j0 : 512;
