+    // (consecutive SSM layers three to a blob): walk the blobs by the table's
+    // layer bytes (word 0); a layer must lie inside its blob and blobs end on
+    // layer ends. Without a table, a blob a layer, as before.
+    Term     t2 = wl;
+    StrParts bq = {0, 0, 0};
