+      }
+    }
+    if (r < MOE_EU) { twk[r] = pr; tid8[r] = (int)i; }
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (MUT & MP_CUT4) { if (i < 8) { B->ids[i] = tid8[i]; B->wn[i] = twk[i]; } return; }
+  // renorm (the twin: sequential double sum of the 8 weights, (float), clamp, divide), simdgroup 0, lane k = weight k.
+  // Fast path: the 8 terms as integers at the lowest set bit lmin; if every term and the total N are < 2^53, every
+  // sequential partial sum is an integer < 2^53 times 2^lmin (representable), so the double sum is N * 2^lmin exactly.
+  // Else the sequential soft-double chain (out of line, uniform across the simdgroup).
+  if (sg == 0 && !(MUT & (MP_NOSERIAL | MP_NORENORM))) {
+    const float w = l < MOE_EU ? twk[l] : 0.0f;
+    const bool wz = xs_is0(w);
+    const int lmin = simd_min(!wz ? xs_lsb(w) : 100000);
+    ulong term = 0; bool bad = lmin < -100;
+    if (!wz) {
+      const uint u = as_type<uint>(w), E = (u >> 23) & 255; const ulong F = (ulong)((u & 0x7fffff) | (E ? 0x800000u : 0u));
+      const int sh = (E ? (int)E : 1) - 150 - lmin;            // sh < 0 drops only zero bits (lsb >= lmin)
+      if (sh > 29) bad = true; else term = sh >= 0 ? F << sh : F >> (-sh);   // term < 2^53
+    }
+    const uint tlo = simd_sum((uint)(term & 0x7ffffffu)), thi = simd_sum((uint)(term >> 27));
+    const ulong N = ((ulong)thi << 27) + (ulong)tlo;
+    const bool ok = !simd_any(bad) && N < (1ull << 53) && N != 0;
+    float sf;
+    if (MUT & MP_NOSF) sf = 1.0f;
+    else if (ok) { const int msb = 63 - X_CLZ64(N); sf = sd_to_float(sd_make(N << (52 - msb), lmin - (52 - msb), 0)); }
+    else sf = xs_seqsum8(twk[0], twk[1], twk[2], twk[3], twk[4], twk[5], twk[6], twk[7]);
+    if (!(MUT & MM_NO_CLAMP) && sf < 6.103515625e-5f) sf = 6.103515625e-5f;
+    if (l < MOE_EU) { B->ids[l] = tid8[l]; B->wn[l] = (MUT & MM_NO_RENORM) ? w : (MUT & MP_HWDIV) ? w / sf : fx_fdiv(w, sf); }
+  }
+}
+
+// ---- 3. grouped gate + up + SiLU. Threadgroup = 2 simdgroups = the 2 pairs of a d-9 row (K) or 2 x 256 groups (Q8);
+// task gid: slot k = gid % 9 (8 = shared Q8), row r = gid / 9. Gate and up rows share the x loads.
+INLINE float moe_q8_half2048(device const u8* row, device const float* x, u32 l, u32 sg) {   // groups 256sg + 8l .. +7
+  float d[8];
+  const u32 g0 = 256 * sg + 8 * l;
+  for (u32 k = 0; k < 2; k++) {
+    const u32 g = g0 + 4 * k;
+    const uint4 q = *(device const uint4*)(row + 4 * g);
+    const float s = (float)as_type<half>(*(device const ushort*)(row + 2048 + 2 * (g >> 3)));
+    d[4 * k + 0] = moe_leaf4(float4(as_type<char4>(q.x)) * s, *(device const float4*)(x + 4 * g));
+    d[4 * k + 1] = moe_leaf4(float4(as_type<char4>(q.y)) * s, *(device const float4*)(x + 4 * g + 4));
+    d[4 * k + 2] = moe_leaf4(float4(as_type<char4>(q.z)) * s, *(device const float4*)(x + 4 * g + 8));
+    d[4 * k + 3] = moe_leaf4(float4(as_type<char4>(q.w)) * s, *(device const float4*)(x + 4 * g + 12));
+  }
+  return moe_bfly_all(((d[0] + d[1]) + (d[2] + d[3])) + ((d[4] + d[5]) + (d[6] + d[7])), l);
+}
+// V 0: threadgroup = 2 simdgroups = the 2 pairs (64 threads), one task per threadgroup, join in threadgroup memory.
+// V 1: one simdgroup per task (both pairs in registers, P0 + P1 in-lane), 4 tasks per 128-thread threadgroup.
+// V 2: as V 0 but a task = rows r, r+1 of a slot (gate and up of both: 4 rows in flight sharing the x loads).
+template <u32 FG, int MUT>
+INLINE void moe_gu_pair(device const u8* Wg, device const u8* Wu, u64 o, device const float* x, u32 l, u32 p,
+  thread float& g, thread float& u) {
+  typedef KQ<FG> F;
+  const u32 slo = F::slo(l), shi = slo + (1u << F::KIN);
+  float4 xl[4], xh[4];
+  for (u32 t = 0; t < 4; t++) {
+    xl[t] = *(device const float4*)(x + 1024 * p + 16 * slo + 4 * t);
+    xh[t] = *(device const float4*)(x + 1024 * p + 16 * shi + 4 * t);
+  }
+  const u64 ob = o + (u64)(4 * p + (l >> 3)) * F::SB;
+  float2 a, b;
+  if (FG == 9 && (MUT & MM_Q5_AS_Q4)) {           // mutant: Q5_K layout, fifth bit ignored
+    a = kq_fused45<false>(*(device const uint4*)(Wg + ob), *(device const uint4*)(Wg + ob + 48 + 32 * ((l >> 1) & 3) + 16 * (l & 1)), uint4(0), l, xl, xh);
+    b = kq_fused45<false>(*(device const uint4*)(Wu + ob), *(device const uint4*)(Wu + ob + 48 + 32 * ((l >> 1) & 3) + 16 * (l & 1)), uint4(0), l, xl, xh);
+  } else { a = F::fused(Wg + ob, l, xl, xh); b = F::fused(Wu + ob, l, xl, xh); }
+  g = kq_pair_tree<F::KIN, 0>(a.x, a.y, l);
+  u = kq_pair_tree<F::KIN, 0>(b.x, b.y, l);
+}
+INLINE float moe_silu(float G, float U) { return fx_fmul(fx_fdiv(G, 1.0f + fx_expf(-G)), U); }   // (g / (1 + expf(-g))) * u, exact
+template <u32 FG, int MUT, u32 V>
+kernel void moe_gu(device const u8* Wg [[buffer(0)]], device const u8* Wu [[buffer(1)]],
+  device const u8* Sg [[buffer(2)]], device const u8* Su [[buffer(3)]], device const float* x [[buffer(4)]],
+  device const MoeBuf* B [[buffer(5)]], device float* act [[buffer(6)]], constant MoeArgs& A [[buffer(7)]],
+  uint gid [[threadgroup_position_in_grid]], uint l [[thread_index_in_simdgroup]],
+  uint sg [[simdgroup_index_in_threadgroup]]) {
+  typedef KQ<FG> F;
+  const u64 rb = (MOE_D / 256) * F::SB, es = (MUT & MM_STRIDE) ? A.eg - rb : A.eg;
+  if (V == 1) {
+    const u32 task = gid * 4 + sg, k = task % (MOE_EU + 1), r = task / (MOE_EU + 1);
+    float G, U;
+    if (k < MOE_EU) {
+      const u64 o = (u64)B->ids[k] * es + (u64)r * rb;
+      float g0, u0, g1, u1;
+      moe_gu_pair<FG, MUT>(Wg, Wu, o, x, l, 0, g0, u0);
+      moe_gu_pair<FG, MUT>(Wg, Wu, o, x, l, 1, g1, u1);
+      G = g0 + g1; U = u0 + u1;
+    } else {
+      const u64 o = (u64)r * (MOE_D + MOE_D / 16);
+      G = moe_q8_half2048(Sg + o, x, l, 0) + moe_q8_half2048(Sg + o, x, l, 1);
+      U = moe_q8_half2048(Su + o, x, l, 0) + moe_q8_half2048(Su + o, x, l, 1);
+    }
+    if (l == 0) act[k * MOE_FF + r] = moe_silu(G, U);
+    return;
+  }
+  constexpr u32 RR = V == 2 ? 2 : 1;
+  threadgroup float part[2][2 * RR];
+  const u32 k = gid % (MOE_EU + 1), r0 = RR * (gid / (MOE_EU + 1));
+  float g[RR], u[RR];
+  for (u32 j = 0; j < RR; j++) {
+    if (k < MOE_EU) moe_gu_pair<FG, MUT>(Wg, Wu, (u64)B->ids[k] * es + (u64)(r0 + j) * rb, x, l, sg, g[j], u[j]);
+    else {
+      const u64 o = (u64)(r0 + j) * (MOE_D + MOE_D / 16);
+      g[j] = moe_q8_half2048(Sg + o, x, l, sg); u[j] = moe_q8_half2048(Su + o, x, l, sg);
+    }
+  }
+  if (l == 0) for (u32 j = 0; j < RR; j++) { part[sg][2 * j] = g[j]; part[sg][2 * j + 1] = u[j]; }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (sg == 0 && l < RR) {
+    const float G = part[0][2 * l] + part[1][2 * l], U = part[0][2 * l + 1] + part[1][2 * l + 1];
+    act[k * MOE_FF + r0 + l] = (MUT & MP_NOSILU) ? G + U : moe_silu(G, U);
+  }
+}
+
+// ---- 4. grouped down + combine. One simdgroup = R output rows; lanes 0-15 / 16-31 = experts 2s / 2s+1 (s = 0..3):
+// a 512-col row is 2 superblocks = half a K0b pair (16 lanes): span16, xor below 2^KIN on lo and hi, lo + hi, xor up to
+// 8 (never 16: the halves never mix). Then the shared Q8 down row on all 32 lanes (lane l = groups 4l .. 4l+3),
+// then lane 0 combines in rank order, the gated shared expert LAST.
+template <u32 FD, int MUT, u32 R>
+kernel void moe_dn(device const u8* Wd [[buffer(0)]], device const u8* Sd [[buffer(1)]],
+  device const float* act [[buffer(2)]], device const MoeBuf* B [[buffer(3)]], device float* out [[buffer(4)]],
+  constant MoeArgs& A [[buffer(5)]],
+  uint gid [[threadgroup_position_in_grid]], uint l [[thread_index_in_simdgroup]],
+  uint sg [[simdgroup_index_in_threadgroup]], uint ns [[simdgroups_per_threadgroup]]) {
+  typedef KQ<FD> F;
+  const u32 i0 = R * (gid * ns + sg), h = l >> 4, l16 = l & 15;
+  if (i0 >= MOE_D) return;
+  const u64 rb = (MOE_FF / 256) * F::SB;
+  const u32 slo = F::slo(l16), shi = slo + (1u << F::KIN);
+  float dn[4][R];
+  for (u32 s = 0; s < 4; s++) {
+    const u32 k = 2 * s + h;
+    device const u8* base = Wd + (u64)B->ids[k] * ((MUT & MM_STRIDE) ? A.ed - rb : A.ed) + (u64)i0 * rb + (u64)(l16 >> 3) * F::SB;
+    device const float* xa = act + k * MOE_FF;
+    float4 xl[4], xh[4];
+    for (u32 t = 0; t < 4; t++) { xl[t] = *(device const float4*)(xa + 16 * slo + 4 * t); xh[t] = *(device const float4*)(xa + 16 * shi + 4 * t); }
+    for (u32 j = 0; j < R; j++) {
+      float2 sp = F::fused(base + j * rb, l16, xl, xh);
+      float lo = sp.x, hi = sp.y;
+      for (u32 m = 1; m < (1u << F::KIN); m <<= 1) { lo = kq_bfly(lo, l, m); hi = kq_bfly(hi, l, m); }
+      float v = lo + hi;
+      for (u32 m = 1u << F::KIN; m < 16; m <<= 1) v = kq_bfly(v, l, m);
+      dn[s][j] = v;
+    }
+  }
+  float sh[R];
+  {
+    device const float* xs = act + MOE_EU * MOE_FF + 16 * l;
+    const float4 x0 = *(device const float4*)xs, x1 = *(device const float4*)(xs + 4), x2 = *(device const float4*)(xs + 8),
+                 x3 = *(device const float4*)(xs + 12);
+    for (u32 j = 0; j < R; j++) {
+      device const u8* row = Sd + (u64)(i0 + j) * (MOE_FF + MOE_FF / 16);
+      const uint4 q = *(device const uint4*)(row + 16 * l);
+      const float s = (float)as_type<half>(*(device const ushort*)(row + MOE_FF + 2 * (l >> 1)));
+      const float v = (moe_leaf4(float4(as_type<char4>(q.x)) * s, x0) + moe_leaf4(float4(as_type<char4>(q.y)) * s, x1))
+                    + (moe_leaf4(float4(as_type<char4>(q.z)) * s, x2) + moe_leaf4(float4(as_type<char4>(q.w)) * s, x3));
+      sh[j] = moe_bfly_all(v, l);
+    }
+  }
+  float od[4][R];
+  for (u32 s = 0; s < 4; s++)
+    for (u32 j = 0; j < R; j++) od[s][j] = simd_shuffle(dn[s][j], (ushort)16);
+  if ((MUT & MP_NOCOMB) && l == 0) { for (u32 j = 0; j < R; j++) out[i0 + j] = dn[0][j] + od[1][j] + sh[j]; return; }
+  if (l == 0) {
+    const float gm = (MUT & MM_NO_SIGMOID) ? B->gr : B->gs;
+    for (u32 j = 0; j < R; j++) {
+      float wt[MOE_EU];
+      for (u32 s = 0; s < 4; s++) { wt[2 * s] = dn[s][j] * B->wn[2 * s]; wt[2 * s + 1] = od[s][j] * B->wn[2 * s + 1]; }
+      const float shg = sh[j] * gm;
+      float moe = wt[0];
+      for (u32 k = 1; k < MOE_EU; k++) moe = moe + wt[k];
+      float ffn;
+      if (MUT & MM_SHARED_FIRST) { ffn = shg; for (u32 k = 0; k < MOE_EU; k++) ffn = ffn + wt[k]; }
+      else ffn = moe + shg;
+      out[i0 + j] = moe; out[MOE_D + i0 + j] = ffn;
+      if (A.dbg) {
+        for (u32 s = 0; s < 4; s++) { out[2 * MOE_D + 2 * s * MOE_D + i0 + j] = dn[s][j]; out[2 * MOE_D + (2 * s + 1) * MOE_D + i0 + j] = od[s][j]; }
+        out[2 * MOE_D + MOE_EU * MOE_D + i0 + j] = sh[j];
+      }
+    }
+  }
+}
+
+// ---- instantiations (production = MUT 0; mutants / probes / alternative layouts live in moe_kat.metal)
+#define MOE_TAIL(M) template [[host_name("moe_tail_m" #M)]] kernel void moe_tail<M>(device MoeBuf*, uint, uint, uint);
+#define MOE_GUV(FG, M, V) template [[host_name("moe_gu_f" #FG "_m" #M "_v" #V)]] kernel void moe_gu<FG, M, V>(device const u8*, \
+  device const u8*, device const u8*, device const u8*, device const float*, device const MoeBuf*, device float*, \
+  constant MoeArgs&, uint, uint, uint);
+#define MOE_GU(FG, M) MOE_GUV(FG, M, 0) MOE_GUV(FG, M, 1) MOE_GUV(FG, M, 2)
+#define MOE_DN(FD, M, R) template [[host_name("moe_dn_f" #FD "_m" #M "_r" #R)]] kernel void moe_dn<FD, M, R>( \
+  device const u8*, device const u8*, device const float*, device const MoeBuf*, device float*, constant MoeArgs&, \
+  uint, uint, uint, uint);
+// production bodies (the engine drop-in): one tail, gate/up per gate format (4 = Q4_K, 9 = Q5_K), down per down format
+MOE_TAIL(0)
+MOE_GUV(4, 0, 0) MOE_GUV(9, 0, 0)
+MOE_DN(9, 0, 2) MOE_DN(6, 0, 2)
+
+// the Stage 1 gate's mutants (LLB_MOE_MUT; never selected otherwise): no renorm
+// (tail 2), shared expert first (down 4), no sigmoid (down 64), the expert
+// stride one row short (gate/up and down 128)
+MOE_TAIL(2)
+MOE_GUV(4, 128, 0) MOE_GUV(9, 128, 0)
+MOE_DN(9, 4, 2) MOE_DN(6, 4, 2) MOE_DN(9, 64, 2) MOE_DN(6, 64, 2)
+MOE_DN(9, 128, 2) MOE_DN(6, 128, 2)
+
+// CUDA's llb_rms (tools/payload-rms.patch), flat.bend's rms over 2048: s = 1 /
+// sqrt(sumsq / 2048 + eps), sumsq the balanced tree of v * v (pairs, then
+// halves up in threadgroup memory); h = (x * s) * w into slot j of gpu_att.
+// One threadgroup of 1024.
+kernel void llb_rms(device const u8* C [[buffer(0)]],
+  device float* att [[buffer(1)]], constant RmsArgs& A [[buffer(2)]],
+  uint t [[thread_position_in_threadgroup]]) {
+  threadgroup float a[1024];
+  device const float* x = (device const float*)(C + A.x);
+  device const float* w = (device const float*)(C + A.w);
+  device float* h = att + A.slot * 2048;
+  a[t] = x[2 * t] * x[2 * t] + x[2 * t + 1] * x[2 * t + 1];
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  for (u32 st = 1; st < 1024; st <<= 1) {
+    if ((t & (2 * st - 1)) == 0) {
+      a[t] = a[t] + a[t + st];
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+  }
+  const float s = 1.0f / sqrt(a[0] / 2048.0f + as_type<float>(0x358637BDu));
+  for (u32 i = t; i < 2048; i += 1024) {
+    h[i] = (x[i] * s) * w[i];
+  }
+}
+
+// CUDA's llb_rope (tools/interiors-rope.patch), flat.bend's k.rope in place
+// over y[0 .. n) at pos: pair p, theta index p & 63; pow/cos/sin through x32
+// as the Bend body's F64 line on Metal. A thread a pair.
+kernel void llb_rope(device u8* C [[buffer(0)]],
+  constant RopeArgs& A [[buffer(2)]], uint p [[thread_position_in_grid]]) {
+  device float* y = (device float*)(C + A.y);
+  if (2 * p >= A.n) {
+    return;
+  }
+  const float t  = A.pos * x32_pow(5000000.0f, -(float)(2 * (p & 63)) / 128.0f);
+  const float co = x32_cos(t), si = x32_sin(t);
+  const float x0 = y[2 * p], x1 = y[2 * p + 1];
+  y[2 * p]     = x0 * co - x1 * si;
+  y[2 * p + 1] = x0 * si + x1 * co;
+}
+
+// CUDA's llb_silu (tools/interiors-ffn.patch): a[i] = silu1(g[i]) * u[i],
+// silu1(v) = v / (1 + exp32(-v)); g, u, a are the FFN slot's three 8192 runs
+// of gpu_act (a's tail past 6144 stays 0: the down GEMV's x padding).
+kernel void llb_silu(device float* act [[buffer(1)]],
+  constant u32& o [[buffer(2)]], uint i [[thread_position_in_grid]]) {
+  device float* g = act + o;
+  if (i < 6144) {
+    const float v = g[i];
+    g[2 * 8192 + i] = v / (1.0f + attn_exp(-v)) * g[8192 + i];
+  }
+}
+
+// The Qwen3.5 kernels on Metal (tools/metal-9b.patch): CUDA's payload-*
+// kernels op for op -- the same trees, threads and blocks, fp contract off and
+// MTLMathModeSafe (IEEE +, -, *, / and sqrt), each (f32)fn((double)x) through
+// x32 as the Bend body's F64 line on Metal. Pointers are serve addresses
+// (HybArgs): a byte offset into the corpus C (buffer 0), or into the serve's
+// scratch S (buffer 1) when SA_SCR is set.
+INLINE device float* sa_f(device u8* C, device u8* S, u64 a) {
+  return (device float*)(((a & SA_SCR) != 0 ? S : C) + (a & ~SA_SCR));
+}
+
+// K.rms_norm over n = 2^d (d = 11 or 12) or n 5120 (a tree over 8192, +0 pad
+// leaves: tools/metal-27b.patch), CUDA's llb_rmsnorm
+// (tools/payload-rmsnorm.patch): a balanced local tree over the n / 1024
+// elements a thread owns, then the shared halving strides. One group of 1024.
+kernel void llb_m_rmsnorm(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant HybArgs& A [[buffer(2)]], uint t [[thread_position_in_threadgroup]]) {
+  threadgroup float a[1024];
+  device const float* x = sa_f(C, S, A.a[0]);
+  device const float* w = sa_f(C, S, A.a[1]);
+  device float* y = sa_f(C, S, A.a[2]);
+  const u32 n = A.n, q = n >> 10;
+  device const float* xp = x + (u64)t * q;
+  float acc;
+  if (q == 4) {
+    const float a0 = xp[0] * xp[0], a1 = xp[1] * xp[1];
+    const float a2 = xp[2] * xp[2], a3 = xp[3] * xp[3];
+    acc = (a0 + a1) + (a2 + a3);
+  } else if (n > 2048) {
+    // (ENGINE-4B) n 5120 and n 2560 (the 4B; fnw1's CUDA form): the +0-padded
+    // 8-wide tree over 8192
+    // (tools/metal-27b.patch) n 5120 (the 27B), CUDA's: the tree over 8192,
+    // 8 leaves a thread, +0 pad leaves past n
+    float b[8];
+    for (u32 k = 0; k < 8; k++) {
+      const u32 i = t * 8 + k;
+      b[k] = i < n ? x[i] * x[i] : 0.0f;
+    }
+    acc = ((b[0] + b[1]) + (b[2] + b[3])) + ((b[4] + b[5]) + (b[6] + b[7]));
+  } else {
+    acc = xp[0] * xp[0] + xp[1] * xp[1];
+  }
+  // (tools/metal-m30.patch, lever A) the same halving tree: strides 1 .. 16
+  // by kq_bfly, the 32 simdgroup nodes a[32 g], strides 32 .. 512 by kq_bfly
+  // over them (2 barrier rounds, was 10)
+  const u32 l = t & 31;
+  float v = acc;
+  for (u32 m = 1; m < 32; m <<= 1) {
+    v = kq_bfly(v, l, m);
+  }
+  if (l == 0) {
+    a[t >> 5] = v;
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  v = a[l];
+  for (u32 m = 1; m < 32; m <<= 1) {
+    v = kq_bfly(v, l, m);
+  }
+  const float s = 1.0f / sqrt(v / (float)n + as_type<float>(0x358637BDu));
+  for (u32 i = t; i < n; i += 1024) {
+    y[i] = (x[i] * s) * w[i];
+  }
+}
+
+// (tools/metal-m25.patch = M24 lever L8) the residual add fused into the
+// rmsnorm after it: x1 = x + z (A.a[0], A.a[1]) into A.a[3] (llb_m_elem op 0,
+// element for element), then llb_m_rmsnorm of x1 (w A.a[4], y A.a[2]): each
+// thread squares its own sums, the same local trees (q 4: the 9B; n 5120:
+// the 27B's tree over 8192 with +0 pad leaves, as llb_m_rmsnorm; else 2) and
+// halving strides; the scaling loop reads x1 back after a device barrier. One
+// group of 1024
+kernel void llb_m_addrms(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
