+// count = the grid / 8 (the 27B: 48 value heads, q / k already in their copies)
+kernel void llb_f27_gdl(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant HybTArgs& A [[buffer(2)]], uint g [[threadgroup_position_in_grid]],
+  ushort sg [[simdgroup_index_in_threadgroup]],
+  ushort l [[thread_index_in_simdgroup]]) {
+  const u32 h = g / 8, j0 = (g % 8) * 16 + sg * 4;
+  device float4* Sr = (device float4*)(sa_f(C, S, A.a[0]) + (((u64)h * 128 + j0) << 7));
+  float4 s0 = Sr[l], s1 = Sr[32 + l], s2 = Sr[64 + l], s3 = Sr[96 + l];
+  for (u32 t = 0; t < A.k; t += 1) {
+    const float4 q4 = ((device const float4*)(sa_f(C, S, A.a[1] + (u64)t * A.s[1]) + ((u64)h << 7)))[l];
+    const float4 k4 = ((device const float4*)(sa_f(C, S, A.a[2] + (u64)t * A.s[2]) + ((u64)h << 7)))[l];
+    const float4 v4 = *(device const float4*)(sa_f(C, S, A.a[3] + (u64)t * A.s[3]) + ((u64)h << 7) + j0);
+    const float decay = sa_f(C, S, A.a[4] + (u64)t * A.s[4])[h];
+    const float beta = sa_f(C, S, A.a[5] + (u64)t * A.s[5])[h];
+    s0 = s0 * decay; s1 = s1 * decay; s2 = s2 * decay; s3 = s3 * decay;
+    float4 p = float4(dot(s0, k4), dot(s1, k4), dot(s2, k4), dot(s3, k4));
+    p += simd_shuffle_xor(p, 16);
+    p += simd_shuffle_xor(p, 8);
+    p += simd_shuffle_xor(p, 4);
+    p += simd_shuffle_xor(p, 2);
+    p += simd_shuffle_xor(p, 1);
+    const float4 dl = (v4 - p) * beta;
+    s0 = s0 + k4 * dl.x; s1 = s1 + k4 * dl.y; s2 = s2 + k4 * dl.z; s3 = s3 + k4 * dl.w;
+    float4 y = float4(dot(s0, q4), dot(s1, q4), dot(s2, q4), dot(s3, q4));
+    y += simd_shuffle_xor(y, 16);
+    y += simd_shuffle_xor(y, 8);
+    y += simd_shuffle_xor(y, 4);
+    y += simd_shuffle_xor(y, 2);
+    y += simd_shuffle_xor(y, 1);
+    if (l == 0) {
+      *(device float4*)(sa_f(C, S, A.a[6] + (u64)t * A.s[6]) + ((u64)h << 7) + j0) = y;
+    }
+  }
+  Sr[l] = s0; Sr[32 + l] = s1; Sr[64 + l] = s2; Sr[96 + l] = s3;
+}
+
+// llb_f27_attn: lane m21's llb_f_attn (flash-style causal attention, f32
+// simdgroup MMA, online softmax) with F27_G q heads a kv head (the 27B: 24 q
+// heads, 4 kv heads, GQA 6): threadgroup (g, rb) = kv head g, rows 8 rb ..;
+// simdgroup sg = q head F27_G g + sg; kv rows of 1024 floats (4 x 256). Needs
+// pos0 + nt <= 2^dT and 2^dT >= 32
+// (lane m31) the body a template on F27_G, the q heads a kv head: the 27B's 6
+// (llb_f27_attn, its text unchanged inside), the 9B's 4 (llb_f9_attn)
+template <short F27_G>
+INLINE void f27_attn_g(device u8* C, device u8* S, constant FAttArgs& A,
+  uint2 tg, ushort sg, ushort l, threadgroup float (*ssh)[8 * 32],
+  threadgroup float (*dsh)[64]) {
+  const u32 g = tg.x, r0 = tg.y * 8, h = F27_G * g + sg;
+  const u32 nr = A.nt - r0 < 8 ? A.nt - r0 : 8;
+  const u32 kmax = A.pos0 + r0 + nr - 1;
+  device const float* qb = sa_f(C, S, A.q) + (u64)r0 * A.qs + h * 256;
+  device const float* kb0 = sa_f(C, S, A.kc) + g * 256;
+  device const float* vb0 = sa_f(C, S, A.vc) + g * 256;
+  threadgroup float* ss = ssh[sg];
+  threadgroup float* ds = dsh[sg];
+  simdgroup_float8x8 O[32];
+  F27_UNROLL (short d = 0; d < 32; d++) {
+    O[d] = make_filled_simdgroup_matrix<float, 8>(0.f);
+  }
+  const u32 ri = l / 4, rc = l % 4;
+  const u32 rpos = A.pos0 + r0 + ri;
+  float m = as_type<float>(0xFF800000u), lsum = 0.0f;
+  for (u32 kb = 0; kb <= kmax; kb += 32) {
+    simdgroup_float8x8 sc[4];
+    F27_UNROLL (short j = 0; j < 4; j++) {
+      sc[j] = make_filled_simdgroup_matrix<float, 8>(0.f);
+    }
+    for (short d = 0; d < 32; d++) {
+      simdgroup_float8x8 mq;
+      simdgroup_load(mq, qb + 8 * d, A.qs, 0, false);
+      F27_UNROLL (short j = 0; j < 4; j++) {
+        simdgroup_float8x8 mk;
+        simdgroup_load(mk, kb0 + (u64)(kb + 8 * j) * 1024 + 8 * d, 1024, 0, true);
+        simdgroup_multiply_accumulate(sc[j], mq, mk, sc[j]);
+      }
+    }
+    F27_UNROLL (short j = 0; j < 4; j++) {
+      simdgroup_store(sc[j], ss + 8 * j, 32, 0, false);
+    }
+    simdgroup_barrier(mem_flags::mem_threadgroup);
+    float x[8];
+    float mb = as_type<float>(0xFF800000u);
+    F27_UNROLL (short e = 0; e < 8; e++) {
+      const u32 t = kb + rc * 8 + e;
+      x[e] = t <= rpos ? ss[ri * 32 + rc * 8 + e] * 0.0625f : as_type<float>(0xFF800000u);
+      mb = max(mb, x[e]);
+    }
+    mb = max(mb, simd_shuffle_xor(mb, 1));
+    mb = max(mb, simd_shuffle_xor(mb, 2));
+    const float mn = max(m, mb);
+    const float alpha = exp(m - mn);
+    float ps = 0.0f;
+    F27_UNROLL (short e = 0; e < 8; e++) {
+      const float pe = exp(x[e] - mn);
+      ss[ri * 32 + rc * 8 + e] = pe;
+      ps += pe;
+    }
+    ps += simd_shuffle_xor(ps, 1);
+    ps += simd_shuffle_xor(ps, 2);
+    lsum = lsum * alpha + ps;
+    m = mn;
+    ds[2 * l] = 0.0f;
+    ds[2 * l + 1] = 0.0f;
+    const float al = simd_shuffle(alpha, (ushort)(4 * (l & 7)));
+    simdgroup_barrier(mem_flags::mem_threadgroup);
+    if (l < 8) {
+      ds[9 * l] = al;
+    }
+    simdgroup_barrier(mem_flags::mem_threadgroup);
+    simdgroup_float8x8 dg;
+    simdgroup_load(dg, ds, 8, 0, false);
+    F27_UNROLL (short d = 0; d < 32; d++) {
+      simdgroup_multiply(O[d], dg, O[d]);
+    }
+    F27_UNROLL (short j = 0; j < 4; j++) {
+      simdgroup_float8x8 pj;
+      simdgroup_load(pj, ss + 8 * j, 32, 0, false);
+      device const float* vr = vb0 + (u64)(kb + 8 * j) * 1024;
+      F27_UNROLL (short d = 0; d < 32; d++) {
+        simdgroup_float8x8 mv;
+        simdgroup_load(mv, vr + 8 * d, 1024, 0, false);
+        simdgroup_multiply_accumulate(O[d], pj, mv, O[d]);
+      }
+    }
+    simdgroup_barrier(mem_flags::mem_threadgroup);
+  }
+  ds[2 * l] = 0.0f;
+  ds[2 * l + 1] = 0.0f;
+  const float il = simd_shuffle(1.0f / lsum, (ushort)(4 * (l & 7)));
+  simdgroup_barrier(mem_flags::mem_threadgroup);
+  if (l < 8) {
+    ds[9 * l] = il;
+  }
+  simdgroup_barrier(mem_flags::mem_threadgroup);
+  simdgroup_float8x8 dg;
+  simdgroup_load(dg, ds, 8, 0, false);
+  device float* ob = sa_f(C, S, A.att) + (u64)r0 * A.qs + h * 256;
+  F27_UNROLL (short d = 0; d < 32; d++) {
+    simdgroup_float8x8 o;
+    simdgroup_multiply(o, dg, O[d]);
+    simdgroup_store(o, ob + 8 * d, A.qs, 0, false);
+  }
+}
+
+kernel void llb_f27_attn(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant FAttArgs& A [[buffer(2)]], uint2 tg [[threadgroup_position_in_grid]],
+  ushort sg [[simdgroup_index_in_threadgroup]],
+  ushort l [[thread_index_in_simdgroup]]) {
+  threadgroup float ssh[6][8 * 32];
+  threadgroup float dsh[6][64];
+  f27_attn_g<6>(C, S, A, tg, sg, l, ssh, dsh);
+}
+
+kernel void llb_f9_attn(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant FAttArgs& A [[buffer(2)]], uint2 tg [[threadgroup_position_in_grid]],
+  ushort sg [[simdgroup_index_in_threadgroup]],
+  ushort l [[thread_index_in_simdgroup]]) {
+  threadgroup float ssh[4][8 * 32];
+  threadgroup float dsh[4][64];
+  f27_attn_g<4>(C, S, A, tg, sg, l, ssh, dsh);
+}
+
+// llb_f27_conv1dt: lane m21's llb_f_conv1dt (K.conv1d 4-tap + SiLU, A.n
+// channels) with a per-row input table (row's x / h0 / h1 / h2 = in[row + 3],
+// in[row], in[row + 1], in[row + 2]); w a[0], y a[1] + row s[1]
+kernel void llb_f27_conv1dt(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant FConvArgs& A [[buffer(2)]], uint2 c_v [[thread_position_in_grid]]) {
+  const uint c = c_v.x, row = c_v.y;
+  if (c >= A.n) {
+    return;
+  }
+  device const float* w  = sa_f(C, S, A.a[0]);
+  device const float* x  = sa_f(C, S, A.in[row + 3]);
+  device const float* h0 = sa_f(C, S, A.in[row]);
+  device const float* h1 = sa_f(C, S, A.in[row + 1]);
+  device const float* h2 = sa_f(C, S, A.in[row + 2]);
+  device float* y = sa_f(C, S, A.a[1] + (u64)row * A.s[1]);
+  const float a = h0[c] * w[4 * c] + h1[c] * w[4 * c + 1];
+  const float b = h2[c] * w[4 * c + 2] + x[c] * w[4 * c + 3];
+  const float u = a + b;
+  y[c] = u / (1.0f + attn_exp(-u));
+}
+
+// (lane m31, lever E1) llb_f27_embt: llb_m_embk4 / llb_m_embq8 for row
+// tgp.y of a 2D grid (token id A.id[row]); the per-column arithmetic verbatim
+kernel void llb_f27_embt(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant FEmbArgs& A [[buffer(2)]], uint2 g [[thread_position_in_grid]]) {
+  const uint i = g.x, row = g.y;
+  device float* y = sa_f(C, S, A.y + (u64)row * A.ys * 4);
+  if (i >= A.d) {
+    return;
+  }
+  if (A.k4 == 2) {
+    // (ENGINE-PREFILL, patches/metal-4bpf.patch) llb_m_embk6's column i
+    // verbatim: the chunk's rows are the fused step's bits
+    device const u8* a = C + A.ep + (u64)A.id[row] * A.erb + (u64)(i >> 8) * 210;
+    const u32 r = i & 255, h = r >> 7, g = (r & 127) >> 5, l = r & 31;
+    const u32 ql = a[64 * h + l + (g & 1) * 32], qh = a[128 + 32 * h + l];
+    const u32 q = ((g < 2 ? ql : ql >> 4) & 15) | ((qh >> (2 * g)) & 3) << 4;
+    const float d = llb_f16((u32)a[208] | (u32)a[209] << 8);
+    const float sc = (float)(int)(char)a[192 + 8 * h + l / 16 + 2 * g];
+    y[i] = d * sc * (float)((int)q - 32);
+  } else if (A.k4 != 0) {
+    device const u8* a = C + A.ep + (u64)A.id[row] * A.erb + (u64)(i >> 8) * 144;
+    const u32 rr = i & 255, b = rr >> 6, hi = (rr & 63) >> 5, j = 2 * b + hi;
+    const float d  = llb_f16((u32)a[0] | (u32)a[1] << 8);
+    const float dn = llb_f16((u32)a[2] | (u32)a[3] << 8);
+    const u32 sc = j < 4 ? a[4 + j] & 63 : (a[8 + j] & 15) | (a[j] >> 6) << 4;
+    const u32 mn = j < 4 ? a[8 + j] & 63 : (a[8 + j] >> 4) | (a[4 + j] >> 6) << 4;
+    const float d1 = d * (float)sc;
+    const float m1 = dn * (float)mn;
+    const u32 q = a[16 + 32 * b + (rr & 31)];
+    y[i] = d1 * (float)((q >> (4 * hi)) & 15) - m1;
+  } else {
+    device const u8* rw = C + A.ep + (u64)A.id[row] * A.erb;
+    y[i] = (float)(char)rw[i]
+      * llb_f16(*(device const ushort*)(rw + A.d + 2 * (i >> 5)));
+  }
+}
+
+// llb_f27_copy: y[i] := x[i], i < n
+kernel void llb_f27_copy(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant HybArgs& A [[buffer(2)]], uint i [[thread_position_in_grid]]) {
+  if (i < A.n) {
+    sa_f(C, S, A.a[1])[i] = sa_f(C, S, A.a[0])[i];
+  }
+}
+
+// ---- lane m32 (f35): the 35B-A3B fast chunk's kernels -----------------------------------------------------------
+// the host's MoeBuf row stride (F35_MBS) is the device's
+static_assert(sizeof(MoeBuf) == F35_MBS, "f35: MoeBuf row stride");
+
+// f35_rdot: moe_rdot for row g2.y of a 2D grid (x = x0 + row xs floats, B = B0 + row); its body verbatim, so each
+// row's router and shexp-gate logits are the decode router's bits for the same input
+kernel void f35_rdot(device const float* Wr [[buffer(0)]], device const float* Wsg [[buffer(1)]],
+  device const float* x0 [[buffer(2)]], device MoeBuf* B0 [[buffer(3)]], constant u32& xs [[buffer(4)]],
+  uint2 g2 [[threadgroup_position_in_grid]], uint l [[thread_index_in_simdgroup]],
+  uint sg [[simdgroup_index_in_threadgroup]], uint ns [[simdgroups_per_threadgroup]]) {
+  const uint gid = g2.x;
+  device const float* x = x0 + (u64)g2.y * xs;
+  device MoeBuf* B = B0 + g2.y;
+  const u32 row = gid * ns + sg;
+  if (row > MOE_NE) return;
+  device const float* w = (row < MOE_NE ? Wr + (u64)row * MOE_D : Wsg) + 64 * l;
+  device const float* xl = x + 64 * l;
+  float s0 = moe_f32_span16(w, xl), s1 = moe_f32_span16(w + 16, xl + 16), s2 = moe_f32_span16(w + 32, xl + 32),
+        s3 = moe_f32_span16(w + 48, xl + 48);
+  float v = moe_bfly_all((s0 + s1) + (s2 + s3), l);
+  if (l == 0) B->logits[row] = v;
+}
+
+// f35_tail: moe_tail<0> for row gq (one threadgroup of 288 a row, B = B0 + gq); its body verbatim (MUT 0): the
+// soft-double softmax, top-8 and renorm of the decode router, bit for bit
+kernel void f35_tail(device MoeBuf* B0 [[buffer(0)]], uint gq [[threadgroup_position_in_grid]],
+  uint i [[thread_index_in_threadgroup]], uint l [[thread_index_in_simdgroup]],
+  uint sg [[simdgroup_index_in_threadgroup]]) {
+  constexpr int MUT = 0;
+  device MoeBuf* B = B0 + gq;
+  threadgroup float tv[9], pp[MOE_NE], shf[2];
+  threadgroup uint ti[9];
+  threadgroup ulong tn[9];
+  threadgroup int tl[9], tvi[9];
+  const bool ex = i < MOE_NE;
+  const float lg = ex ? B->logits[i] : 0.0f;
+  float m = simd_max(lg);
+  if (l == 0) tv[sg] = m;
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  float mx = tv[0];
+  for (u32 s = 1; s < 8; s++) mx = max(mx, tv[s]);
+  // ONE expf call site: experts take expf(lg - mx); thread 256 takes expf(-gr) for the shexp sigmoid (overlapped)
+  const float gr = i == MOE_NE ? B->logits[MOE_NE] : 0.0f;
+  const float xe = ex ? lg - mx : -gr;
+  const float e = (MUT & MP_HWEXP) ? fx_expf(xe) : fx_expf(xe);   // M24: the engine #defines exp (SHIMS); the MP_HWEXP probe is off here
+  const float p = ex ? e : 0.0f;
+  if (ex) pp[i] = p;
+  else if (i == MOE_NE) { B->gr = gr; B->gs = fx_fdiv(1.0f, 1.0f + e); }   // 1 + e: e >= 0, a subnormal e leaves 1 on both sides
+  if (MUT & MP_STOP_EXP) { if (ex) B->probs[i] = p; return; }
+  // exact softmax double sum: integer fast path pieces (moe_exact.h). Zero tests on BITS (Metal compares subnormals as 0).
+  const bool pz = xs_is0(p);
+  const int lsb = !pz ? xs_lsb(p) : 100000;
+  const ulong fx = pz ? 0 : (MUT & MM_FAST_ALWAYS) ? xs_fix52(p) : (lsb >= -52 ? xs_fix52(p) : 0);
+  const uint flo = (uint)(fx & 0x3ffffffu), fhi = (uint)(fx >> 26);     // fx <= 2^52: 32-lane sums fit in 32 bits
+  const uint slo = simd_sum(flo), shi = simd_sum(fhi);
+  const int lm = simd_min(lsb);
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (l == 0) { tn[sg] = ((ulong)shi << 26) + (ulong)slo; tl[sg] = lm; }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  // every thread derives N, the fast-path verdict and (float)(1/sum) from the published pieces (no single-thread island,
+  // no broadcast barrier); the sequential chain (rare) runs uniformly
+  float inv;
+  {
+    ulong N = 0; int lmin = tl[0];
+    for (u32 s = 0; s < 8; s++) { N += tn[s]; lmin = min(lmin, tl[s]); }
+    const bool fast = (MUT & MM_SEQ_SUM) ? false : (MUT & MM_FAST_ALWAYS) ? true : xs_fast_ok(N, lmin);
+    SD S;
+    if (fast) { inv = fx_inv(N); S = xs_fix_to_sd(N); }
+    else { S = xs_seqsum256(pp); inv = xs_inv_slow(S); }   // llama.cpp / twin: sequential double sum in index order
+    if (i == 0) {
+      const ulong bits = ((ulong)(S.e + 1075) << 52) | (S.m & ((1ull << 52) - 1));
+      B->fast = fast ? 1u : 0u; B->dlo = (uint)bits; B->dhi = (uint)(bits >> 32);
+    }
+  }
+  if (MUT & MP_CUT1) { if (i == 0) B->gr = inv; return; }
+  const float pr = ex ? fx_fmul(p, inv) : 0.0f;    // exact even for subnormal p (hardware would flush)
+  if (ex) B->probs[i] = pr;
+  if (MUT & MP_CUT2) return;
+  // top-8 on the BITS (probs >= +0: int order == float order, subnormals included) in the order (value desc, id asc)
+  // = the twin's repeated strict-> argmax with ties to the lowest id. Rank counting: expert i's rank = #experts before
+  // it in that total order (unique ranks); ranks 0..7 write their slot. No reductions, two barriers.
+  threadgroup int vb[MOE_NE], tid8[8];
+  threadgroup float twk[8];
+  const int v = (int)as_type<uint>(pr);
+  if (ex) vb[i] = v;
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (ex) {
+    int r = 0;
+    threadgroup const int4* v4 = (threadgroup const int4*)vb;
+    for (u32 j4 = 0; j4 < MOE_NE / 4; j4++) {
+      const int4 w = v4[j4]; const int j = (int)(4 * j4), ii = (int)i;
+      if (MUT & MM_TIE_HIGH) {
+        r += (w.x > v || (w.x == v && j > ii)) ? 1 : 0; r += (w.y > v || (w.y == v && j + 1 > ii)) ? 1 : 0;
+        r += (w.z > v || (w.z == v && j + 2 > ii)) ? 1 : 0; r += (w.w > v || (w.w == v && j + 3 > ii)) ? 1 : 0;
+      } else {
+        r += (w.x > v || (w.x == v && j < ii)) ? 1 : 0; r += (w.y > v || (w.y == v && j + 1 < ii)) ? 1 : 0;
+        r += (w.z > v || (w.z == v && j + 2 < ii)) ? 1 : 0; r += (w.w > v || (w.w == v && j + 3 < ii)) ? 1 : 0;
+      }
+    }
+    if (r < MOE_EU) { twk[r] = pr; tid8[r] = (int)i; }
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (MUT & MP_CUT4) { if (i < 8) { B->ids[i] = tid8[i]; B->wn[i] = twk[i]; } return; }
+  // renorm (the twin: sequential double sum of the 8 weights, (float), clamp, divide), simdgroup 0, lane k = weight k.
+  // Fast path: the 8 terms as integers at the lowest set bit lmin; if every term and the total N are < 2^53, every
+  // sequential partial sum is an integer < 2^53 times 2^lmin (representable), so the double sum is N * 2^lmin exactly.
+  // Else the sequential soft-double chain (out of line, uniform across the simdgroup).
+  if (sg == 0 && !(MUT & (MP_NOSERIAL | MP_NORENORM))) {
+    const float w = l < MOE_EU ? twk[l] : 0.0f;
+    const bool wz = xs_is0(w);
+    const int lmin = simd_min(!wz ? xs_lsb(w) : 100000);
+    ulong term = 0; bool bad = lmin < -100;
+    if (!wz) {
+      const uint u = as_type<uint>(w), E = (u >> 23) & 255; const ulong F = (ulong)((u & 0x7fffff) | (E ? 0x800000u : 0u));
+      const int sh = (E ? (int)E : 1) - 150 - lmin;            // sh < 0 drops only zero bits (lsb >= lmin)
+      if (sh > 29) bad = true; else term = sh >= 0 ? F << sh : F >> (-sh);   // term < 2^53
+    }
+    const uint tlo = simd_sum((uint)(term & 0x7ffffffu)), thi = simd_sum((uint)(term >> 27));
+    const ulong N = ((ulong)thi << 27) + (ulong)tlo;
+    const bool ok = !simd_any(bad) && N < (1ull << 53) && N != 0;
+    float sf;
+    if (MUT & MP_NOSF) sf = 1.0f;
+    else if (ok) { const int msb = 63 - X_CLZ64(N); sf = sd_to_float(sd_make(N << (52 - msb), lmin - (52 - msb), 0)); }
+    else sf = xs_seqsum8(twk[0], twk[1], twk[2], twk[3], twk[4], twk[5], twk[6], twk[7]);
+    if (!(MUT & MM_NO_CLAMP) && sf < 6.103515625e-5f) sf = 6.103515625e-5f;
+    if (l < MOE_EU) { B->ids[l] = tid8[l]; B->wn[l] = (MUT & MM_NO_RENORM) ? w : (MUT & MP_HWDIV) ? w / sf : fx_fdiv(w, sf); }
+  }
+}
+
+// f35_group: ONE threadgroup of 256 (thread e = expert e): a stable counting sort of the nt x 8 (token, rank)
+// entries q = 8 t + k by expert (ascending q within an expert), the per-expert tiles of <= 32 entries, the inverse
+INLINE u32 f35_eid(device const MoeBuf* B, u32 q) {
+  return (u32)B[q >> 3].ids[q & 7];
+}
+
+kernel void f35_group(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant F35GArgs& A [[buffer(2)]], uint e [[thread_index_in_threadgroup]]) {
+  device const MoeBuf* B = (device const MoeBuf*)(S + (A.b & ~SA_SCR));
+  device u32* G = (device u32*)(S + (A.g & ~SA_SCR));
+  threadgroup u32 cnt[256], off[256], toff[256];
+  // the entries' expert ids as bytes in threadgroup memory (up to F35_GSM entries; else read from the MoeBuf rows)
+  threadgroup uchar ib[F35_GSM];
+  const u32 n8 = A.nt * 8;
+  const bool sm = n8 <= F35_GSM;
+  if (sm) {
+    for (u32 q = e; q < n8; q += 256) {
+      ib[q] = (uchar)f35_eid(B, q);
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  u32 c = 0;
+  if (sm) {
+    for (u32 q = 0; q < n8; q += 4) {
+      const uchar4 v = *(threadgroup const uchar4*)(ib + q);
+      c += (v.x == e ? 1u : 0u) + (v.y == e ? 1u : 0u) + (v.z == e ? 1u : 0u) + (v.w == e ? 1u : 0u);
+    }
+  } else {
+    for (u32 q = 0; q < n8; q += 1) {
+      c += f35_eid(B, q) == e ? 1u : 0u;
+    }
+  }
+  cnt[e] = c;
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (e == 0) {
+    u32 a = 0, t = 0;
+    for (u32 j = 0; j < 256; j += 1) {
+      off[j] = a;
+      toff[j] = t;
+      a += cnt[j];
+      t += (cnt[j] + 31) / 32;
+    }
+    G[F35_GNT] = t;
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  const u32 o = off[e];
+  G[F35_GCNT + e] = c;
+  G[F35_GOFF + e] = o;
+  u32 p = o;
+  for (u32 q = 0; q < n8 && p < o + c; q += 1) {
+    if ((sm ? (u32)ib[q] : f35_eid(B, q)) == e) {
+      G[F35_GLIST + p] = q;
+      G[F35_GINV + q] = p;
+      p += 1;
+    }
+  }
+  for (u32 j = 0; 32 * j < c; j += 1) {
+    device u32* tl = G + F35_GTILE + 3 * (toff[e] + j);
+    tl[0] = e;
+    tl[1] = o + 32 * j;
+    tl[2] = c - 32 * j < 32 ? c - 32 * j : 32;
+  }
+}
+
+// f35_mm: M26's tile (llb_f27_mm: 128 threads, 64 weight rows x 32 entries, K steps of 32, f32 operands) over the
+// tiles of f35_group: tile tg.x = (expert, first entry position p0, rows); tg.y = segment (gate / up) x 64-row
+// tile; weights = the bound buffer (3 or 4) + expert x es; X rows gathered by token (gather) or by position; Y rows
+// at the entry positions. QT 4 Q4_K, 5 Q5_K, 6 Q6_K (ggml's dequantize_row_*)
+template <short QT>
+INLINE void f35_mm(device u8* S, device const u8* W0, device const u8* W1, constant F35MArgs& A,
+  uint3 tg, ushort ti, ushort sg, threadgroup float* shm) {
+  device const u32* G = (device const u32*)(S + (A.g & ~SA_SCR));
+  if (tg.x >= G[F35_GNT]) {
+    return;
+  }
+  device const u32* tl = G + F35_GTILE + 3 * tg.x;
+  const u32 ex = tl[0], p0 = tl[1], rt = A.M / 64, seg = tg.y / rt;
+  threadgroup float* sa = shm;
+  threadgroup float* sb = shm + 2048;
+  const int r0 = (int)(tg.y % rt) * 64;
+  const short nr1 = (short)tl[2];
+  const short lr0 = (short)(ti / 2);
+  const short il0 = ti % 2;
+  device const u8* wr = (seg == 0 ? W0 : W1) + (u64)ex * A.es + (u64)(r0 + lr0) * A.rb;
+  const short lr1 = (short)(ti / 4) < nr1 ? (short)(ti / 4) : nr1 - 1;
+  const short ix = 8 * (ti % 4);
+  const u32 xr = A.gather != 0 ? G[F35_GLIST + p0 + lr1] >> 3 : p0 + lr1;
+  device const float* xp = (device const float*)(S + (A.x & ~SA_SCR)) + (u64)xr * A.xs + ix;
+  simdgroup_float8x8 ma[4];
+  simdgroup_float8x8 mb[2];
+  simdgroup_float8x8 mc[8];
+  F27_UNROLL (short i = 0; i < 8; i++) {
+    mc[i] = make_filled_simdgroup_matrix<float, 8>(0.f);
+  }
+  const short sya = (ti / 2) / 8, lxa = (ti / 2) % 8;
+  const short syb = (ti / 4) / 8, lyb = (ti / 4) % 8, sxb = ti % 4;
+  for (uint k = 0; k < A.K; k += 32) {
+    float v[16];
+    if (QT == 4) {
+      f27_deq4(wr + (k >> 8) * 144, (short)((k & 255) + 16 * il0), v);
+    } else if (QT == 5) {
+      f27_deq5(wr + (k >> 8) * 176, (short)((k & 255) + 16 * il0), v);
+    } else {
+      f27_deq6(wr + (k >> 8) * 210, (short)((k & 255) + 16 * il0), v);
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    F27_UNROLL (short i = 0; i < 16; i++) {
+      const short sx = 2 * il0 + i / 8, ly = i % 8;
+      sa[64 * (8 * sx + sya) + 8 * ly + lxa] = v[i];
+    }
+    *(threadgroup float2x4*)(sb + 64 * (4 * sxb + syb) + 8 * lyb) =
+      *(device const float2x4*)xp;
+    xp += 32;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    threadgroup const float* lsma = sa + 4 * 64 * (sg % 2);
+    threadgroup const float* lsmb = sb + 2 * 64 * (sg / 2);
+    F27_UNROLL (short ik = 0; ik < 4; ik++) {
+      simdgroup_barrier(mem_flags::mem_none);
+      F27_UNROLL (short i = 0; i < 4; i++) {
+        simdgroup_load(ma[i], lsma + 64 * i, 8, 0, false);
+      }
+      simdgroup_barrier(mem_flags::mem_none);
+      F27_UNROLL (short i = 0; i < 2; i++) {
+        simdgroup_load(mb[i], lsmb + 64 * i, 8, 0, false);
+      }
+      simdgroup_barrier(mem_flags::mem_none);
+      F27_UNROLL (short i = 0; i < 8; i++) {
+        simdgroup_multiply_accumulate(mc[i], mb[i / 4], ma[i % 4], mc[i]);
+      }
+      lsma += 8 * 64;
+      lsmb += 4 * 64;
+    }
+  }
+  device float* Y = (device float*)(S + ((seg == 0 ? A.y0 : A.y1) & ~SA_SCR));
+  if (nr1 == 32) {
+    device float* Cp = Y + (r0 + 32 * (sg & 1)) + (u64)(p0 + 16 * (sg >> 1)) * A.ys;
+    F27_UNROLL (short i = 0; i < 8; i++) {
+      simdgroup_store(mc[i], Cp + 8 * (i % 4) + (u64)8 * A.ys * (i / 4), A.ys, 0, false);
+    }
+    return;
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  threadgroup float* ts = shm + 32 * (sg & 1) + (16 * (sg >> 1)) * 64;
+  F27_UNROLL (short i = 0; i < 8; i++) {
+    simdgroup_store(mc[i], ts + 8 * (i % 4) + 8 * 64 * (i / 4), 64, 0, false);
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  for (int e = ti; e < 32 * 64; e += 128) {
+    const short t = e / 64, r = e % 64;
+    if (t < nr1) {
+      Y[(u64)(p0 + t) * A.ys + r0 + r] = shm[e];
+    }
+  }
+}
+
+kernel void f35_mmk4(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant F35MArgs& A [[buffer(2)]], device const u8* W0 [[buffer(3)]],
+  device const u8* W1 [[buffer(4)]], uint3 tg [[threadgroup_position_in_grid]],
+  ushort ti [[thread_index_in_threadgroup]], ushort sg [[simdgroup_index_in_threadgroup]]) {
+  threadgroup float shm[3072];
+  f35_mm<4>(S, W0, W1, A, tg, ti, sg, shm);
+}
+
+kernel void f35_mmk5(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant F35MArgs& A [[buffer(2)]], device const u8* W0 [[buffer(3)]],
+  device const u8* W1 [[buffer(4)]], uint3 tg [[threadgroup_position_in_grid]],
+  ushort ti [[thread_index_in_threadgroup]], ushort sg [[simdgroup_index_in_threadgroup]]) {
+  threadgroup float shm[3072];
+  f35_mm<5>(S, W0, W1, A, tg, ti, sg, shm);
+}
+
+kernel void f35_mmk6(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant F35MArgs& A [[buffer(2)]], device const u8* W0 [[buffer(3)]],
+  device const u8* W1 [[buffer(4)]], uint3 tg [[threadgroup_position_in_grid]],
+  ushort ti [[thread_index_in_threadgroup]], ushort sg [[simdgroup_index_in_threadgroup]]) {
+  threadgroup float shm[3072];
+  f35_mm<6>(S, W0, W1, A, tg, ti, sg, shm);
+}
+
+// f35_silu: z[r] = moe_silu(x[r], y[r]) (the decode's SiLU-mul) for row g.y < n of 512 (rows at xs / ys floats)
+kernel void f35_silu(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant F35GArgs& A [[buffer(2)]], uint2 g [[thread_position_in_grid]]) {
+  if (g.y >= A.n || g.x >= 512) {
+    return;
+  }
+  const u64 o = (u64)g.y * A.xs * 4;
+  const float G = sa_f(C, S, A.x + o)[g.x], U = sa_f(C, S, A.y + o)[g.x];
+  sa_f(C, S, A.z + (u64)g.y * A.ys * 4)[g.x] = moe_silu(G, U);
+}
+
+// f35_comb: token row g.y, column g.x: y = x1 + (moe + gs sd), moe = the 8 ranks' wn[k] down_k summed in rank order
+// (moe_dn's combine: wt[0] + wt[1] + .. + wt[7], then the gated shared expert LAST); x1 at x, sd at z, the routed
+// down rows (2048 floats a position) at w; y may be the token's x slot
+kernel void f35_comb(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant F35GArgs& A [[buffer(2)]], uint2 g [[thread_position_in_grid]]) {
+  const u32 c = g.x, t = g.y;
+  if (t >= A.nt || c >= 2048) {
+    return;
+  }
+  device const MoeBuf* B = (device const MoeBuf*)(S + (A.b & ~SA_SCR)) + t;
+  device const u32* G = (device const u32*)(S + (A.g & ~SA_SCR));
+  device const float* D = sa_f(C, S, A.w);
+  float moe = D[(u64)G[F35_GINV + 8 * t] * 2048 + c] * B->wn[0];
+  for (u32 k = 1; k < 8; k += 1) {
+    moe = moe + D[(u64)G[F35_GINV + 8 * t + k] * 2048 + c] * B->wn[k];
+  }
+  const float ffn = moe + sa_f(C, S, A.z + (u64)t * A.xs * 4)[c] * B->gs;
+  const float x1 = sa_f(C, S, A.x + (u64)t * A.xs * 4)[c];
+  sa_f(C, S, A.y + (u64)t * A.ys * 4)[c] = x1 + ffn;
+}
+
+// ---- (lane m32, f35 lever X) the routed experts in the DECODE's arithmetic, grouped by expert. For every entry
+// (token t, rank k) of a tile, each output is computed with moe_gu's / moe_dn's own per-lane leaves (kq_fused45 /
+// kq_fused6 on the same superblock words and the same x lanes) and the same lane trees, so for the same h2 row and the
+// same expert the gate / up / SiLU / down values are the decode's bits. Only the order of the work changes: the
+// weight words of a row block are loaded once per tile, x / act rows are staged in threadgroup memory.
+// f35_xgu: tile tg.x (expert, <= 32 entries), 16-row block tg.y (32 blocks of 512); 8 simdgroups: half p = sg & 1
+// (moe_gu's simdgroup = the pair p), rows 16 tg.y + 4 (sg >> 1) + j, j < 4; act at A.y0 + position 512 floats
+template <u32 FG>
+INLINE void f35_xgu_t(device u8* S, device const u8* Wg, device const u8* Wu, constant F35MArgs& A, uint2 tg,
+  ushort ti, ushort l, ushort sg, threadgroup float* xs, threadgroup float* part) {
+  typedef KQ<FG> F;
+  device const u32* G = (device const u32*)(S + (A.g & ~SA_SCR));
+  if (tg.x >= G[F35_GNT]) {
+    return;
+  }
+  device const u32* tl = G + F35_GTILE + 3 * tg.x;
+  const u32 ex = tl[0], p0 = tl[1], n = tl[2], p = sg & 1, rq = sg >> 1;
+  const u64 rb = (MOE_D / 256) * F::SB;
+  const u32 slo = F::slo(l), shi = slo + (1u << F::KIN);
+  uint4 gh[4], gq[4], gqh[4], uh[4], uq[4], uqh[4];
+  for (u32 j = 0; j < 4; j++) {
+    const u64 ob = (u64)ex * A.es + (u64)(tg.y * 16 + rq * 4 + j) * rb + (u64)(4 * p + (l >> 3)) * F::SB;
+    gh[j] = *(device const uint4*)(Wg + ob);
+    uh[j] = *(device const uint4*)(Wu + ob);
+    if (FG == 9) {
+      gqh[j] = *(device const uint4*)(Wg + ob + 16 + 16 * (l & 1));
+      uqh[j] = *(device const uint4*)(Wu + ob + 16 + 16 * (l & 1));
+      gq[j] = *(device const uint4*)(Wg + ob + 48 + 32 * ((l >> 1) & 3) + 16 * (l & 1));
+      uq[j] = *(device const uint4*)(Wu + ob + 48 + 32 * ((l >> 1) & 3) + 16 * (l & 1));
+    } else {
+      gqh[j] = uint4(0);
+      uqh[j] = uint4(0);
+      gq[j] = *(device const uint4*)(Wg + ob + 16 + 32 * ((l >> 1) & 3) + 16 * (l & 1));
+      uq[j] = *(device const uint4*)(Wu + ob + 16 + 32 * ((l >> 1) & 3) + 16 * (l & 1));
+    }
+  }
+  device const float* X = (device const float*)(S + (A.x & ~SA_SCR));
+  device float* act = (device float*)(S + (A.y0 & ~SA_SCR));
+  for (u32 e = 0; e < n; e += 1) {
+    device const float4* xr = (device const float4*)(X + (u64)(G[F35_GLIST + p0 + e] >> 3) * A.xs);
+    for (u32 c = ti; c < 512; c += 256) {
+      ((threadgroup float4*)xs)[c] = xr[c];
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    float4 xl[4], xh[4];
+    for (u32 t = 0; t < 4; t++) {
+      xl[t] = *(threadgroup const float4*)(xs + 1024 * p + 16 * slo + 4 * t);
+      xh[t] = *(threadgroup const float4*)(xs + 1024 * p + 16 * shi + 4 * t);
+    }
+    for (u32 j = 0; j < 4; j++) {
+      const float2 a = kq_fused45<FG == 9>(gh[j], gq[j], gqh[j], l, xl, xh);
+      const float2 b = kq_fused45<FG == 9>(uh[j], uq[j], uqh[j], l, xl, xh);
+      const float gv = kq_pair_tree<F::KIN, 0>(a.x, a.y, l), uv = kq_pair_tree<F::KIN, 0>(b.x, b.y, l);
+      if (l == 0) {
+        part[(rq * 4 + j) * 4 + 2 * p] = gv;
+        part[(rq * 4 + j) * 4 + 2 * p + 1] = uv;
+      }
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (ti < 16) {
+      // moe_gu V0's join: part[0] + part[1] (pair 0 + pair 1), then moe_silu
+      const float Gv = part[ti * 4] + part[ti * 4 + 2], Uv = part[ti * 4 + 1] + part[ti * 4 + 3];
+      act[(u64)(p0 + e) * 512 + tg.y * 16 + ti] = moe_silu(Gv, Uv);
+    }
+  }
+}
+
+kernel void f35_xgu4(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant F35MArgs& A [[buffer(2)]], device const u8* Wg [[buffer(3)]], device const u8* Wu [[buffer(4)]],
+  uint2 tg [[threadgroup_position_in_grid]], ushort ti [[thread_index_in_threadgroup]],
+  ushort l [[thread_index_in_simdgroup]], ushort sg [[simdgroup_index_in_threadgroup]]) {
+  threadgroup float xs[2048];
+  threadgroup float part[64];
+  f35_xgu_t<4>(S, Wg, Wu, A, tg, ti, l, sg, xs, part);
+}
+
+kernel void f35_xgu9(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant F35MArgs& A [[buffer(2)]], device const u8* Wg [[buffer(3)]], device const u8* Wu [[buffer(4)]],
+  uint2 tg [[threadgroup_position_in_grid]], ushort ti [[thread_index_in_threadgroup]],
+  ushort l [[thread_index_in_simdgroup]], ushort sg [[simdgroup_index_in_threadgroup]]) {
+  threadgroup float xs[2048];
+  threadgroup float part[64];
+  f35_xgu_t<9>(S, Wg, Wu, A, tg, ti, l, sg, xs, part);
+}
+
+// f35_xdn2: the routed down rows in moe_dn's arithmetic (each half-warp = one rank's slot: the same l16 lanes, leaves
+// and half tree, never mixing halves), each lane's down-row words decoded once (Q5_K: kq_fused45's scales and
+// nibble words; Q6_K: kq_fused6's dl / dg and 6-bit words), 4 rows a simdgroup, the two halves on two entries
+template <u32 FD>
+INLINE void f35_xdn2_t(device u8* S, device const u8* Wd, constant F35MArgs& A, uint2 tg, ushort ti, ushort l,
+  ushort sg, threadgroup float* as) {
+  typedef KQ<FD> F;
+  device const u32* G = (device const u32*)(S + (A.g & ~SA_SCR));
+  if (tg.x >= G[F35_GNT]) {
+    return;
+  }
+  device const u32* tl = G + F35_GTILE + 3 * tg.x;
+  const u32 ex = tl[0], p0 = tl[1], n = tl[2], h = l >> 4, l16 = l & 15;
+  const u64 rb = (MOE_FF / 256) * F::SB;
+  const u32 slo = F::slo(l16), shi = slo + (1u << F::KIN);
+  float da[4], ma[4], db[4], mb[4];
+  u32 lw[4][4], hwd[4][4];
+  F27_UNROLL (u32 jr = 0; jr < 4; jr++) {
+    device const u8* B = Wd + (u64)ex * A.es + (u64)(tg.y * 32 + sg * 4 + jr) * rb + (u64)(l16 >> 3) * F::SB;
+    if (FD == 6) {
+      const u32 jj = l16 & 7, ss = (jj & 3) + 8 * (jj >> 2);
+      const uint4 q = kq_ld16_a2(B + 16 * jj);
+      const uint4 hq = kq_ld16_a2(B + 128 + 32 * (jj >> 2) + 16 * (jj & 1));
+      const float d = kq_hf(*(device const ushort*)(B + 208));
+      da[jr] = d * (float)(int)(char)B[192 + ss];
+      db[jr] = d * (float)(int)(char)B[196 + ss];
+      ma[jr] = 0.0f; mb[jr] = 0.0f;
+      const u32 sh = 2 * ((l16 >> 1) & 1);
+      const u32 qw[4] = {q.x, q.y, q.z, q.w}, hw[4] = {hq.x, hq.y, hq.z, hq.w};
+      F27_UNROLL (u32 t = 0; t < 4; t++) {
+        lw[jr][t] = (qw[t] & 0x0F0F0F0Fu) | (((hw[t] >> sh) & 0x03030303u) << 4);
+        hwd[jr][t] = ((qw[t] >> 4) & 0x0F0F0F0Fu) | (((hw[t] >> (sh + 4)) & 0x03030303u) << 4);
+      }
+    } else {
+      const uint4 hh = *(device const uint4*)B;
+      const uint4 q = *(device const uint4*)(B + 48 + 32 * ((l16 >> 1) & 3) + 16 * (l16 & 1));
+      const uint4 qh = *(device const uint4*)(B + 16 + 16 * (l16 & 1));
+      const u32 j = (l16 >> 1) & 3, k8 = 8 * ((2 * j) & 3);
+      const u32 A0 = (hh.y >> k8) & 255, B0 = (hh.z >> k8) & 255, C0 = (hh.w >> k8) & 255;
+      const u32 A1 = (hh.y >> (k8 + 8)) & 255, B1 = (hh.z >> (k8 + 8)) & 255, C1 = (hh.w >> (k8 + 8)) & 255;
+      const bool lo4 = j < 2;
+      const u32 ds0 = lo4 ? (A0 & 63) : ((C0 & 15) | ((A0 >> 6) << 4)), ms0 = lo4 ? (B0 & 63) : ((C0 >> 4) | ((B0 >> 6) << 4));
+      const u32 ds1 = lo4 ? (A1 & 63) : ((C1 & 15) | ((A1 >> 6) << 4)), ms1 = lo4 ? (B1 & 63) : ((C1 >> 4) | ((B1 >> 6) << 4));
+      const float d = kq_hf(hh.x & 0xffffu), dm = kq_hf(hh.x >> 16);
+      da[jr] = d * (float)ds0; ma[jr] = dm * (float)ms0; db[jr] = d * (float)ds1; mb[jr] = dm * (float)ms1;
+      const u32 qw[4] = {q.x, q.y, q.z, q.w}, hw[4] = {qh.x, qh.y, qh.z, qh.w};
+      F27_UNROLL (u32 t = 0; t < 4; t++) {
+        lw[jr][t] = (qw[t] & 0x0F0F0F0Fu) | (((hw[t] >> (2 * j)) & 0x01010101u) << 4);
+        hwd[jr][t] = ((qw[t] >> 4) & 0x0F0F0F0Fu) | (((hw[t] >> (2 * j + 1)) & 0x01010101u) << 4);
+      }
+    }
+  }
+  device const float* act = (device const float*)(S + (A.x & ~SA_SCR));
+  device float* D = (device float*)(S + (A.y0 & ~SA_SCR));
+  for (u32 e0 = 0; e0 < n; e0 += 8) {
+    const u32 m = n - e0 < 8 ? n - e0 : 8;
+    for (u32 c = ti; c < m * 128; c += 256) {
+      ((threadgroup float4*)as)[c] = ((device const float4*)(act + (u64)(p0 + e0) * 512))[c];
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (u32 e = h; e < m; e += 2) {
+      threadgroup const float* xa = as + e * 512;
+      float4 xl[4], xh[4];
+      F27_UNROLL (u32 t = 0; t < 4; t++) {
+        xl[t] = *(threadgroup const float4*)(xa + 16 * slo + 4 * t);
+        xh[t] = *(threadgroup const float4*)(xa + 16 * shi + 4 * t);
+      }
+      F27_UNROLL (u32 jr = 0; jr < 4; jr++) {
+        float Ll[4], Lh[4];
+        F27_UNROLL (u32 t = 0; t < 4; t++) {
+          float4 wl, wh;
+          if (FD == 6) {
+            wl = da[jr] * (float4(as_type<uchar4>(lw[jr][t])) - 32.0f);
+            wh = db[jr] * (float4(as_type<uchar4>(hwd[jr][t])) - 32.0f);
+          } else {
+            wl = fma(float4(da[jr]), float4(as_type<uchar4>(lw[jr][t])), float4(-ma[jr]));
+            wh = fma(float4(db[jr]), float4(as_type<uchar4>(hwd[jr][t])), float4(-mb[jr]));
+          }
+          Ll[t] = kq_leaf4(wl, xl[t]);
+          Lh[t] = kq_leaf4(wh, xh[t]);
+        }
+        float lo = (Ll[0] + Ll[1]) + (Ll[2] + Ll[3]), hi = (Lh[0] + Lh[1]) + (Lh[2] + Lh[3]);
+        for (u32 mm = 1; mm < (1u << F::KIN); mm <<= 1) {
+          lo = kq_bfly(lo, l, mm);
+          hi = kq_bfly(hi, l, mm);
+        }
+        float v = lo + hi;
+        for (u32 mm = 1u << F::KIN; mm < 16; mm <<= 1) {
+          v = kq_bfly(v, l, mm);
+        }
+        if (l16 == 0) {
+          D[(u64)(p0 + e0 + e) * 2048 + tg.y * 32 + sg * 4 + jr] = v;
+        }
+      }
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+  }
+}
+
+kernel void f35_xdn2q5(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant F35MArgs& A [[buffer(2)]], device const u8* Wd [[buffer(3)]],
+  uint2 tg [[threadgroup_position_in_grid]], ushort ti [[thread_index_in_threadgroup]],
+  ushort l [[thread_index_in_simdgroup]], ushort sg [[simdgroup_index_in_threadgroup]]) {
+  threadgroup float as[8 * 512];
+  f35_xdn2_t<9>(S, Wd, A, tg, ti, l, sg, as);
+}
+
+kernel void f35_xdn2q6(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant F35MArgs& A [[buffer(2)]], device const u8* Wd [[buffer(3)]],
+  uint2 tg [[threadgroup_position_in_grid]], ushort ti [[thread_index_in_threadgroup]],
+  ushort l [[thread_index_in_simdgroup]], ushort sg [[simdgroup_index_in_threadgroup]]) {
+  threadgroup float as[8 * 512];
+  f35_xdn2_t<6>(S, Wd, A, tg, ti, l, sg, as);
+}
+
+// f35_xsgu: the shared expert's gate / up / SiLU (moe_gu's slot 8: moe_q8_half2048 per pair, part[0] + part[1],
+// moe_silu) for token tile tg.x (32 rows), 16-row block tg.y (32 blocks of 512); 8 simdgroups: pair p = sg & 1, rows
+// 16 tg.y + 4 (sg >> 1) + j
+INLINE float f35_q8h(uint4 q0, uint4 q1, float s0, float s1, threadgroup const float* x, u32 g0) {
+  float d[8];
+  const uint4 qq[2] = {q0, q1};
+  const float ss[2] = {s0, s1};
+  for (u32 k = 0; k < 2; k++) {
+    const u32 g = g0 + 4 * k;
+    const uint4 q = qq[k];
+    const float s = ss[k];
+    d[4 * k + 0] = moe_leaf4(float4(as_type<char4>(q.x)) * s, *(threadgroup const float4*)(x + 4 * g));
+    d[4 * k + 1] = moe_leaf4(float4(as_type<char4>(q.y)) * s, *(threadgroup const float4*)(x + 4 * g + 4));
+    d[4 * k + 2] = moe_leaf4(float4(as_type<char4>(q.z)) * s, *(threadgroup const float4*)(x + 4 * g + 8));
+    d[4 * k + 3] = moe_leaf4(float4(as_type<char4>(q.w)) * s, *(threadgroup const float4*)(x + 4 * g + 12));
+  }
+  return ((d[0] + d[1]) + (d[2] + d[3])) + ((d[4] + d[5]) + (d[6] + d[7]));
+}
+
+kernel void f35_xsgu(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant F35SArgs& A [[buffer(2)]], uint2 tg [[threadgroup_position_in_grid]],
+  ushort ti [[thread_index_in_threadgroup]], ushort l [[thread_index_in_simdgroup]],
+  ushort sg [[simdgroup_index_in_threadgroup]]) {
+  threadgroup float xs[2048];
+  threadgroup float part[64];
+  const u32 p = sg & 1, rq = sg >> 1, g0 = 256 * p + 8 * l;
+  uint4 gq0[4], gq1[4], uq0[4], uq1[4];
+  float gs0[4], gs1[4], us0[4], us1[4];
+  for (u32 j = 0; j < 4; j++) {
+    const u64 o = (u64)(tg.y * 16 + rq * 4 + j) * (MOE_D + MOE_D / 16);
+    device const u8* rg = C + A.wg + o;
+    device const u8* ru = C + A.wu + o;
+    gq0[j] = *(device const uint4*)(rg + 4 * g0); gq1[j] = *(device const uint4*)(rg + 4 * (g0 + 4));
+    uq0[j] = *(device const uint4*)(ru + 4 * g0); uq1[j] = *(device const uint4*)(ru + 4 * (g0 + 4));
+    gs0[j] = (float)as_type<half>(*(device const ushort*)(rg + 2048 + 2 * (g0 >> 3)));
+    gs1[j] = (float)as_type<half>(*(device const ushort*)(rg + 2048 + 2 * ((g0 + 4) >> 3)));
+    us0[j] = (float)as_type<half>(*(device const ushort*)(ru + 2048 + 2 * (g0 >> 3)));
+    us1[j] = (float)as_type<half>(*(device const ushort*)(ru + 2048 + 2 * ((g0 + 4) >> 3)));
+  }
+  const u32 t0 = tg.x * 32, tn = A.nt - t0 < 32 ? A.nt - t0 : 32;
+  for (u32 e = 0; e < tn; e += 1) {
+    device const float4* xr = (device const float4*)sa_f(C, S, A.x + (u64)(t0 + e) * A.xs * 4);
+    for (u32 c = ti; c < 512; c += 256) {
+      ((threadgroup float4*)xs)[c] = xr[c];
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (u32 j = 0; j < 4; j++) {
+      const float gv = moe_bfly_all(f35_q8h(gq0[j], gq1[j], gs0[j], gs1[j], xs, g0), l);
+      const float uv = moe_bfly_all(f35_q8h(uq0[j], uq1[j], us0[j], us1[j], xs, g0), l);
+      if (l == 0) {
+        part[(rq * 4 + j) * 4 + 2 * p] = gv;
+        part[(rq * 4 + j) * 4 + 2 * p + 1] = uv;
+      }
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (ti < 16) {
+      const float Gv = part[ti * 4] + part[ti * 4 + 2], Uv = part[ti * 4 + 1] + part[ti * 4 + 3];
+      sa_f(C, S, A.y + (u64)(t0 + e) * A.ys * 4)[tg.y * 16 + ti] = moe_silu(Gv, Uv);
+    }
+  }
+}
+
+// f35_xsdn: the shared expert's down row (moe_dn's: lane l = groups 4l .. 4l+3 of the 512-col Q8_0 row, the leaf
+// pairs, moe_bfly_all) for token tile tg.x (32 rows), 32-row block tg.y (64 blocks of 2048); 8 simdgroups x 4 rows
+kernel void f35_xsdn(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant F35SArgs& A [[buffer(2)]], uint2 tg [[threadgroup_position_in_grid]],
+  ushort ti [[thread_index_in_threadgroup]], ushort l [[thread_index_in_simdgroup]],
+  ushort sg [[simdgroup_index_in_threadgroup]]) {
+  threadgroup float xs[512];
+  uint4 q[4];
+  float sc[4];
+  for (u32 j = 0; j < 4; j++) {
+    device const u8* row = C + A.wg + (u64)(tg.y * 32 + sg * 4 + j) * (MOE_FF + MOE_FF / 16);
+    q[j] = *(device const uint4*)(row + 16 * l);
+    sc[j] = (float)as_type<half>(*(device const ushort*)(row + MOE_FF + 2 * (l >> 1)));
+  }
+  const u32 t0 = tg.x * 32, tn = A.nt - t0 < 32 ? A.nt - t0 : 32;
+  for (u32 e = 0; e < tn; e += 1) {
+    device const float4* xr = (device const float4*)sa_f(C, S, A.x + (u64)(t0 + e) * A.xs * 4);
+    if (ti < 128) {
+      ((threadgroup float4*)xs)[ti] = xr[ti];
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    const float4 x0 = *(threadgroup const float4*)(xs + 16 * l), x1 = *(threadgroup const float4*)(xs + 16 * l + 4);
+    const float4 x2 = *(threadgroup const float4*)(xs + 16 * l + 8), x3 = *(threadgroup const float4*)(xs + 16 * l + 12);
+    for (u32 j = 0; j < 4; j++) {
+      const float s = sc[j];
+      const float v = (moe_leaf4(float4(as_type<char4>(q[j].x)) * s, x0) + moe_leaf4(float4(as_type<char4>(q[j].y)) * s, x1))
+                    + (moe_leaf4(float4(as_type<char4>(q[j].z)) * s, x2) + moe_leaf4(float4(as_type<char4>(q[j].w)) * s, x3));
+      const float shv = moe_bfly_all(v, l);
+      if (l == 0) {
+        sa_f(C, S, A.y + (u64)(t0 + e) * A.ys * 4)[tg.y * 32 + sg * 4 + j] = shv;
+      }
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+  }
+}
+
+// (diagnostic, LLB_F35_IDS) f35_idcp: token row g: its 8 ids, then the 8th and 9th largest probs (bits), into w + g 10
+kernel void f35_idcp(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant F35GArgs& A [[buffer(2)]], uint g [[thread_position_in_grid]]) {
+  if (g >= A.nt) {
+    return;
+  }
+  device const MoeBuf* B = (device const MoeBuf*)(S + (A.b & ~SA_SCR)) + g;
+  device u32* w = (device u32*)sa_f(C, S, A.w) + (u64)g * 10;
+  float t8 = 1e30f, t9 = -1.0f;
+  for (u32 k = 0; k < 8; k++) {
+    w[k] = (u32)B->ids[k];
+    t8 = min(t8, B->probs[B->ids[k]]);
+  }
+  for (u32 e = 0; e < 256; e++) {
+    bool in = false;
+    for (u32 k = 0; k < 8; k++) {
+      in = in || (u32)B->ids[k] == e;
+    }
+    if (!in) {
+      t9 = max(t9, B->probs[e]);
+    }
+  }
+  w[8] = as_type<u32>(t8);
+  w[9] = as_type<u32>(t9);
+}
+
+// (diagnostic, LLB_F35_DBG) f35_dcmp: token row g: max over the 2048 columns of |y - (x1 + ffn_t)| (y at y, x1 at x, the
+// decode MoE's per-token output rows at z: ffn at z + 2048) and of |ffn_t| into w[g * 2 + 0 / 1]; one threadgroup of 256
+kernel void f35_dcmp(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant F35GArgs& A [[buffer(2)]], uint g [[threadgroup_position_in_grid]],
+  uint t [[thread_index_in_threadgroup]], uint l [[thread_index_in_simdgroup]],
+  uint sg [[simdgroup_index_in_threadgroup]]) {
+  threadgroup float m0[8], m1[8];
+  device const float* y = sa_f(C, S, A.y + (u64)g * A.ys * 4);
+  device const float* x1 = sa_f(C, S, A.x + (u64)g * A.xs * 4);
+  device const float* f = sa_f(C, S, A.z + (u64)g * A.xs * 4) + 2048;
+  float a = 0.0f, b = 0.0f;
+  for (u32 c = t; c < 2048; c += 256) {
+    a = max(a, fabs(y[c] - (x1[c] + f[c])));
+    b = max(b, fabs(f[c]));
+  }
+  a = simd_max(a); b = simd_max(b);
+  if (l == 0) { m0[sg] = a; m1[sg] = b; }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (t == 0) {
+    for (u32 j = 1; j < 8; j += 1) { a = max(a, m0[j]); b = max(b, m1[j]); }
+    device float* w = sa_f(C, S, A.w);
+    w[2 * g] = max(a, m0[0]); w[2 * g + 1] = max(b, m1[0]);
+  }
+}
+
+// f35_f32ab: llb_m_f32ab (the F32 ssm_beta / ssm_alpha rows, moe_rdot's lane tree) for token row g2.y: x at
+// a[2] + row s[2], y at a[3] + row s[3]
+kernel void f35_f32ab(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant HybTArgs& A [[buffer(2)]], uint2 g2 [[threadgroup_position_in_grid]],
+  uint l [[thread_index_in_simdgroup]], uint sg [[simdgroup_index_in_threadgroup]],
+  uint ns [[simdgroups_per_threadgroup]]) {
+  const u32 row = g2.x * ns + sg;
+  if (row >= 2 * A.n) {
+    return;
+  }
+  device const float* w = sa_f(C, S, row < A.n ? A.a[0] : A.a[1])
+    + (u64)(row % A.n) * 2048 + 64 * l;
+  device const float* x = sa_f(C, S, A.a[2] + (u64)g2.y * A.s[2]) + 64 * l;
+  const float s0 = moe_f32_span16(w, x), s1 = moe_f32_span16(w + 16, x + 16);
+  const float s2 = moe_f32_span16(w + 32, x + 32), s3 = moe_f32_span16(w + 48, x + 48);
+  const float v = moe_bfly_all((s0 + s1) + (s2 + s3), l);
+  if (l == 0) {
+    sa_f(C, S, A.a[3] + (u64)g2.y * A.s[3])[row] = v;
+  }
+}
+
+// f35_attn: lane m21's flash attention (f27_attn_g) at the 35B's GQA 8 and kv rows of 512 floats (2 kv heads x 256)
+template <short F27_G>
+INLINE void f35_attn_g(device u8* C, device u8* S, constant FAttArgs& A,
+  uint2 tg, ushort sg, ushort l, threadgroup float (*ssh)[8 * 32],
+  threadgroup float (*dsh)[64]) {
+  const u32 g = tg.x, r0 = tg.y * 8, h = F27_G * g + sg;
+  const u32 nr = A.nt - r0 < 8 ? A.nt - r0 : 8;
+  const u32 kmax = A.pos0 + r0 + nr - 1;
+  device const float* qb = sa_f(C, S, A.q) + (u64)r0 * A.qs + h * 256;
+  device const float* kb0 = sa_f(C, S, A.kc) + g * 256;
+  device const float* vb0 = sa_f(C, S, A.vc) + g * 256;
+  threadgroup float* ss = ssh[sg];
+  threadgroup float* ds = dsh[sg];
+  simdgroup_float8x8 O[32];
+  F27_UNROLL (short d = 0; d < 32; d++) {
+    O[d] = make_filled_simdgroup_matrix<float, 8>(0.f);
+  }
+  const u32 ri = l / 4, rc = l % 4;
+  const u32 rpos = A.pos0 + r0 + ri;
+  float m = as_type<float>(0xFF800000u), lsum = 0.0f;
+  for (u32 kb = 0; kb <= kmax; kb += 32) {
+    simdgroup_float8x8 sc[4];
+    F27_UNROLL (short j = 0; j < 4; j++) {
+      sc[j] = make_filled_simdgroup_matrix<float, 8>(0.f);
+    }
+    for (short d = 0; d < 32; d++) {
+      simdgroup_float8x8 mq;
+      simdgroup_load(mq, qb + 8 * d, A.qs, 0, false);
+      F27_UNROLL (short j = 0; j < 4; j++) {
+        simdgroup_float8x8 mk;
+        simdgroup_load(mk, kb0 + (u64)(kb + 8 * j) * 512 + 8 * d, 512, 0, true);
+        simdgroup_multiply_accumulate(sc[j], mq, mk, sc[j]);
+      }
+    }
+    F27_UNROLL (short j = 0; j < 4; j++) {
+      simdgroup_store(sc[j], ss + 8 * j, 32, 0, false);
+    }
+    simdgroup_barrier(mem_flags::mem_threadgroup);
+    float x[8];
+    float mb = as_type<float>(0xFF800000u);
+    F27_UNROLL (short e = 0; e < 8; e++) {
+      const u32 t = kb + rc * 8 + e;
+      x[e] = t <= rpos ? ss[ri * 32 + rc * 8 + e] * 0.0625f : as_type<float>(0xFF800000u);
+      mb = max(mb, x[e]);
+    }
+    mb = max(mb, simd_shuffle_xor(mb, 1));
+    mb = max(mb, simd_shuffle_xor(mb, 2));
+    const float mn = max(m, mb);
+    const float alpha = exp(m - mn);
+    float ps = 0.0f;
+    F27_UNROLL (short e = 0; e < 8; e++) {
+      const float pe = exp(x[e] - mn);
+      ss[ri * 32 + rc * 8 + e] = pe;
+      ps += pe;
+    }
+    ps += simd_shuffle_xor(ps, 1);
+    ps += simd_shuffle_xor(ps, 2);
+    lsum = lsum * alpha + ps;
+    m = mn;
+    ds[2 * l] = 0.0f;
+    ds[2 * l + 1] = 0.0f;
+    const float al = simd_shuffle(alpha, (ushort)(4 * (l & 7)));
+    simdgroup_barrier(mem_flags::mem_threadgroup);
+    if (l < 8) {
+      ds[9 * l] = al;
+    }
+    simdgroup_barrier(mem_flags::mem_threadgroup);
+    simdgroup_float8x8 dg;
+    simdgroup_load(dg, ds, 8, 0, false);
+    F27_UNROLL (short d = 0; d < 32; d++) {
+      simdgroup_multiply(O[d], dg, O[d]);
+    }
+    F27_UNROLL (short j = 0; j < 4; j++) {
+      simdgroup_float8x8 pj;
+      simdgroup_load(pj, ss + 8 * j, 32, 0, false);
+      device const float* vr = vb0 + (u64)(kb + 8 * j) * 512;
+      F27_UNROLL (short d = 0; d < 32; d++) {
+        simdgroup_float8x8 mv;
+        simdgroup_load(mv, vr + 8 * d, 512, 0, false);
+        simdgroup_multiply_accumulate(O[d], pj, mv, O[d]);
+      }
+    }
+    simdgroup_barrier(mem_flags::mem_threadgroup);
+  }
+  ds[2 * l] = 0.0f;
+  ds[2 * l + 1] = 0.0f;
+  const float il = simd_shuffle(1.0f / lsum, (ushort)(4 * (l & 7)));
+  simdgroup_barrier(mem_flags::mem_threadgroup);
+  if (l < 8) {
+    ds[9 * l] = il;
+  }
+  simdgroup_barrier(mem_flags::mem_threadgroup);
+  simdgroup_float8x8 dg;
+  simdgroup_load(dg, ds, 8, 0, false);
+  device float* ob = sa_f(C, S, A.att) + (u64)r0 * A.qs + h * 256;
+  F27_UNROLL (short d = 0; d < 32; d++) {
+    simdgroup_float8x8 o;
+    simdgroup_multiply(o, dg, O[d]);
+    simdgroup_store(o, ob + 8 * d, A.qs, 0, false);
+  }
+}
+
+kernel void f35_attn(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant FAttArgs& A [[buffer(2)]], uint2 tg [[threadgroup_position_in_grid]],
+  ushort sg [[simdgroup_index_in_threadgroup]],
+  ushort l [[thread_index_in_simdgroup]]) {
+  threadgroup float ssh[8][8 * 32];
+  threadgroup float dsh[8][64];
+  f35_attn_g<8>(C, S, A, tg, sg, l, ssh, dsh);
+}
+
+// (tools/metal-m25.patch = M24 lever L2) the fused step's embedding: one Q8_0
+// row-split row [n int8][n / 32 f16] of the corpus into y, y[i] = i8 * f16:
+// flat.bend's q8.load (q8.i8 times q8.d, q8.f16 = llb_f16), one fmul. One
+// thread a column
+kernel void llb_m_embq8(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant HybArgs& A [[buffer(2)]], uint i [[thread_position_in_grid]]) {
+  device const u8* row = C + A.a[0];
+  device float* y = sa_f(C, S, A.a[1]);
+  if (i < A.n) {
+    y[i] = (float)(char)row[i]
+      * llb_f16(*(device const ushort*)(row + A.n + 2 * (i >> 5)));
+  }
+}
+
+// (tools/metal-m25.patch, L2 for the 27B) the fused step's Q4_K embedding: the
+// engine's q4k.w (ggml's dequantize_row_q4_K, flat.bend's q4k.sc) of column i
+// of the 144 B-superblock row at corpus byte A.a[0]: d1 = d * sc, m1 = dmin *
+// m (both exact), w = d1 * nib - m1 (the one rounding), into y. One thread a
+// column, i < A.n (d_model); the bytes are read one at a time (no alignment)
+kernel void llb_m_embk4(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant HybArgs& A [[buffer(2)]], uint i [[thread_position_in_grid]]) {
+  device float* y = sa_f(C, S, A.a[1]);
+  if (i >= A.n) {
+    return;
+  }
+  device const u8* a = C + A.a[0] + (u64)(i >> 8) * 144;
+  const u32 rr = i & 255, b = rr >> 6, hi = (rr & 63) >> 5, j = 2 * b + hi;
+  const float d  = llb_f16((u32)a[0] | (u32)a[1] << 8);
+  const float dn = llb_f16((u32)a[2] | (u32)a[3] << 8);
+  const u32 sc = j < 4 ? a[4 + j] & 63 : (a[8 + j] & 15) | (a[j] >> 6) << 4;
+  const u32 mn = j < 4 ? a[8 + j] & 63 : (a[8 + j] >> 4) | (a[4 + j] >> 6) << 4;
+  const float d1 = d * (float)sc;
+  const float m1 = dn * (float)mn;
+  const u32 q = a[16 + 32 * b + (rr & 31)];
+  y[i] = d1 * (float)((q >> (4 * hi)) & 15) - m1;
+}
+
+// (ENGINE-4B, patches/metal-4b.patch) the fused step's Q6_K embedding (the 4B
+// Q4_K_M's tied token_embd, 2100 B rows): column i of the 210 B-superblock row
+// at corpus byte A.a[0] as ggml's dequantize_row_q6_K writes it, y = d * sc *
+// (q - 32) (each product exact: f16 x int8 x 6 bits), the bytes read one at a
+// time. One thread a column, i < A.n (d_model)
+kernel void llb_m_embk6(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant HybArgs& A [[buffer(2)]], uint i [[thread_position_in_grid]]) {
+  device float* y = sa_f(C, S, A.a[1]);
+  if (i >= A.n) {
+    return;
+  }
+  device const u8* a = C + A.a[0] + (u64)(i >> 8) * 210;
+  const u32 r = i & 255, h = r >> 7, g = (r & 127) >> 5, l = r & 31;
+  const u32 ql = a[64 * h + l + (g & 1) * 32], qh = a[128 + 32 * h + l];
+  const u32 q = ((g < 2 ? ql : ql >> 4) & 15) | ((qh >> (2 * g)) & 3) << 4;
+  const float d = llb_f16((u32)a[208] | (u32)a[209] << 8);
+  const float sc = (float)(int)(char)a[192 + 8 * h + l / 16 + 2 * g];
+  y[i] = d * sc * (float)((int)q - 32);
+}
+
+// (tools/metal-m25.patch = M24 lever L10) llb_m_gdl with a simdgroup a row:
+// group (h, quarter), simdgroup sg = row j = 32 quarter + sg, lane l = columns
+// 4l .. 4l+3. The same ops per element (S * decay; S + k * delta) and
+// hyb_dot_128's tree: pair 2l = s0 k0 + s1 k1, pair 2l+1 = s2 k2 + s3 k3, their
+// sum (stride 1), then the butterfly (strides 2 .. 32), a perfect tree in
+// index order. 4 groups of 1024 a head (the 27B: 48 heads, 192 groups).
+// Assumes a SIMD width of 32 (as M18 / M20 / M24's kernels do)
+INLINE float m24_dot4(float4 a, float4 b, u32 l) {
+  float v = (a.x * b.x + a.y * b.y) + (a.z * b.z + a.w * b.w);
+  for (u32 m = 1; m < 32; m <<= 1) {
+    v = kq_bfly(v, l, m);
+  }
+  return v;
+}
+
+kernel void llb_m_gdl2(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant HybArgs& A [[buffer(2)]], uint gid [[threadgroup_position_in_grid]],
+  uint l [[thread_index_in_simdgroup]], uint sg [[simdgroup_index_in_threadgroup]]) {
+  device float* St = sa_f(C, S, A.a[0]);
+  device const float* q   = sa_f(C, S, A.a[1]);
+  device const float* kk  = sa_f(C, S, A.a[2]);
+  device const float* v   = sa_f(C, S, A.a[3]);
+  device const float* dec = sa_f(C, S, A.a[4]);
+  device const float* bet = sa_f(C, S, A.a[5]);
+  device float* y = sa_f(C, S, A.a[6]);
+  const u32 h = gid >> 2, j = ((gid & 3) << 5) + sg;
+  device float4* Sr = (device float4*)(St + (((u64)h * 128 + j) << 7)) + l;
+  const float4 k4 = ((device const float4*)(kk + ((u64)h << 7)))[l];
+  const float4 q4 = ((device const float4*)(q + ((u64)h << 7)))[l];
+  const float decay = dec[h], beta = bet[h];
+  float4 r = *Sr;
+  r = float4(r.x * decay, r.y * decay, r.z * decay, r.w * decay);
+  const float kv = m24_dot4(r, k4, l);
+  const float delta = (v[((u64)h << 7) + j] - kv) * beta;
+  r = float4(r.x + k4.x * delta, r.y + k4.y * delta, r.z + k4.z * delta,
+    r.w + k4.w * delta);
+  *Sr = r;
+  const float o = m24_dot4(r, q4, l);
+  if (l == 0) {
+    y[((u64)h << 7) + j] = o;
+  }
+}
+
+// (tools/metal-moe.patch, M24 lever L4) the 35B's F32 ssm_beta / ssm_alpha
+// [32 x 2048] in ONE dispatch: row r < n of beta (A.a[0]), r >= n of alpha
+// (A.a[1]) into y[r] (bpre, apre adjacent). moe_rdot's lane tree (lane = 64
+// contiguous cols, (s0 + s1) + (s2 + s3), the xor butterfly) is llb_warp's
+// perfect 512-group tree with the same leaf, bit for bit; 4 rows a group
+kernel void llb_m_f32ab(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant HybArgs& A [[buffer(2)]], uint gid [[threadgroup_position_in_grid]],
+  uint l [[thread_index_in_simdgroup]], uint sg [[simdgroup_index_in_threadgroup]],
+  uint ns [[simdgroups_per_threadgroup]]) {
+  const u32 row = gid * ns + sg;
+  if (row >= 2 * A.n) {
+    return;
+  }
+  device const float* w = sa_f(C, S, row < A.n ? A.a[0] : A.a[1])
+    + (u64)(row % A.n) * 2048 + 64 * l;
+  device const float* x = sa_f(C, S, A.a[2]) + 64 * l;
+  const float s0 = moe_f32_span16(w, x), s1 = moe_f32_span16(w + 16, x + 16);
+  const float s2 = moe_f32_span16(w + 32, x + 32), s3 = moe_f32_span16(w + 48, x + 48);
+  const float v = moe_bfly_all((s0 + s1) + (s2 + s3), l);
+  if (l == 0) {
+    sa_f(C, S, A.a[3])[row] = v;
+  }
+}
+
+// The 32-element gated-delta middleware (CUDA's llb_mid32): beta :=
+// sigmoid(bpre); dec := exp(softplus(apre + dt) * ssm_a), softplus through
+// x32_softplus, CUDA's (f32)log(1.0 + exp((double)x)) chain. One group of n.
+// (tools/metal-m25.patch = M24 lever L1) as two dispatches, the same ops on
+// the same values: mid32a the softplus into sp (A.a[6]), mid32b beta and dec.
+// One kernel holding softplus and the exps ran 81 us (code volume: 2 softplus
+// in one kernel 40 us, 1 alone 7.7); the two run 7.7 + 4.9 us (M24's bench).
+kernel void llb_m_mid32a(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant HybArgs& A [[buffer(2)]], uint i [[thread_position_in_threadgroup]]) {
+  device const float* apre = sa_f(C, S, A.a[1]);
+  device const float* dtp  = sa_f(C, S, A.a[2]);
+  device float* spo = sa_f(C, S, A.a[6]);
+  if (i < A.n) {
+    const float x  = apre[i] + dtp[i];
+    spo[i] = 20.0f < x ? x : x32_softplus(x < 88.0f ? x : 88.0f);
+  }
+}
+
+kernel void llb_m_mid32b(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant HybArgs& A [[buffer(2)]], uint i [[thread_position_in_threadgroup]]) {
+  device const float* bpre = sa_f(C, S, A.a[0]);
+  device const float* sap  = sa_f(C, S, A.a[3]);
+  device float* beta = sa_f(C, S, A.a[4]);
+  device float* dec  = sa_f(C, S, A.a[5]);
+  device const float* spi = sa_f(C, S, A.a[6]);
+  if (i < A.n) {
+    const float b = bpre[i];
+    beta[i] = 1.0f / (1.0f + attn_exp(-b));
+    dec[i] = attn_exp(spi[i] * sap[i]);
+  }
+}
+
+// flat.bend's argmax twice over z[0 .. n), y := [v, i, w, j] (CUDA's
+// llb_amax, the head bang's tail). One group of 1024.
+INLINE bool amax_lt(float a, u32 ia, float b, u32 ib) {
+  const bool na = a != a, nb = b != b;
+  if (na || nb) {
+    return na && (!nb || ia < ib);
+  }
+  return a > b || (a == b && ia < ib);
+}
+
+kernel void llb_m_amax(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant HybArgs& A [[buffer(2)]], uint t [[thread_position_in_threadgroup]]) {
+  threadgroup float sv[1024];
+  threadgroup u32   si[1024];
+  device const float* z = sa_f(C, S, A.a[0]);
+  device float* y = sa_f(C, S, A.a[1]);
+  const u32 n = A.n;
+  u32 skip = 0xFFFFFFFFu;
+  for (u32 k = 0; k < 2; k += 1) {
+    float bv = as_type<float>(0xFF800000u);
+    u32   bi = 0xFFFFFFFFu;
+    for (u32 i = t; i < n; i += 1024) {
+      const float v = i == skip ? as_type<float>(0xFF800000u) : z[i];
+      if (amax_lt(v, i, bv, bi)) {
+        bv = v;
+        bi = i;
+      }
+    }
+    sv[t] = bv;
+    si[t] = bi;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (u32 st = 512; st > 0; st >>= 1) {
+      if (t < st && amax_lt(sv[t + st], si[t + st], sv[t], si[t])) {
+        sv[t] = sv[t + st];
+        si[t] = si[t + st];
+      }
+      threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    if (t == 0) {
+      y[2 * k]     = sv[0];
+      y[2 * k + 1] = (float)si[0];
+    }
+    skip = si[0];
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+  }
+}
+
+// K.put's 1024-f32 slot (CUDA's llb_slot): y is already the slot
+kernel void llb_m_slot(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant HybArgs& A [[buffer(2)]], uint t [[thread_position_in_threadgroup]]) {
+  device const float* x = sa_f(C, S, A.a[0]);
+  device float* y = sa_f(C, S, A.a[1]);
+  y[t] = x[t];
+}
+
+// K.qg.go / K.kr.go (CUDA's llb_qkr): per-head qk-norm (rms over 256 with the
+// 256 gain) then the partial NEOX rope (nd 64, base 1e7). c 1: n / 512 heads
+// of [q(256), gate(256)], rope q and copy the gate after all the q heads; c 0:
+// n / 256 k heads. One group of 256 a head; k = pos.
+kernel void llb_m_qkr(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant HybArgs& A [[buffer(2)]], uint hb [[threadgroup_position_in_grid]],
+  uint nh [[threadgroups_per_grid]], uint t [[thread_position_in_threadgroup]]) {
+  threadgroup float a[256];
+  device const float* x = sa_f(C, S, A.a[0]);
+  device const float* w = sa_f(C, S, A.a[1]);
+  device float* y = sa_f(C, S, A.a[2]);
+  const u32 qk = A.c, pos = A.k;
+  device const float* xr = x + (u64)hb * (qk != 0 ? 512 : 256);
+  device float* yr = y + (u64)hb * 256;
+  const float xv = xr[t];
+  const float xb = xr[(t + 32) & 255];
+  const float xg = qk != 0 ? xr[256 + t] : 0.0f;
+  a[t] = xv * xv;
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  for (u32 st = 1; st < 256; st <<= 1) {
+    if ((t & (2 * st - 1)) == 0) {
+      a[t] = a[t] + a[t + st];
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+  }
+  const float s = 1.0f / sqrt(a[0] / 256.0f + as_type<float>(0x358637BDu));
+  const float v = (xv * s) * w[t];
+  if (t < 32) {
+    const float th = (float)pos * x32_pow(10000000.0f, -(float)(2 * t) / 64.0f);
+    const float co = x32_cos(th), si = x32_sin(th);
+    const float b = (xb * s) * w[t + 32];
+    yr[2 * t]     = v * co - b * si;
+    yr[2 * t + 1] = v * si + b * co;
+  } else if (t >= 64) {
+    yr[t] = v;
+  }
+  if (qk != 0) {
+    y[(u64)nh * 256 + (u64)hb * 256 + t] = xg;
+  }
+}
+
+// (tools/metal-m25.patch = M24 lever L5) the rope's 32 (cos, sin) pairs depend
+// on pos and t only: llb_m_ropecs computes them once a command buffer
+// (llb_m_qkr's own expressions) into cs = A.a[3]; llb_m_qkr2 is llb_m_qkr
+// reading them
+kernel void llb_m_ropecs(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant HybArgs& A [[buffer(2)]], uint t [[thread_position_in_threadgroup]]) {
+  device float* cs = sa_f(C, S, A.a[3]);
+  const u32 pos = A.k;
+  if (t < 32) {
+    const float th = (float)pos * x32_pow(10000000.0f, -(float)(2 * t) / 64.0f);
+    const float co = x32_cos(th), si = x32_sin(th);
+    cs[t] = co;
+    cs[32 + t] = si;
+  }
+}
+
+kernel void llb_m_qkr2(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant HybArgs& A [[buffer(2)]], uint hb [[threadgroup_position_in_grid]],
+  uint nh [[threadgroups_per_grid]], uint t [[thread_position_in_threadgroup]]) {
+  threadgroup float a[256];
+  device const float* x = sa_f(C, S, A.a[0]);
+  device const float* w = sa_f(C, S, A.a[1]);
+  device float* y = sa_f(C, S, A.a[2]);
+  const u32 qk = A.c;
+  device const float* xr = x + (u64)hb * (qk != 0 ? 512 : 256);
+  device float* yr = y + (u64)hb * 256;
+  const float xv = xr[t];
+  const float xb = xr[(t + 32) & 255];
+  const float xg = qk != 0 ? xr[256 + t] : 0.0f;
+  a[t] = xv * xv;
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  for (u32 st = 1; st < 256; st <<= 1) {
+    if ((t & (2 * st - 1)) == 0) {
+      a[t] = a[t] + a[t + st];
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+  }
+  const float s = 1.0f / sqrt(a[0] / 256.0f + as_type<float>(0x358637BDu));
+  const float v = (xv * s) * w[t];
+  if (t < 32) {
+    device const float* cs = sa_f(C, S, A.a[3]);
+    const float co = cs[t], si = cs[32 + t];
+    const float b = (xb * s) * w[t + 32];
+    yr[2 * t]     = v * co - b * si;
+    yr[2 * t + 1] = v * si + b * co;
+  } else if (t >= 64) {
+    yr[t] = v;
+  }
+  if (qk != 0) {
+    y[(u64)nh * 256 + (u64)hb * 256 + t] = xg;
+  }
+}
+
+// Qwen3.5 attention (CUDA's llb_attn4): K.scores4 + K.probs + K.weighted4 of
+// all nh query heads (16, or 24: tools/metal-27b.patch), a group a head. q nh
+// x 256, kc / vc 2^dT slots of 4 kv heads x 256 (head h reads kv head h / A.k),
+// sc / pr the two scratch planes (nh heads of 2^17 floats each); att nh x 256.
+// Slots t > pos are -inf.
+kernel void llb_m_attn4(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant HybArgs& A [[buffer(2)]], uint h [[threadgroup_position_in_grid]],
+  uint tx [[thread_position_in_threadgroup]]) {
+  device const float* q  = sa_f(C, S, A.a[0]);
+  device const float* kc = sa_f(C, S, A.a[1]);
+  device const float* vc = sa_f(C, S, A.a[2]);
+  device float* att = sa_f(C, S, A.a[3]);
+  device float* sc  = sa_f(C, S, A.a[4]);
+  device float* pr  = sa_f(C, S, A.a[5]);
+  const u32 c = A.c, dT = c & 31, pos = c >> 5, T = 1u << dT;
+  // (tools/metal-27b.patch) A.k q heads share a kv head: 4 the 9B, 6 the 27B
+  const u32 g = (h / A.k) * 256;
+  const float scale = 1.0f / sqrt(256.0f);
+  const float ninf = as_type<float>(0xFF800000u);
+  device float* sh = sc + (u64)h * (1u << 17);
+  device float* ph = pr + (u64)h * (1u << 17);
+  device const float* qh = q + (u64)h * 256;
+  // (tools/metal-m25.patch = M24 lever L11) a simdgroup a slot: lane l holds
+  // columns 8l .. 8l+7 (coalesced rows); the in-lane 8-leaf tree, then the
+  // butterfly: attn_push's perfect 256-leaf tree, bit for bit. 4 kv heads x
+  // 256 a slot on both models; assumes a SIMD width of 32 (tx & 31)
+  {
+    const u32 l = tx & 31, sgi = tx >> 5;
+    const float4 qa = *(device const float4*)(qh + 8 * l);
+    const float4 qb = *(device const float4*)(qh + 8 * l + 4);
+    for (u32 t = sgi; t < T; t += 8) {
+      device const float* k = kc + (u64)t * 1024 + g + 8 * l;
+      const float4 ka = *(device const float4*)k;
+      const float4 kb = *(device const float4*)(k + 4);
+      float v = ((ka.x * qa.x + ka.y * qa.y) + (ka.z * qa.z + ka.w * qa.w))
+        + ((kb.x * qb.x + kb.y * qb.y) + (kb.z * qb.z + kb.w * qb.w));
+      for (u32 m = 1; m < 32; m <<= 1) {
+        v = kq_bfly(v, l, m);
+      }
+      if (l == 0) {
+        sh[t] = v * scale;
+      }
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_device);
+  // (tools/metal-m25.patch = M24 lever L3) the softmax's T exps on every
+  // thread (each ph[t] is the same op on the same value); thread 0 keeps the
+  // max tree and the sum tree in their order, the divides go back to all
+  // threads: bit for bit the single-thread loop, ~T x x32_exp shorter
+  threadgroup float mz[2];
+  if (tx == 0) {
+    float st[18];
+    u32   sp = 0;
+    for (u32 t = 0; t < T; t++) {
+      float v = t <= pos ? sh[t] : ninf;
+      u32   i = t;
+      for (; i & 1; i >>= 1) {
+        float a = st[--sp];
+        v = a < v ? v : a;
+      }
+      st[sp++] = v;
+    }
+    mz[0] = st[0];
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  {
+    const float m = mz[0];
+    for (u32 t = tx; t < T; t += 256) {
+      ph[t] = attn_exp((t <= pos ? sh[t] : ninf) - m);
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_device);
+  if (tx == 0) {
+    float st[18];
+    u32   sp = 0;
+    for (u32 t = 0; t < T; t++) {
+      attn_push(st, &sp, t, ph[t]);
+    }
+    mz[1] = st[0];
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  {
+    const float z = mz[1];
+    for (u32 t = tx; t < T; t += 256) {
+      ph[t] = ph[t] / z;
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_device);
+  float st[18];
+  u32   sp = 0;
+  for (u32 t = 0; t < T; t++) {
+    attn_push(st, &sp, t, vc[(u64)t * 1024 + g + tx] * ph[t]);
+  }
+  att[(u64)h * 256 + tx] = st[0];
+}
+
+// (tools/metal-moe.patch) the 35B's attention: llb_m_attn4 copied with GQA 8
+// (head h reads kv head h >> 3) and a 512 kv stride (2 kv heads x 256);
+// CUDA's llb_attn8 (tools/payload-moe.patch). The 9B kernel is untouched.
+kernel void llb_m_attn8(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant HybArgs& A [[buffer(2)]], uint h [[threadgroup_position_in_grid]],
+  uint tx [[thread_position_in_threadgroup]]) {
+  device const float* q  = sa_f(C, S, A.a[0]);
+  device const float* kc = sa_f(C, S, A.a[1]);
+  device const float* vc = sa_f(C, S, A.a[2]);
+  device float* att = sa_f(C, S, A.a[3]);
+  device float* sc  = sa_f(C, S, A.a[4]);
+  device float* pr  = sa_f(C, S, A.a[5]);
+  const u32 c = A.c, dT = c & 31, pos = c >> 5, T = 1u << dT;
+  const u32 g = (h >> 3) * 256;
+  const float scale = 1.0f / sqrt(256.0f);
+  const float ninf = as_type<float>(0xFF800000u);
+  device float* sh = sc + (u64)h * (1u << 17);
+  device float* ph = pr + (u64)h * (1u << 17);
+  device const float* qh = q + (u64)h * 256;
+  // (tools/metal-moe.patch, M24 lever L11) a simdgroup a slot: lane l holds
+  // columns 8l .. 8l+7 (coalesced rows); the in-lane 8-leaf tree, then the
+  // butterfly: attn_push's perfect 256-leaf tree, bit for bit
+  {
+    const u32 l = tx & 31, sgi = tx >> 5;
+    const float4 qa = *(device const float4*)(qh + 8 * l);
+    const float4 qb = *(device const float4*)(qh + 8 * l + 4);
+    for (u32 t = sgi; t < T; t += 8) {
+      device const float* k = kc + (u64)t * 512 + g + 8 * l;
+      const float4 ka = *(device const float4*)k;
+      const float4 kb = *(device const float4*)(k + 4);
+      float v = ((ka.x * qa.x + ka.y * qa.y) + (ka.z * qa.z + ka.w * qa.w))
+        + ((kb.x * qb.x + kb.y * qb.y) + (kb.z * qb.z + kb.w * qb.w));
+      for (u32 m = 1; m < 32; m <<= 1) {
+        v = kq_bfly(v, l, m);
+      }
+      if (l == 0) {
+        sh[t] = v * scale;
+      }
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_device);
+  // (tools/metal-moe.patch, M24 lever L3) the softmax's T exps on every
+  // thread (each ph[t] is the same op on the same value); thread 0 keeps the
+  // max tree and the sum tree in their order, the divides go back to all
+  // threads: bit for bit the single-thread loop, ~T x x32_exp shorter
+  threadgroup float mz[2];
+  if (tx == 0) {
+    float st[18];
+    u32   sp = 0;
+    for (u32 t = 0; t < T; t++) {
+      float v = t <= pos ? sh[t] : ninf;
+      u32   i = t;
+      for (; i & 1; i >>= 1) {
+        float a = st[--sp];
+        v = a < v ? v : a;
+      }
+      st[sp++] = v;
+    }
+    mz[0] = st[0];
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  {
+    const float m = mz[0];
+    for (u32 t = tx; t < T; t += 256) {
+      ph[t] = attn_exp((t <= pos ? sh[t] : ninf) - m);
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_device);
+  if (tx == 0) {
+    float st[18];
+    u32   sp = 0;
+    for (u32 t = 0; t < T; t++) {
+      attn_push(st, &sp, t, ph[t]);
+    }
+    mz[1] = st[0];
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  {
+    const float z = mz[1];
+    for (u32 t = tx; t < T; t += 256) {
+      ph[t] = ph[t] / z;
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_device);
+  float st[18];
+  u32   sp = 0;
+  for (u32 t = 0; t < T; t++) {
+    attn_push(st, &sp, t, vc[(u64)t * 512 + g + tx] * ph[t]);
+  }
+  att[(u64)h * 256 + tx] = st[0];
+}
+
+// (tools/metal-m27.patch, lever 4) llb_m_attn5: llb_m_attn4's bytes at the
+// cost of the positions, not the window (the pass chain only; the other arms
+// keep llb_m_attn4). P = min(pos + 1, T) real slots; L = the smallest power of
+// two >= P. Every tree is attn4's perfect pairwise tree over the T = 2^dT
+// leaves (lower index on the left), computed as: aligned per-thread blocks of
+// the [0, L) leaves (attn_push order), a level tree over the block roots in
+// threadgroup memory (the same pairs), then the masked tail [L, T) folded in as
+// whole aligned masked subtrees M[j] (2^j masked leaves: M[0] the masked
+// leaf, M[j] = M[j-1] op M[j-1]): root = (..(root_L op M[lgL]) op ..) op
+// M[dT-1], what attn_push does when it pushes those leaves one by one. Leaves
+// in [P, L) are attn4's masked leaves, computed per leaf (vc read as attn4
+// reads it). The tail's value leaf is 0 * (e0 / z): the pass arm's kv state
+// is zeroed at reserve and slot t is written only at pos t (m9_pass_run
+// enforces pos 0, 1, 2, ..), so vc = +0 past pos (Fable c1). Scores past pos
+// are never read (attn4 masks them by the select). 1024 threads: 32 scoring
+// simdgroups (L11's lane layout and tree), the value tree in 4 aligned quarters
+// of [0, L) joined (Q0 + Q1) + (Q2 + Q3).
+INLINE float m27_max(float a, float v) {
+  return a < v ? v : a;
+}
+
+kernel void llb_m_attn5(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant HybArgs& A [[buffer(2)]], uint h [[threadgroup_position_in_grid]],
+  uint tx [[thread_position_in_threadgroup]]) {
+  device const float* q  = sa_f(C, S, A.a[0]);
+  device const float* kc = sa_f(C, S, A.a[1]);
+  device const float* vc = sa_f(C, S, A.a[2]);
+  device float* att = sa_f(C, S, A.a[3]);
+  device float* sc  = sa_f(C, S, A.a[4]);
+  device float* pr  = sa_f(C, S, A.a[5]);
+  const u32 c = A.c, dT = c & 31, pos = c >> 5, T = 1u << dT;
+  const u32 P = min(pos + 1, T);
+  const u32 lgL = P <= 1 ? 0 : 32 - clz(P - 1), L = 1u << lgL;
+  const u32 NT = min(L, 1024u), B = L / NT;
+  const u32 g = (h / A.k) * 256;
+  const float scale = 1.0f / sqrt(256.0f);
+  const float ninf = as_type<float>(0xFF800000u);
+  device float* sh = sc + (u64)h * (1u << 17);
+  device float* ph = pr + (u64)h * (1u << 17);
+  device const float* qh = q + (u64)h * 256;
+  threadgroup float red[1024];
+  threadgroup float mz[2];
+  {
+    const u32 l = tx & 31, sgi = tx >> 5;
+    const float4 qa = *(device const float4*)(qh + 8 * l);
+    const float4 qb = *(device const float4*)(qh + 8 * l + 4);
+    for (u32 t = sgi; t < P; t += 32) {
+      device const float* k = kc + (u64)t * 1024 + g + 8 * l;
+      const float4 ka = *(device const float4*)k;
+      const float4 kb = *(device const float4*)(k + 4);
+      float v = ((ka.x * qa.x + ka.y * qa.y) + (ka.z * qa.z + ka.w * qa.w))
+        + ((kb.x * qb.x + kb.y * qb.y) + (kb.z * qb.z + kb.w * qb.w));
+      for (u32 m = 1; m < 32; m <<= 1) {
+        v = kq_bfly(v, l, m);
+      }
+      if (l == 0) {
+        sh[t] = v * scale;
+      }
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_device);
+  // the max tree
+  if (tx < NT) {
+    float st[18];
+    u32   sp = 0;
+    for (u32 i = 0; i < B; i++) {
+      const u32 t = tx * B + i;
+      float v = t < P ? sh[t] : ninf;
+      for (u32 u = i; u & 1; u >>= 1) {
+        v = m27_max(st[--sp], v);
+      }
+      st[sp++] = v;
+    }
+    red[tx] = st[0];
+  }
+  for (u32 w = 1; w < NT; w <<= 1) {
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (tx < NT && (tx & (2 * w - 1)) == 0) {
+      red[tx] = m27_max(red[tx], red[tx + w]);
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (tx == 0) {
+    float r = red[0];
+    for (u32 j = lgL; j < dT; j++) {
+      r = m27_max(r, ninf);
+    }
+    mz[0] = r;
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  const float m = mz[0];
+  const float e0 = attn_exp(ninf - m);
+  // the probabilities (attn4's ph[t], t < P) and the sum tree
+  if (tx < NT) {
+    float st[18];
+    u32   sp = 0;
+    for (u32 i = 0; i < B; i++) {
+      const u32 t = tx * B + i;
+      float v = e0;
+      if (t < P) {
+        v = attn_exp(sh[t] - m);
+        ph[t] = v;
+      }
+      for (u32 u = i; u & 1; u >>= 1) {
+        v = st[--sp] + v;
+      }
+      st[sp++] = v;
+    }
+    red[tx] = st[0];
+  }
+  for (u32 w = 1; w < NT; w <<= 1) {
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (tx < NT && (tx & (2 * w - 1)) == 0) {
+      red[tx] = red[tx] + red[tx + w];
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (tx == 0) {
+    float r = red[0], mj = e0;
+    for (u32 j = 0; j < dT; j++) {
+      if (j >= lgL) {
+        r = r + mj;
+      }
+      mj = mj + mj;
+    }
+    mz[1] = r;
+  }
+  threadgroup_barrier(mem_flags::mem_device);
+  const float z = mz[1];
+  for (u32 t = tx; t < P; t += 1024) {
+    ph[t] = ph[t] / z;
+  }
+  threadgroup_barrier(mem_flags::mem_device);
+  // the value tree: quarter qt of [0, L), column col
+  const float pm = e0 / z;
+  const u32 NQ = min(L, 4u), CH = L / NQ, qt = tx >> 8, col = tx & 255;
+  if (qt < NQ) {
+    float st[18];
+    u32   sp = 0;
+    for (u32 i = 0; i < CH; i++) {
+      const u32 t = qt * CH + i;
+      float v = vc[(u64)t * 1024 + g + col] * (t < P ? ph[t] : pm);
+      for (u32 u = i; u & 1; u >>= 1) {
+        v = st[--sp] + v;
+      }
+      st[sp++] = v;
+    }
+    red[tx] = st[0];
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (qt == 0) {
+    float r = NQ == 4 ? (red[col] + red[256 + col]) + (red[512 + col]
+      + red[768 + col]) : NQ == 2 ? red[col] + red[256 + col] : red[col];
+    float mv = 0.0f * pm;
+    for (u32 j = 0; j < dT; j++) {
+      if (j >= lgL) {
+        r = r + mv;
+      }
+      mv = mv + mv;
+    }
+    att[(u64)h * 256 + col] = r;
+  }
+}
+
+// (lever 4b) the long-window split of llb_m_attn5: the same trees cut at
+// aligned subtrees and spread over threadgroups (4 dispatches): D1 scores and
+// the 32-slot block max subtrees; D2 m = the tree over the block roots + the
+// masked tail, the probabilities and the 32-slot block sum subtrees; D3 z the
+// same way, the value subtrees of NC aligned chunks; D4 the tree over the
+// chunks + the masked tail. A 32-slot subtree over the lanes is the xor
+// butterfly (lower lane on the left). Partials live in the score plane's upper
+// half (the split runs only at dT <= 16): R = plane + 65536: block maxes
+// R[0, 2048), block sums R[2048, 4096), m R[4096], z R[4097], chunk values
+// R[8192 + 256 k + col] (k < 64). All bits are llb_m_attn5's = llb_m_attn4's.
+INLINE float m27_bmax(float v, u32 l, u32 m) {
+  float o = simd_shuffle_xor(v, (ushort)m);
+  return (l & m) ? m27_max(o, v) : m27_max(v, o);
+}
+
+kernel void llb_m_attn5s(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant HybArgs& A [[buffer(2)]], uint gid [[threadgroup_position_in_grid]],
+  uint tx [[thread_position_in_threadgroup]]) {
+  device const float* q  = sa_f(C, S, A.a[0]);
+  device const float* kc = sa_f(C, S, A.a[1]);
+  device float* sc  = sa_f(C, S, A.a[4]);
+  const u32 c = A.c, dT = c & 31, pos = c >> 5, T = 1u << dT;
+  const u32 P = min(pos + 1, T), NB = A.n, h = gid / NB, b = gid % NB;
+  const u32 g = (h / A.k) * 256;
+  const float scale = 1.0f / sqrt(256.0f);
+  const float ninf = as_type<float>(0xFF800000u);
+  device float* sh = sc + (u64)h * (1u << 17);
+  device float* R = sh + 65536;
+  device const float* qh = q + (u64)h * 256;
+  const u32 l = tx & 31, sgi = tx >> 5;
+  const float4 qa = *(device const float4*)(qh + 8 * l);
+  const float4 qb = *(device const float4*)(qh + 8 * l + 4);
+  for (u32 i = 0; i < 4; i++) {
+    const u32 t = 32 * b + sgi + 8 * i;
+    if (t < P) {
+      device const float* k = kc + (u64)t * 1024 + g + 8 * l;
+      const float4 ka = *(device const float4*)k;
+      const float4 kb = *(device const float4*)(k + 4);
+      float v = ((ka.x * qa.x + ka.y * qa.y) + (ka.z * qa.z + ka.w * qa.w))
+        + ((kb.x * qb.x + kb.y * qb.y) + (kb.z * qb.z + kb.w * qb.w));
+      for (u32 m = 1; m < 32; m <<= 1) {
+        v = kq_bfly(v, l, m);
+      }
+      if (l == 0) {
+        sh[t] = v * scale;
+      }
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_device);
+  if (sgi == 0) {
+    const u32 t = 32 * b + l;
+    float v = t < P ? sh[t] : ninf;
+    for (u32 m = 1; m < 32; m <<= 1) {
+      v = m27_bmax(v, l, m);
+    }
+    if (l == 0) {
+      R[b] = v;
+    }
+  }
+}
+
+// D2: one simdgroup a (head, block)
+kernel void llb_m_attn5p(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant HybArgs& A [[buffer(2)]], uint gid [[threadgroup_position_in_grid]],
+  uint l [[thread_position_in_threadgroup]]) {
+  device float* sc  = sa_f(C, S, A.a[4]);
+  device float* pr  = sa_f(C, S, A.a[5]);
+  const u32 c = A.c, dT = c & 31, pos = c >> 5, T = 1u << dT;
+  const u32 P = min(pos + 1, T), NB = A.n, h = gid / NB, b = gid % NB;
+  const u32 lgL = P <= 1 ? 0 : 32 - clz(P - 1);
+  const float ninf = as_type<float>(0xFF800000u);
+  device float* sh = sc + (u64)h * (1u << 17);
+  device float* ph = pr + (u64)h * (1u << 17);
+  device float* R = sh + 65536;
+  const u32 NT = min(NB, 32u), BB = NB / NT;
+  float v = ninf;
+  if (l < NT) {
+    float st[18];
+    u32   sp = 0;
+    for (u32 i = 0; i < BB; i++) {
+      float x = R[l * BB + i];
+      for (u32 u = i; u & 1; u >>= 1) {
+        x = m27_max(st[--sp], x);
+      }
+      st[sp++] = x;
+    }
+    v = st[0];
+  }
+  for (u32 m = 1; m < NT; m <<= 1) {
+    v = m27_bmax(v, l, m);
+  }
+  float r = simd_broadcast(v, 0);
+  for (u32 j = lgL; j < dT; j++) {
+    r = m27_max(r, ninf);
+  }
+  const float m = r;
+  const float e0 = attn_exp(ninf - m);
+  const u32 t = 32 * b + l;
+  float w = e0;
+  if (t < P) {
+    w = attn_exp(sh[t] - m);
+    ph[t] = w;
+  }
+  for (u32 k = 1; k < 32; k <<= 1) {
+    w = kq_bfly(w, l, k);
+  }
+  if (l == 0) {
+    R[2048 + b] = w;
+    if (b == 0) {
+      R[4096] = m;
+    }
+  }
+}
+
+// D3: 256 threads (a column each) a (head, chunk of CH = L / NC slots)
+kernel void llb_m_attn5v(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant HybArgs& A [[buffer(2)]], uint gid [[threadgroup_position_in_grid]],
+  uint tx [[thread_position_in_threadgroup]]) {
+  device const float* vc = sa_f(C, S, A.a[2]);
+  device float* sc  = sa_f(C, S, A.a[4]);
+  device float* pr  = sa_f(C, S, A.a[5]);
+  const u32 c = A.c, dT = c & 31, pos = c >> 5, T = 1u << dT;
+  const u32 P = min(pos + 1, T), NC = A.n, h = gid / NC, ch = gid % NC;
+  const u32 lgL = P <= 1 ? 0 : 32 - clz(P - 1), L = 1u << lgL;
+  const u32 NB = L / 32, CH = L / NC, g = (h / A.k) * 256;
+  const float ninf = as_type<float>(0xFF800000u);
+  device float* sh = sc + (u64)h * (1u << 17);
+  device float* ph = pr + (u64)h * (1u << 17);
+  device float* R = sh + 65536;
+  threadgroup float red[256];
+  threadgroup float pz[1024];
+  threadgroup float zz[1];
+  const float m = R[4096];
+  const float e0 = attn_exp(ninf - m);
+  const u32 NT = min(NB, 256u), BB = NB / NT;
+  if (tx < NT) {
+    float st[18];
+    u32   sp = 0;
+    for (u32 i = 0; i < BB; i++) {
+      float x = R[2048 + tx * BB + i];
+      for (u32 u = i; u & 1; u >>= 1) {
+        x = st[--sp] + x;
+      }
+      st[sp++] = x;
+    }
+    red[tx] = st[0];
+  }
+  for (u32 w = 1; w < NT; w <<= 1) {
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (tx < NT && (tx & (2 * w - 1)) == 0) {
+      red[tx] = red[tx] + red[tx + w];
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (tx == 0) {
+    float r = red[0], mj = e0;
+    for (u32 j = 0; j < dT; j++) {
+      if (j >= lgL) {
+        r = r + mj;
+      }
+      mj = mj + mj;
+    }
+    zz[0] = r;
+    if (ch == 0) {
+      R[4097] = r;
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  const float z = zz[0];
+  const float pm = e0 / z;
+  const u32 t0 = ch * CH;
+  for (u32 i = tx; i < CH; i += 256) {
+    const u32 t = t0 + i;
+    pz[i] = t < P ? ph[t] / z : pm;
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  float st[18];
+  u32   sp = 0;
+  for (u32 i = 0; i < CH; i++) {
+    float v = vc[(u64)(t0 + i) * 1024 + g + tx] * pz[i];
+    for (u32 u = i; u & 1; u >>= 1) {
+      v = st[--sp] + v;
+    }
+    st[sp++] = v;
+  }
+  R[8192 + ch * 256 + tx] = st[0];
+}
+
+// D4: the chunks' tree + the masked tail, 256 threads a head
+kernel void llb_m_attn5c(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant HybArgs& A [[buffer(2)]], uint h [[threadgroup_position_in_grid]],
+  uint tx [[thread_position_in_threadgroup]]) {
+  device float* att = sa_f(C, S, A.a[3]);
+  device float* sc  = sa_f(C, S, A.a[4]);
+  const u32 c = A.c, dT = c & 31, pos = c >> 5, T = 1u << dT;
+  const u32 P = min(pos + 1, T), NC = A.n;
+  const u32 lgL = P <= 1 ? 0 : 32 - clz(P - 1);
+  const float ninf = as_type<float>(0xFF800000u);
+  device float* R = sc + (u64)h * (1u << 17) + 65536;
+  float st[18];
+  u32   sp = 0;
+  for (u32 k = 0; k < NC; k++) {
+    float v = R[8192 + k * 256 + tx];
+    for (u32 u = k; u & 1; u >>= 1) {
+      v = st[--sp] + v;
+    }
+    st[sp++] = v;
+  }
+  float r = st[0];
+  const float e0 = attn_exp(ninf - R[4096]);
+  float mv = 0.0f * (e0 / R[4097]);
+  for (u32 j = 0; j < dT; j++) {
+    if (j >= lgL) {
+      r = r + mv;
+    }
+    mv = mv + mv;
+  }
+  att[(u64)h * 256 + tx] = r;
+}
+
+// (lane m32) M29's llb_m_attn5 (tools/metal-m29.patch = M27 lever 4 re-cut: the kv stride is A.a[6],
+// the 35B's 512) as llb_m_attn5x; M31's llb_m_attn5 keeps the literal 1024 (the 9B / 27B)
+kernel void llb_m_attn5x(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant HybArgs& A [[buffer(2)]], uint h [[threadgroup_position_in_grid]],
+  uint tx [[thread_position_in_threadgroup]]) {
+  device const float* q  = sa_f(C, S, A.a[0]);
+  device const float* kc = sa_f(C, S, A.a[1]);
+  device const float* vc = sa_f(C, S, A.a[2]);
+  device float* att = sa_f(C, S, A.a[3]);
+  device float* sc  = sa_f(C, S, A.a[4]);
+  device float* pr  = sa_f(C, S, A.a[5]);
+  const u32 c = A.c, dT = c & 31, pos = c >> 5, T = 1u << dT;
+  const u32 P = min(pos + 1, T);
+  const u32 lgL = P <= 1 ? 0 : 32 - clz(P - 1), L = 1u << lgL;
+  const u32 NT = min(L, 1024u), B = L / NT;
+  const u32 g = (h / A.k) * 256;
+  const float scale = 1.0f / sqrt(256.0f);
+  const float ninf = as_type<float>(0xFF800000u);
+  const u64 kvs = A.a[6];
