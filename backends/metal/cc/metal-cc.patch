+INLINE float moe_leaf4(float4 w, float4 a) { return (w.x * a.x + w.y * a.y) + (w.z * a.z + w.w * a.w); }
+// 16 contiguous F32 cols (4 groups): (L0 + L1) + (L2 + L3)
+INLINE float moe_f32_span16(device const float* w, device const float* x) {
+  float L[4];
+  for (u32 t = 0; t < 4; t++) L[t] = moe_leaf4(*(device const float4*)(w + 4 * t), *(device const float4*)(x + 4 * t));
+  return (L[0] + L[1]) + (L[2] + L[3]);
+}
+INLINE float moe_bfly_all(float v, u32 l) {
+  for (u32 m = 1; m < 32; m <<= 1) v = kq_bfly(v, l, m);
+  return v;
+}
