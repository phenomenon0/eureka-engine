+    || gpu_m_slot.maxTotalThreadsPerThreadgroup < 1024
+    || gpu_m_qkr.maxTotalThreadsPerThreadgroup < 256
+    || gpu_m_attn4.maxTotalThreadsPerThreadgroup < 256
+    || gpu_m_attn5.maxTotalThreadsPerThreadgroup < 1024
+    || gpu_m_a5s.maxTotalThreadsPerThreadgroup < 256
+    || gpu_m_a5p.maxTotalThreadsPerThreadgroup < 32
+    || gpu_m_a5v.maxTotalThreadsPerThreadgroup < 256
+    || gpu_m_a5c.maxTotalThreadsPerThreadgroup < 256
+    || gpu_m_embq8.maxTotalThreadsPerThreadgroup < 256
+    || gpu_m_embk4.maxTotalThreadsPerThreadgroup < 256
+    || gpu_m_embk6.maxTotalThreadsPerThreadgroup < 256
+    || gpu_m_gdl2.maxTotalThreadsPerThreadgroup < 1024
+    || gpu_m_ropecs.maxTotalThreadsPerThreadgroup < 32
+    || gpu_m_qkr2.maxTotalThreadsPerThreadgroup < 256
+    || gpu_m_l2nr.maxTotalThreadsPerThreadgroup < 64
+    || gpu_m_addrms.maxTotalThreadsPerThreadgroup < 1024
+    || gpu_m_elem.maxTotalThreadsPerThreadgroup < 256
+    || gpu_m_conv.maxTotalThreadsPerThreadgroup < 256
+    || gpu_m_gdl.maxTotalThreadsPerThreadgroup < 128
+    || gpu_m_l2n.maxTotalThreadsPerThreadgroup < 64
+    || gpu_m_grn.maxTotalThreadsPerThreadgroup < 64
+    || gpu_m_mida.maxTotalThreadsPerThreadgroup < 48
+    || gpu_m_midb.maxTotalThreadsPerThreadgroup < 48
+    || gpu_warpq.maxTotalThreadsPerThreadgroup < 128
+    || gpu_warpqs.maxTotalThreadsPerThreadgroup < 128
+    || gpu_warpqv.maxTotalThreadsPerThreadgroup < 128
+    || gpu_warpq11.maxTotalThreadsPerThreadgroup < 256
+    || gpu_warp.maxTotalThreadsPerThreadgroup < 128) {
+    err_fail("warp serve: a Qwen3.5 kernel's threadgroup does not fit");
+  }
+  static const char* kqn[3][3] = {
+    { "bd2_f4_n4_s4_m0", "bd2_f4_n4_s2_m0", "bd2_f4_n16_s8_m0" },
+    { "bd2_f9_n4_s4_m0", "bd2_f9_n4_s2_m0", "bd2_f9_n16_s8_m0" },
+    { "bd2_f6_n4_s4_m0", "bd2_f6_n4_s2_m0", "bd2_f6_n16_s8_m0" } };
+  for (u32 f = 0; f < 3; f += 1) {
+    for (u32 k = 0; k < 3; k += 1) {
+      gpu_kq[f][k] = warp_pipe(kqn[f][k]);
+      if (gpu_kq[f][k].maxTotalThreadsPerThreadgroup < (k == 0 ? 128u
+        : k == 1 ? 64u : 256u)) {
+        err_fail("warp serve: a K-quant GEMV's threadgroup does not fit");
+      }
+    }
+  }
+  static const char* kxn[4] = { "bd2_f4_n8_s8_m0", "bd2_f6_n8_s8_m0",
+    "rd2_f4_n32_p17_m0", "rd2_f6_n8_p5_m0" };
+  for (u32 k = 0; k < 4; k += 1) {
+    gpu_kx[k] = warp_pipe(kxn[k]);
+    if (gpu_kx[k].maxTotalThreadsPerThreadgroup < (k == 3 ? 128u : 256u)) {
+      err_fail("warp serve: a K-quant GEMV's threadgroup does not fit");
+    }
+  }
+  gpu_scr = [gpu_dev newBufferWithLength:M9_SCR
+    options:MTLResourceStorageModeShared | MTLResourceHazardTrackingModeUntracked];
+  if (!gpu_scr) {
+    err_fail("warp serve: no scratch buffer");
+  }
+  memset([gpu_scr contents], 0, M9_SCR);
+}
+
+// (tools/metal-m28.patch, overlap) the step encoder is concurrent: a dispatch
+// is followed by a barrier unless m28_nb was set before it (then it runs
+// beside the next dispatch; only for pairs whose operands are disjoint)
+static bool m28_nb;
+static void m28_bar(id<MTLComputeCommandEncoder> en) {
+  if (m28_nb) {
+    m28_nb = false;
+    return;
+  }
+  [en memoryBarrierWithScope:MTLBarrierScopeBuffers];
+}
+
+// a launch of a Qwen3.5 kernel, then a barrier: each launch reads the last
+static void m9_go(id<MTLComputeCommandEncoder> en,
+  id<MTLComputePipelineState> p, const HybArgs* A, u32 groups, u32 threads) {
+  [en setBuffer:gpu_scr offset:0 atIndex:1];
+  [en setComputePipelineState:p];
+  [en setBytes:A length:sizeof *A atIndex:2];
+  [en dispatchThreadgroups:MTLSizeMake(groups, 1, 1)
+    threadsPerThreadgroup:MTLSizeMake(threads, 1, 1)];
+  m28_bar(en);
+}
+
+static void m9_args(HybArgs* A, u64 a0, u64 a1, u64 a2, u64 a3, u64 a4,
+  u64 a5, u64 a6, u32 n, u32 c, u32 k, f32 f) {
+  memset(A, 0, sizeof *A);
+  A->a[0] = a0; A->a[1] = a1; A->a[2] = a2; A->a[3] = a3;
+  A->a[4] = a4; A->a[5] = a5; A->a[6] = a6;
+  A->n = n; A->c = c; A->k = k; A->f = f;
+}
+
+// one llb_warp_q8 (fm 1) or llb_warp (fm 0) launch: n rows of rb bytes at
+// corpus byte w, x and y serve addresses, depth d, then a barrier. The layer
+// GEMVs (n <= 12288) take llb_warp_q8_split, the same row words with 4
+// simdgroups a row (tools/metal-gemv-split.patch: 26.5 -> 24.1 ms/step); the
+// 248320-row head keeps llb_warp_q8 (split measured 0.2 ms slower there)
+// (M16, tools/metal-gemv2.patch) Every d-10 Q8 GEMV, the head included, now
+// takes llb_warp_q8_v2, the same row words, one row a threadgroup up to
+// 32768 threadgroups (the passed grid is ignored there); d 12 (down) keeps
+// the split
+//
+// (tools/metal-kquant.patch, M19) fm Q4_K / Q5_K / Q6_K rows take M18's bd2
+// bodies (kq_bR, two rows a threadgroup, grid ceil(n / 2)): cols = rb / SB *
+// 256 in whole superblock quads (cols % 1024 == 0), d 10 (NS 4, 128 threads;
+// 1024-row Q4_K / Q5_K: NS 2, 64) or d 12 (NS 8, 256). Q4_K / Q5_K rows load
+// uint4 (16-aligned); Q6_K's 210 B superblocks load ushort (2-aligned, so a
+// row of rb % 16 == 8 is admitted). (tools/metal-27b.patch) The 27B's: d 11
+// Q4_K / Q6_K (bd2 NP 8 NS 8, 256 threads, grid ceil(n / 2); the Q6_K 5120-col
+// head rd2 5 pairs, 128 threads, grid ceil(n / 32)) and d 13 Q4_K of 17408
+// cols (rd2 17 pairs, 256 threads, grid ceil(n / 64)). Every body is the same
+// fixed-tree contract, so the choice is speed only; rd2's NPR is compiled in.
+static void m9_kgemv(id<MTLComputeCommandEncoder> en, u32 fm, u64 w, u32 rb,
+  u64 x, u64 y, u32 n, u32 d) {
+  u32  sb = LLB_FM_SB(fm), cols = sb != 0 ? rb / sb * 256 : 0;
+  bool q6 = fm == LLB_FM_Q6_K, q4 = fm == LLB_FM_Q4_K;
+  bool d11 = d == 11 && (q4 || q6), d13 = d == 13 && q4 && cols == 17408;
+  // (ENGINE-4B) the bd2 bodies (d 10 / 12) also take a partial last pair
+  // (cols % 256 == 0: the 4B's 2560 cols); rd2 / d 11 / d 13 keep whole pairs
+  bool bd2 = d == 10 || d == 12;
+  if (sb == 0 || rb % sb != 0 || cols % (bd2 ? 256 : 1024) != 0
+    || cols / 4 > 1u << d
+    || (d != 10 && d != 12 && !d11 && !d13) || n == 0 || (x & 15) != 0
+    || (q6 ? (w & 1) != 0 : (w & 15) != 0)) {
+    err_fail("warp GEMV: K-quant operands refused (Metal: d 10 / 12, Q4_K /"
+      " Q6_K d 11, Q4_K 17408-col d 13, whole superblock quads, aligned rows)");
+  }
+  u32 f = fm == LLB_FM_Q4_K ? 0 : fm == LLB_FM_Q5_K ? 1 : 2;
+  u32 k = d == 12 ? 2 : n == 1024 && !q6 ? 1 : 0;
+  // rd2 head: kx 3; rd2 down: kx 2; bd2 d 11: kx 0 / 1
+  u32 kx = d13 ? 2 : d11 && q6 && cols == 5120 ? 3 : d11 ? (q6 ? 1 : 0) : 4;
+  // (tools/metal-m25.patch, Stage 2) rd2 down: ceil(n / 16) threadgroups, one
+  // 16-row sweep each (was n / 64: 80 groups on the 60-core GPU, 162 -> 124 us
+  // a call on the 27B's real rows, kat/dn.m). The body loops rows, each row's
+  // tree is its own and the pad values depend on x only: exact by construction
+  // (all 64 layers' rows equal at grids 80 / 160 / 320; kref PASS)
+  u32 g = kx == 2 ? (n + 15) / 16 : kx == 3 ? (n + 31) / 32 : (n + 1) / 2;
+  u32 th = kx == 3 ? 128 : kx < 4 ? 256 : k == 0 ? 128 : k == 1 ? 64 : 256;
+  [en setBuffer:((x & SA_SCR) != 0 ? gpu_scr : gpu_buf) offset:(x & ~SA_SCR)
+    atIndex:1];
+  [en setBuffer:((y & SA_SCR) != 0 ? gpu_scr : gpu_buf) offset:0 atIndex:3];
+  WarpArgs wa = { w, y & ~SA_SCR, rb, cols / 4, n, d, 0 };
+  [en setComputePipelineState:kx < 4 ? gpu_kx[kx] : gpu_kq[f][k]];
+  [en setBytes:&wa length:sizeof wa atIndex:2];
+  [en dispatchThreadgroups:MTLSizeMake(g, 1, 1)
+    threadsPerThreadgroup:MTLSizeMake(th, 1, 1)];
+  m28_bar(en);
+}
+
+static void m9_gemv(id<MTLComputeCommandEncoder> en, u32 fm, u64 w, u32 rb,
+  u64 x, u64 y, u32 n, u32 d, u32 grid) {
+  if (LLB_FM_KQ(fm)) {
+    m9_kgemv(en, fm, w, rb, x, y, n, d);
+    return;
+  }
+  // Metal is stricter than CUDA here: a misaligned uint4/float4 load is
+  // undefined on Metal (a fault on CUDA), and columns past the 4 << d window
+  // would be dropped -- refuse both
+  if ((w & 15) != 0 || (rb & 15) != 0 || (x & 15) != 0
+    || (fm ? rb / 17 * 4 : rb / 16) > 1u << d) {
+    err_fail("warp GEMV: misaligned or wider-than-window operands (Metal)");
+  }
+  [en setBuffer:((x & SA_SCR) != 0 ? gpu_scr : gpu_buf) offset:(x & ~SA_SCR)
+    atIndex:1];
+  [en setBuffer:((y & SA_SCR) != 0 ? gpu_scr : gpu_buf) offset:0 atIndex:3];
+  WarpArgs wa = { w, y & ~SA_SCR, fm ? rb : rb / 16, fm ? rb / 17 * 4 : rb / 16,
+    n, d, 0 };
+  bool v2 = fm == 1 && d == 10;
+  bool sp = fm == 1 && n <= 12288 && d >= 9;
+  // (tools/metal-m27.patch, lever 1) every d-11 Q8 GEMV of n <= 12288 rows
+  // whose cg is whole 256-group spans (the 27B's layer GEMVs: 5120 / 6144
+  // cols) takes llb_warp_q8_v2d11: the split's row words, M27_Q11R rows a
+  // threadgroup, grid ceil(n / M27_Q11R) (the passed grid is ignored there)
+  bool v11 = fm == 1 && d == 11 && n <= 12288 && wa.cg % 256 == 0 && n != 0;
+  [en setComputePipelineState:v2 ? gpu_warpqv : v11 ? gpu_warpq11
+    : sp ? gpu_warpqs : fm ? gpu_warpq : gpu_warp];
+  [en setBytes:&wa length:sizeof wa atIndex:2];
+  [en dispatchThreadgroups:MTLSizeMake(v2 ? (n == 0 ? 1 : n < 32768 ? n : 32768)
+    : v11 ? (n + M27_Q11R - 1) / M27_Q11R : grid, 1, 1)
+    threadsPerThreadgroup:MTLSizeMake(v11 ? 256 : 128, 1, 1)];
+  m28_bar(en);
+}
+
+static void m9_elem(id<MTLComputeCommandEncoder> en, u32 op, u64 x, u64 z,
+  u64 y, u32 n) {
+  HybArgs A;
+  m9_args(&A, x, z, y, 0, 0, 0, 0, n, op, 0, 0.0f);
+  m9_go(en, gpu_m_elem, &A, (n + 255) / 256, 256);
+}
+
+static void m9_rnorm(id<MTLComputeCommandEncoder> en, u64 x, u64 w, u64 y,
+  u32 n) {
+  HybArgs A;
+  m9_args(&A, x, w, y, 0, 0, 0, 0, n, 0, 0, 0.0f);
+  m9_go(en, gpu_m_rnorm, &A, 1, 1024);
+}
+
+static void m9_l2n(id<MTLComputeCommandEncoder> en, u64 v, u64 y, f32 sc,
+  u32 heads) {
+  HybArgs A;
+  m9_args(&A, v, y, 0, 0, 0, 0, 0, heads, 0, 0, sc);
+  m9_go(en, gpu_m_l2n, &A, heads, 64);
+}
+
+// (tools/metal-27b.patch) nh q heads (16 the 9B, 24 the 27B) over the 4 kv
+// heads: k = the GQA group nh / 4; the probability plane after nh score planes
+static void m9_attn4(id<MTLComputeCommandEncoder> en, u64 q, u64 kc, u64 vc,
+  u64 y, u32 c, u32 nh) {
+  HybArgs A;
+  m9_args(&A, q, kc, vc, y, M9_ATTS, M9_ATTS + ((u64)nh << 17) * 4, 0, 0, c,
+    nh / 4, 0.0f);
+  m9_go(en, gpu_m_attn4, &A, nh, 256);
+}
+
+// (tools/metal-m27.patch, lever 4) the pass chain's attention: llb_m_attn5,
+// attn4's bytes at the positions' cost (needs the pass arm's zeroed, in-order
+// kv state); the same planes and arguments
+static void m9_attn5(id<MTLComputeCommandEncoder> en, u64 q, u64 kc, u64 vc,
+  u64 y, u32 c, u32 nh) {
+  HybArgs A;
+  m9_args(&A, q, kc, vc, y, M9_ATTS, M9_ATTS + ((u64)nh << 17) * 4, 0, 0, c,
+    nh / 4, 0.0f);
+  u32 dT = c & 31, pos = c >> 5, T = 1u << dT, P = pos + 1 < T ? pos + 1 : T;
+  u32 L = 1;
+  while (L < P) {
+    L <<= 1;
+  }
+  const u32 ls = M27_LS;
+  if (L >= (u32)ls && L >= 32 && dT <= 16) {
+    // (lever 4b) the split: NB 32-slot blocks, NC = L / CH chunks (CH = L / 16
+    // within [32, 1024]: NC <= 64)
+    u32 ch = L / 16 < 32 ? 32 : L / 16 > 1024 ? 1024 : L / 16;
+    u32 nb = L / 32, nc = L / ch;
+    A.n = nb;
+    m9_go(en, gpu_m_a5s, &A, nh * nb, 256);
+    m9_go(en, gpu_m_a5p, &A, nh * nb, 32);
+    A.n = nc;
+    m9_go(en, gpu_m_a5v, &A, nh * nc, 256);
+    m9_go(en, gpu_m_a5c, &A, nh, 256);
+    return;
+  }
+  m9_go(en, gpu_m_attn5, &A, nh, 1024);
+}
+
+// (tools/metal-m25.patch = M24 lever L5) the rope table at the unused tail of
+// M9_LOGIT (2^18 floats; the head writes rows < 248320): computed by the
+// first full-attention layer of a command buffer (encoder) at its pos, reused
+// by the rest (keyed by encoder and pos; pos rises every step). The head
+// writes M9_LOGIT only after the step's last layer, so even a head of more
+// than 250,048 rows could not clobber a table still in use; both models here
+// have 248,320 (M24's stated limit)
+#define M24_CS (M9_LOGIT + 250048ull * 4)
+static void* m24_cs_en;
+static u32   m24_cs_pos;
+
+static void m24_ropecs(id<MTLComputeCommandEncoder> en, u32 pos) {
+  if ((__bridge void*)en == m24_cs_en && pos == m24_cs_pos) {
+    return;
+  }
+  HybArgs A;
+  m9_args(&A, 0, 0, 0, M24_CS, 0, 0, 0, 32, 0, pos, 0.0f);
+  m9_go(en, gpu_m_ropecs, &A, 1, 32);
+  m24_cs_en  = (__bridge void*)en;
+  m24_cs_pos = pos;
+}
+
+// a tagged or sniffed row word (CUDA's llb_mail): rb the row's bytes, fm the
+// format (0 F32, 1 Q8_0, 2 F16, 3.. the quant doors); false if refused
+static bool m9_rw(u32 rw, u32* rb, u32* fm) {
+  bool tg = rw >> 30 & 1;
+  *rb = rw & (tg ? 0x07ffffffu : 0x7fffffffu);
+  *fm = tg ? (rw >> 28 & 3) + ((rw >> 31 & 1) << 2) + ((rw >> 27 & 1) << 3)
+    : rw >> 31 ? 2 : *rb % 17 == 0;
+  return tg ? !(*fm == 1 && *rb % 17 != 0) : !(*fm == 1 && *rb % 16 == 0);
+}
+
+#define M9_A(t) (8ull * blk_loc(H, (t)))
+#define M9_ARR(t) (term_tag(t) == TAG_ARR)
+
+static void m9_bad(u32 aux) {
+  fprintf(stderr, "warp serve: Qwen3.5 bang fid %u\n", aux);
+  err_fail("warp hybrid: unsupported operands");
+}
+
+// The FBN / LINB / FULB chains as functions of resolved serve addresses
+// (tools/metal-pass.patch; CUDA's llb_fbn_run / llb_linb_run / llb_fulb_run):
+// their m9_serve arms and the pass bang encode the same dispatches. b is the
+// layer blob's corpus byte offset, the w* its tensors' byte offsets in it.
+// (tools/metal-kquant.patch) R: each GEMV tensor's format and row bytes, by
+// its Offs word (an post fg fu fd qkv gate sb sa ssa dt cv sn so aq ak av aqn
+// akn ao = 0 .. 19): the table's per-tensor select; a Q8 record (m9_rows_q8)
+// gives the old rg / rd launches
+// (tools/metal-27b.patch) and the Shape: d_model d, d_ff f, nh q heads, lkh /
+// lvh SSM key / value heads, nl layers (kv 4 x 256, head and state 128 fixed)
+typedef struct {
+  u32 fm[20], rb[20];
+  u32 d, f, nh, lkh, lvh, nl;
+} M9Rows;
+
+// the 9B or the 27B (the engine's mf.validate admits exactly these two)
+// (ENGINE-4B, patches/metal-4b.patch) or the 4B: d 2560, f 9216, the 9B's
+// heads / SSM / layers. Its attn_output / ssm_out rows are nh 256 = 4096
+// columns, not d: the Q8 record (one rg for every non-down tensor, right only
+// while d = nh 256) gets q8 rows of 4096 there; a table overwrites rb per layer
+static bool m9_shape(M9Rows* R, u32 d, u32 f) {
+  bool b27 = d == 5120 && f == 17408;
+  bool b4 = d == 2560 && f == 9216;
+  R->d = d; R->f = f; R->nh = b27 ? 24 : 16; R->lkh = 16;
+  R->lvh = b27 ? 48 : 32; R->nl = b27 ? 64 : 32;
+  if (b4) {
+    R->rb[13] = R->rb[19] = LLB_FM_RB(LLB_FM_Q8_0, R->nh * 256);
+  }
+  return b27 || b4 || (d == 4096 && f == 12288);
+}
+
+static void m9_rows_q8(M9Rows* R, u32 rg, u32 rd) {
+  for (u32 f = 0; f < 20; f += 1) {
+    R->fm[f] = LLB_FM_Q8_0;
+    R->rb[f] = f == 4 ? rd : rg;
+  }
+  m9_shape(R, 4096, 12288);
+}
+
+// the least d with 2^d >= cols / 4: a GEMV's group depth (the engine's cdepth)
+static u32 m9_cd(u32 cols) {
+  u32 d = 0;
+  while ((1u << d) < cols / 4) {
+    d += 1;
+  }
+  return d;
+}
+
+// Offs word f's columns (ffn_down d_ff, attn_output / ssm_out nh 256 = lvh
+// 128, the rest d_model) and rows (an F32 tensor: its floats)
+static u32 m9_cols(const M9Rows* R, u32 f) {
+  return f == 4 ? R->f : f == 13 || f == 19 ? R->nh * 256 : R->d;
+}
+
+static u64 m9_n(const M9Rows* R, u32 f) {
+  u32 lk = R->lkh * 128, lv = R->lvh * 128, cv = 2 * lk + lv;
+  static const u8 k[20] = { 0, 0, 1, 1, 0, 2, 3, 4, 4, 4, 4, 5, 6, 0, 7, 8, 8,
+    9, 9, 0 };
+  u32 v[10] = { R->d, R->f, cv, lv, R->lvh, 4 * cv, 128, 2 * R->nh * 256,
+    1024, 256 };
+  return v[k[f]];
+}
+
+// tensor f's bytes in its layer blob
+// (SYS1-MAC) an F32 GEMV slot (7, 8) is rows of rb = 4 cols bytes
+static u64 m9_tsz(const M9Rows* R, u32 f) {
+  return m9_n(R, f) * (R->fm[f] == LLB_FM_F32 && f != 7 && f != 8 ? 4 : R->rb[f]);
+}
+
+static void m9_fbn_run(id<MTLComputeCommandEncoder> en, u64 b, u32 post,
+  u32 fg, u32 fu, u32 fd, const M9Rows* R, u64 x, u64 at, u64 y, u32 grid,
+  u64 nw, u64 nh) {
+  // x1 = x + a, rms(post), gate / up GEMVs, silu-mul, the down GEMV, x1 + down
+  // (tools/metal-27b.patch) from the Shape (d, f): down's x window, aab + 4 <<
+  // m9_cd(f) floats, ends inside M9_BLK
+  u32 dm = R->d, df = R->f;
+  u64 x1b = M9_BLK, h2b = x1b + dm * 4, ggb = h2b + dm * 4;
+  u64 uub = ggb + df * 4, aab = uub + df * 4, ddb = aab + df * 4;
+  // (tools/metal-m25.patch = M24 lever L8) x1 = x + a fused into the rmsnorm
+  HybArgs A;
+  m9_args(&A, x, at, h2b, x1b, b + post, 0, 0, dm, 0, 0, 0.0f);
+  m9_go(en, gpu_m_addrms, &A, 1, 1024);
+  // (tools/metal-m28.patch, Stage 2) gate and up as ONE GEMV of 2 df rows
+  // when up's rows follow gate's in the blob with the same format and row
+  // bytes (the 27B pack, every layer): uub = ggb + df 4, so the rows land
+  // where the two GEMVs put them; the bodies loop rows and each row keeps its
+  // own tree: the same bits, one dispatch (M28's variant pick, runs/S2sel:
+  // bd2 over the 2 df rows beat two bd2s by 0.50 ms; 4 / 8 rows a group, the
+  // gate+up pair bodies and a silu-mul epilogue were all slower)
+  if (R->fm[2] == R->fm[3] && R->rb[2] == R->rb[3]
+    && fu == fg + (u64)df * R->rb[2]) {
+    m9_gemv(en, R->fm[2], b + fg, R->rb[2], h2b, ggb, 2 * df, m9_cd(dm),
+      grid);
+  } else {
+    m9_gemv(en, R->fm[2], b + fg, R->rb[2], h2b, ggb, df, m9_cd(dm), grid);
+    m9_gemv(en, R->fm[3], b + fu, R->rb[3], h2b, uub, df, m9_cd(dm), grid);
+  }
+  m9_elem(en, 3, ggb, uub, aab, df);
+  m9_gemv(en, R->fm[4], b + fd, R->rb[4], aab, ddb, dm, m9_cd(df), grid);
+  // (tools/metal-m28.patch, lever 6) nw != 0: y = x1 + down and the next
+  // rmsnorm (weight nw, output nh: the next layer's or the head's, which then
+  // skips its own) as ONE llb_m_addrms: elem op 0's add element for element,
+  // then llb_m_rmsnorm's tree on the same values (M24 L8): the same bits, one
+  // dispatch fewer
+  if (nw != 0) {
+    m9_args(&A, x1b, ddb, nh, y, nw, 0, 0, dm, 0, 0, 0.0f);
+    m9_go(en, gpu_m_addrms, &A, 1, 1024);
+    return;
+  }
+  m9_elem(en, 0, x1b, ddb, y, dm);
+}
+
+// (lever 6) where layer chain full / linb writes its rmsnorm (fulb's h,
+// linb's hb), from the Shape: the fbn before it writes there instead
+static u64 m28_ndst(const M9Rows* R, bool full) {
+  u32 lk = R->lkh * 128, lv = R->lvh * 128, cv = 2 * lk + lv, nv = R->lvh;
+  u32 end = 4 * lv + 4 * nv + cv;
+  return full ? M9_BLK + 2ull * R->nh * 256 * 4
+    : M9_BLK + (u64)(end > 39040 ? end : 39040) * 4;
+}
+
+static void m9_linb_run(id<MTLComputeCommandEncoder> en, u64 b, u32 an,
+  u32 wqkv, u32 wgate, u32 wbo, u32 wao, u32 wsa, u32 wdt, u32 wcv, u32 wsn,
+  u32 wso, const M9Rows* R, u64 x, u64 qkva, u64 h0, u64 h1, u64 h2, u64 S,
+  u64 y, u32 grid, bool nrm) {
+  // gated_delta updates S in place, the qkv GEMV fills qkva
+  HybArgs A;
+  // (tools/metal-27b.patch) the layout from the Shape (CUDA's llb_linb_run):
+  // lk = lkh 128 (q, k), lv = lvh 128 (v), cv = 2 lk + lv conv channels; qt /
+  // kt hold lk and its copies, lv in all; hb past them (39040 the 9B's)
+  u32 lk = R->lkh * 128, lv = R->lvh * 128, cv = 2 * lk + lv, nv = R->lvh;
+  u32 end = 4 * lv + 4 * nv + cv;
+  // (tools/metal-m25.patch, L4b) apre before bpre (the packs store ssm_alpha
+  // then ssm_beta): one 2 nv-row GEMV fills both when the tensors are adjacent
+  u64 zz = M9_BLK, apre = zz + lv * 4, bpre = apre + nv * 4;
+  u64 hb = M9_BLK + (end > 39040 ? end : 39040) * 4;
+  u64 beta = bpre + nv * 4, dec = beta + nv * 4;
+  u64 cnv = dec + nv * 4, cnvk = cnv + lk * 4, vn = cnv + 2 * lk * 4;
+  u64 gout = cnv + cv * 4, qt = gout + lv * 4;
+  u64 kt = qt + lv * 4, normed = kt + lv * 4;
+  union { u32 u; f32 f; } sq = { 0x413504f3u };
+  if (!nrm) {
+    m9_rnorm(en, x, b + an, hb, R->d);
+  }
+  // (tools/metal-27b.patch) the counts from the Shape: qkv cv rows, gate lv,
+  // beta / alpha nv (= lvh) rows, mid32 nv threads, conv cv channels
+  u32 dd = m9_cd(R->d);
+  // (tools/metal-m28.patch, overlap) with alpha + beta as one GEMV (both
+  // packs): the small serial chain (ab -> mida -> midb, conv -> l2nr, then
+  // gdl2) runs beside the qkv GEMV and three row slices of the z GEMV (rows
+  // are independent: the same bits). Stages ([a | b] = side by side, then a
+  // barrier): [qkv | ab] -> [z 0 .. z0 | mida | conv] -> [z z0 .. z1 | midb |
+  // l2nr] -> [z z1 .. lv | gdl2]. Disjoint operands in every stage: the GEMVs
+  // read hb's window [39040, 47232) floats of M9_BLK (+ rows) and write qkva
+  // (the ring), zz [0, lv), apre / bpre; mida writes the slot at 38912 (+ nv);
+  // midb beta / dec; conv cnv (the ring in); l2nr qt / kt; gdl2 gout and S
+  // (M28: -2.45 ms vs the serial encoder on the 27B, -0.77 on the 9B; no
+  // slice is 1024 rows, so m9_kgemv's 1024-row body choice never moves)
+  if (end > 38912 || nv > 128) {
+    err_fail("warp linb: the mid32 scratch slot does not fit this Shape");
+  }
+  if (R->fm[7] == R->fm[8] && R->rb[7] == R->rb[8]
+    && wbo == wao + (u64)nv * R->rb[8]) {
+    u32 z0 = lv / 2, z1 = z0 + lv / 4 + lv / 16;
+    m28_nb = true;
+    m9_gemv(en, R->fm[5], b + wqkv, R->rb[5], hb, qkva, cv, dd, grid);
+    m9_gemv(en, R->fm[8], b + wao, R->rb[8], hb, apre, 2 * nv, dd, grid);
+    m9_args(&A, bpre, apre, b + wdt, b + wsa, beta, dec, M9_BLK + 38912 * 4,
+      nv, 0, 0, 0.0f);
+    m28_nb = true;
+    m9_go(en, gpu_m_mida, &A, 1, nv);
+    m9_args(&A, b + wcv, qkva, h0, h1, h2, cnv, 0, cv, 0, 0, 0.0f);
+    m28_nb = true;
+    m9_go(en, gpu_m_conv, &A, (cv + 255) / 256, 256);
+    m9_gemv(en, R->fm[6], b + wgate, R->rb[6], hb, zz, z0, dd, grid);
+    m9_args(&A, bpre, apre, b + wdt, b + wsa, beta, dec, M9_BLK + 38912 * 4,
+      nv, 0, 0, 0.0f);
+    m28_nb = true;
+    m9_go(en, gpu_m_midb, &A, 1, nv);
+    m28_nb = true;
+    m9_gemv(en, R->fm[6], b + wgate + (u64)z0 * R->rb[6], R->rb[6], hb,
+      zz + (u64)z0 * 4, z1 - z0, dd, grid);
+    m9_args(&A, cnv, cnvk, qt, kt, 0, 0, 0, R->lkh, lk, nv / R->lkh, sq.f);
+    m9_go(en, gpu_m_l2nr, &A, 2 * R->lkh, 64);
+    m28_nb = true;
+    m9_gemv(en, R->fm[6], b + wgate + (u64)z1 * R->rb[6], R->rb[6], hb,
+      zz + (u64)z1 * 4, lv - z1, dd, grid);
+    m9_args(&A, S, qt, kt, vn, dec, beta, gout, nv, 0, 0, 0.0f);
+    m9_go(en, gpu_m_gdl2, &A, nv * 4, 1024);
+  } else {
+    m9_gemv(en, R->fm[5], b + wqkv, R->rb[5], hb, qkva, cv, dd, grid);
+    m9_gemv(en, R->fm[6], b + wgate, R->rb[6], hb, zz, lv, dd, grid);
+    // (tools/metal-m25.patch, L4b, the 27B's analog of M24's L4) alpha and
+    // beta as ONE GEMV of 2 nv rows when beta's rows follow alpha's in the blob
+    // with the same format and row bytes (the 27B pack): the same row words and
+    // per-row trees (the body loops rows), so the same bits; else two, as before
+    if (R->fm[7] == R->fm[8] && R->rb[7] == R->rb[8]
+      && wbo == wao + (u64)nv * R->rb[8]) {
+      m9_gemv(en, R->fm[8], b + wao, R->rb[8], hb, apre, 2 * nv, dd, grid);
+    } else {
+      m9_gemv(en, R->fm[7], b + wbo, R->rb[7], hb, bpre, nv, dd, grid);
+      m9_gemv(en, R->fm[8], b + wao, R->rb[8], hb, apre, nv, dd, grid);
+    }
+    // (tools/metal-m25.patch = M24 lever L1) mid32 as two dispatches; softplus
+    // through a scratch slot at float 38912 of M9_BLK. Live between mid32a and
+    // mid32b: zz .. dec (< end <= 38912); the slot lies inside normed / hb's
+    // range on the 27B, which grn writes and the rmsnorm read before, so it is
+    // free only for these two adjacent dispatches (keep mid32 before grn)
+    if (end > 38912 || nv > 128) {
+      err_fail("warp linb: the mid32 scratch slot does not fit this Shape");
+    }
+    m9_args(&A, bpre, apre, b + wdt, b + wsa, beta, dec, M9_BLK + 38912 * 4, nv,
+      0, 0, 0.0f);
+    m9_go(en, gpu_m_mida, &A, 1, nv);
+    m9_go(en, gpu_m_midb, &A, 1, nv);
+    m9_args(&A, b + wcv, qkva, h0, h1, h2, cnv, 0, cv, 0, 0, 0.0f);
+    m9_go(en, gpu_m_conv, &A, (cv + 255) / 256, 256);
+    // (tools/metal-27b.patch) q then k, each into its lvh / lkh copies (2 the
+    // 9B, 3 the 27B: the value heads tile the key heads)
+    // (tools/metal-m25.patch = M24 lever L6) all of them in one dispatch: each
+    // head computed once, stored nv / lkh times (lkh q groups, lkh k groups)
+    m9_args(&A, cnv, cnvk, qt, kt, 0, 0, 0, R->lkh, lk, nv / R->lkh, sq.f);
+    m9_go(en, gpu_m_l2nr, &A, 2 * R->lkh, 64);
+    // gated_delta / gated_rmsnorm over the nv value heads; ssm_out lv columns
+    m9_args(&A, S, qt, kt, vn, dec, beta, gout, nv, 0, 0, 0.0f);
+    // (tools/metal-m25.patch = M24 lever L10) a simdgroup a state row
+    m9_go(en, gpu_m_gdl2, &A, nv * 4, 1024);
+  }
+  m9_args(&A, gout, b + wsn, zz, normed, 0, 0, 0, nv, 0, 0, 0.0f);
+  m9_go(en, gpu_m_grn, &A, nv, 64);
+  m9_gemv(en, R->fm[13], b + wso, R->rb[13], normed, y, R->d, m9_cd(lv), grid);
+}
+
+static void m9_fulb_run(id<MTLComputeCommandEncoder> en, u64 b, u32 an,
+  u32 wq, u32 wk, u32 wv, u32 wqn, u32 wkn, u32 wo, u32 c, const M9Rows* R,
+  u64 x, u64 kc, u64 vc, u64 y, u32 grid, bool nrm) {
+  // rnorm, q GEMV, qkr(q), k GEMV, qkr(k), v GEMV, slot k, slot v, attn4,
+  // the output gate, the o GEMV; kc / vc written in place at pos
+  HybArgs A;
+  u32 pos = c >> 5;
+  // (tools/metal-27b.patch) the layout from the Shape: qa = nh 256
+  u32 qa = R->nh * 256;
+  u64 attn = M9_BLK, gated = attn + qa * 4, h = M9_BLK + 2 * qa * 4;
+  u64 qgn = h + R->d * 4, qg = qgn + 2 * qa * 4, kb = qg + 2 * qa * 4;
+  u64 kn = kb + 1024 * 4, vb = kn + 1024 * 4;
+  // (tools/metal-m25.patch = M24 lever L5) the (cos, sin) table once a
+  // command buffer; qkr2 reads it
+  m24_ropecs(en, pos);
+  if (!nrm) {
+    m9_rnorm(en, x, b + an, h, R->d);
+  }
+  m9_gemv(en, R->fm[14], b + wq, R->rb[14], h, qgn, 2 * qa, m9_cd(R->d), grid);
+  // (tools/metal-m28.patch, overlap) [qkr2(q) | k GEMV] -> [qkr2(k) | v GEMV]
+  // -> [slot k | slot v]: qkr2 reads qgn / kb and writes qg / kn; the k / v
+  // GEMVs read h's window [2 qa, 2 qa + 8192) floats (+ rows) and write kb /
+  // vb; the slots write kc / vc at pos: disjoint in every pair
+  m9_args(&A, qgn, b + wqn, qg, M24_CS, 0, 0, 0, 2 * qa, 1, pos, 0.0f);
+  m28_nb = true;
+  m9_go(en, gpu_m_qkr2, &A, R->nh, 256);
+  m9_gemv(en, R->fm[15], b + wk, R->rb[15], h, kb, 1024, m9_cd(R->d), grid);
+  m9_args(&A, kb, b + wkn, kn, M24_CS, 0, 0, 0, 1024, 0, pos, 0.0f);
+  m28_nb = true;
+  m9_go(en, gpu_m_qkr2, &A, 1024 / 256, 256);
+  m9_gemv(en, R->fm[16], b + wv, R->rb[16], h, vb, 1024, m9_cd(R->d), grid);
+  m9_args(&A, kn, kc + (u64)pos * 1024 * 4, 0, 0, 0, 0, 0, 1024,
+    0, 0, 0.0f);
+  m28_nb = true;
+  m9_go(en, gpu_m_slot, &A, 1, 1024);
+  m9_args(&A, vb, vc + (u64)pos * 1024 * 4, 0, 0, 0, 0, 0, 1024,
+    0, 0, 0.0f);
+  m9_go(en, gpu_m_slot, &A, 1, 1024);
+  m9_attn5(en, qg, kc, vc, attn, c, R->nh);
+  m9_elem(en, 2, attn, qg + qa * 4, gated, qa);
+  m9_gemv(en, R->fm[19], b + wo, R->rb[19], gated, y, R->d, m9_cd(qa), grid);
+}
+
+// The whole-pass bang (tools/metal-pass.patch; CUDA's llb_pass_run,
+// tools/payload-pass.patch): layers s..s+k-1 of one step, each the linb (SSM)
+// or fulb (full, (i + 1) % 4 == 0) chain into a, then the fbn chain (x, a)
+// into the next x; the last into y. The layer state lives here, not in the
+// interpreter: per SSM layer a ring of four 8192 conv buffers (h0, h1, h2,
+// qkva = b[r .. r + 3 mod 4], r += 1 a step: lin's (h1, h2, qkva) rotation;
+// qkva's GEMV writes all 8192 rows before conv reads it) and S (2^19); per
+// full layer kc, vc (2^(dT + 10)); a and the x ping-pong, each fully written
+// (4096 rows) before it is read. Each layer must see pos 0, 1, 2, ...
+// Metal: the kernels see only the corpus and gpu_scr (serve addresses), so the
+// state is a region of gpu_scr. It is reserved once, at the first pass bang,
+// before anything in that command buffer binds gpu_scr (gpu_scr regrown, the
+// old scratch copied over, the region zeroed as Array.new(F32, _, 0.0) was);
+// CUDA allocates per layer between launches, which would orphan the dispatches
+// already encoded against the old buffer here.
+// (tools/metal-27b.patch) 64: the 27B's layers
+static u64  pass_b[64], pass_S[64], pass_kc[64], pass_vc[64], pass_x[3];
+// lane m26 (tools/metal-f27.patch): the 27B fast chunk's token blocks: F27_CH
+// blocks of F27_TB floats (x 5120, the mixer's output 5120, then the larger of
+// the linb / fulb / fbn scratch: fbn's 3 x 5120 + 3 x 17408)
+#define F27_CH 512u
+#define F27_TB 77824ull
+#define F27_BYTES ((u64)F27_CH * F27_TB * 4)
+static u64  f27_base;
+static bool f9_want;
+static u64  pass_top, pass_end;
+static u32  pass_r[64], pass_pos[64], pass_dT;
+static bool pass_on[64];
+
+// (tools/metal-27b.patch) over the Shape's nl layers: an SSM layer's conv
+// ring 4 cv and S lvh 128 128, the x ping-pong 3 d
+static void pass_reserve(u32 dT, const M9Rows* R) {
+  u64 cv = 2 * R->lkh * 128 + R->lvh * 128;
+  // (tools/metal-m25.patch, L2) + the fused step's final slot
+  u64 n = 4ull * R->d * 4;
+  for (u32 i = 0; i < R->nl; i += 1) {
+    n += (i + 1) % 4 == 0 ? 2 * (4ull << (dT + 10))
+      : (4 * cv + ((u64)R->lvh << 14)) * 4;
+  }
+  // lane m26 (tools/metal-f27.patch): the 27B fast chunk's area past the
+  // state (its addresses unchanged); only at the 27B Shape
+  // (lane m31) and at d_model 4096 when the first pass bang is a fast chunk
+  // (ENGINE-PREFILL, patches/metal-4bpf.patch) and the 4B's d_model 2560 so
+  u64 fch = R->d == 5120 || ((R->d == 4096 || R->d == 2560) && f9_want)
+    ? F27_BYTES : 0;
+  id<MTLBuffer> g = [gpu_dev newBufferWithLength:M9_SCR + n + fch
+    options:MTLResourceStorageModeShared | MTLResourceHazardTrackingModeUntracked];
+  if (!g) {
+    err_fail("warp pass: cannot allocate the layer state");
+  }
+  memcpy([g contents], [gpu_scr contents], M9_SCR);
+  memset((u8*)[g contents] + M9_SCR, 0, n + fch);
+  gpu_scr  = g;
+  pass_top = SA_SCR + M9_SCR;
+  pass_end = pass_top + n;
+  f27_base = fch != 0 ? pass_end : 0;
+}
+
+// n zeroed f32 of the reserved region, as a serve address
+static u64 pass_zero(u64 n) {
+  u64 p = pass_top;
+  if (p + n * 4 > pass_end) {
+    err_fail("warp pass: cannot allocate the layer state");
+  }
+  pass_top = p + n * 4;
+  return p;
+}
+
+// pw: the k layer blobs' corpus byte offsets; po: the lin / full Offs words;
+// tw (tools/metal-kquant.patch): table.bin's words (a 32-word row per layer:
+// [0] its bytes, [1 + f] Offs word f's offset | fm << 28), or NULL for the
+// Q8 pack's po / rg / rd
+// (tools/metal-27b.patch) S0: the Q8 record (rg / rd) and the Shape
+// (tools/metal-m25.patch, L2) the reserve, the x ping-pong and the fused
+// step's final slot (m24_fin), once, before anything binds gpu_scr
+static u64 m24_fin;
+
+static void m9_pass_init(u32 dT, const M9Rows* S0) {
+  if (pass_x[0] == 0) {
+    pass_reserve(dT, S0);
+    for (u32 b = 0; b < 3; b += 1) {
+      pass_x[b] = pass_zero(S0->d);
+    }
+    m24_fin = pass_zero(S0->d);
+    pass_dT = dT;
+  }
+}
+
+// (lever 6) hw: the head's rmsnorm weight (serve address) when the fused
+// step's head follows the last layer (it then skips its rmsnorm), else 0
+// (tools/metal-m30.patch, lever E) the served round's buffer / encoder (set by
+// warp_serve) and one early split: end the encoder after a fence update,
+// commit, open the next buffer's encoder waiting on that fence
+static id<MTLCommandBuffer>         m30_cb, m30_cb0;
+static id<MTLComputeCommandEncoder> m30_en;
+static id<MTLFence>                 m30_fence;
+static u32                          m30_split_at = 2;
+static id<MTLComputeCommandEncoder> m30_split(void) {
+  [m30_en updateFence:m30_fence];
+  [m30_en endEncoding];
+  [m30_cb commit];
+  m30_cb0 = m30_cb;
+  m30_cb  = [gpu_que commandBuffer];
+  m30_en  = [m30_cb computeCommandEncoderWithDispatchType:MTLDispatchTypeConcurrent];
+  [m30_en waitForFence:m30_fence];
+  [m30_en setBuffer:gpu_buf offset:0 atIndex:0];
+  [m30_en setBuffer:gpu_att offset:0 atIndex:1];
+  [m30_en setBuffer:gpu_buf offset:0 atIndex:3];
+  return m30_en;
+}
+
+// lane m26 (tools/metal-f27.patch): a new sequence (pos 0 after state): the
+// layer state zeroed in place, the slots re-taken in m9_pass_init's order
+static void m26_reset(u32 dT, const M9Rows* S0) {
+  if (dT != pass_dT) {
+    err_fail("warp pass: a new sequence at another dT");
+  }
+  memset(pass_on, 0, sizeof pass_on);
+  memset(pass_r, 0, sizeof pass_r);
+  memset(pass_pos, 0, sizeof pass_pos);
+  pass_top = SA_SCR + M9_SCR;
+  memset((u8*)[gpu_scr contents] + M9_SCR, 0, pass_end - pass_top);
+  for (u32 b = 0; b < 3; b += 1) {
+    pass_x[b] = pass_zero(S0->d);
+  }
+  m24_fin = pass_zero(S0->d);
+}
+
+static void m9_pass_run(id<MTLComputeCommandEncoder> en, u64 x, u64 y, u32 c,
+  const M9Rows* S0, u32 s, u32 k, const u64* pw, const u32* po, const u32* tw,
+  u32 grid, u64 hw) {
+  u32 dT = c & 31, pos = c >> 5;
+  if (pass_x[0] != 0 && s == 0 && pos == 0 && pass_on[0]) {
+    m26_reset(dT, S0);
+  }
+  u64 cv = 2 * S0->lkh * 128 + S0->lvh * 128;
+  m9_pass_init(dT, S0);
+  if (dT != pass_dT) {
+    err_fail("warp pass: dT changed");
+  }
+  u64 cur = x;
+  for (u32 j = 0; j < k; j += 1) {
+    u32  i = s + j;
+    bool full = (i + 1) % 4 == 0;
+    if (!pass_on[i]) {
+      if (pos != 0) {
+        err_fail("warp pass: a layer's state must start at pos 0");
+      }
+      if (full) {
+        pass_kc[i] = pass_zero(1ull << (dT + 10));
+        pass_vc[i] = pass_zero(1ull << (dT + 10));
+      } else {
+        pass_b[i] = pass_zero(4 * cv);
+        pass_S[i] = pass_zero((u64)S0->lvh << 14);
+      }
+      pass_on[i] = true;
+    } else if (pass_pos[i] + 1 != pos) {
+      err_fail("warp pass: a layer served out of order");
+    }
+    pass_pos[i] = pos;
+    u64        b = pw[j];
+    const u32* p = po + (full ? 20 : 0);
+    u32        tp[20];
+    M9Rows     R = *S0;
+    if (tw != NULL) {
+      for (u32 f = 0; f < 20; f += 1) {
+        tp[f] = tw[i * 32 + 1 + f] & 0x0fffffffu;
+        R.fm[f] = tw[i * 32 + 1 + f] >> 28;
+        R.rb[f] = LLB_FM_RB(R.fm[f], m9_cols(&R, f));
+      }
+      p = tp;
+    }
+    // (lever 6) the norm of layer i was written by layer i - 1's fbn
+    if (full) {
+      m9_fulb_run(en, b, p[0], p[14], p[15], p[16], p[17], p[18], p[19], c,
+        &R, cur, pass_kc[i], pass_vc[i], pass_x[2], grid, j != 0);
+    } else {
+      u32 r = pass_r[i];
+      pass_r[i] = r + 1;
+      m9_linb_run(en, b, p[0], p[5], p[6], p[7], p[8], p[9], p[10], p[11],
+        p[12], p[13], &R, cur, pass_b[i] + (u64)((r + 3) % 4) * cv * 4,
+        pass_b[i] + (u64)(r % 4) * cv * 4,
+        pass_b[i] + (u64)((r + 1) % 4) * cv * 4,
+        pass_b[i] + (u64)((r + 2) % 4) * cv * 4, pass_S[i], pass_x[2], grid,
+        j != 0);
+    }
+    u64 nxt = j + 1 == k ? y : pass_x[cur == pass_x[0] ? 1 : 0];
+    // (lever 6) the next layer's rmsnorm weight (its an word: table row
+    // i + 1, or the Q8 record's lin / full word 0) and output, or the head's
+    u64 nw = 0, nh = 0;
+    if (j + 1 < k) {
+      bool nf = (i + 2) % 4 == 0;
+      nw = pw[j + 1] + (tw != NULL ? (tw[(i + 1) * 32 + 1] & 0x0fffffffu)
+        : po[nf ? 20 : 0]);
+      nh = m28_ndst(S0, nf);
+    } else if (hw != 0) {
+      nw = hw;
+      nh = M9_HEADH;
+    }
+    m9_fbn_run(en, b, p[1], p[2], p[3], p[4], &R, cur, pass_x[2], nxt,
+      grid, nw, nh);
+    cur = nxt;
+    if (j + 1 == m30_split_at && j + 1 < k && m30_en == en && m30_cb0 == nil) {
+      en = m30_split();
+    }
+  }
+}
+
+
+// The 27B FAST chunk (lane m26, tools/metal-f27.patch): the pass's layer
+// chains (m9_linb_run / m9_fulb_run / m9_fbn_run at the 27B Shape) for nt
+// tokens at once, layer-major: every GEMM one f32-operand MMA dispatch over the
+// nt rows (Q8_0 / Q4_K / Q6_K), the per-row kernels as row-batched twins of the
+// pass's own, gated delta in token order inside one dispatch, flash-style
+// attention. NOT byte-exact; the state it leaves has the token-by-token
+// layout. Token t's block at f27_base + t F27_TB floats.
+#ifndef F27_G
+#define F27_G 6
+#endif
+static id<MTLComputePipelineState> gpu_f27_mm[4], gpu_f27_gdl, gpu_f27_attn, gpu_f9_attn;
+static id<MTLComputePipelineState> gpu_f27_conv, gpu_f27_copy, gpu_f27_embt;
+static id<MTLComputePipelineState> gpu_t27_rnorm, gpu_t27_addrms, gpu_t27_elem;
+static id<MTLComputePipelineState> gpu_t27_grn, gpu_t27_mida, gpu_t27_midb;
+static id<MTLComputePipelineState> gpu_t27_slot, gpu_t27_qkr, gpu_t27_l2nr;
+
+static void f27_pipes(void) {
+  if (gpu_f27_gdl != nil) {
+    return;
+  }
+  gpu_f27_mm[0] = warp_pipe("llb_f27_mm8");
+  gpu_f27_mm[1] = warp_pipe("llb_f27_mmk4");
+  gpu_f27_mm[2] = warp_pipe("llb_f27_mmk6");
+  gpu_f27_mm[3] = warp_pipe("llb_f27_mmk5");
+  gpu_f9_attn   = warp_pipe("llb_f9_attn");
+  gpu_f27_gdl   = warp_pipe("llb_f27_gdl");
+  gpu_f27_attn  = warp_pipe("llb_f27_attn");
+  gpu_f27_conv  = warp_pipe("llb_f27_conv1dt");
+  gpu_f27_copy  = warp_pipe("llb_f27_copy");
+  gpu_f27_embt  = warp_pipe("llb_f27_embt");
+  gpu_t27_rnorm = warp_pipe("llb_m_rmsnormt");
+  gpu_t27_addrms = warp_pipe("llb_m_addrmst");
+  gpu_t27_elem  = warp_pipe("llb_m_elemt");
+  gpu_t27_grn   = warp_pipe("llb_m_grnt");
+  gpu_t27_mida  = warp_pipe("llb_m_mid32at");
+  gpu_t27_midb  = warp_pipe("llb_m_mid32bt");
+  gpu_t27_slot  = warp_pipe("llb_m_slott");
+  gpu_t27_qkr   = warp_pipe("llb_m_qkrt");
+  gpu_t27_l2nr  = warp_pipe("llb_m_l2nrt");
+  if (gpu_f27_mm[0].maxTotalThreadsPerThreadgroup < 128
+    || gpu_f27_mm[1].maxTotalThreadsPerThreadgroup < 128
+    || gpu_f27_mm[2].maxTotalThreadsPerThreadgroup < 128
+    || gpu_f27_mm[3].maxTotalThreadsPerThreadgroup < 128
+    || gpu_f9_attn.maxTotalThreadsPerThreadgroup < 32 * 4
+    || gpu_f27_gdl.maxTotalThreadsPerThreadgroup < 128
+    || gpu_f27_attn.maxTotalThreadsPerThreadgroup < 32 * F27_G
+    || gpu_f27_conv.maxTotalThreadsPerThreadgroup < 256
+    || gpu_f27_copy.maxTotalThreadsPerThreadgroup < 256
+    || gpu_f27_embt.maxTotalThreadsPerThreadgroup < 256
+    || gpu_t27_rnorm.maxTotalThreadsPerThreadgroup < 1024
+    || gpu_t27_addrms.maxTotalThreadsPerThreadgroup < 1024
+    || gpu_t27_elem.maxTotalThreadsPerThreadgroup < 256
+    || gpu_t27_grn.maxTotalThreadsPerThreadgroup < 64
+    || gpu_t27_mida.maxTotalThreadsPerThreadgroup < 48
+    || gpu_t27_midb.maxTotalThreadsPerThreadgroup < 48
+    || gpu_t27_slot.maxTotalThreadsPerThreadgroup < 1024
+    || gpu_t27_qkr.maxTotalThreadsPerThreadgroup < 256
+    || gpu_t27_l2nr.maxTotalThreadsPerThreadgroup < 64) {
+    err_fail("27B fast chunk: a kernel's threadgroup does not fit");
+  }
+}
+
+// a 2D launch (gx groups x rows) of threads each, then a barrier
+static void f27_go(id<MTLComputeCommandEncoder> en, id<MTLComputePipelineState> p,
+  const void* A, u32 len, u32 gx, u32 rows, u32 threads) {
+  [en setBuffer:gpu_scr offset:0 atIndex:1];
+  [en setComputePipelineState:p];
+  [en setBytes:A length:len atIndex:2];
+  [en dispatchThreadgroups:MTLSizeMake(gx, rows, 1)
+    threadsPerThreadgroup:MTLSizeMake(threads, 1, 1)];
+  [en memoryBarrierWithScope:MTLBarrierScopeBuffers];
+}
+
+static void f27_targs(HybTArgs* T, u32 n, u32 cc, u32 k, f32 f) {
+  memset(T, 0, sizeof *T);
+  T->n = n; T->c = cc; T->k = k; T->f = f;
+}
+
+#define F27_TS ((u64)F27_TB * 4)
+
+// Y_s (nt rows at y[s]) = X (nt rows at x0) . W_s^T, s < ns, one dispatch; fm
+// the segments' format (all the same), rb their row bytes, K the columns
+static void f27_mms(id<MTLComputeCommandEncoder> en, u32 fm, u32 ns,
+  const u64* w, const u64* y, const u32* M, u32 rb, u64 x0, u32 K, u32 nt) {
+  FMArgs a;
+  u32 tiles = 0, f;
+  memset(&a, 0, sizeof a);
+  if (fm == LLB_FM_Q8_0) {
+    f = 0;
+  } else if (fm == LLB_FM_Q4_K) {
+    f = 1;
+  } else if (fm == LLB_FM_Q6_K) {
+    f = 2;
+  } else if (fm == LLB_FM_Q5_K) {
+    f = 3;
+  } else {
+    f = 4;
+  }
+  bool ok = f < 4 && ns >= 1 && ns <= 4 && K % 32 == 0 && (x0 & 15) == 0
+    && rb == LLB_FM_RB(fm, K) && (f == 0 || K % 256 == 0);
+  for (u32 j = 0; ok && j < ns; j += 1) {
+    ok = (y[j] & 15) == 0 && (f == 2 ? (w[j] & 1) == 0 : (w[j] & 15) == 0)
+      && M[j] >= 1;
+    a.w[j] = w[j];
+    a.y[j] = y[j] & ~SA_SCR;
+    a.M[j] = M[j];
+    tiles += (M[j] + 63) / 64;
+  }
+  if (!ok) {
+    err_fail("27B fast chunk GEMM: unsupported operands");
+  }
+  a.nseg = ns;
+  a.x = x0 & ~SA_SCR;
+  a.rb = rb;
+  a.K = K;
+  a.N = nt;
+  a.xs = (u32)F27_TB;
+  a.ys = (u32)F27_TB;
+  [en setBuffer:gpu_scr offset:0 atIndex:1];
+  [en setComputePipelineState:gpu_f27_mm[f]];
+  [en setBytes:&a length:sizeof a atIndex:2];
+  [en dispatchThreadgroups:MTLSizeMake((nt + 31) / 32, tiles, 1)
+    threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
+  [en memoryBarrierWithScope:MTLBarrierScopeBuffers];
+}
+
+static void f27_mm1(id<MTLComputeCommandEncoder> en, u32 fm, u64 w, u32 rb,
+  u64 x0, u64 y0, u32 M, u32 K, u32 nt) {
+  f27_mms(en, fm, 1, &w, &y0, &M, rb, x0, K, nt);
+}
+
+static void f27_copy(id<MTLComputeCommandEncoder> en, u64 x, u64 y, u32 n) {
+  HybArgs A;
+  m9_args(&A, x, y, 0, 0, 0, 0, 0, n, 0, 0, 0.0f);
+  m9_go(en, gpu_f27_copy, &A, (n + 255) / 256, 256);
+}
+
+// the block offsets (floats): x 0, the mixer's output 5120, scratch from W0
+#define F27_X  0ull
+#define F27_AO 5120ull
+#define F27_W0 10240ull
+
+// one SSM layer (m9_linb_run's chain) for the chunk's nt tokens
+static void f27_linb(id<MTLComputeCommandEncoder> en, u32 i, u64 b,
+  const u32* p, const M9Rows* R, u32 nt) {
+  const u64 B = f27_base;
+  const u32 d = R->d, lk = R->lkh * 128, lv = R->lvh * 128, cv = 2 * lk + lv;
+  const u32 nv = R->lvh;
+  const u64 hb = F27_W0, qkv = hb + d, zz = qkv + cv, apre = zz + lv;
+  const u64 bpre = apre + nv, beta = bpre + nv, dec = beta + nv, sp = dec + nv;
+  const u64 cnv = F27_W0 + 21744, cnvk = cnv + lk, vn = cnv + 2 * lk;
+  const u64 qt = cnv + cv, kt = qt + lv, gout = kt + lv, normed = gout + lv;
+  union { u32 u; f32 f; } sq = { 0x413504f3u };
+  HybTArgs T;
+  if (sp + nv > cnv || normed + lv > F27_TB - F27_W0 + F27_W0) {
+    err_fail("27B fast chunk: the linb block layout does not fit");
+  }
+  f27_targs(&T, d, 0, 0, 0.0f);
+  T.a[0] = B + F27_X * 4; T.s[0] = F27_TS; T.a[1] = b + p[0];
+  T.a[2] = B + hb * 4; T.s[2] = F27_TS;
+  f27_go(en, gpu_t27_rnorm, &T, sizeof T, 1, nt, 1024);
+  // qkv, z, alpha (+ beta) as one dispatch when the formats agree
+  if (R->fm[5] == R->fm[6] && R->rb[5] == R->rb[6] && R->fm[7] == R->fm[5]
+    && R->fm[8] == R->fm[5] && R->rb[7] == R->rb[5] && R->rb[8] == R->rb[5]) {
+    const u64 w4[4] = {b + p[5], b + p[6], b + p[8], b + p[7]};
+    const u64 y4[4] = {B + qkv * 4, B + zz * 4, B + apre * 4, B + bpre * 4};
+    const u32 m4[4] = {cv, lv, nv, nv};
+    f27_mms(en, R->fm[5], 4, w4, y4, m4, R->rb[5], B + hb * 4, d, nt);
+  } else {
+    f27_mm1(en, R->fm[5], b + p[5], R->rb[5], B + hb * 4, B + qkv * 4, cv, d, nt);
+    f27_mm1(en, R->fm[6], b + p[6], R->rb[6], B + hb * 4, B + zz * 4, lv, d, nt);
+    f27_mm1(en, R->fm[8], b + p[8], R->rb[8], B + hb * 4, B + apre * 4, nv, d, nt);
+    f27_mm1(en, R->fm[7], b + p[7], R->rb[7], B + hb * 4, B + bpre * 4, nv, d, nt);
+  }
+  // mid32a / mid32b (beta, dec), the softplus in a per-row slot
+  f27_targs(&T, nv, 0, 0, 0.0f);
+  T.a[0] = B + bpre * 4; T.s[0] = F27_TS; T.a[1] = B + apre * 4; T.s[1] = F27_TS;
+  T.a[2] = b + p[10]; T.a[3] = b + p[9];
+  T.a[4] = B + beta * 4; T.s[4] = F27_TS; T.a[5] = B + dec * 4; T.s[5] = F27_TS;
+  T.a[6] = B + sp * 4; T.s[6] = F27_TS;
+  f27_go(en, gpu_t27_mida, &T, sizeof T, 1, nt, nv);
+  f27_go(en, gpu_t27_midb, &T, sizeof T, 1, nt, nv);
+  // conv: token row j's input = its qkv (j >= 0) or the ring (j < 0), pieces
+  // of <= 256 rows
+  const u32 r0 = pass_r[i];
+  FConvArgs V;
+  for (u32 c0 = 0; c0 < nt; c0 += 256) {
+    const u32 cn = nt - c0 < 256 ? nt - c0 : 256;
+    memset(&V, 0, sizeof V);
+    V.a[0] = b + p[11]; V.a[1] = B + (u64)c0 * F27_TS + cnv * 4; V.s[1] = F27_TS;
+    V.n = cv;
+    for (int j = (int)c0 - 3; j < (int)(c0 + cn); j += 1) {
+      V.in[j - (int)c0 + 3] = j >= 0 ? B + (u64)j * F27_TS + qkv * 4
+        : pass_b[i] + (u64)((r0 + 3 + (u32)(j + 4)) % 4) * cv * 4;
+    }
+    f27_go(en, gpu_f27_conv, &V, sizeof V, (cv + 255) / 256, cn, 256);
+  }
+  // the l2norms into their copies (lkh q heads, lkh k heads; nv / lkh copies)
+  f27_targs(&T, R->lkh, lk, nv / R->lkh, sq.f);
+  T.a[0] = B + cnv * 4; T.s[0] = F27_TS; T.a[1] = B + cnvk * 4; T.s[1] = F27_TS;
+  T.a[2] = B + qt * 4; T.s[2] = F27_TS; T.a[3] = B + kt * 4; T.s[3] = F27_TS;
+  f27_go(en, gpu_t27_l2nr, &T, sizeof T, 2 * R->lkh, nt, 64);
+  // gated delta, the rows in order
+  f27_targs(&T, nv, 0, nt, 0.0f);
+  T.a[0] = pass_S[i];
+  T.a[1] = B + qt * 4; T.s[1] = F27_TS; T.a[2] = B + kt * 4; T.s[2] = F27_TS;
+  T.a[3] = B + vn * 4; T.s[3] = F27_TS; T.a[4] = B + dec * 4; T.s[4] = F27_TS;
+  T.a[5] = B + beta * 4; T.s[5] = F27_TS; T.a[6] = B + gout * 4; T.s[6] = F27_TS;
+  f27_go(en, gpu_f27_gdl, &T, sizeof T, nv * 8, 1, 128);
+  f27_targs(&T, nv, 0, 0, 0.0f);
+  T.a[0] = B + gout * 4; T.s[0] = F27_TS; T.a[1] = b + p[12];
+  T.a[2] = B + zz * 4; T.s[2] = F27_TS; T.a[3] = B + normed * 4; T.s[3] = F27_TS;
+  f27_go(en, gpu_t27_grn, &T, sizeof T, nv, nt, 64);
+  // the ring: the last (up to) 4 tokens' qkv, as the steps would leave it
+  for (u32 t = nt > 4 ? nt - 4 : 0; t < nt; t += 1) {
+    f27_copy(en, B + (u64)t * F27_TS + qkv * 4,
+      pass_b[i] + (u64)((r0 + 3 + t) % 4) * cv * 4, cv);
+  }
+  pass_r[i] = r0 + nt;
+  f27_mm1(en, R->fm[13], b + p[13], R->rb[13], B + normed * 4, B + F27_AO * 4,
+    d, lv, nt);
+}
+
+// one full layer (m9_fulb_run's chain) for the chunk's nt tokens at pos0 ..
+static void f27_fulb(id<MTLComputeCommandEncoder> en, u32 i, u64 b,
+  const u32* p, const M9Rows* R, u32 dT, u32 pos0, u32 nt) {
+  const u64 B = f27_base;
+  const u32 d = R->d, qa = R->nh * 256;
+  const u64 h = F27_W0, qgn = h + d, qg = qgn + 2 * qa, kb = qg + 2 * qa;
+  const u64 kn = kb + 1024, vb = kn + 1024, attn = vb + 1024, gated = attn + qa;
+  HybTArgs T;
+  if ((R->nh != 24 && R->nh != 16) || gated + qa > F27_TB || dT < 5) {
+    err_fail("27B fast chunk: the fulb shape / window does not fit");
+  }
+  f27_targs(&T, d, 0, 0, 0.0f);
+  T.a[0] = B + F27_X * 4; T.s[0] = F27_TS; T.a[1] = b + p[0];
+  T.a[2] = B + h * 4; T.s[2] = F27_TS;
+  f27_go(en, gpu_t27_rnorm, &T, sizeof T, 1, nt, 1024);
+  if (R->fm[14] == R->fm[15] && R->fm[14] == R->fm[16] && R->rb[14] == R->rb[15]
+    && R->rb[14] == R->rb[16]) {
+    const u64 w3[3] = {b + p[14], b + p[15], b + p[16]};
+    const u64 y3[3] = {B + qgn * 4, B + kb * 4, B + vb * 4};
+    const u32 m3[3] = {2 * qa, 1024, 1024};
+    f27_mms(en, R->fm[14], 3, w3, y3, m3, R->rb[14], B + h * 4, d, nt);
+  } else {
+    f27_mm1(en, R->fm[14], b + p[14], R->rb[14], B + h * 4, B + qgn * 4, 2 * qa, d, nt);
+    f27_mm1(en, R->fm[15], b + p[15], R->rb[15], B + h * 4, B + kb * 4, 1024, d, nt);
+    f27_mm1(en, R->fm[16], b + p[16], R->rb[16], B + h * 4, B + vb * 4, 1024, d, nt);
+  }
+  // qk-norm + rope (pos = pos0 + row), the q gate copied after the q heads
+  f27_targs(&T, 2 * qa, 1, pos0, 0.0f);
+  T.a[0] = B + qgn * 4; T.s[0] = F27_TS; T.a[1] = b + p[17];
+  T.a[2] = B + qg * 4; T.s[2] = F27_TS;
+  f27_go(en, gpu_t27_qkr, &T, sizeof T, R->nh, nt, 256);
+  f27_targs(&T, 1024, 0, pos0, 0.0f);
+  T.a[0] = B + kb * 4; T.s[0] = F27_TS; T.a[1] = b + p[18];
+  T.a[2] = B + kn * 4; T.s[2] = F27_TS;
+  f27_go(en, gpu_t27_qkr, &T, sizeof T, 1024 / 256, nt, 256);
+  // the cache slots pos0 + row
+  f27_targs(&T, 1024, 0, 0, 0.0f);
+  T.a[0] = B + kn * 4; T.s[0] = F27_TS;
+  T.a[1] = pass_kc[i] + (u64)pos0 * 1024 * 4; T.s[1] = 4096;
+  f27_go(en, gpu_t27_slot, &T, sizeof T, 1, nt, 1024);
+  T.a[0] = B + vb * 4; T.s[0] = F27_TS;
+  T.a[1] = pass_vc[i] + (u64)pos0 * 1024 * 4; T.s[1] = 4096;
+  f27_go(en, gpu_t27_slot, &T, sizeof T, 1, nt, 1024);
+  FAttArgs F;
+  memset(&F, 0, sizeof F);
+  F.q = B + qg * 4;
+  F.kc = pass_kc[i];
+  F.vc = pass_vc[i];
+  F.att = B + attn * 4;
+  F.qs = (u32)F27_TB;
+  F.pos0 = pos0;
+  F.nt = nt;
+  f27_go(en, R->nh == 24 ? gpu_f27_attn : gpu_f9_attn, &F, sizeof F, 4,
+    (nt + 7) / 8, 32 * (R->nh / 4));
+  // the output gate: attn * sigmoid(gate), the gate at qg + qa
+  f27_targs(&T, qa, 2, 0, 0.0f);
+  T.a[0] = B + attn * 4; T.s[0] = F27_TS; T.a[1] = B + (qg + qa) * 4;
+  T.s[1] = F27_TS; T.a[2] = B + gated * 4; T.s[2] = F27_TS;
+  f27_go(en, gpu_t27_elem, &T, sizeof T, (qa + 255) / 256, nt, 256);
+  f27_mm1(en, R->fm[19], b + p[19], R->rb[19], B + gated * 4, B + F27_AO * 4,
+    d, qa, nt);
+}
+
+// the FFN (m9_fbn_run's chain): x := (x + a) + down(silu(gate) * up)
+static void f27_fbn(id<MTLComputeCommandEncoder> en, u64 b, const u32* p,
+  const M9Rows* R, u32 nt) {
+  const u64 B = f27_base;
+  const u32 d = R->d, df = R->f;
+  const u64 x1 = F27_W0, h2 = x1 + d, gg = h2 + d, uu = gg + df, aa = uu + df;
+  const u64 dd = aa + df;
+  HybTArgs T;
+  if (dd + d > F27_TB) {
+    err_fail("27B fast chunk: the fbn block layout does not fit");
+  }
+  f27_targs(&T, d, 0, 0, 0.0f);
+  T.a[0] = B + F27_X * 4; T.s[0] = F27_TS; T.a[1] = B + F27_AO * 4;
+  T.s[1] = F27_TS; T.a[2] = B + h2 * 4; T.s[2] = F27_TS;
+  T.a[3] = B + x1 * 4; T.s[3] = F27_TS; T.a[4] = b + p[1];
+  f27_go(en, gpu_t27_addrms, &T, sizeof T, 1, nt, 1024);
+  if (R->fm[2] == R->fm[3] && R->rb[2] == R->rb[3]) {
+    const u64 w2[2] = {b + p[2], b + p[3]};
+    const u64 y2[2] = {B + gg * 4, B + uu * 4};
+    const u32 m2[2] = {df, df};
+    f27_mms(en, R->fm[2], 2, w2, y2, m2, R->rb[2], B + h2 * 4, d, nt);
+  } else {
+    f27_mm1(en, R->fm[2], b + p[2], R->rb[2], B + h2 * 4, B + gg * 4, df, d, nt);
+    f27_mm1(en, R->fm[3], b + p[3], R->rb[3], B + h2 * 4, B + uu * 4, df, d, nt);
+  }
+  f27_targs(&T, df, 3, 0, 0.0f);
+  T.a[0] = B + gg * 4; T.s[0] = F27_TS; T.a[1] = B + uu * 4; T.s[1] = F27_TS;
+  T.a[2] = B + aa * 4; T.s[2] = F27_TS;
+  f27_go(en, gpu_t27_elem, &T, sizeof T, (df + 255) / 256, nt, 256);
+  f27_mm1(en, R->fm[4], b + p[4], R->rb[4], B + aa * 4, B + dd * 4, d, df, nt);
+  f27_targs(&T, d, 0, 0, 0.0f);
+  T.a[0] = B + x1 * 4; T.s[0] = F27_TS; T.a[1] = B + dd * 4; T.s[1] = F27_TS;
+  T.a[2] = B + F27_X * 4; T.s[2] = F27_TS;
+  f27_go(en, gpu_t27_elem, &T, sizeof T, (d + 255) / 256, nt, 256);
+}
+
+// the chunk: nt (1 .. F27_CH) tokens at pos0 .. through all S0->nl layers,
+// head-less. ids / erow: the tokens and the embedding region (Q4_K rows of
+// 2880 B); pw / tw / po as m9_pass_run's (the table required)
+// (ENGINE-PREFILL, patches/metal-4bpf.patch) or the 4B (d 2560): ek6 its
+// Q4_K_M's Q6_K embedding (2100 B rows); Kev-4B's Q4_K (1440 B) is ek4
+static void f27_chunk(id<MTLComputeCommandEncoder> en, const u32* ids, u32 nt,
+  u64 ep, bool ek4, bool ek6, u32 c, const M9Rows* S0, const u64* pw,
+  const u32* po, const u32* tw) {
+  u32 dT = c & 31, pos0 = c >> 5;
+  u64 cv = 2 * S0->lkh * 128 + S0->lvh * 128;
+  f9_want = true;
+  m9_pass_init(dT, S0);
+  if (pos0 == 0 && pass_on[0]) {
+    m26_reset(dT, S0);
+  }
+  if (dT != pass_dT) {
+    err_fail("warp pass: dT changed");
+  }
+  if (f27_base == 0 || (S0->d != 5120 && S0->d != 4096 && S0->d != 2560)
+    || nt < 1 || nt > F27_CH || (S0->d == 5120 && (tw == NULL || !ek4))
+    || (ek6 && (ek4 || S0->d != 2560))) {
+    err_fail("fast chunk: no chunk area / not the 27B or 9B / nt out of range");
+  }
+  f27_pipes();
+  // (lane m31) the embedding rows: Q4_K (d / 256 x 144 B) or Q8_0 (d / 32 x 34)
+  const u64 erb = ek4 ? S0->d / 256 * 144 : ek6 ? S0->d / 256 * 210
+    : S0->d / 32 * 34;
+  // (lane m31, lever E1) one dispatch: d / 256 groups x nt rows
+  {
+    FEmbArgs E;
+    memset(&E, 0, sizeof E);
+    E.ep = ep; E.y = f27_base + F27_X * 4; E.erb = (u32)erb; E.d = S0->d;
+    E.ys = (u32)F27_TB; E.k4 = ek4 ? 1 : ek6 ? 2 : 0;
+    memcpy(E.id, ids, nt * sizeof(u32));
+    f27_go(en, gpu_f27_embt, &E, (u32)(32 + nt * sizeof(u32)),
+      S0->d / 256, nt, 256);
+  }
+  for (u32 i = 0; i < S0->nl; i += 1) {
+    bool full = (i + 1) % 4 == 0;
+    for (u32 t = 0; t < nt; t += 1) {
+      u32 pos = pos0 + t;
+      if (!pass_on[i]) {
+        if (pos != 0) {
+          err_fail("warp pass: a layer's state must start at pos 0");
+        }
+        if (full) {
+          pass_kc[i] = pass_zero(1ull << (dT + 10));
+          pass_vc[i] = pass_zero(1ull << (dT + 10));
+        } else {
+          pass_b[i] = pass_zero(4 * cv);
+          pass_S[i] = pass_zero((u64)S0->lvh << 14);
+        }
+        pass_on[i] = true;
+      } else if (pass_pos[i] + 1 != pos) {
+        err_fail("warp pass: a layer served out of order");
+      }
+      pass_pos[i] = pos;
+    }
+    u64    b = pw[i];
+    u32    tp[20];
+    M9Rows R = *S0;
+    // (lane m31) no table (the 9B Q8 pack): the pass arm's lin / full Offs and
+    // the Q8 record's formats, as m9_pass_run
+    for (u32 f = 0; f < 20; f += 1) {
+      if (tw != NULL) {
+        tp[f] = tw[i * 32 + 1 + f] & 0x0fffffffu;
+        R.fm[f] = tw[i * 32 + 1 + f] >> 28;
+        R.rb[f] = LLB_FM_RB(R.fm[f], m9_cols(&R, f));
+      } else {
+        tp[f] = po[(full ? 20 : 0) + f];
+      }
+    }
+    if (full) {
+      f27_fulb(en, i, b, tp, &R, dT, pos0, nt);
+    } else {
+      f27_linb(en, i, b, tp, &R, nt);
+    }
+    f27_fbn(en, b, tp, &R, nt);
+  }
+}
+
+// (lane m32) the 35B MoE host chain (M24 / M29) sits after the serve loop; its entry points
+static void m24_q8(id<MTLComputeCommandEncoder> en, u64 w, u32 rb, u64 x,
+  u64 y, u32 n, u32 d);
+static void m24_pass_arm(Env e, Corpus H, id<MTLComputeCommandEncoder> en,
+  Loc a, u32 aux, u32 grid);
+static void m24_flush(void);
+
+// (SYS1-MAC) CLEF-3's hidden-row hook on Metal: the names tools/sys1dual/sys1.c
+// sets per request (CUDA: host/llb_host.c). The fused step's final RMS-normed
+// row (M9_HEADH, CUDA's gpu_headh) for its pos, appended as [pos, width] + row
+// (llb_hidden_put's format) once the round's command buffer has completed
+static const char*   llb_hidden_path;
+static unsigned char llb_hidden_positions[16384];
+static u32           llb_hidden_tokens, llb_hidden_pos, llb_hidden_width;
+static bool          llb_hidden_ready, llb_hidden_written, llb_hidden_pend;
+// (ENGINE-DECIDECHUNK, patches/metal-dchunk.patch) a fast chunk's marked rows
+// (f27_rows): their pos and serve address, appended before the fused step's
+static u32 llb_hidden_cn, llb_hidden_cw, llb_hidden_cpos[F27_CH];
+static u64 llb_hidden_crow[F27_CH];
+static void llb_hidden_put1(u32 pos, u32 width, u64 at) {
+  u32 header[2] = { pos, width };
+  const f32* row = (const f32*)((const u8*)[gpu_scr contents]
+    + (at & ~SA_SCR));
+  FILE* f = fopen(llb_hidden_path, llb_hidden_written ? "ab" : "wb");
+  if (!f || fwrite(header, 4, 2, f) != 2
+    || fwrite(row, 4, width, f) != width) {
+    err_fail("LLB_DUMP_HIDDEN: write failed");
+  }
+  if (fclose(f)) {
+    err_fail("LLB_DUMP_HIDDEN: close failed");
+  }
+  llb_hidden_written = true;
+}
+static void llb_hidden_flush(void) {
+  for (u32 i = 0; i < llb_hidden_cn; i += 1) {
+    llb_hidden_put1(llb_hidden_cpos[i], llb_hidden_cw, llb_hidden_crow[i]);
+  }
+  llb_hidden_cn = 0;
+  if (!llb_hidden_pend) {
+    return;
+  }
+  llb_hidden_pend = false;
+  llb_hidden_put1(llb_hidden_pos, llb_hidden_width, M9_HEADH);
+}
+
+// (ENGINE-DECIDECHUNK, patches/metal-dchunk.patch) the hook inside a fast
+// chunk: each hook-marked pos among its nt rows (llb_hidden_positions, the
+// fused step's test) gets the head's rmsnorm (output_norm: the bang's head
+// region, word 50, at offset word 51) by llb_m_rmsnormt, the chunk's *t
+// kernel, from its block's x after the last layer into its block's mixer
+// slot (F27_AO, dead after the last fbn): the fused step's M9_HEADH, a row a
+// marked pos; llb_hidden_flush appends them once the round has completed
+static void f27_rows(Env e, Corpus H, Loc a, id<MTLComputeCommandEncoder> en,
+  u32 nt, u32 pos0, u32 d) {
+  if (!llb_hidden_path) {
+    return;
+  }
+  Term hd = H[a + 50];
+  u32  noff = (u32)H[a + 51];
+  u64  hw = 0;
+  if (term_tag(hd) == TAG_STR) {
+    StrParts q = str_peek_ro(e, hd);
+    const u8* hb = (const u8*)(H + term_peek_ro(e, q.data)) + q.off;
+    if (str_nar(q) == 2 && noff % 4 == 0 && (u64)noff + d * 4 <= q.len) {
+      hw = (u64)(hb - (const u8*)H) + noff;
+    }
+  }
+  for (u32 t = 0; t < nt; t += 1) {
+    u32 pos = pos0 + t;
+    if (pos >= llb_hidden_tokens || !llb_hidden_positions[pos]) {
+      continue;
+    }
+    if (hw == 0 || llb_hidden_cn >= F27_CH) {
+      err_fail("fast chunk: a hook-marked row without the head's norm");
+    }
+    HybTArgs T;
+    f27_targs(&T, d, 0, 0, 0.0f);
+    T.a[0] = f27_base + t * F27_TS + F27_X * 4;
+    T.a[1] = hw;
+    T.a[2] = f27_base + t * F27_TS + F27_AO * 4;
+    f27_go(en, gpu_t27_rnorm, &T, sizeof T, 1, 1, 1024);
+    llb_hidden_cpos[llb_hidden_cn] = pos;
+    llb_hidden_crow[llb_hidden_cn] = T.a[2];
+    llb_hidden_cn += 1;
+    llb_hidden_cw = d;
+  }
+}
+
+// (lane m32, f35) the 35B fast chunk's area past the 35B layer state, only when the first 35B bang is a fast
+// chunk (f35_want): F35_CH token blocks of F35_TB floats (x 2048, the mixer's output 2048, then the larger of the
+// linb / fulb / MoE scratch: linb's 39,072), the MoE entries (8 a token: gate / up rows of 512 then the down row of
+// 2048), the MoeBuf rows and the group tables
+#define F35_TB  43264ull
+#define F35_TS  (F35_TB * 4)
+#define F35_ENT ((u64)F35_CH * 8)
+#define F35_BYTES ((u64)F35_CH * F35_TS + F35_ENT * (512 + 512 + 2048) * 4 \
+  + (u64)F35_CH * F35_MBS + (u64)F35_GN * 4 + 40ull * F35_CH * 10 * 4)
+static u64  f35_base;
+static bool f35_want;
+
+// the MoE area: entry p's gate row at F35_MG + p 512 floats, up at F35_MU, down (2048) at F35_MD; the MoeBuf rows
+// at F35_MB; the group tables at F35_MT
+#define F35_MG (f35_base + (u64)F35_CH * F35_TS)
+#define F35_MU (F35_MG + F35_ENT * 512 * 4)
+#define F35_MD (F35_MU + F35_ENT * 512 * 4)
+#define F35_MB (F35_MD + F35_ENT * 2048 * 4)
+#define F35_MT (F35_MB + (u64)F35_CH * F35_MBS)
+// (R1) LLB_F35_R1: the decode gate hook's fed rows also go through the batched router (f35_r1_stage)
+static int  f35_r1l = -1;
+// (diagnostic) LLB_F35_DBG: 40 x nt x 2 floats after the group tables
+#define F35_DBG (F35_MT + (u64)F35_GN * 4)
+static u32  f35_dbg_nt, f35_ids_nt;
+static const char* f35_dbgf(void);
+static const char* f35_idsf(void);
+static bool f35_r1(void);
+static void f35_r1_stage(id<MTLComputeCommandEncoder> en, u32 i, u32 pos, u64 b, const u32* p, u64 xin);
+static void f35_arm(Env e, Corpus H, id<MTLComputeCommandEncoder> en, Loc a, u32 aux);
+
+// (tools/metal-m25.patch = M24 lever L2) the fused step (pass-bang words 51 ..
+// 56: head region, its norm / output offsets, its row word, the embedding
+// region, the token): the token's embedding row into slot 1, the pass from it
+// into the final slot, then the head arm's chain (rms over dm, the head GEMV,
+// the top two into y). One command buffer a step. hd SNil = the plain pass
+// bang. The embedding: the 9B Q8 pack's Q8_0 (dm 4096, 4352 B rows) or the
+// 27B's Q4_K (dm 5120, 2880 B rows); the region must be exactly 248320 such
+// rows (the host has no format word: the length is the check). (tools/metal-
+// m30.patch, F1) the 9B Q4_K_M's Q4_K embedding (dm 4096, 2304 B rows) too:
+// at dm 4096 the region length picks Q4_K (248320 x 2304) or Q8_0 (x 4352)
+// (ENGINE-4B) k6: the 4B Q4_K_M's Q6_K embedding (dm 2560, 2100 B rows), told
+// by the region's length (248320 x 2100) as M30's rule tells Q4_K from Q8_0
+// (ENGINE-ONE, patches/metal-kev.patch) and Kev-4B Q4_K_M's Q4_K embedding (dm
+// 2560, 1440 B rows), by the same length rule; llb_m_embk4 is width-general
+typedef struct {
+  bool on, k4, k6;
+  u64  erow, hb;
+  u32  noff, ooff, rb, fm, dm;
+} M24Fz;
+
+static bool m24_fz(Env e, Corpus H, Loc a, u32 dm, M24Fz* F) {
+  Term hd = H[a + 51], ep = H[a + 55];
+  F->on = term_tag(hd) == TAG_STR;
+  if (!F->on) {
+    return true;
+  }
+  StrParts q = str_peek_ro(e, hd), qe = str_peek_ro(e, ep);
+  bool     k4 = dm == 5120
+    || (dm == 4096 && term_tag(ep) == TAG_STR && (u64)qe.len == 248320ull * 2304)
+    || (dm == 2560 && term_tag(ep) == TAG_STR && (u64)qe.len == 248320ull * 1440);
+  u32      noff = (u32)H[a + 52], ooff = (u32)H[a + 53], hw = (u32)H[a + 54];
+  bool     k6 = dm == 2560 && term_tag(ep) == TAG_STR
+    && (u64)qe.len == 248320ull * 2100;
+  u32      tok = (u32)H[a + 56], rb, fm;
+  u32      erb = k4 ? dm / 256 * 144 : k6 ? dm / 256 * 210 : dm / 32 * 34;
+  bool     rok = m9_rw(hw, &rb, &fm);
+  bool     ok = str_nar(q) == 2 && term_tag(ep) == TAG_STR && str_nar(qe) == 2
+    && rok && tok < 248320 && noff % 4 == 0 && ooff % 16 == 0
+    && (dm == 4096 || k4 || dm == 2048 || dm == 2560)
+    && (dm == 2048 ? fm == LLB_FM_Q8_0 : fm == LLB_FM_Q8_0 || LLB_FM_KQ(fm))
+    && rb == LLB_FM_RB(fm, dm)
+    && (u64)noff + dm * 4 <= q.len && (u64)ooff + 248320ull * rb <= q.len
+    && (dm == 2048 ? (u64)(tok + 1) * erb <= qe.len : (u64)qe.len == 248320ull * erb);
+  const u8* hb = (const u8*)(H + term_peek_ro(e, q.data)) + q.off;
+  const u8* eb = (const u8*)(H + term_peek_ro(e, qe.data)) + qe.off;
+  F->erow = (u64)(eb - (const u8*)H) + (u64)tok * erb;
+  F->hb   = (u64)(hb - (const u8*)H);
+  F->noff = noff;
+  F->ooff = ooff;
+  F->rb   = rb;
+  F->fm   = fm;
+  F->dm   = dm;
+  F->k4   = k4;
+  F->k6   = k6;
+  return ok && (F->erow & 1) == 0;
+}
+
+static void m24_fz_embed(id<MTLComputeCommandEncoder> en, const M24Fz* F, u64 y) {
+  HybArgs A;
+  m9_args(&A, F->erow, y, 0, 0, 0, 0, 0, F->dm, 0, 0, 0.0f);
+  m9_go(en, F->k4 ? gpu_m_embk4 : F->k6 ? gpu_m_embk6 : gpu_m_embq8, &A,
+    F->dm / 256, 256);
+}
+
+static void m24_fz_head(id<MTLComputeCommandEncoder> en, const M24Fz* F, u64 x,
+  u64 y, u32 grid, bool nrm) {
+  HybArgs A;
+  if (!nrm) {
+    m9_rnorm(en, x, F->hb + F->noff, M9_HEADH, F->dm);
+  }
+  if (F->dm == 2048) {
+    m24_q8(en, F->hb + F->ooff, F->rb, M9_HEADH, M9_LOGIT, 248320, 9);
+  } else {
+    m9_gemv(en, F->fm, F->hb + F->ooff, F->rb, M9_HEADH, M9_LOGIT, 248320,
+      m9_cd(F->dm), grid);
+  }
+  m9_args(&A, M9_LOGIT, y, 0, 0, 0, 0, 0, 248320, 0, 0, 0.0f);
+  m9_go(en, gpu_m_amax, &A, 1, 1024);
+}
+
+// encodes task t if it is a bang tools/metal-9b.patch serves; false if not
+static bool m9_serve(Env e, Corpus H, id<MTLComputeCommandEncoder> en, Term t,
+  u32 grid) {
+  u32 aux = (u32)term_aux(t);
+  Loc a   = term_loc(t);
+  HybArgs A;
+  if (aux == LLB_WARP_FID && ((u32)H[a + 7] >> 30 & 1) == 0) {
+    // an untagged row word (the sync tree's 2B lines sniff Q8_0 as 17 | rb,
+    // which CUDA's quant-fix decoder refuses as ambiguous): the sync Metal GEMV
+    // serve below keeps it, unchanged
+    return false;
+  }
+  if (aux == LLB_WARP_FID) {
+    // the GEMV bang (f, +wb, +x, y, +base, +n, +d, +rb), a tagged row word
+    // (tools/quant-fix.patch): CUDA's kind 0
+    Term     x  = H[a + 2], y = H[a + 3];
+    u32      bs = (u32)H[a + 4], n = (u32)H[a + 5], d = (u32)H[a + 6];
+    u32      rb, fm;
+    bool     ok = m9_rw((u32)H[a + 7], &rb, &fm);
+    StrParts p  = str_peek_ro(e, H[a + 1]);
+    const u8* w = (const u8*)(H + term_peek_ro(e, p.data)) + p.off + bs;
+    if (!ok || (fm != 0 && fm != 1 && !LLB_FM_KQ(fm))) {
+      err_fail("warp GEMV: row format refused (Metal serves F32, Q8_0, Q4_K,"
+        " Q5_K and Q6_K)");
+    }
+    // (tools/metal-kquant.patch) a K-quant row: whole superblocks; m9_kgemv
+    // checks the rest (d 10 / 12, cols % 1024, alignment)
+    if (term_tag(H[a + 1]) != TAG_STR || str_nar(p) != 2 || d < 9
+      || d > (LLB_FM_KQ(fm) ? 13u : fm ? 12u : 11u)
+      || (LLB_FM_KQ(fm) ? rb % LLB_FM_SB(fm) != 0
+        : fm == 1 ? rb / 17 % 4 != 0 : rb % 16 != 0)
+      || ((uintptr_t)w & 15) != 0
+      || (u64)bs + (u64)n * rb > p.len || M9_ARR(x) || M9_ARR(y)
+      || blk_cls(x) < d + 2 || n > 1ull << blk_cls(y)) {
+      err_fail("warp GEMV: unsupported operands");
+    }
+    m9_gemv(en, fm, (u64)(w - (const u8*)H), rb, M9_A(x), M9_A(y), n, d, grid);
+    return true;
+  }
+  if (aux == LLB_L2N_FID) {
+    Term v = H[a + 1], y = H[a + 3];
+    u32  scb = (u32)H[a + 2], k = (u32)H[a + 4];
+    if (M9_ARR(v) || M9_ARR(y) || k != 4) {
+      m9_bad(aux);
+    }
+    union { u32 u; f32 f; } sc = { scb };
+    m9_l2n(en, M9_A(v), M9_A(y), sc.f, 1u << k);
+    return true;
+  }
+  if (aux == LLB_CONV_FID) {
+    Term     wbt = H[a + 1], y = H[a + 3], x = H[a + 4];
+    Term     h0 = H[a + 5], h1 = H[a + 6], h2 = H[a + 7];
+    u32      at = (u32)H[a + 2], d = (u32)H[a + 8];
+    StrParts q = str_peek_ro(e, wbt);
+    if (term_tag(wbt) != TAG_STR || str_nar(q) != 2 || d < 9 || d > 15
+      || M9_ARR(y) || M9_ARR(x) || M9_ARR(h0) || M9_ARR(h1) || M9_ARR(h2)
+      || (u64)at + ((u64)1 << d) * 16 > q.len) {
+      m9_bad(aux);
+    }
+    u64 w = (u64)((const u8*)(H + term_peek_ro(e, q.data)) + q.off + at
+      - (const u8*)H);
+    m9_args(&A, w, M9_A(x), M9_A(h0), M9_A(h1), M9_A(h2), M9_A(y), 0,
+      1u << d, 0, 0, 0.0f);
+    m9_go(en, gpu_m_conv, &A, ((1u << d) + 255) / 256, 256);
+    return true;
+  }
+  if (aux == LLB_GRN_FID) {
+    Term     ot = H[a + 1], wbt = H[a + 2], y = H[a + 3], z = H[a + 5];
+    u32      at = (u32)H[a + 4], k = (u32)H[a + 6];
+    StrParts q = str_peek_ro(e, wbt);
+    if (term_tag(wbt) != TAG_STR || str_nar(q) != 2 || k != 5
+      || M9_ARR(ot) || M9_ARR(y) || M9_ARR(z) || (u64)at + 128 * 4 > q.len
+      || ((uintptr_t)((const u8*)(H + term_peek_ro(e, q.data)) + q.off + at) & 7) != 0) {
+      m9_bad(aux);
+    }
+    u64 w = (u64)((const u8*)(H + term_peek_ro(e, q.data)) + q.off + at
+      - (const u8*)H);
+    m9_args(&A, M9_A(ot), w, M9_A(z), M9_A(y), 0, 0, 0, 1u << k, 0, 0, 0.0f);
+    m9_go(en, gpu_m_grn, &A, 1u << k, 64);
+    return true;
+  }
+  if (aux == LLB_GDL_FID) {
+    Term qt = H[a + 1], S = H[a + 2], y = H[a + 3], kk = H[a + 4];
+    Term v = H[a + 5], dec = H[a + 6], bet = H[a + 7];
+    u32  k = (u32)H[a + 8];
