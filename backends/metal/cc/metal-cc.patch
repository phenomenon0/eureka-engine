+// the chunk: nt (1 .. F35_CH) ids at pos0 .. through the 40 layers; ep the Q8_0 embedding region (2176 B rows);
+// pw / tw as m24_pass_run's (the table required)
+static void f35_chunk(id<MTLComputeCommandEncoder> en, const u32* ids, u32 nt, u64 ep, u32 c,
