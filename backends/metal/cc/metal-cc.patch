+  uint tx [[thread_position_in_threadgroup]]) {
+  threadgroup float sc[1024];
+  threadgroup float pr[1024];
+  device const float* q  = (device const float*)(C + A.q);
+  device const float* kc = (device const float*)(C + A.k);
+  device const float* vc = (device const float*)(C + A.v);
+  const u32 c = A.c, dT = c & 31, pos = c >> 5, T = 1u << dT;
+  const u32 g = (h >> 3) * 128;
+  const float scale = 1.0f / sqrt(128.0f);
+  for (u32 t = tx; t < T; t += 128) {
+    device const float* k = kc + t * 256 + g;
+    device const float* x = q + h * 128;
+    float st[8];
+    u32   sp = 0;
+    for (u32 i = 0; i < 128; i++) {
