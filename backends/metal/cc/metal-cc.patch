+          && (u64)p[17] + 256 * 4 <= q.len && (u64)p[18] + 256 * 4 <= q.len;
+      } else {
+        // linb: an 0, qkv 5, gate 6, beta 7, alpha 8, ssm_a 9, dt 10, conv 11,
+        // ssm_norm 12, ssm_out 13
+        ok = ok && ((uintptr_t)(base + p[6]) & 15) == 0
+          && ((uintptr_t)(base + p[7]) & 15) == 0
+          && ((uintptr_t)(base + p[8]) & 15) == 0
+          && ((uintptr_t)(base + p[13]) & 15) == 0
+          && ((uintptr_t)(base + p[12]) & 7) == 0
+          && (u64)p[0] + m9_n(&R, 0) * 4 <= q.len
+          && (u64)p[5] + m9_n(&R, 5) * R.rb[5] <= q.len
+          && (u64)p[6] + m9_n(&R, 6) * R.rb[6] <= q.len
+          && (u64)p[7] + m9_n(&R, 7) * R.rb[7] <= q.len
+          && (u64)p[8] + m9_n(&R, 8) * R.rb[8] <= q.len
+          && (u64)p[13] + m9_n(&R, 13) * R.rb[13] <= q.len
+          && (u64)p[9] + m9_n(&R, 9) * 4 <= q.len
+          && (u64)p[10] + m9_n(&R, 10) * 4 <= q.len
+          && (u64)p[11] + m9_n(&R, 11) * 4 <= q.len
+          && (u64)p[12] + m9_n(&R, 12) * 4 <= q.len;
+      }
+      pw[i - s] = (u64)(base - (const u8*)H);
+    }
+    Term t3 = il;
+    for (u32 j = 0; ok && j < nt; j += 1) {
+      if (term_tag(t3) != TAG_CTR || (u32)term_aux(t3) != CID_CON) {
+        ok = false;
+        break;
+      }
+      Loc l = term_peek_ro(e, t3);
