+    if (term_tag(wbt) != TAG_STR || str_nar(q) != 2 || fm != 1 || dT < 1
+      || dT > 17 || M9_ARR(qt) || blk_cls(qt) != 13 || M9_ARR(kct)
+      || M9_ARR(vct) || M9_ARR(y) || (u64)wo + (u64)4096 * rg > q.len
+      || ((uintptr_t)(base + wo) & 15) != 0
+      || ((M9_A(qt) | M9_A(kct)) & 15) != 0) {
