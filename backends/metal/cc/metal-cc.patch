+// ---- the softmax double sum, exactly. p[i] >= 0 finite floats with max(p) == 1 (expf(0)), n <= 256.
+// FAST (no rounding can occur): N = sum p_i * 2^52 as an integer (needs every lsb(p_i) >= -52), e = msb(N) - 52 =
+// floor(log2 S). If every nonzero p_i is a multiple of g = 2^(e-52), every sequential partial sum S_k <= S < 2^(e+1)
+// is a multiple of g, i.e. an integer < 2^53 times g: representable, so no step rounds and the sequential double sum
+// equals S exactly (any order). Else: the sequential soft-double chain (one lane).
+XI int xs_lsb(float p) {                          // exponent of the lowest set bit of p > 0
+  const uint u = X_ASU(p), E = (u >> 23) & 255, F = (u & 0x7fffff) | (E ? 0x800000u : 0u);
+  const int tz = (int)(63 - X_CLZ64((ulong)(F & (0u - F))));
+  return (E ? (int)E : 1) - 150 + tz;
+}
+XI ulong xs_fix52(float p) {                      // p * 2^52 as an integer; requires p <= 1 and lsb(p) >= -52
+  const uint u = X_ASU(p), E = (u >> 23) & 255; const ulong F = (ulong)((u & 0x7fffff) | 0x800000u);
+  const int sh = (int)E - 98;                     // value = F * 2^(E-150); * 2^52 -> F * 2^(E-98)
+  return sh >= 0 ? F << sh : F >> (-sh);
+}
+// combine step: given the integer sum N (exact if ok) and lmin = min lsb over nonzero p: SD of the exact sum or flag
+XI bool xs_fast_ok(ulong N, int lmin) {
+  if (lmin < -52 || N == 0) return false;
+  const int e = (63 - X_CLZ64(N)) - 52;
+  return lmin >= e - 52;
+}
+XI SD xs_fix_to_sd(ulong N) { U128 M; M.hi = 0; M.lo = N; return sd_round(M, -52, 0); }
+
+// ---- exact IEEE float ops for the scalar tail. Metal FP32 flushes subnormal operands/results to zero even under
+// MTLMathModeSafe (M20 receipts/s1-div-probe.txt), the CPU twin does not: route every tail mul/div through integers.
+XI bool xs_is0(float x) { return (X_ASU(x) & 0x7fffffffu) == 0; }
+XI SD sd_neg(SD a) { a.s ^= 1; return a; }
+// a * b correctly rounded: the exact 48-bit product is an SD (no rounding), then one RNE to float
+XSLOW float xs_fmul(float a, float b) {
+  const uint ua = X_ASU(a), ub = X_ASU(b);
+  if (((ua >> 23) & 255) == 255 || ((ub >> 23) & 255) == 255) {                // inf/NaN by IEEE rules on bits (DAZ-free)
+    const bool na = (ua & 0x7fffffffu) > 0x7f800000u, nb = (ub & 0x7fffffffu) > 0x7f800000u;
+    const bool za = (ua & 0x7fffffffu) == 0, zb = (ub & 0x7fffffffu) == 0;
+    if (na || nb || za || zb) return X_ASF(0x7fc00000u);                         // NaN, or inf * 0
+    return X_ASF(((ua ^ ub) & 0x80000000u) | 0x7f800000u);
+  }
+  return sd_to_float(sd_mul(sd_from_float(a), sd_from_float(b)));
+}
+// a / b correctly rounded (RNE), all IEEE cases; NaN results are the default NaN (compare by class)
+XSLOW float xs_fdiv(float a, float b) {
+  const uint ua = X_ASU(a), ub = X_ASU(b), s = (ua ^ ub) & 0x80000000u;
+  const uint ea = (ua >> 23) & 255, eb = (ub >> 23) & 255, fa = ua & 0x7fffff, fb = ub & 0x7fffff;
+  const bool za = (ua & 0x7fffffffu) == 0, zb = (ub & 0x7fffffffu) == 0;
+  if ((ea == 255 && fa) || (eb == 255 && fb) || (ea == 255 && eb == 255) || (za && zb)) return X_ASF(0x7fc00000u);
+  if (ea == 255 || zb) return X_ASF(s | 0x7f800000u);
+  if (eb == 255 || za) return X_ASF(s);
+  const SD A = sd_from_float(a), B = sd_from_float(b);   // 24-bit mantissas at bits 52..29
+  ulong ma = A.m >> 29, mb = B.m >> 29, rem = ma, q = 0;
+  for (int i = 0; i < 31; i++) { q <<= 1; if (rem >= mb) { rem -= mb; q |= 1; } rem <<= 1; }
+  // ma / mb = (q + frac) * 2^-30, q in [2^29, 2^31)
+  const int msb = 63 - X_CLZ64(q);
+  SD r = sd_make((q << (52 - msb)) | (rem ? 1ull : 0ull), (A.e + 29) - (B.e + 29) - 30 - (52 - msb), (int)(s >> 31));
+  return sd_to_float(r);
+}
