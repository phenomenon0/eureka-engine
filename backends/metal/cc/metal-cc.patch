+      }
+      m9_bad(aux);
+    }
+    u64 ep = (u64)((const u8*)(H + term_peek_ro(e, eq.data)) + eq.off
+      - (const u8*)H);
+    if ((ep & 1) != 0) {
+      m9_bad(aux);
+    }
