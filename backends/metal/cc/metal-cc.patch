+struct SD { ulong m; int e; int s; };            // m == 0: zero with sign s; else 2^52 <= m < 2^53
+struct U128 { ulong hi, lo; };
+
+XI SD sd_make(ulong m, int e, int s) { SD r; r.m = m; r.e = e; r.s = s; return r; }
+XI int u128_msb(U128 a) { return a.hi ? 127 - X_CLZ64(a.hi) : 63 - X_CLZ64(a.lo); }   // a != 0
+XI U128 u128_shl(U128 a, int n) {                 // 0 <= n < 128
+  U128 r;
+  if (n == 0) return a;
+  if (n >= 64) { r.hi = a.lo << (n - 64); r.lo = 0; }
+  else { r.hi = (a.hi << n) | (a.lo >> (64 - n)); r.lo = a.lo << n; }
+  return r;
+}
+XI U128 u128_shr_sticky(U128 a, int n) {          // n >= 0; bits shifted out OR'ed into bit 0
+  U128 r;
+  if (n == 0) return a;
+  if (n >= 128) { r.hi = 0; r.lo = (a.hi | a.lo) ? 1 : 0; return r; }
+  ulong lost;
+  if (n >= 64) {
+    lost = (n == 64 ? 0 : (a.hi << (128 - n))) | a.lo;
+    r.lo = n == 64 ? a.hi : a.hi >> (n - 64); r.hi = 0;
+  } else {
+    lost = a.lo << (64 - n);
+    r.lo = (a.lo >> n) | (a.hi << (64 - n)); r.hi = a.hi >> n;
+  }
+  if (lost) r.lo |= 1;
+  return r;
+}
+XI U128 u128_add(U128 a, U128 b) { U128 r; r.lo = a.lo + b.lo; r.hi = a.hi + b.hi + (r.lo < a.lo ? 1 : 0); return r; }
+XI U128 u128_sub(U128 a, U128 b) { U128 r; r.lo = a.lo - b.lo; r.hi = a.hi - b.hi - (a.lo < b.lo ? 1 : 0); return r; }
+XI bool u128_ge(U128 a, U128 b) { return a.hi > b.hi || (a.hi == b.hi && a.lo >= b.lo); }
+XI U128 u128_mul64(ulong a, ulong b) { U128 r; r.lo = a * b; r.hi = X_MULHI(a, b); return r; }
+
+// round (M * 2^e) to 53 bits, nearest-even; M != 0. Bit 0 may carry a sticky bit (always below the guard bit here).
+XN SD sd_round(U128 M, int e, int s) {
+  const int msb = u128_msb(M), sh = msb - 52;
+  if (sh <= 0) return sd_make(M.lo << (-sh), e + sh, s);
+  ulong keep, guard, sticky;
+  if (sh >= 64) { keep = M.hi >> (sh - 64); }
+  else { keep = (M.lo >> sh) | (M.hi << (64 - sh)); }
+  // guard = bit sh-1, sticky = bits below
+  const int g = sh - 1;
+  guard = g >= 64 ? (M.hi >> (g - 64)) & 1 : (M.lo >> g) & 1;
+  if (g >= 64) sticky = (M.lo != 0) || (g > 64 && (M.hi & ((1ull << (g - 64)) - 1)) != 0);
+  else sticky = g > 0 && (M.lo & ((1ull << g) - 1)) != 0;
+  int ee = e + sh;
+  if (guard && (sticky || (keep & 1))) { keep += 1; if (keep == (1ull << 53)) { keep >>= 1; ee += 1; } }
+  return sd_make(keep, ee, s);
+}
+
+// exactly-rounded a*b + c (IEEE fma, RNE), finite operands, normal-range result
+XN SD sd_fma(SD a, SD b, SD c) {
+  const int sp = a.s ^ b.s;
+  if (a.m == 0 || b.m == 0) {
+    if (c.m == 0) return sd_make(0, 0, sp & c.s);
+    return c;
+  }
+  const U128 P = u128_mul64(a.m, b.m);
+  const int ep = a.e + b.e;
+  if (c.m == 0) return sd_round(P, ep, sp);
+  const int mp = u128_msb(P), lp = ep + mp, lc = c.e + 52;
+  U128 A, B; int eF, sA, sB;
+  U128 Cw; Cw.hi = 0; Cw.lo = c.m;
+  if (lp >= lc) {
+    const int sh = 125 - mp; A = u128_shl(P, sh); eF = ep - sh; sA = sp; sB = c.s;
+    const int t = c.e - eF;
+    B = t >= 0 ? u128_shl(Cw, t) : u128_shr_sticky(Cw, -t);
+  } else {
+    A = u128_shl(Cw, 73); eF = c.e - 73; sA = c.s; sB = sp;
+    const int t = ep - eF;
+    B = t >= 0 ? u128_shl(P, t) : u128_shr_sticky(P, -t);
+  }
+  U128 M; int s;
+  if (sA == sB) { M = u128_add(A, B); s = sA; }
+  else if (u128_ge(A, B)) { M = u128_sub(A, B); s = sA; }
+  else { M = u128_sub(B, A); s = sB; }
+  if (M.hi == 0 && M.lo == 0) return sd_make(0, 0, 0);   // exact cancellation: +0 under RNE
+  return sd_round(M, eF, s);
+}
+XI SD sd_mul(SD a, SD b) {
+  if (a.m == 0 || b.m == 0) return sd_make(0, 0, a.s ^ b.s);
+  return sd_round(u128_mul64(a.m, b.m), a.e + b.e, a.s ^ b.s);
+}
+XI SD sd_one() { return sd_make(1ull << 52, -52, 0); }
+XI SD sd_add(SD a, SD b) { return sd_fma(a, sd_one(), b); }   // a*1 is exact: one rounding of a+b
+// a / b, b != 0, a >= 0 finite: bit-serial quotient of 55 bits + sticky remainder
+XN SD sd_div(SD a, SD b) {
+  if (a.m == 0) return sd_make(0, 0, a.s ^ b.s);
+  ulong rem = a.m, q = 0;
+  for (int i = 0; i < 55; i++) { q <<= 1; if (rem >= b.m) { rem -= b.m; q |= 1; } rem <<= 1; }
+  // a.m / b.m = q * 2^-54 + rem'...; q in [2^53, 2^55)
+  U128 M; M.hi = 0; M.lo = (q << 1) | (rem ? 1 : 0);   // one extra sticky bit position
+  return sd_round(M, a.e - b.e - 55, a.s ^ b.s);
+}
+XI SD sd_from_float(float x) {
+  const uint u = X_ASU(x), E = (u >> 23) & 255, F = u & 0x7fffff; const int s = (int)(u >> 31);
+  if (E == 0) {
+    if (F == 0) return sd_make(0, 0, s);
+    const int msb = 63 - X_CLZ64((ulong)F);
+    return sd_make((ulong)F << (52 - msb), -149 - (52 - msb), s);
+  }
+  return sd_make((ulong)(F | 0x800000u) << 29, (int)E - 179, s);
+}
+XI SD sd_from_i64(long v) {                       // |v| < 2^53
+  if (v == 0) return sd_make(0, 0, 0);
+  const int s = v < 0; const ulong a = s ? (ulong)(-v) : (ulong)v;
+  const int msb = 63 - X_CLZ64(a);
+  return sd_make(a << (52 - msb), msb - 52, s);
+}
+// RNE to float, incl. subnormal results; finite input
+XN float sd_to_float(SD a) {
+  const uint sb = (uint)a.s << 31;
+  if (a.m == 0) return X_ASF(sb);
+  int lead = a.e + 52;
+  if (lead >= -126) {
+    ulong keep = a.m >> 29; const ulong guard = (a.m >> 28) & 1, sticky = a.m & ((1ull << 28) - 1);
+    if (guard && (sticky || (keep & 1))) { keep += 1; if (keep == (1ull << 24)) { keep >>= 1; lead += 1; } }
+    if (lead + 127 >= 255) return X_ASF(sb | 0x7f800000u);
+    return X_ASF(sb | ((uint)(lead + 127) << 23) | (uint)(keep & 0x7fffff));
+  }
+  const int sh = -149 - a.e;                      // > 29
+  if (sh > 54) return X_ASF(sb);
+  ulong keep = sh >= 64 ? 0 : a.m >> sh; const ulong guard = (a.m >> (sh - 1)) & 1,
+        sticky = (sh - 1) >= 64 ? a.m : a.m & ((1ull << (sh - 1)) - 1);
+  if (guard && (sticky || (keep & 1))) keep += 1;
+  return X_ASF(sb | (uint)keep);                  // keep == 2^23 is the smallest normal: same bits
+}
