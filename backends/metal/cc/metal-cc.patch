+// ===================== FAST PATHS (M20 Stage 2 tuning). Each returns the exact result or defers to the exact
+// soft-double code above; correctness is by construction (verification) or by the exhaustive 2^32 checks.
+XI ulong xs_m32(uint a, uint b) { return (ulong)a * (ulong)b; }   // 32x32 -> 64 (cheap on Apple GPUs)
+// glibc expf (MOE-1 V2) in 64-bit fixed point: t = |x| * 32/ln2 (50 fractional bits), k = RNE(t), r = t - k,
+// y = 1 + C2 r + (C0 r + C1) r^2 (2^-60 units), A = y * 2^(j/32) (2^-62 units). glibc's double D differs from A by
+// < ~2^11 units (its own roundings: y1, y, y*s at 2^-53 each, r at 2^-54); A's float rounding is returned unless A is
+// within MARGIN = 2^13 units of a float midpoint (then the exact sx_expf). Fast domain: 2^-27 <= |x| < 2^7, result
+// normal; x == 0 -> 1. Proven equal to sx_expf / glibc on all 2^32 inputs (receipts/s2-fexp-*).
+XI float fx_expf_try(float x, XREF(bool) ok) {
+  const uint ux = X_ASU(x), E = (ux >> 23) & 255;
+  ok = true;
+  if ((ux & 0x7fffffffu) == 0) return 1.0f;
+  ok = false;
+  if (E < 100 || E > 133) return 0.0f;
+  if (x > 0x1.62e42ep6f || x < -0x1.5d589ep6f) return 0.0f;     // overflow side / results near 2^-126
