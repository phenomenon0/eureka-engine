+XSLOW float sx_expf(float x) {
+  const uint ux = X_ASU(x), abstop = (ux >> 20) & 0x7ff;
+  if (abstop >= 0x42b) {
+    if (ux == 0xff800000u) return 0.0f;
+    if (abstop >= 0x7f8) return x + x;
+    if (x > 0x1.62e42ep6f) return X_ASF(0x7f800000u);
+    if (x < -0x1.9fe368p6f) return 0.0f;
+  }
+  const SD INVLN2N = sd_make(0x171547652b82feull, -47, 0), SHIFT = sd_make(0x18000000000000ull, 0, 0);
+  const SD C0 = sd_make(0x1c6af84b912394ull, -72, 0), C1 = sd_make(0x1ebfce50fac4f3ull, -65, 0),
+           C2 = sd_make(0x162e42ff0c52d6ull, -58, 0);
+  const SD xd = sd_from_float(x);
+  const SD kd = sd_fma(INVLN2N, xd, SHIFT);       // in [2^52, 2^53): e == 0, m = SHIFT + k
+  const long k = (long)kd.m - (long)0x18000000000000ull;
+  SD nk = sd_from_i64(k); nk.s ^= 1;              // -(kd - SHIFT); k == 0 gives -0, as the double code
+  const SD r = sd_fma(INVLN2N, xd, nk);
+  const int j = (int)(kd.m & 31); const int q = (int)((k - j) / 32);
+  const SD sc = sd_make(XS_T[j] | (1ull << 52), -52 + q, 0);
+  const SD z = sd_fma(C0, r, C1), r2 = sd_mul(r, r);
+  SD y = sd_fma(C2, r, sd_one());
+  y = sd_fma(z, r2, y);
+  return sd_to_float(sd_mul(y, sc));
+}
