+kernel void llb_m_attn5sx(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant HybArgs& A [[buffer(2)]], uint gid [[threadgroup_position_in_grid]],
+  uint tx [[thread_position_in_threadgroup]]) {
+  device const float* q  = sa_f(C, S, A.a[0]);
+  device const float* kc = sa_f(C, S, A.a[1]);
+  device float* sc  = sa_f(C, S, A.a[4]);
+  const u32 c = A.c, dT = c & 31, pos = c >> 5, T = 1u << dT;
+  const u32 P = min(pos + 1, T), NB = A.n, h = gid / NB, b = gid % NB;
+  const u32 g = (h / A.k) * 256;
+  const float scale = 1.0f / sqrt(256.0f);
+  const float ninf = as_type<float>(0xFF800000u);
+  const u64 kvs = A.a[6];
+  device float* sh = sc + (u64)h * (1u << 17);
+  device float* R = sh + 65536;
+  device const float* qh = q + (u64)h * 256;
+  const u32 l = tx & 31, sgi = tx >> 5;
+  const float4 qa = *(device const float4*)(qh + 8 * l);
+  const float4 qb = *(device const float4*)(qh + 8 * l + 4);
+  for (u32 i = 0; i < 4; i++) {
+    const u32 t = 32 * b + sgi + 8 * i;
+    if (t < P) {
+      device const float* k = kc + (u64)t * kvs + g + 8 * l;
+      const float4 ka = *(device const float4*)k;
+      const float4 kb = *(device const float4*)(k + 4);
+      float v = ((ka.x * qa.x + ka.y * qa.y) + (ka.z * qa.z + ka.w * qa.w))
+        + ((kb.x * qb.x + kb.y * qb.y) + (kb.z * qb.z + kb.w * qb.w));
+      for (u32 m = 1; m < 32; m <<= 1) {
+        v = kq_bfly(v, l, m);
+      }
+      if (l == 0) {
+        sh[t] = v * scale;
+      }
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_device);
+  if (sgi == 0) {
+    const u32 t = 32 * b + l;
+    float v = t < P ? sh[t] : ninf;
+    for (u32 m = 1; m < 32; m <<= 1) {
+      v = m27_bmax(v, l, m);
+    }
+    if (l == 0) {
+      R[b] = v;
+    }
+  }
+}
