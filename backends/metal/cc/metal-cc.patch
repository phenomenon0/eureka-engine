+        llb_hidden_pos = pos;
+        llb_hidden_width = F.dm;
+      }
+      return true;
+    }
+    m9_pass_run(en, M9_A(x), M9_A(y), c, &S0, s, k, pw, po, tw, grid, 0);
+    return true;
+  }
+  if (aux == LLB_AOB_FID) {
+    // the attention output tail: attn4 -> output gate -> the o GEMV into y;
+    // q|gate one 8192 buffer, the gate at q + 4096 (CUDA's kind 19)
+    Term wbt = H[a + 1], qt = H[a + 2], kct = H[a + 3];
+    Term vct = H[a + 4], y = H[a + 5];
+    u32  wo = (u32)H[a + 6], c = (u32)H[a + 7], rgw = (u32)H[a + 8];
+    u32  dT = c & 31;
+    StrParts q = str_peek_ro(e, wbt);
+    bool rgt = rgw >> 30 & 1;
+    u32  rg = rgw & (rgt ? 0x0fffffffu : 0x7fffffffu);
+    u32  fm = rgt ? rgw >> 28 & 3 : (rgw >> 31 ? 2 : rg % 17 == 0);
