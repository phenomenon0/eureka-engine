+// ---- 2. the routing tail: ONE threadgroup of 288 threads: thread i < 256 = expert i; thread 256 (simdgroup 8) computes
+// the shexp sigmoid in parallel with the softmax; simdgroup 8 otherwise only passes the barriers.
+// renorm (the twin: sequential double sum of the 8 weights): exact integer fast path when the 8 terms fit a 53-bit
+// fixed point at their lowest set bit (then no sequential partial sum can round); else the soft-double chain.
+// the twin's renorm sum when the integer fast path does not apply (out of line: never if-converted into the hot path)
+__attribute__((noinline)) float xs_seqsum8(float a, float b, float c, float d, float e, float f, float g, float h) {
+  SD s = sd_add(sd_make(0, 0, 0), sd_from_float(a)); s = sd_add(s, sd_from_float(b)); s = sd_add(s, sd_from_float(c)); s = sd_add(s, sd_from_float(d));
+  s = sd_add(s, sd_from_float(e)); s = sd_add(s, sd_from_float(f)); s = sd_add(s, sd_from_float(g)); s = sd_add(s, sd_from_float(h));
+  return sd_to_float(s);
+}
+__attribute__((noinline)) SD xs_seqsum256(threadgroup const float* pp) {
+  SD S = sd_make(0, 0, 0);
+  for (u32 k = 0; k < MOE_NE; k++) S = sd_add(S, sd_from_float(pp[k]));
+  return S;
+}
+template <int MUT>
