+    return true;
+  }
+  if (aux == LLB_QKRQ_FID || aux == LLB_QKRK_FID) {
+    Term     wbt = H[a + 1], xt = H[a + 2], y = H[a + 3];
+    u32      at = (u32)H[a + 4], pos = (u32)H[a + 5];
+    StrParts q = str_peek_ro(e, wbt);
+    if (term_tag(wbt) != TAG_STR || str_nar(q) != 2 || at % 4 != 0
+      || M9_ARR(xt) || M9_ARR(y) || (u64)at + 256 * 4 > q.len) {
+      m9_bad(aux);
+    }
+    u64 w = (u64)((const u8*)(H + term_peek_ro(e, q.data)) + q.off + at
+      - (const u8*)H);
+    bool qk = aux == LLB_QKRQ_FID;
+    m9_args(&A, M9_A(xt), w, M9_A(y), 0, 0, 0, 0, qk ? 8192 : 1024, qk, pos,
+      0.0f);
+    m9_go(en, gpu_m_qkr, &A, qk ? 8192 / 512 : 1024 / 256, 256);
+    return true;
+  }
+  if (aux == LLB_SLOT_FID) {
+    // y is consumed and owned (a plain block, or a handle whose count is 1)
+    Term xt = H[a + 2], y = H[a + 3];
+    u32  c = (u32)H[a + 4], dT = c & 31, pos = c >> 5;
+    if (M9_ARR(xt) || M9_ARR(y)
+      || (blk_shr(y) && (H[term_loc(y)] & RFC_CNT) != 1)
+      || dT > 17 || blk_cls(xt) != 10 || blk_cls(y) != dT + 10
+      || pos >= (1u << dT)) {
+      m9_bad(aux);
+    }
+    m9_args(&A, M9_A(xt), M9_A(y) + (u64)pos * 1024 * 4, 0, 0, 0, 0, 0, 1024,
+      0, 0, 0.0f);
+    m9_go(en, gpu_m_slot, &A, 1, 1024);
+    return true;
+  }
+  return false;
+}
+
+// The parked attention tasks (f, +wt, +q, +kc, +vc, +c, y, +wo, +r, +rb), as
+// on CUDA: llb_attn into slot j of gpu_att, then the o GEMV (llb_warp, 2048 x
+// 2048 rows of wo, d = 9) into y, then llb_add adds the residual r into y; one
+// command buffer, then y goes to its continuation and a join that completes
+// reopens the frontier on ring 0. The parked rms tasks (f, +wb, +x, y, +base,
+// +n, +d, +rb, +an; tools/metal-rms.patch): llb_rms into slot j, then the
+// GEMV (llb_warp, n rows at base, d = 9) into y. The parked gemv tasks (f,
+// +wb, +x, y, +base, +n, +d, +rb; tools/metal-gemv.patch): llb_warp straight
+// on x in the corpus (buffer 1 rebound at x, slot 0), CUDA's operand checks;
+// F32 rows only (rb in (8 << d, 16 << d]: Q8_0 and F16 rows are refused).
+// tools/metal-interiors.patch: rope/put tasks (the rms task + at, +pos) run
+// the rms task's pair into y from slot at, then (rope) llb_rope in place; the
+// FFN task (f, +wb, +x, y, +base, +n, +d, +rb, +g, +u, +an, +rg): llb_rms,
+// the gate and up GEMVs into slot j of gpu_act (three zeroed runs of 8192),
+// llb_silu, the down GEMV on the silu run, llb_add of x. llb_warp's y is
+// buffer 3: the corpus, or gpu_act for gate/up.
+static bool warp_serve(Corpus H) {
+  u32 m = a32_load(a32_at(H, H_WARP_N));
+  if (m == 0) {
+    return false;
+  }
+  if (gpu_att == nil) {
+    gpu_attn = warp_pipe("llb_attn");
+    gpu_warp = warp_pipe("llb_warp");
+    gpu_warpq = warp_pipe("llb_warp_q8");
+    gpu_warpqs = warp_pipe("llb_warp_q8_split");
+    gpu_warpqv = warp_pipe("llb_warp_q8_v2");
+    gpu_warpq11 = warp_pipe("llb_warp_q8_v2d11_r2");
+    gpu_add  = warp_pipe("llb_add");
+    gpu_rms  = warp_pipe("llb_rms");
+    gpu_rope = warp_pipe("llb_rope");
+    gpu_silu = warp_pipe("llb_silu");
+    gpu_act  = [gpu_dev newBufferWithLength:3 * 8192 * 4 * LINE
+      options:MTLResourceStorageModeShared
+        | MTLResourceHazardTrackingModeUntracked];
+    memset([gpu_act contents], 0, 3 * 8192 * 4 * LINE);
+    if (gpu_rms.maxTotalThreadsPerThreadgroup < 1024) {
+      err_fail("warp rms: llb_rms needs a threadgroup of 1024");
+    }
+    gpu_att  = [gpu_dev newBufferWithLength:2048 * 4 * LINE
+      options:MTLResourceStorageModeShared
+        | MTLResourceHazardTrackingModeUntracked];
+    m9_init();
+  }
+  const char* gs   = getenv("LLB_WARP_GRID");
+  u32         grid = gs != NULL && atoi(gs) > 0 ? (u32)atoi(gs) : 4096;
+  Env         e    = { H, ALC[0] };
+  @autoreleasepool {
+    id<MTLCommandBuffer>         cb = [gpu_que commandBuffer];
+    // (tools/metal-m28.patch, overlap) concurrent: every dispatch path ends
+    // in a barrier (m28_bar) unless it is paired, and a barrier between tasks
+    // orders the legacy arms that end without one
+    id<MTLComputeCommandEncoder> en = [cb
+      computeCommandEncoderWithDispatchType:MTLDispatchTypeConcurrent];
+    [en setBuffer:gpu_buf offset:0 atIndex:0];
+    [en setBuffer:gpu_att offset:0 atIndex:1];
+    [en setBuffer:gpu_buf offset:0 atIndex:3];
+    // (lever E) one early split at most a round (m9_pass_run)
+    if (m30_fence == nil) {
+      m30_fence = [gpu_dev newFence];
+    }
+    m30_cb = cb; m30_en = en; m30_cb0 = nil;
+    if (m > LINE) {
+      err_fail("warp serve: more parked tasks than LINE");
+    }
+    for (u32 j = 0; j < m; j += 1) {
+      Term     t  = H[H_WARP + j];
+      Loc      a  = term_loc(t);
+      if (j > 0) {
+        [en memoryBarrierWithScope:MTLBarrierScopeBuffers];
+      }
+      m28_nb = false;
+      if (m9_serve(e, H, en, t, grid)) {
+        en = m30_en;
+        cb = m30_cb;
+        [en setBuffer:gpu_att offset:0 atIndex:1];
+        [en setBuffer:gpu_buf offset:0 atIndex:3];
+        continue;
+      }
+      bool     at = (u32)term_aux(t) == LLB_ATTN_FID;
+      Term     x  = H[a + 2], y = H[a + (at ? 6 : 3)];
+      u32      bs = (u32)H[a + (at ? 7 : 4)], n = at ? 2048 : (u32)H[a + 5];
+      StrParts p  = str_peek_ro(e, H[a + 1]);
+      const u8* w = (const u8*)(H + term_peek_ro(e, p.data)) + p.off + bs;
+      if ((u32)term_aux(t) == LLB_WARP_FID) {
+        u32 d = (u32)H[a + 6], rb = (u32)H[a + 7];
+        u64 xo = 8ull * blk_loc(H, x);
+        // Q8_0 rows (tools/metal-q8.patch): rb = c * 17 / 16, 4 | rb; F32
+        // rows are 4c, and the model's c (2048, 6144) has no factor 17.
+        bool q8 = rb % 17 == 0;
+        if (term_tag(H[a + 1]) != TAG_STR || str_nar(p) != 2 || d < 9 || d > 11
+          || (q8 ? rb / 17 % 4 != 0
+            : rb % 16 != 0 || rb <= 8u << d || rb > 16u << d)
+          || ((uintptr_t)w & 15) != 0
+          || (u64)bs + (u64)n * rb > p.len || term_tag(x) == TAG_ARR
+          || term_tag(y) == TAG_ARR || blk_cls(x) < d + 2
+          || n > 1ull << blk_cls(y) || (xo & 15) != 0) {
+          err_fail("warp GEMV: unsupported operands");
+        }
+        WarpArgs wa = { (u64)(w - (const u8*)H), 8ull * blk_loc(H, y),
+          q8 ? rb : rb / 16, q8 ? rb / 17 * 4 : rb / 16, n, d, 0 };
+        [en setBuffer:gpu_buf offset:xo atIndex:1];
+        [en setComputePipelineState:q8 ? gpu_warpq : gpu_warp];
+        [en setBytes:&wa length:sizeof wa atIndex:2];
+        [en dispatchThreadgroups:MTLSizeMake(grid, 1, 1)
+          threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
+        [en setBuffer:gpu_att offset:0 atIndex:1];
+        continue;
+      }
+      if ((u32)term_aux(t) == LLB_FFN_FID) {
+        u32 d = (u32)H[a + 6], rb = (u32)H[a + 7], gb = (u32)H[a + 8];
+        u32 ub = (u32)H[a + 9], an = (u32)H[a + 10], rg = (u32)H[a + 11];
+        const u8* wb = (const u8*)(H + term_peek_ro(e, p.data)) + p.off;
+        // Q8_0 rows (tools/metal-q8.patch): gate/up rows are rg bytes (F32
+        // 8192, Q8 2176), the down row rb (F32 24576, Q8 6528).
+        bool q8g = rg % 17 == 0, q8d = rb % 17 == 0;
+        if (term_tag(H[a + 1]) != TAG_STR || str_nar(p) != 2 || n != 2048
+          || d != 11 || (q8d ? rb / 17 % 4 != 0 : rb != 24576)
+          || (q8g ? rg / 17 % 4 != 0 : rg != 8192)
+          || ((uintptr_t)w & 15) != 0
+          || ((uintptr_t)(wb + gb) & 15) != 0 || ((uintptr_t)(wb + ub) & 15) != 0
+          || (u64)bs + 2048ull * rb > p.len || (u64)gb + 6144ull * rg > p.len
+          || (u64)ub + 6144ull * rg > p.len || an % 4 != 0
+          || (u64)an + 2048 * 4 > p.len || term_tag(x) == TAG_ARR
+          || term_tag(y) == TAG_ARR || blk_cls(x) != 11 || blk_cls(y) < 11) {
+          err_fail("warp FFN: unsupported operands");
+        }
+        u32 go = j * 3 * 8192;
+        RmsArgs ra = { 8ull * blk_loc(H, x), (u64)(wb + an - (const u8*)H), j };
+        [en setComputePipelineState:gpu_rms];
+        [en setBytes:&ra length:sizeof ra atIndex:2];
+        [en dispatchThreadgroups:MTLSizeMake(1, 1, 1)
+          threadsPerThreadgroup:MTLSizeMake(1024, 1, 1)];
+        [en memoryBarrierWithScope:MTLBarrierScopeBuffers];
+        [en setBuffer:gpu_act offset:0 atIndex:3];
+        [en setComputePipelineState:q8g ? gpu_warpq : gpu_warp];
+        for (u32 h = 0; h < 2; h += 1) {
+          WarpArgs wa = { (u64)(wb + (h ? ub : gb) - (const u8*)H),
+            4ull * (go + h * 8192), q8g ? rg : 512, q8g ? rg / 17 * 4 : 512,
+            6144, 9, j };
+          [en setBytes:&wa length:sizeof wa atIndex:2];
+          [en dispatchThreadgroups:MTLSizeMake(grid, 1, 1)
+            threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
+        }
+        [en memoryBarrierWithScope:MTLBarrierScopeBuffers];
+        [en setBuffer:gpu_act offset:0 atIndex:1];
+        [en setComputePipelineState:gpu_silu];
+        [en setBytes:&go length:sizeof go atIndex:2];
+        [en dispatchThreadgroups:MTLSizeMake(24, 1, 1)
+          threadsPerThreadgroup:MTLSizeMake(256, 1, 1)];
+        [en memoryBarrierWithScope:MTLBarrierScopeBuffers];
+        [en setBuffer:gpu_act offset:4ull * (go + 2 * 8192) atIndex:1];
+        [en setBuffer:gpu_buf offset:0 atIndex:3];
+        WarpArgs wd = { (u64)(w - (const u8*)H), 8ull * blk_loc(H, y),
+          q8d ? rb : rb / 16, q8d ? rb / 17 * 4 : rb / 16, 2048, 11, 0 };
+        [en setComputePipelineState:q8d ? gpu_warpq : gpu_warp];
+        [en setBytes:&wd length:sizeof wd atIndex:2];
+        [en dispatchThreadgroups:MTLSizeMake(grid, 1, 1)
+          threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
+        [en memoryBarrierWithScope:MTLBarrierScopeBuffers];
+        [en setBuffer:gpu_att offset:0 atIndex:1];
+        AddArgs ad = { 8ull * blk_loc(H, x), 8ull * blk_loc(H, y) };
+        [en setComputePipelineState:gpu_add];
+        [en setBytes:&ad length:sizeof ad atIndex:2];
+        [en dispatchThreadgroups:MTLSizeMake(8, 1, 1)
+          threadsPerThreadgroup:MTLSizeMake(256, 1, 1)];
+        continue;
+      }
+      if (!at) {
+        u32 an = (u32)H[a + 8];
+        bool ro = (u32)term_aux(t) == LLB_ROPE_FID;
+        bool pt = (u32)term_aux(t) == LLB_PUT_FID;
+        u32 as = ro || pt ? (u32)H[a + 9] : 0;
+        if ((ro || pt) && (n % 256 != 0 || (u64)as + n > 1ull << blk_cls(y))) {
+          err_fail("warp rope: unsupported operands");
+        }
+        u32  rbr = (u32)H[a + 7];
+        bool q8r = rbr % 17 == 0;
+        if (((u32)term_aux(t) != LLB_RMS_FID && !ro && !pt)
+          || term_tag(H[a + 1]) != TAG_STR
+          || str_nar(p) != 2 || ((uintptr_t)w & 15) != 0
+          || (u32)H[a + 6] != 9
+          || (q8r ? rbr / 17 % 4 != 0 : rbr != 8192)
+          || (u64)bs + (u64)n * rbr > p.len || term_tag(x) == TAG_ARR
+          || term_tag(y) == TAG_ARR || blk_cls(x) != 11
+          || n > 1ull << blk_cls(y) || an % 4 != 0
+          || (u64)an + 2048 * 4 > p.len) {
+          err_fail("warp rms: unsupported operands");
+        }
+        const u8* wn = (const u8*)(H + term_peek_ro(e, p.data)) + p.off + an;
+        RmsArgs ra = { 8ull * blk_loc(H, x), (u64)(wn - (const u8*)H), j };
+        [en setComputePipelineState:gpu_rms];
+        [en setBytes:&ra length:sizeof ra atIndex:2];
+        [en dispatchThreadgroups:MTLSizeMake(1, 1, 1)
+          threadsPerThreadgroup:MTLSizeMake(1024, 1, 1)];
+        [en memoryBarrierWithScope:MTLBarrierScopeBuffers];
+        WarpArgs wa = { (u64)(w - (const u8*)H), 8ull * blk_loc(H, y) + 4ull * as,
+          q8r ? rbr : 512, q8r ? rbr / 17 * 4 : 512, n, 9, j };
+        [en setComputePipelineState:q8r ? gpu_warpq : gpu_warp];
+        [en setBytes:&wa length:sizeof wa atIndex:2];
+        [en dispatchThreadgroups:MTLSizeMake(grid, 1, 1)
+          threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
+        if (ro) {
+          [en memoryBarrierWithScope:MTLBarrierScopeBuffers];
+          RopeArgs rp = { wa.y, n, (f32)(u32)H[a + 10] };
+          [en setComputePipelineState:gpu_rope];
+          [en setBytes:&rp length:sizeof rp atIndex:2];
+          [en dispatchThreadgroups:MTLSizeMake((n / 2 + 127) / 128, 1, 1)
+            threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
+        }
+        continue;
+      }
+      Term     kc = H[a + 3], vc = H[a + 4], r = H[a + 8];
+      u32      c  = (u32)H[a + 5], dT = c & 31, rb = (u32)H[a + 9];
+      bool     q8 = rb % 17 == 0;
+      if (term_tag(H[a + 1]) != TAG_STR
+        || str_nar(p) != 2 || ((uintptr_t)w & 15) != 0
+        || (u64)bs + 2048ull * rb > p.len || term_tag(x) == TAG_ARR
+        || term_tag(y) == TAG_ARR || blk_cls(x) < 11 || blk_cls(y) < 11
+        || dT > 10 || term_tag(kc) == TAG_ARR || term_tag(vc) == TAG_ARR
+        || blk_cls(kc) < dT + 8 || blk_cls(vc) < dT + 8
+        || term_tag(r) == TAG_ARR || blk_cls(r) != 11
+        || (q8 ? rb / 17 % 4 != 0 : rb != 8192)) {
+        err_fail("warp attention: unsupported operands");
+      }
+      AttnArgs aa = { 8ull * blk_loc(H, x), 8ull * blk_loc(H, kc),
+        8ull * blk_loc(H, vc), c, j };
+      [en setComputePipelineState:gpu_attn];
+      [en setBytes:&aa length:sizeof aa atIndex:2];
+      [en dispatchThreadgroups:MTLSizeMake(16, 1, 1)
+        threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
+      [en memoryBarrierWithScope:MTLBarrierScopeBuffers];
+      WarpArgs wa = { (u64)(w - (const u8*)H), 8ull * blk_loc(H, y),
+        q8 ? rb : 512, q8 ? rb / 17 * 4 : 512, 2048, 9, j };
+      [en setComputePipelineState:q8 ? gpu_warpq : gpu_warp];
+      [en setBytes:&wa length:sizeof wa atIndex:2];
+      [en dispatchThreadgroups:MTLSizeMake(grid, 1, 1)
+        threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
+      [en memoryBarrierWithScope:MTLBarrierScopeBuffers];
+      AddArgs ra = { 8ull * blk_loc(H, r), 8ull * blk_loc(H, y) };
+      [en setComputePipelineState:gpu_add];
+      [en setBytes:&ra length:sizeof ra atIndex:2];
+      [en dispatchThreadgroups:MTLSizeMake(8, 1, 1)
+        threadsPerThreadgroup:MTLSizeMake(256, 1, 1)];
+    }
+    [en memoryBarrierWithScope:MTLBarrierScopeBuffers];
+    // tools/metal-cbfold.patch (lane m13): one command buffer and one wait a
+    // served round, not two. The delivery reads and writes only the tasks'
+    // continuations, their rem counters, the lent caches' count words and
+    // ring 0; no parked kernel reads or writes those, and they are final
+    // since the pass that parked the tasks. (tools/metal-m30.patch, lever E:
+    // after an early split the first buffer may still run while the host
+    // delivers; it touches none of these words either, Fable c1.) So the host delivers here, before
+    // the commit, with the GPU idle (never beside it), and cube_run's next
+    // gpu_pass(0) is encoded after the barrier above: the same dispatches in
+    // the same order, the kernels' y fenced before the interpreter reads it.
+    u32 k = 0;
+    for (u32 j = 0; j < m; j += 1) {
+      Term t  = H[H_WARP + j];
+      Loc  tl = task_tail(t);
+      Term rv[WL_RESW];
+      // CUDA's llb_deliver: attn4's y is its 4th term, the aob block's its 5th,
+      // the llama attention's its 6th, the others' their 3rd
+      rv[0]   = H[term_loc(t) + ((u32)term_aux(t) == LLB_ATTN_FID ? 6
+        : (u32)term_aux(t) == LLB_ATTN4_FID ? 4
+        : (u32)term_aux(t) == LLB_AOB_FID ? 5 : 3)];
+      // the aob block's caches come lent: return the lend, so llb.slot_warp
+      // finds the cache unique next step (tools/payload-slot.patch)
+      for (u32 f = 3; (u32)term_aux(t) == LLB_AOB_FID && f < 5; f += 1) {
+        Term kv = H[term_loc(t) + f];
+        if (!term_triv(kv) && term_rfc(kv)
+          && (H[term_loc(kv)] & RFC_CNT) > 1) {
+          a32_sub_rel(a32_at(H, term_loc(kv)), 1);
+        }
+      }
+      // the full-attention block's caches (fields 4, 5) come lent the same way
+      // (tools/metal-fulb.patch)
+      for (u32 f = 4; (u32)term_aux(t) == LLB_FULB_FID && f < 6; f += 1) {
+        Term kv = H[term_loc(t) + f];
+        if (!term_triv(kv) && term_rfc(kv)
+          && (H[term_loc(kv)] & RFC_CNT) > 1) {
+          a32_sub_rel(a32_at(H, term_loc(kv)), 1);
+        }
+      }
+      Term c  = task_deliver(H, H[tl], (u32)(H[tl + 1] >> 32) & 0xFFFF, rv, 1);
+      if (c != 0) {
+        ring_push(H, 0, c);
+        k += 1;
+      }
+    }
+    a32_store(a32_at(H, H_WARP_N), 0);
+    a32_store(a32_at(H, H_CURSOR), k);
+    gpu_enc = en;
+    gpu_pass_enc();
+    [en endEncoding];
+    [cb commit];
+    m30_wait(cb);
+    if ([cb error]) {
+      gpu_fail([cb error]);
+    }
+    // (tools/metal-moe.patch) the Stage 1 gate's dump, if one is pending
+    m24_flush();
+    llb_hidden_flush();
+    // (lever E) the early buffer completed before the last one began (fence)
+    if (m30_cb0 != nil && [m30_cb0 error]) {
+      gpu_fail([m30_cb0 error]);
+    }
+    m30_cb = nil; m30_en = nil; m30_cb0 = nil;
+  }
+  return true;
+}
+
+// (tools/metal-moe.patch, M24) The Qwen3.6-35B-A3B (qwen35moe: 40 layers, d
+// 2048, the shared expert's f 512, GQA 16 / 2, 256 routed experts, top 8) on
+// Metal: CUDA's tools/payload-moe.patch host side (llb_moe_reserve, llb_moe_run,
+// the F32 kgemv, attn8 / slot 512) as new chains beside the 9B's, which stay
+// textually unchanged. Admission: the pass bang's task word 50 is the pack's
+// experts.idx (Bytes; SNil for the 9B) and every table row carries words 21 /
+// 22 (router, shexp gate); rg / rd must then be q8rw(2048) / q8rw(512).
+//
+// The routed experts (19.67 GB) are the GGUF's own bytes: the file is mapped
+// read-only and each expert tensor's page-aligned window is a no-copy
+// MTLBuffer (CUDA: llb_alloc_zero + llb_upload into a device pool; llama.cpp's
+// Metal backend maps its model the same way). The pages are the file cache:
+// clean, shared with any other reader of the file, never anonymous memory (an
+// anonymous 19.67 GB copy pushed this Mac into swap). They are touched once
+// up front (the load time). The MoE kernels (M20's leaves) take their buffers
+// at indices 0 .. 7 with offsets; m24_bind0 rebinds index 0 to the corpus
+// after each, as m9_go / m9_gemv assume it.
+static id<MTLComputePipelineState> gpu_moe_rdot, gpu_moe_tail, gpu_m_attn8, gpu_m_f32ab;
+static id<MTLComputePipelineState> gpu_moe_gu[2], gpu_moe_dn[2];
+// (tools/metal-m29.patch, lever 3) M27's attention over the positions
+static id<MTLComputePipelineState> gpu_x_attn5, gpu_x_a5s, gpu_x_a5v;
+// (lane m32) the 35B chain's l2norm form (M24 L6), created by m24_init
+static id<MTLComputePipelineState> gpu_m_l2n4;
+static bool                       moe_on;
+// per layer: gate / up / down's buffer and the tensor's offset in it (256
+// experts each), their expert strides, the gate/up format (Q4_K 3 | Q5_K 9)
+// and the down format (Q5_K 9 | Q6_K 4)
+static id<MTLBuffer> moe_b[40][3];
+static u64  moe_o[40][3], moe_eg[40], moe_ed[40];
+static u32  moe_fg[40], moe_fd[40];
+// the Stage 1 gate (env, read once; never set when serving): LLB_MOE_GATE =
+// "<layer>:<feed file or ->:<dump dir>", LLB_MOE_MUT = a mutant's name
+static int  moe_gl = -1;
+static u32  moe_gn, moe_dfd;
+static f32* moe_feed;
+// (ENGINE-REPEAT) the experts' GGUF map, for bend_close
+static u8*  moe_map;
+static u64  moe_maplen;
+static char moe_dir[1024];
+static u64  moe_fslot, moe_dmb, moe_dout;
+static int  moe_pend_l = -1, moe_pend_p;
+
+typedef struct {
+  u64 eg, ed;
+  u32 dbg, pad0, pad1, pad2;
+} M24MoeArgs;
+
+static id<MTLComputePipelineState> m24_pipe(const char* name, u32 thr) {
+  id<MTLComputePipelineState> p = warp_pipe(name);
+  if (p.maxTotalThreadsPerThreadgroup < thr) {
+    err_fail("warp pass: a 35B MoE kernel's threadgroup does not fit");
+  }
+  return p;
+}
+
+static u32 m24_mut(void) {
+  const char* m = getenv("LLB_MOE_MUT");
+  if (m == NULL || *m == 0) {
+    return 0;
+  }
+  return strcmp(m, "no_renorm") == 0 ? 2u : strcmp(m, "shared_first") == 0 ? 4u
+    : strcmp(m, "no_sigmoid") == 0 ? 64u : strcmp(m, "stride") == 0 ? 128u
+    : strcmp(m, "down_as_q6") == 0 ? 1001u : strcmp(m, "down_as_q5") == 0
+    ? 1002u : 0xFFFFFFFFu;
+}
+
+static void m24_init(void) {
+  u32 mt = m24_mut();
+  if (mt == 0xFFFFFFFFu) {
+    err_fail("LLB_MOE_MUT: unknown mutant");
+  }
+  if (mt != 0) {
+    fprintf(stderr, "moe gate: MUTANT %s\n", getenv("LLB_MOE_MUT"));
+  }
+  char nm[64];
+  gpu_moe_rdot = m24_pipe("moe_rdot", 128);
+  gpu_moe_tail = m24_pipe(mt == 2 ? "moe_tail_m2" : "moe_tail_m0", 288);
+  for (u32 f = 0; f < 2; f += 1) {
+    snprintf(nm, sizeof nm, "moe_gu_f%u_m%u_v0", f ? 9u : 4u, mt == 128 ? 128u : 0u);
+    gpu_moe_gu[f] = m24_pipe(nm, 64);
+    snprintf(nm, sizeof nm, "moe_dn_f%u_m%u_r2", f ? 6u : 9u,
+      mt == 4 || mt == 64 || mt == 128 ? mt : 0u);
+    gpu_moe_dn[f] = m24_pipe(nm, 128);
+  }
+  gpu_m_attn8 = m24_pipe("llb_m_attn8", 256);
+  gpu_m_f32ab = m24_pipe("llb_m_f32ab", 128);
+  gpu_x_attn5 = m24_pipe("llb_m_attn5x", 1024);
+  gpu_x_a5s   = m24_pipe("llb_m_attn5sx", 256);
+  gpu_x_a5v   = m24_pipe("llb_m_attn5vx", 256);
+  gpu_m_l2n4  = m24_pipe("llb_m_l2n4", 64);
+  // a format mutant: the down rows decoded in the other K format
+  moe_dfd = mt == 1001 ? LLB_FM_Q6_K : mt == 1002 ? LLB_FM_Q5_K : 0;
+  const char* g = getenv("LLB_MOE_GATE");
+  if (g != NULL && *g != 0) {
+    char f[1024];
+    if (sscanf(g, "%d:%1023[^:]:%1023s", &moe_gl, f, moe_dir) != 3 || moe_gl < 0
+      || moe_gl >= 40) {
+      err_fail("LLB_MOE_GATE: <layer>:<feed file or ->:<dump dir>");
+    }
+    moe_gn = 4;
+    if (strcmp(f, "-") != 0) {
+      FILE* fp = fopen(f, "rb");
+      if (fp == NULL) {
+        err_fail("LLB_MOE_GATE: cannot open the feed file");
+      }
+      moe_feed = malloc(64 * 2048 * 4);
+      moe_gn = (u32)fread(moe_feed, 2048 * 4, 64, fp);
+      fclose(fp);
+    }
+    fprintf(stderr, "moe gate: layer %d, %s %u positions, dump %s\n", moe_gl,
+      moe_feed ? "feed" : "no feed,", moe_gn, moe_dir);
+  }
+}
+
+// experts.idx: "gguf <path>" then per layer "i og fg sg ou fu su od fd sd"
+// (GGUF byte offset, format, expert stride of gate / up / down). Each tensor
+// is 256 contiguous experts; its stride must be rows x row bytes of its
+// format (gate/up 512 x 2048 cols, down 2048 x 512 cols).
+static void m24_pool(const u8* ix, u64 len) {
+  char* t = malloc(len + 1);
+  memcpy(t, ix, len);
+  t[len] = 0;
+  char path[1024];
+  char* ln = strchr(t, '\n');
+  if (ln == NULL || sscanf(t, "gguf %1023s", path) != 1) {
+    err_fail("moe pool: experts.idx header");
+  }
+  u64 src[40][3], tot = 0;
+  for (u32 i = 0; i < 40; i += 1) {
+    u32 li, a, b, c;
+    unsigned long long og, ou, od, sg, su, sd;
+    if (ln == NULL || sscanf(ln + 1, "%u %llu %u %llu %llu %u %llu %llu %u %llu",
+      &li, &og, &a, &sg, &ou, &b, &su, &od, &c, &sd) != 10 || li != i
+      || a != b || !(a == LLB_FM_Q4_K || a == LLB_FM_Q5_K)
+      || !(c == LLB_FM_Q5_K || c == LLB_FM_Q6_K) || sg != su
+      || sg != 512ull * LLB_FM_RB(a, 2048) || sd != 2048ull * LLB_FM_RB(c, 512)
+      || og % 16 != 0 || ou % 16 != 0 || od % 16 != 0) {
+      err_fail("moe pool: experts.idx row refused (40 layers; Q4_K / Q5_K"
+        " gate = up, Q5_K / Q6_K down, whole-tensor strides, 16-aligned)");
+    }
+    ln = strchr(ln + 1, '\n');
+    moe_fg[i] = a;
+    moe_fd[i] = c;
+    moe_eg[i] = sg;
+    moe_ed[i] = sd;
+    src[i][0] = og;
+    src[i][1] = ou;
+    src[i][2] = od;
+    tot += 256 * (2 * sg + sd);
+  }
+  int fd = open(path, O_RDONLY);
+  struct stat st;
+  if (fd < 0 || fstat(fd, &st) != 0) {
+    err_fail("moe pool: cannot open the GGUF");
+  }
+  u64 pg = 16384, flen = ((u64)st.st_size + pg - 1) & ~(pg - 1);
+  u8* F = mmap(NULL, flen, PROT_READ, MAP_SHARED, fd, 0);
+  close(fd);
+  if (F == MAP_FAILED) {
+    err_fail("moe pool: cannot map the GGUF");
+  }
+  moe_map    = F;
+  moe_maplen = flen;
+  struct timespec t0, t1;
+  clock_gettime(CLOCK_MONOTONIC, &t0);
+  volatile u64 sink = 0;
+  for (u32 i = 0; i < 40; i += 1) {
+    for (u32 r = 0; r < 3; r += 1) {
+      u64 n = 256 * (r == 2 ? moe_ed[i] : moe_eg[i]);
+      u64 lo = src[i][r] & ~(pg - 1), hi = (src[i][r] + n + pg - 1) & ~(pg - 1);
+      if (src[i][r] + n > (u64)st.st_size) {
+        err_fail("moe pool: an expert tensor lies past the GGUF's end");
+      }
+      madvise(F + lo, hi - lo, MADV_WILLNEED);
+      for (u64 k = lo; k < hi; k += pg) {
+        sink += F[k];
+      }
+      moe_b[i][r] = [gpu_dev newBufferWithBytesNoCopy:F + lo length:hi - lo
+        options:MTLResourceStorageModeShared
+          | MTLResourceHazardTrackingModeUntracked deallocator:nil];
+      if (moe_b[i][r] == nil) {
+        err_fail("moe pool: cannot wrap an expert tensor in a buffer");
+      }
+      moe_o[i][r] = src[i][r] - lo;
+    }
+  }
+  clock_gettime(CLOCK_MONOTONIC, &t1);
+  (void)sink;
+  f64 s = (f64)(t1.tv_sec - t0.tv_sec) + (f64)(t1.tv_nsec - t0.tv_nsec) * 1e-9;
+  fprintf(stderr, "moe pool: 40 layers, %llu bytes of experts mapped from %s,"
+    " touched in %.2f s (%.2f GB/s)\n", (unsigned long long)tot, path, s,
+    (f64)tot / s * 1e-9);
+  free(t);
+}
+
+static void m24_bind(id<MTLComputeCommandEncoder> en, u64 sa, u32 i) {
+  [en setBuffer:((sa & SA_SCR) != 0 ? gpu_scr : gpu_buf) offset:(sa & ~SA_SCR)
+    atIndex:i];
+}
+
+static void m24_bind0(id<MTLComputeCommandEncoder> en) {
+  [en setBuffer:gpu_buf offset:0 atIndex:0];
+}
+
+// the 35B's Q8 GEMVs: d 9 (2048 cols) on llb_warp_q8_split at 64 threads (2
+// simdgroups a row, a perfect subtree each: M20 3(c)), d 10 (4096 cols) on
+// v2; anything else is refused, never passed to a body that would skip it
+static void m24_q8(id<MTLComputeCommandEncoder> en, u64 w, u32 rb, u64 x,
+  u64 y, u32 n, u32 d) {
+  if (!((d == 9 && rb == 2176) || (d == 10 && rb == 4352)) || n == 0
+    || (w & 15) != 0 || (x & 15) != 0) {
+    err_fail("warp pass: 35B Q8 GEMV refused (d 9 = 2048 cols, d 10 = 4096"
+      " cols, aligned)");
+  }
+  m24_bind(en, x, 1);
+  [en setBuffer:((y & SA_SCR) != 0 ? gpu_scr : gpu_buf) offset:0 atIndex:3];
+  WarpArgs wa = { w, y & ~SA_SCR, rb, rb / 17 * 4, n, d, 0 };
+  [en setComputePipelineState:d == 10 ? gpu_warpqv : gpu_warpqs];
+  [en setBytes:&wa length:sizeof wa atIndex:2];
+  [en dispatchThreadgroups:MTLSizeMake(n < 32768 ? n : 32768, 1, 1)
+    threadsPerThreadgroup:MTLSizeMake(d == 10 ? 128 : 64, 1, 1)];
+  m28_bar(en);
+}
+
+// the F32 ssm_beta / ssm_alpha [32 x 2048]: llb_warp (the F32 body m9_gemv
+// takes for fm 0; d 9: one 512-group chunk, the same fixed tree), 4 rows a
+// threadgroup
+static void m24_f32(id<MTLComputeCommandEncoder> en, u64 w, u64 x, u64 y,
+  u32 n) {
+  if ((w & 15) != 0 || (x & 15) != 0) {
+    err_fail("warp pass: 35B F32 GEMV refused (aligned)");
+  }
+  m24_bind(en, x, 1);
+  [en setBuffer:((y & SA_SCR) != 0 ? gpu_scr : gpu_buf) offset:0 atIndex:3];
+  WarpArgs wa = { w, y & ~SA_SCR, 512, 512, n, 9, 0 };
+  [en setComputePipelineState:gpu_warp];
+  [en setBytes:&wa length:sizeof wa atIndex:2];
+  [en dispatchThreadgroups:MTLSizeMake((n + 3) / 4, 1, 1)
+    threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
+  m28_bar(en);
+}
+
+// the 35B linear layer: m9_linb_run's chain at d 2048 (the SSM interior is the
+// 9B's: qkv 8192, z 4096, 32 value heads of 128, 16 key heads); p the layer's
+// Offs words from its table row
+static void m24_linb_run(id<MTLComputeCommandEncoder> en, u64 b, const u32* p,
+  u64 x, u64 qkva, u64 h0, u64 h1, u64 h2, u64 S, u64 y, bool nrm) {
+  HybArgs A;
+  u64 zz = M9_BLK, bpre = zz + 4096 * 4, apre = bpre + 32 * 4;
+  u64 hb = M9_BLK + 39040 * 4;
+  u64 beta = apre + 32 * 4, dec = beta + 32 * 4;
+  u64 cnv = dec + 32 * 4, cnvk = cnv + 2048 * 4, vn = cnv + 4096 * 4;
+  u64 gout = cnv + 8192 * 4, qt = gout + 4096 * 4;
+  u64 qt2 = qt + 2048 * 4, kt = qt + 4096 * 4;
+  u64 kt2 = kt + 2048 * 4, normed = kt + 4096 * 4;
+  union { u32 u; f32 f; } sq = { 0x413504f3u };
+  // (tools/metal-m29.patch, lever 6) hb was written by the previous layer's
+  // addrms when nrm
+  if (!nrm) {
+    m9_rnorm(en, x, b + p[0], hb, 2048);
+  }
+  // (tools/metal-m29.patch, overlap = M28's linb schedule at d 2048) the small
+  // serial chain (f32ab -> mida -> midb, conv -> l2n4, then gdl2) beside the
+  // qkv GEMV and three row slices of the z GEMV (rows are independent: the
+  // same bits). [qkv | f32ab] -> [z 0 .. 2048 | mida | conv] -> [z 2048 ..
+  // 3328 | midb | l2n4] -> [z 3328 .. 4096 | gdl2]. Disjoint in every group:
+  // the GEMVs read hb [39040, 41088) floats of M9_BLK (d 9: exactly 2048
+  // columns, no pad leaves) and write the ring slot qkva, zz [0, 4096), bpre /
+  // apre [4096, 4160); mida writes the slot [38912, 38944); midb beta / dec
+  // [4160, 4224); conv cnv [4224, 12416) (reads the ring); l2n4 qt .. kt2
+  // [16512, 24704); gdl2 gout [12416, 16512) and S. No slice is 1024 rows
+  m28_nb = true;
+  m24_q8(en, b + p[5], 2176, hb, qkva, 8192, 9);
+  // (M24 lever L4) beta and alpha in one dispatch (bpre, apre adjacent)
+  m9_args(&A, b + p[7], b + p[8], hb, bpre, 0, 0, 0, 32, 0, 0, 0.0f);
+  m9_go(en, gpu_m_f32ab, &A, 16, 128);
+  m9_args(&A, bpre, apre, b + p[10], b + p[9], beta, dec, M9_BLK + 38912 * 4,
+    32, 0, 0, 0.0f);
+  m28_nb = true;
+  m9_go(en, gpu_m_mida, &A, 1, 32);
+  m9_args(&A, b + p[11], qkva, h0, h1, h2, cnv, 0, 8192, 0, 0, 0.0f);
+  m28_nb = true;
+  m9_go(en, gpu_m_conv, &A, (8192 + 255) / 256, 256);
+  m24_q8(en, b + p[6], 2176, hb, zz, 2048, 9);
+  m9_args(&A, bpre, apre, b + p[10], b + p[9], beta, dec, M9_BLK + 38912 * 4,
+    32, 0, 0, 0.0f);
+  m28_nb = true;
+  m9_go(en, gpu_m_midb, &A, 1, 32);
+  // (M24 lever L6) the four l2norms in one dispatch
+  m9_args(&A, cnv, cnvk, qt, qt2, kt, kt2, 0, 16, 0, 0, sq.f);
+  m28_nb = true;
+  m9_go(en, gpu_m_l2n4, &A, 32, 64);
+  m24_q8(en, b + p[6] + 2048ull * 2176, 2176, hb, zz + 2048 * 4, 1280, 9);
+  m9_args(&A, S, qt, kt, vn, dec, beta, gout, 32, 0, 0, 0.0f);
+  m28_nb = true;
+  m9_go(en, gpu_m_gdl2, &A, 32 * 4, 1024);
+  m24_q8(en, b + p[6] + 3328ull * 2176, 2176, hb, zz + 3328 * 4, 768, 9);
+  m9_args(&A, gout, b + p[12], zz, normed, 0, 0, 0, 32, 0, 0, 0.0f);
+  m9_go(en, gpu_m_grn, &A, 32, 64);
+  m24_q8(en, b + p[13], 4352, normed, y, 2048, 10);
+}
+
+// (tools/metal-m29.patch, lever 3 = M27's m9_attn5 at the 35B's shape) the
+// pass chain's attention: llb_m_attn5, attn8's bytes at the positions' cost
+// (needs the pass arm's zeroed, in-order kv state: m24_reserve zeroes it,
+// m24_pass_run enforces pos 0, 1, 2, ..); the same planes and arguments as
+// attn8, plus A.k = 8 (16 heads over 2 kv heads) and the kv stride 512 in
+// A.a[6]. L >= 128 live slots (dT <= 16) take the 4-dispatch split. Never
+// pair (m28_nb) a dispatch before this: the split issues four
+static void m29_attn5(id<MTLComputeCommandEncoder> en, u64 q, u64 kc, u64 vc,
+  u64 y, u32 c) {
+  HybArgs A;
+  const u32 nh = 16;
+  m9_args(&A, q, kc, vc, y, M9_ATTS, M9_ATTS + ((u64)nh << 17) * 4, 512, 0, c,
+    8, 0.0f);
+  u32 dT = c & 31, pos = c >> 5, T = 1u << dT, P = pos + 1 < T ? pos + 1 : T;
+  u32 L = 1;
+  while (L < P) {
+    L <<= 1;
+  }
+  if (L >= M27_LS && L >= 32 && dT <= 16) {
+    // (M27 lever 4b) the split: NB 32-slot blocks, NC = L / CH chunks (CH =
+    // L / 16 within [32, 1024]: NC <= 64)
+    u32 ch = L / 16 < 32 ? 32 : L / 16 > 1024 ? 1024 : L / 16;
+    u32 nb = L / 32, nc = L / ch;
+    A.n = nb;
+    m9_go(en, gpu_x_a5s, &A, nh * nb, 256);
+    m9_go(en, gpu_m_a5p, &A, nh * nb, 32);
+    A.n = nc;
+    m9_go(en, gpu_x_a5v, &A, nh * nc, 256);
+    m9_go(en, gpu_m_a5c, &A, nh, 256);
+    return;
+  }
+  m9_go(en, gpu_x_attn5, &A, nh, 1024);
+}
+
+// the 35B full-attention layer: m9_fulb_run's chain at d 2048, GQA 8 (k / v
+// 512 rows, 2 kv heads), a 512 kv stride, llb_m_attn8
+static void m24_fulb_run(id<MTLComputeCommandEncoder> en, u64 b, const u32* p,
+  u32 c, u64 x, u64 kc, u64 vc, u64 y, bool nrm) {
+  HybArgs A;
+  u32 pos = c >> 5;
+  u64 attn = M9_BLK, gated = attn + 4096 * 4, h = M9_BLK + 8192 * 4;
+  u64 qgn = h + 4096 * 4, qg = qgn + 8192 * 4, kb = qg + 8192 * 4;
+  u64 kn = kb + 1024 * 4, vb = kn + 1024 * 4;
+  m24_ropecs(en, pos);
+  // (tools/metal-m29.patch, lever 6) h was written by the previous layer's
+  // addrms when nrm (ropecs writes M24_CS only)
+  if (!nrm) {
+    m9_rnorm(en, x, b + p[0], h, 2048);
+  }
+  // (tools/metal-m29.patch, overlap) [q | k | v] -> [qkr2(q) | qkr2(k) | slot
+  // v] -> [slot k]: the GEMVs read h [8192, 10240) (d 9: exactly 2048 columns;
+  // unlike the 27B's d 11 no pad window reaches qgn) and write qgn [12288,
+  // 20480), kb [28672, 29184), vb [30720, 31232); qkr2 reads qgn / kb (+ the
+  // rope table) and writes qg [20480, 28672) / kn [29696, 30208); slot v reads
+  // vb and writes vc at pos
+  m28_nb = true;
+  m24_q8(en, b + p[14], 2176, h, qgn, 8192, 9);
+  m28_nb = true;
+  m24_q8(en, b + p[15], 2176, h, kb, 512, 9);
+  m24_q8(en, b + p[16], 2176, h, vb, 512, 9);
+  m9_args(&A, qgn, b + p[17], qg, M24_CS, 0, 0, 0, 8192, 1, pos, 0.0f);
+  m28_nb = true;
+  m9_go(en, gpu_m_qkr2, &A, 8192 / 512, 256);
+  m9_args(&A, kb, b + p[18], kn, M24_CS, 0, 0, 0, 512, 0, pos, 0.0f);
+  m28_nb = true;
+  m9_go(en, gpu_m_qkr2, &A, 512 / 256, 256);
+  m9_args(&A, vb, vc + (u64)pos * 512 * 4, 0, 0, 0, 0, 0, 512, 0, 0, 0.0f);
+  m9_go(en, gpu_m_slot, &A, 1, 512);
+  m9_args(&A, kn, kc + (u64)pos * 512 * 4, 0, 0, 0, 0, 0, 512, 0, 0, 0.0f);
+  m9_go(en, gpu_m_slot, &A, 1, 512);
+  // (tools/metal-m29.patch, lever 3) attn8's bytes over the positions
+  m29_attn5(en, qg, kc, vc, attn, c);
+  m9_elem(en, 2, attn, qg + 4096 * 4, gated, 4096);
+  m24_q8(en, b + p[19], 4352, gated, y, 2048, 10);
+}
+
+// the MoE FFN (CUDA's llb_moe_run; M20's 4 dispatches): x1 = x + a,
+// h2 = rms(x1) * post, router + shexp gate dots, the routing tail into
+// MoeBuf, grouped gate/up/SiLU (8 routed + the shared Q8), grouped down +
+// combine (shared expert last), y = x1 + ffn_out. Expert k of layer i is
+// pool + moe_o?[i] + ids[k] * stride, read on the device. The gated layer
+// (LLB_MOE_GATE) reads the fed input and writes a dedicated MoeBuf / out
+// with the per-rank down and the ungated shexp (dbg).
+static void m24_moe_run(id<MTLComputeCommandEncoder> en, u64 b, const u32* p,
+  u32 i, u32 pos, u64 x, u64 at, u64 y, u64 nw, u64 nh) {
+  u64 x1b = M9_BLK, h2b = x1b + 2048 * 4, mb = h2b + 2048 * 4;
+  u64 act = mb + 1024 * 4, out = act + 4608 * 4;
+  bool gt = (int)i == moe_gl && pos < moe_gn;
+  u64  xin = h2b;
+  // (M24 lever L8) x1 = x + a fused into the rmsnorm
+  HybArgs A;
+  m9_args(&A, x, at, h2b, x1b, b + p[1], 0, 0, 2048, 0, 0, 0.0f);
+  m9_go(en, gpu_m_addrms, &A, 1, 1024);
+  if (gt) {
+    if (moe_feed != NULL) {
+      memcpy((u8*)[gpu_scr contents] + (moe_fslot & ~SA_SCR),
+        moe_feed + (u64)pos * 2048, 2048 * 4);
+      xin = moe_fslot;
+    }
+    memset((u8*)[gpu_scr contents] + (moe_dmb & ~SA_SCR), 0, 1024 * 4);
+    mb = moe_dmb;
+    out = moe_dout;
+    moe_pend_l = (int)i;
+    moe_pend_p = (int)pos;
+    // (lane m32, f35 R1) the fed row through the batched router too
+    if (f35_r1()) {
+      f35_r1_stage(en, i, pos, b, p, xin);
+    }
+  }
+  M24MoeArgs ma = { moe_eg[i], moe_ed[i], gt ? 1u : 0u, 0, 0, 0 };
+  u32 fd = moe_dfd != 0 && moe_dfd != moe_fd[i] ? moe_dfd : moe_fd[i];
+  // 1. router (256 F32 rows) + shexp gate (1 row): 65 x 128
+  [en setComputePipelineState:gpu_moe_rdot];
+  m24_bind(en, b + p[20], 0);
+  m24_bind(en, b + p[21], 1);
+  m24_bind(en, xin, 2);
+  m24_bind(en, mb, 3);
+  [en dispatchThreadgroups:MTLSizeMake(65, 1, 1)
+    threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
+  m28_bar(en);
+  // 2. the routing tail: 1 x 288
+  [en setComputePipelineState:gpu_moe_tail];
+  m24_bind(en, mb, 0);
+  [en dispatchThreadgroups:MTLSizeMake(1, 1, 1)
+    threadsPerThreadgroup:MTLSizeMake(288, 1, 1)];
+  m28_bar(en);
+  // 3. gate/up/SiLU: 9 slots x 512 rows, 64 threads a task
+  [en setComputePipelineState:gpu_moe_gu[moe_fg[i] == LLB_FM_Q5_K]];
+  [en setBuffer:moe_b[i][0] offset:moe_o[i][0] atIndex:0];
+  [en setBuffer:moe_b[i][1] offset:moe_o[i][1] atIndex:1];
+  m24_bind(en, b + p[2], 2);
+  m24_bind(en, b + p[3], 3);
+  m24_bind(en, xin, 4);
+  m24_bind(en, mb, 5);
+  m24_bind(en, act, 6);
+  [en setBytes:&ma length:sizeof ma atIndex:7];
+  [en dispatchThreadgroups:MTLSizeMake(9 * 512, 1, 1)
+    threadsPerThreadgroup:MTLSizeMake(64, 1, 1)];
+  m28_bar(en);
+  // 4. down + combine: 2048 rows, 2 a simdgroup, 128 threads
+  [en setComputePipelineState:gpu_moe_dn[fd == LLB_FM_Q6_K]];
+  [en setBuffer:moe_b[i][2] offset:moe_o[i][2] atIndex:0];
+  m24_bind(en, b + p[4], 1);
+  m24_bind(en, act, 2);
+  m24_bind(en, mb, 3);
+  m24_bind(en, out, 4);
+  [en setBytes:&ma length:sizeof ma atIndex:5];
+  [en dispatchThreadgroups:MTLSizeMake(256, 1, 1)
+    threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
+  m28_bar(en);
+  m24_bind0(en);
+  // (tools/metal-m29.patch, lever 6 = M28's) with the next norm's weight nw:
+  // y = x1 + ffn_out (elem 0's add, element for element) and rms(y) * nw into
+  // nh (llb_m_rmsnorm's tree, the q 2 branch at n 2048) in ONE addrms; it
+  // reads x1 [0, 2048) and ffn_out, writes y and nh (hb [39040, 41088), h
+  // [8192, 10240) or M9_HEADH): disjoint
+  if (nw != 0) {
+    HybArgs A2;
+    m9_args(&A2, x1b, out + 2048 * 4, nh, y, nw, 0, 0, 2048, 0, 0, 0.0f);
+    m9_go(en, gpu_m_addrms, &A2, 1, 1024);
+    return;
+  }
+  m9_elem(en, 0, x1b, out + 2048 * 4, y, 2048);
+}
+
+// the gated layer's MoeBuf and out (moe_out, ffn_out, per-rank down [8], the
+// ungated shexp), written after the command buffer completes
+static void m24_flush(void) {
+  // (diagnostic) LLB_F35_DBG: the per-layer, per-token max |grouped - per-token| and max |ffn| rows
+  if (f35_dbg_nt != 0 && f35_dbgf() != NULL) {
+    FILE* fd = fopen(f35_dbgf(), "wb");
+    if (fd != NULL) {
+      fwrite((const u8*)[gpu_scr contents] + (F35_DBG & ~SA_SCR), 4, 40ull * f35_dbg_nt * 2, fd);
+      fclose(fd);
+    }
+    f35_dbg_nt = 0;
+  }
+  if (f35_ids_nt != 0 && f35_idsf() != NULL) {
+    FILE* fi = fopen(f35_idsf(), "wb");
+    if (fi != NULL) {
+      fwrite((const u8*)[gpu_scr contents] + (F35_DBG & ~SA_SCR), 4, 40ull * f35_ids_nt * 10, fi);
+      fclose(fi);
+    }
+    f35_ids_nt = 0;
+  }
+  if (moe_pend_l < 0) {
+    return;
+  }
+  // (lane m32, f35 R1) the batched router's rows for the gated layer
+  if (f35_r1l >= 0) {
+    char g[1200];
+    snprintf(g, sizeof g, "%s/L%d_bat.moebuf", moe_dir, f35_r1l);
+    FILE* fb = fopen(g, "wb");
+    if (fb == NULL || fwrite((const u8*)[gpu_scr contents] + (F35_MB & ~SA_SCR), F35_MBS, moe_gn, fb)
+      != moe_gn) {
+      err_fail("f35 R1: cannot write the batched router's rows");
+    }
+    fclose(fb);
+    f35_r1l = -1;
+  }
+  if (moe_pend_l < 0) {
+    return;
+  }
+  char f[1200];
+  const u8* S = (const u8*)[gpu_scr contents];
+  snprintf(f, sizeof f, "%s/L%d_p%d.moebuf", moe_dir, moe_pend_l, moe_pend_p);
+  FILE* fp = fopen(f, "wb");
+  snprintf(f, sizeof f, "%s/L%d_p%d.out", moe_dir, moe_pend_l, moe_pend_p);
+  FILE* fo = fopen(f, "wb");
+  if (fp == NULL || fo == NULL
+    || fwrite(S + (moe_dmb & ~SA_SCR), 4, 1024, fp) != 1024
+    || fwrite(S + (moe_dout & ~SA_SCR), 4, 11 * 2048, fo) != 11 * 2048) {
+    err_fail("moe gate: cannot write the dump");
+  }
+  fclose(fp);
+  fclose(fo);
+  moe_pend_l = -1;
+}
+
+// layers s .. s+k-1 of one 35B step (m9_pass_run's schedule: full attention at
+// (i + 1) % 4 == 0, else gated delta; the MoE FFN in every layer). The state
+// region holds 40 layers: per linear layer the conv ring + S, per full layer
+// kc / vc at 512 floats a position; the x ping-pong of 2048; the gate's slots
+static void m24_reserve(u32 dT) {
+  u64 n = 4 * 2048 * 4 + (2048 + 1024 + 11 * 2048) * 4;
+  for (u32 i = 0; i < 40; i += 1) {
+    n += (i + 1) % 4 == 0 ? 2 * (4ull << (dT + 9)) : (4 * 8192 + (1ull << 19)) * 4;
+  }
+  // (lane m32, f35) + the fast chunk's area when the first 35B bang is a chunk
+  u64 fch = f35_want ? F35_BYTES : 0;
+  id<MTLBuffer> g = [gpu_dev newBufferWithLength:M9_SCR + n + fch
+    options:MTLResourceStorageModeShared | MTLResourceHazardTrackingModeUntracked];
+  if (!g) {
+    err_fail("warp pass: cannot allocate the layer state");
+  }
+  memcpy([g contents], [gpu_scr contents], M9_SCR);
+  memset((u8*)[g contents] + M9_SCR, 0, n + fch);
+  gpu_scr  = g;
+  pass_top = SA_SCR + M9_SCR;
+  pass_end = pass_top + n;
+  f35_base = fch != 0 ? pass_end : 0;
+}
+
+static void m24_pass_run(id<MTLComputeCommandEncoder> en, u64 x, u64 y, u32 c,
+  u32 s, u32 k, const u64* pw, const u32* tw, u64 hw) {
+  u32 dT = c & 31, pos = c >> 5;
+  if (pass_x[0] == 0) {
+    m24_reserve(dT);
+    for (u32 b = 0; b < 3; b += 1) {
+      pass_x[b] = pass_zero(2048);
+    }
+    moe_fslot = pass_zero(2048);
+    moe_dmb   = pass_zero(1024);
+    moe_dout  = pass_zero(11 * 2048);
+    pass_dT = dT;
+  }
+  if (dT != pass_dT) {
+    err_fail("warp pass: dT changed");
+  }
+  u64  cur = x;
+  bool nrm = false;
+  for (u32 j = 0; j < k; j += 1) {
+    u32  i = s + j;
+    bool full = (i + 1) % 4 == 0;
+    if (!pass_on[i]) {
+      if (pos != 0) {
+        err_fail("warp pass: a layer's state must start at pos 0");
+      }
+      if (full) {
+        pass_kc[i] = pass_zero(1ull << (dT + 9));
+        pass_vc[i] = pass_zero(1ull << (dT + 9));
+      } else {
+        pass_b[i] = pass_zero(4 * 8192);
+        pass_S[i] = pass_zero(1ull << 19);
+      }
+      pass_on[i] = true;
+    } else if (pass_pos[i] + 1 != pos) {
+      err_fail("warp pass: a layer served out of order");
+    }
+    pass_pos[i] = pos;
+    u64 b = pw[j];
+    u32 p[22];
+    for (u32 f = 0; f < 22; f += 1) {
+      p[f] = tw[i * 32 + 1 + f] & 0x0fffffffu;
+    }
+    if (full) {
+      m24_fulb_run(en, b, p, c, cur, pass_kc[i], pass_vc[i], pass_x[2], nrm);
+    } else {
+      u32 r = pass_r[i];
+      pass_r[i] = r + 1;
+      m24_linb_run(en, b, p, cur, pass_b[i] + (u64)((r + 3) % 4) * 8192 * 4,
+        pass_b[i] + (u64)(r % 4) * 8192 * 4,
+        pass_b[i] + (u64)((r + 1) % 4) * 8192 * 4,
+        pass_b[i] + (u64)((r + 2) % 4) * 8192 * 4, pass_S[i], pass_x[2], nrm);
+    }
+    u64 nxt = j + 1 == k ? y : pass_x[cur == pass_x[0] ? 1 : 0];
+    // (tools/metal-m29.patch, lever 6) the next layer's attn_norm weight and
+    // its destination (full: h, linb: hb), or the fused head's norm (hw)
+    u64 nw = 0, nh = 0;
+    if (j + 1 < k) {
+      nw = pw[j + 1] + (tw[(i + 1) * 32 + 1] & 0x0fffffffu);
+      nh = (i + 2) % 4 == 0 ? M9_BLK + 8192 * 4 : M9_BLK + 39040 * 4;
+    } else if (hw != 0) {
+      nw = hw;
+      nh = M9_HEADH;
+    }
+    m24_moe_run(en, b, p, i, pos, cur, pass_x[2], nxt, nw, nh);
+    nrm = nw != 0;
+    cur = nxt;
+  }
+}
+
+// the 35B pass bang's operand checks (the 9B arm's, at d 2048): word 50 the
+// experts.idx Bytes; rg / rd exactly q8rw(2048) / q8rw(512); x and y blocks of
+// 2^11; the table (task word 49) has all 40 rows; per layer word 0 = the
+// blob's length, the present tensors' formats (the GEMVs and the shared
+// expert Q8_0, the rest F32; words 21 / 22 = router 256 x 2048 / shexp gate
+// 2048, F32), alignment and bounds by each tensor's own columns
+static void m24_pass_arm(Env e, Corpus H, id<MTLComputeCommandEncoder> en,
+  Loc a, u32 aux, u32 grid) {
+  Term wl = H[a + 1], x = H[a + 2], y = H[a + 3];
+  u32  c = (u32)H[a + 44], rgw = (u32)H[a + 45], rdw = (u32)H[a + 46];
+  u32  s = (u32)H[a + 47], k = (u32)H[a + 48], dT = c & 31, pos = c >> 5;
+  // (lane m32) experts.idx: the last element of the layer list (the engine
+  // appends it after the 40 layer blobs)
+  Term tbt = H[a + 49], ext = term_pak(CID_SNIL, 0);
+  for (Term tl = wl; term_tag(tl) == TAG_CTR && (u32)term_aux(tl) == CID_CON;) {
+    Loc ll = term_peek_ro(e, tl);
+    ext = H[ll];
+    tl = H[ll + 1];
+  }
+  u64  pw[40];
+  bool ok = rgw == (2176u | 0x50000000u) && rdw == (544u | 0x50000000u)
+    && dT >= 1 && dT <= 17 && pos < (1u << dT) && k >= 1 && s + k <= 40
+    && a32_load(a32_at(H, H_WARP_N)) == 1 && term_tag(tbt) == TAG_STR
+    && H[a + 50] == term_pak(CID_SNIL, 0);
+  M24Fz F;
+  ok = ok && m24_fz(e, H, a, 2048, &F) && !M9_ARR(y)
+    && (F.on ? s == 0 && blk_cls(y) >= 2
+      : !M9_ARR(x) && blk_cls(x) == 11 && blk_cls(y) == 11);
+  StrParts   qt = str_peek_ro(e, tbt);
+  const u32* tw = (const u32*)((const u8*)(H + term_peek_ro(e, qt.data)) + qt.off);
+  StrParts   qx = str_peek_ro(e, ext);
+  ok = ok && str_nar(qt) == 2 && ((uintptr_t)tw & 3) == 0
+    && (u64)qt.len >= 40 * 128 && str_nar(qx) == 2 && qx.len > 0;
+  Term t2 = wl;
+  for (u32 i = 0; ok && i < s + k; i += 1) {
+    if (term_tag(t2) != TAG_CTR || (u32)term_aux(t2) != CID_CON) {
+      ok = false;
+      break;
+    }
+    Loc  l = term_peek_ro(e, t2);
+    Term wbt = H[l];
+    t2 = H[l + 1];
+    if (i < s) {
+      continue;
+    }
+    StrParts q = str_peek_ro(e, wbt);
+    if (term_tag(wbt) != TAG_STR || str_nar(q) != 2) {
+      ok = false;
+      break;
+    }
+    const u8* base = (const u8*)(H + term_peek_ro(e, q.data)) + q.off;
+    bool full = (i + 1) % 4 == 0;
+    // present tensors (Offs words 0 .. 19), their Q8_0 subset, rows and
+    // columns: an post fg fu fd qkv gate sb sa ssa dt cv sn so aq ak av aqn
+    // akn ao; words 20 / 21 the router / shexp gate (F32, 2048 cols)
+    static const u32 rows[22] = { 1, 1, 512, 512, 2048, 8192, 4096, 32, 32, 1,
+      1, 1, 1, 2048, 8192, 512, 512, 1, 1, 2048, 256, 1 };
+    static const u32 cols[22] = { 2048, 2048, 2048, 2048, 512, 2048, 2048, 2048,
+      2048, 32, 32, 32768, 128, 4096, 2048, 2048, 2048, 256, 256, 4096, 2048,
+      2048 };
+    u32 has = full ? 0x3FC01Fu : 0x303FFFu, q8 = full ? 0x9C01Cu : 0x207Cu;
+    ok = tw[i * 32] == q.len;
+    for (u32 f = 0; ok && f < 22; f += 1) {
+      u32 w = tw[i * 32 + 1 + f], fm = w >> 28, o = w & 0x0fffffffu;
+      if (!(has >> f & 1)) {
+        continue;
+      }
+      u64 rb = fm == LLB_FM_Q8_0 ? cols[f] / 32 * 34 : (u64)cols[f] * 4;
+      bool v = f == 9 || f == 10 || f == 11 || f == 0 || f == 1 || f == 17
+        || f == 18;
+      ok = (q8 >> f & 1 ? fm == LLB_FM_Q8_0 : fm == LLB_FM_F32)
+        && (f < 20 || o != 0)
+        && ((uintptr_t)(base + o) & (f == 12 ? 7 : v ? 3 : 15)) == 0
+        && (u64)o + rows[f] * rb <= q.len;
+    }
+    pw[i - s] = (u64)(base - (const u8*)H);
+  }
+  if (!ok) {
+    m9_bad(aux);
+  }
+  if (!moe_on) {
+    moe_on = true;
+    m24_init();
+    m24_pool((const u8*)(H + term_peek_ro(e, qx.data)) + qx.off, qx.len);
+    // (lane m32, f35 R1) the chunk area holds the batched router's staging
+    f35_want = f35_want || f35_r1();
+  }
+  if (!F.on) {
+    m24_pass_run(en, M9_A(x), M9_A(y), c, s, k, pw, tw, 0);
+    return;
+  }
+  if (pass_x[0] == 0) {
+    m24_reserve(dT);
+    for (u32 b = 0; b < 3; b += 1) {
+      pass_x[b] = pass_zero(2048);
+    }
+    moe_fslot = pass_zero(2048);
+    moe_dmb   = pass_zero(1024);
+    moe_dout  = pass_zero(11 * 2048);
+    m24_fin   = pass_zero(2048);
+    pass_dT = dT;
+  }
+  m24_fz_embed(en, &F, pass_x[1]);
+  // (tools/metal-m29.patch, lever 6) the last layer's addrms writes the
+  // head's norm
+  m24_pass_run(en, pass_x[1], m24_fin, c, s, k, pw, tw, F.hb + F.noff);
+  m24_fz_head(en, &F, m24_fin, M9_A(y), grid, true);
+}
+
+// ---- lane m32 (f35): the 35B-A3B FAST chunk: nt prompt ids at pos0 .. through the 40 layers, layer-major, head-less,
+// on M24's host-held layer state (its layout and allocation order); NOT byte-exact. Token t's block at f35_base + t
+// F35_TS; the MoE entries, MoeBuf rows and group tables after the F35_CH blocks.
+static id<MTLComputePipelineState> gpu_f35_rdot, gpu_f35_tail, gpu_f35_group, gpu_f35_mm[3];
+static id<MTLComputePipelineState> gpu_f35_silu, gpu_f35_comb, gpu_f35_f32ab, gpu_f35_attn, gpu_f35_dcmp;
+static id<MTLComputePipelineState> gpu_f35_xgu[2], gpu_f35_xdn[2], gpu_f35_xsgu, gpu_f35_xsdn, gpu_f35_idcp;
+
+static void f35_pipes(void) {
+  if (gpu_f35_rdot != nil) {
+    return;
+  }
+  f27_pipes();
+  gpu_f35_rdot  = warp_pipe("f35_rdot");
+  gpu_f35_tail  = warp_pipe("f35_tail");
+  gpu_f35_group = warp_pipe("f35_group");
+  gpu_f35_mm[0] = warp_pipe("f35_mmk4");
+  gpu_f35_mm[1] = warp_pipe("f35_mmk5");
+  gpu_f35_mm[2] = warp_pipe("f35_mmk6");
+  gpu_f35_silu  = warp_pipe("f35_silu");
+  gpu_f35_comb  = warp_pipe("f35_comb");
+  gpu_f35_f32ab = warp_pipe("f35_f32ab");
+  gpu_f35_attn  = warp_pipe("f35_attn");
+  gpu_f35_dcmp  = warp_pipe("f35_dcmp");
+  gpu_f35_xgu[0] = warp_pipe("f35_xgu4");
+  gpu_f35_xgu[1] = warp_pipe("f35_xgu9");
+  gpu_f35_xdn[0] = warp_pipe("f35_xdn2q5");
+  gpu_f35_xdn[1] = warp_pipe("f35_xdn2q6");
+  gpu_f35_xsgu  = warp_pipe("f35_xsgu");
+  gpu_f35_xsdn  = warp_pipe("f35_xsdn");
+  gpu_f35_idcp  = warp_pipe("f35_idcp");
+  if (gpu_f35_rdot.maxTotalThreadsPerThreadgroup < 128
+    || gpu_f35_tail.maxTotalThreadsPerThreadgroup < 288
+    || gpu_f35_group.maxTotalThreadsPerThreadgroup < 256
+    || gpu_f35_mm[0].maxTotalThreadsPerThreadgroup < 128
+    || gpu_f35_mm[1].maxTotalThreadsPerThreadgroup < 128
+    || gpu_f35_mm[2].maxTotalThreadsPerThreadgroup < 128
+    || gpu_f35_silu.maxTotalThreadsPerThreadgroup < 256
+    || gpu_f35_comb.maxTotalThreadsPerThreadgroup < 256
+    || gpu_f35_f32ab.maxTotalThreadsPerThreadgroup < 128
+    || gpu_f35_attn.maxTotalThreadsPerThreadgroup < 256
+    || gpu_f35_xgu[0].maxTotalThreadsPerThreadgroup < 256 || gpu_f35_xgu[1].maxTotalThreadsPerThreadgroup < 256
+    || gpu_f35_xdn[0].maxTotalThreadsPerThreadgroup < 256 || gpu_f35_xdn[1].maxTotalThreadsPerThreadgroup < 256
+    || gpu_f35_xsgu.maxTotalThreadsPerThreadgroup < 256 || gpu_f35_xsdn.maxTotalThreadsPerThreadgroup < 256) {
+    err_fail("35B fast chunk: a kernel's threadgroup does not fit");
+  }
+}
+
+#define F35_X  0ull
+#define F35_AO 2048ull
+#define F35_W0 4096ull
+
+// Y_s (nt rows of F35_TB floats at y[s]) = X . W_s^T, s < ns, one dispatch: llb_f27_mm8 (Q8_0 row-split) as
+// f27_mms with the 35B's block stride
+static void f35_mms(id<MTLComputeCommandEncoder> en, u32 ns, const u64* w, const u64* y,
+  const u32* M, u32 rb, u64 x0, u32 K, u32 nt) {
+  FMArgs a;
+  u32 tiles = 0;
+  memset(&a, 0, sizeof a);
+  bool ok = ns >= 1 && ns <= 4 && K % 32 == 0 && (x0 & 15) == 0
+    && rb == LLB_FM_RB(LLB_FM_Q8_0, K);
+  for (u32 j = 0; ok && j < ns; j += 1) {
+    ok = (y[j] & 15) == 0 && (w[j] & 15) == 0 && M[j] >= 1;
+    a.w[j] = w[j];
+    a.y[j] = y[j] & ~SA_SCR;
+    a.M[j] = M[j];
+    tiles += (M[j] + 63) / 64;
+  }
+  if (!ok) {
+    err_fail("35B fast chunk GEMM: unsupported operands");
+  }
+  a.nseg = ns;
+  a.x = x0 & ~SA_SCR;
+  a.rb = rb;
+  a.K = K;
+  a.N = nt;
+  a.xs = (u32)F35_TB;
+  a.ys = (u32)F35_TB;
+  [en setBuffer:gpu_scr offset:0 atIndex:1];
+  [en setComputePipelineState:gpu_f27_mm[0]];
+  [en setBytes:&a length:sizeof a atIndex:2];
+  [en dispatchThreadgroups:MTLSizeMake((nt + 31) / 32, tiles, 1)
+    threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
+  [en memoryBarrierWithScope:MTLBarrierScopeBuffers];
+}
+
+static void f35_mm1(id<MTLComputeCommandEncoder> en, u64 w, u32 rb, u64 x0, u64 y0,
+  u32 M, u32 K, u32 nt) {
+  f35_mms(en, 1, &w, &y0, &M, rb, x0, K, nt);
+}
+
+// (diagnostic) LLB_F35_DBG=<file> (read once)
+static const char* f35_dbgf(void) {
+  static int v = -1;
+  static const char* f;
+  if (v < 0) {
+    f = getenv("LLB_F35_DBG");
+    v = f != NULL && *f != 0;
+  }
+  return v == 1 ? f : NULL;
+}
+
+// (timing probe) LLB_F35_DUP=<name>: the named f35 dispatch encoded twice (the same bound state, after its barrier)
+static bool f35_dup(const char* nm) {
+  static int v = -1;
+  static char want[32];
+  if (v < 0) {
+    const char* s = getenv("LLB_F35_DUP");
+    v = s != NULL && *s != 0;
+    if (v) {
+      snprintf(want, sizeof want, "%s", s);
+      fprintf(stderr, "f35 DUP %s\n", want);
+    }
+  }
+  return v == 1 && strcmp(want, nm) == 0;
+}
+
+static void f35_again(id<MTLComputeCommandEncoder> en, const char* nm, MTLSize g, MTLSize t) {
+  if (f35_dup(nm)) {
+    [en dispatchThreadgroups:g threadsPerThreadgroup:t];
+    [en memoryBarrierWithScope:MTLBarrierScopeBuffers];
+  }
+}
+
+// (diagnostic) LLB_F35_IDS=<file> (read once)
+static const char* f35_idsf(void) {
+  static int v = -1;
+  static const char* f;
+  if (v < 0) {
+    f = getenv("LLB_F35_IDS");
+    v = f != NULL && *f != 0;
+  }
+  return v == 1 ? f : NULL;
+}
+
+// (R1) LLB_F35_R1 (with LLB_MOE_GATE): read once
+static bool f35_r1(void) {
+  static int v = -1;
+  if (v < 0) {
+    v = getenv("LLB_F35_R1") != NULL;
+  }
+  return v == 1;
+}
+
+// (R1) the fed row xin of position pos into the staging rows (F35_MG); at the last fed position f35_rdot + f35_tail
+// over the moe_gn staged rows into the MoeBuf rows (F35_MB), dumped by m24_flush
+static void f35_r1_stage(id<MTLComputeCommandEncoder> en, u32 i, u32 pos, u64 b, const u32* p, u64 xin) {
+  if (f35_base == 0) {
+    err_fail("f35 R1: no chunk area");
+  }
+  f35_pipes();
+  f27_copy(en, xin, F35_MG + (u64)pos * 2048 * 4, 2048);
+  if (pos + 1 == moe_gn) {
+    const u32 xs = 2048;
+    [en setComputePipelineState:gpu_f35_rdot];
+    m24_bind(en, b + p[20], 0);
+    m24_bind(en, b + p[21], 1);
+    m24_bind(en, F35_MG, 2);
+    m24_bind(en, F35_MB, 3);
+    [en setBytes:&xs length:sizeof xs atIndex:4];
+    [en dispatchThreadgroups:MTLSizeMake(65, moe_gn, 1) threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
+    [en memoryBarrierWithScope:MTLBarrierScopeBuffers];
+    [en setComputePipelineState:gpu_f35_tail];
+    m24_bind(en, F35_MB, 0);
+    [en dispatchThreadgroups:MTLSizeMake(moe_gn, 1, 1) threadsPerThreadgroup:MTLSizeMake(288, 1, 1)];
+    [en memoryBarrierWithScope:MTLBarrierScopeBuffers];
+    m24_bind0(en);
+    [en setBuffer:gpu_scr offset:0 atIndex:1];
+    f35_r1l = (int)i;
+  }
+}
+
+// (lane m36) the program's arguments (IO.args; defined with main below)
+static int    io_argc;
+static char** io_argv;
+
+// (lane m36) the default prefill tier: neither --fastpf nor --exactpf among the arguments
+static bool f35_dflt(void) {
+  for (int i = 0; i < io_argc; i += 1) {
+    if (strcmp(io_argv[i], "--fastpf") == 0 || strcmp(io_argv[i], "--exactpf") == 0) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// (L2 / L3) LLB_F35_MOE=mma: the routed experts on M26's MMA tile instead of lever X (read once)
+// (lane m36) LLB_F35_MOE unset: L3 for the default tier (f35_dflt), lever X under an explicit --fastpf K
+static bool f35_mma(void) {
+  static int v = -1;
+  if (v < 0) {
+    const char* s = getenv("LLB_F35_MOE");
+    v = s != NULL ? strcmp(s, "mma") == 0 : f35_dflt();
+  }
+  return v == 1;
+}
+
+// (L1) LLB_F35_MOE=tok: the MoE per token through the decode's kernels (read once)
+static bool f35_tok(void) {
+  static int v = -1;
+  if (v < 0) {
+    const char* s = getenv("LLB_F35_MOE");
+    v = s != NULL && strcmp(s, "tok") == 0;
+    if (v) {
+      fprintf(stderr, "f35: MoE per token (LLB_F35_MOE=tok)\\n");
+    }
+  }
+  return v == 1;
+}
+
+// one SSM layer (m24_linb_run's chain) for the chunk's nt tokens
+static void f35_linb(id<MTLComputeCommandEncoder> en, u32 i, u64 b, const u32* p, u32 nt) {
+  const u64 B = f35_base;
+  const u64 hb = F35_W0, qkv = hb + 2048, zz = qkv + 8192, bpre = zz + 4096, apre = bpre + 32;
+  const u64 beta = apre + 32, dec = beta + 32, sp = dec + 32, cnv = sp + 32, cnvk = cnv + 2048;
+  const u64 vn = cnv + 4096, qt = cnv + 8192, kt = qt + 4096, gout = kt + 4096, normed = gout + 4096;
+  union { u32 u; f32 f; } sq = { 0x413504f3u };
+  HybTArgs T;
+  if (normed + 4096 > F35_TB) {
+    err_fail("35B fast chunk: the linb block layout does not fit");
+  }
+  f27_targs(&T, 2048, 0, 0, 0.0f);
+  T.a[0] = B + F35_X * 4; T.s[0] = F35_TS; T.a[1] = b + p[0];
+  T.a[2] = B + hb * 4; T.s[2] = F35_TS;
+  f27_go(en, gpu_t27_rnorm, &T, sizeof T, 1, nt, 1024);
+  {
+    const u64 w2[2] = {b + p[5], b + p[6]};
+    const u64 y2[2] = {B + qkv * 4, B + zz * 4};
+    const u32 m2[2] = {8192, 4096};
+    f35_mms(en, 2, w2, y2, m2, 2176, B + hb * 4, 2048, nt);
+  }
+  // the F32 beta / alpha rows (llb_m_f32ab per token): bpre, apre adjacent
+  f27_targs(&T, 32, 0, 0, 0.0f);
+  T.a[0] = b + p[7]; T.a[1] = b + p[8];
+  T.a[2] = B + hb * 4; T.s[2] = F35_TS; T.a[3] = B + bpre * 4; T.s[3] = F35_TS;
+  f27_go(en, gpu_f35_f32ab, &T, sizeof T, 16, nt, 128);
+  f27_targs(&T, 32, 0, 0, 0.0f);
+  T.a[0] = B + bpre * 4; T.s[0] = F35_TS; T.a[1] = B + apre * 4; T.s[1] = F35_TS;
+  T.a[2] = b + p[10]; T.a[3] = b + p[9];
+  T.a[4] = B + beta * 4; T.s[4] = F35_TS; T.a[5] = B + dec * 4; T.s[5] = F35_TS;
+  T.a[6] = B + sp * 4; T.s[6] = F35_TS;
+  f27_go(en, gpu_t27_mida, &T, sizeof T, 1, nt, 32);
+  f27_go(en, gpu_t27_midb, &T, sizeof T, 1, nt, 32);
+  // conv: token row j's input = its qkv (j >= 0) or the ring (j < 0), pieces of <= 256 rows
+  const u32 r0 = pass_r[i];
+  FConvArgs V;
+  for (u32 c0 = 0; c0 < nt; c0 += 256) {
+    const u32 cn = nt - c0 < 256 ? nt - c0 : 256;
+    memset(&V, 0, sizeof V);
+    V.a[0] = b + p[11]; V.a[1] = B + (u64)c0 * F35_TS + cnv * 4; V.s[1] = F35_TS;
+    V.n = 8192;
+    for (int j = (int)c0 - 3; j < (int)(c0 + cn); j += 1) {
+      V.in[j - (int)c0 + 3] = j >= 0 ? B + (u64)j * F35_TS + qkv * 4
+        : pass_b[i] + (u64)((r0 + 3 + (u32)(j + 4)) % 4) * 8192 * 4;
+    }
+    f27_go(en, gpu_f27_conv, &V, sizeof V, 8192 / 256, cn, 256);
+  }
+  // the l2norms into their 2 copies (16 q heads, 16 k heads), as llb_m_l2n4
+  f27_targs(&T, 16, 2048, 2, sq.f);
+  T.a[0] = B + cnv * 4; T.s[0] = F35_TS; T.a[1] = B + cnvk * 4; T.s[1] = F35_TS;
+  T.a[2] = B + qt * 4; T.s[2] = F35_TS; T.a[3] = B + kt * 4; T.s[3] = F35_TS;
+  f27_go(en, gpu_t27_l2nr, &T, sizeof T, 32, nt, 64);
+  // gated delta, the rows in order (32 value heads)
+  f27_targs(&T, 32, 0, nt, 0.0f);
+  T.a[0] = pass_S[i];
+  T.a[1] = B + qt * 4; T.s[1] = F35_TS; T.a[2] = B + kt * 4; T.s[2] = F35_TS;
+  T.a[3] = B + vn * 4; T.s[3] = F35_TS; T.a[4] = B + dec * 4; T.s[4] = F35_TS;
+  T.a[5] = B + beta * 4; T.s[5] = F35_TS; T.a[6] = B + gout * 4; T.s[6] = F35_TS;
+  f27_go(en, gpu_f27_gdl, &T, sizeof T, 32 * 8, 1, 128);
+  f27_targs(&T, 32, 0, 0, 0.0f);
+  T.a[0] = B + gout * 4; T.s[0] = F35_TS; T.a[1] = b + p[12];
+  T.a[2] = B + zz * 4; T.s[2] = F35_TS; T.a[3] = B + normed * 4; T.s[3] = F35_TS;
+  f27_go(en, gpu_t27_grn, &T, sizeof T, 32, nt, 64);
+  // the ring: the last (up to) 4 tokens' qkv, as the steps would leave it
+  for (u32 t = nt > 4 ? nt - 4 : 0; t < nt; t += 1) {
+    f27_copy(en, B + (u64)t * F35_TS + qkv * 4,
+      pass_b[i] + (u64)((r0 + 3 + t) % 4) * 8192 * 4, 8192);
+  }
+  pass_r[i] = r0 + nt;
+  f35_mm1(en, b + p[13], 4352, B + normed * 4, B + F35_AO * 4, 2048, 4096, nt);
+}
+
+// one full layer (m24_fulb_run's chain) for the chunk's nt tokens at pos0 ..
+static void f35_fulb(id<MTLComputeCommandEncoder> en, u32 i, u64 b, const u32* p, u32 dT,
+  u32 pos0, u32 nt) {
+  const u64 B = f35_base;
+  const u64 h = F35_W0, qgn = h + 2048, qg = qgn + 8192, kb = qg + 8192, kn = kb + 512;
+  const u64 vb = kn + 512, attn = vb + 512, gated = attn + 4096;
+  HybTArgs T;
+  if (gated + 4096 > F35_TB || dT < 5) {
+    err_fail("35B fast chunk: the fulb block layout / window does not fit");
+  }
+  f27_targs(&T, 2048, 0, 0, 0.0f);
+  T.a[0] = B + F35_X * 4; T.s[0] = F35_TS; T.a[1] = b + p[0];
+  T.a[2] = B + h * 4; T.s[2] = F35_TS;
+  f27_go(en, gpu_t27_rnorm, &T, sizeof T, 1, nt, 1024);
+  {
+    const u64 w3[3] = {b + p[14], b + p[15], b + p[16]};
+    const u64 y3[3] = {B + qgn * 4, B + kb * 4, B + vb * 4};
+    const u32 m3[3] = {8192, 512, 512};
+    f35_mms(en, 3, w3, y3, m3, 2176, B + h * 4, 2048, nt);
+  }
+  // qk-norm + rope (pos = pos0 + row), the q gate copied after the 16 q heads
+  f27_targs(&T, 8192, 1, pos0, 0.0f);
+  T.a[0] = B + qgn * 4; T.s[0] = F35_TS; T.a[1] = b + p[17];
+  T.a[2] = B + qg * 4; T.s[2] = F35_TS;
+  f27_go(en, gpu_t27_qkr, &T, sizeof T, 16, nt, 256);
+  f27_targs(&T, 512, 0, pos0, 0.0f);
+  T.a[0] = B + kb * 4; T.s[0] = F35_TS; T.a[1] = b + p[18];
+  T.a[2] = B + kn * 4; T.s[2] = F35_TS;
+  f27_go(en, gpu_t27_qkr, &T, sizeof T, 2, nt, 256);
+  // the cache slots pos0 + row (512 floats a position)
+  f27_targs(&T, 512, 0, 0, 0.0f);
+  T.a[0] = B + kn * 4; T.s[0] = F35_TS;
+  T.a[1] = pass_kc[i] + (u64)pos0 * 512 * 4; T.s[1] = 2048;
+  f27_go(en, gpu_t27_slot, &T, sizeof T, 1, nt, 512);
+  T.a[0] = B + vb * 4; T.s[0] = F35_TS;
+  T.a[1] = pass_vc[i] + (u64)pos0 * 512 * 4; T.s[1] = 2048;
+  f27_go(en, gpu_t27_slot, &T, sizeof T, 1, nt, 512);
+  FAttArgs F;
+  memset(&F, 0, sizeof F);
+  F.q = B + qg * 4;
+  F.kc = pass_kc[i];
+  F.vc = pass_vc[i];
+  F.att = B + attn * 4;
+  F.qs = (u32)F35_TB;
+  F.pos0 = pos0;
+  F.nt = nt;
+  f27_go(en, gpu_f35_attn, &F, sizeof F, 2, (nt + 7) / 8, 256);
+  // the output gate: attn * sigmoid(gate), the gate at qg + 4096
+  f27_targs(&T, 4096, 2, 0, 0.0f);
+  T.a[0] = B + attn * 4; T.s[0] = F35_TS; T.a[1] = B + (qg + 4096) * 4;
+  T.s[1] = F35_TS; T.a[2] = B + gated * 4; T.s[2] = F35_TS;
+  f27_go(en, gpu_t27_elem, &T, sizeof T, 16, nt, 256);
+  f35_mm1(en, b + p[19], 4352, B + gated * 4, B + F35_AO * 4, 2048, 4096, nt);
+}
+
+// the MoE FFN (m24_moe_run's chain) for the chunk's nt tokens: x := x1 + moe(rms(x1)), x1 = x + the mixer's output
+static void f35_moe(id<MTLComputeCommandEncoder> en, u32 i, u64 b, const u32* p, u32 nt) {
+  const u64 B = f35_base;
+  const u64 x1 = F35_W0, h2 = x1 + 2048, sgt = h2 + 2048, sut = sgt + 512, sat = sut + 512;
+  const u64 sdt = sat + 512;
+  HybTArgs T;
+  F35GArgs Q;
+  F35MArgs Mg;
+  const u32 n8 = nt * 8, ntl = n8 / 32 + 256;
+  const u32 fg0 = moe_fg[i], fd0 = moe_fd[i];
+  if (sdt + 2048 > F35_TB) {
+    err_fail("35B fast chunk: the MoE block layout does not fit");
+  }
+  f27_targs(&T, 2048, 0, 0, 0.0f);
+  T.a[0] = B + F35_X * 4; T.s[0] = F35_TS; T.a[1] = B + F35_AO * 4;
+  T.s[1] = F35_TS; T.a[2] = B + h2 * 4; T.s[2] = F35_TS;
+  T.a[3] = B + x1 * 4; T.s[3] = F35_TS; T.a[4] = b + p[1];
+  f27_go(en, gpu_t27_addrms, &T, sizeof T, 1, nt, 1024);
+  // 1. the router + shexp gate logits, batched (moe_rdot per row): 65 x 128 a row
+  const u32 xs = (u32)F35_TB;
+  [en setComputePipelineState:gpu_f35_rdot];
+  m24_bind(en, b + p[20], 0);
+  m24_bind(en, b + p[21], 1);
+  m24_bind(en, B + h2 * 4, 2);
+  m24_bind(en, F35_MB, 3);
+  [en setBytes:&xs length:sizeof xs atIndex:4];
+  [en dispatchThreadgroups:MTLSizeMake(65, nt, 1) threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
+  [en memoryBarrierWithScope:MTLBarrierScopeBuffers];
+  f35_again(en, "rdot", MTLSizeMake(65, nt, 1), MTLSizeMake(128, 1, 1));
+  // 2. the routing tail per row (moe_tail): 1 x 288 a row
+  [en setComputePipelineState:gpu_f35_tail];
+  m24_bind(en, F35_MB, 0);
+  [en dispatchThreadgroups:MTLSizeMake(nt, 1, 1) threadsPerThreadgroup:MTLSizeMake(288, 1, 1)];
+  [en memoryBarrierWithScope:MTLBarrierScopeBuffers];
+  f35_again(en, "tail", MTLSizeMake(nt, 1, 1), MTLSizeMake(288, 1, 1));
+  m24_bind0(en);
+  // (L1, LLB_F35_MOE=tok) the decode's own MoE kernels per token (moe_gu over the 8 routed + the shared slot,
+  // moe_dn's down + combine), then x := x1 + ffn: the batched router's lever measured alone; for the same h2 rows
+  // its ffn rows are the decode MoE's bits
+  if (f35_tok()) {
+    M24MoeArgs ma = { moe_eg[i], moe_ed[i], 0, 0, 0, 0 };
+    for (u32 t = 0; t < nt; t += 1) {
+      const u64 act = F35_MG + (u64)t * 4608 * 4, out = F35_MD + (u64)t * 4096 * 4;
+      [en setComputePipelineState:gpu_moe_gu[fg0 == LLB_FM_Q5_K]];
+      [en setBuffer:moe_b[i][0] offset:moe_o[i][0] atIndex:0];
+      [en setBuffer:moe_b[i][1] offset:moe_o[i][1] atIndex:1];
+      m24_bind(en, b + p[2], 2);
+      m24_bind(en, b + p[3], 3);
+      m24_bind(en, B + (u64)t * F35_TS + h2 * 4, 4);
+      m24_bind(en, F35_MB + (u64)t * F35_MBS, 5);
+      m24_bind(en, act, 6);
+      [en setBytes:&ma length:sizeof ma atIndex:7];
+      [en dispatchThreadgroups:MTLSizeMake(9 * 512, 1, 1) threadsPerThreadgroup:MTLSizeMake(64, 1, 1)];
+      [en memoryBarrierWithScope:MTLBarrierScopeBuffers];
+      [en setComputePipelineState:gpu_moe_dn[fd0 == LLB_FM_Q6_K]];
+      [en setBuffer:moe_b[i][2] offset:moe_o[i][2] atIndex:0];
+      m24_bind(en, b + p[4], 1);
+      m24_bind(en, act, 2);
+      m24_bind(en, F35_MB + (u64)t * F35_MBS, 3);
+      m24_bind(en, out, 4);
+      [en setBytes:&ma length:sizeof ma atIndex:5];
+      [en dispatchThreadgroups:MTLSizeMake(256, 1, 1) threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
+      [en memoryBarrierWithScope:MTLBarrierScopeBuffers];
+    }
+    m24_bind0(en);
+    [en setBuffer:gpu_buf offset:0 atIndex:3];
+    f27_targs(&T, 2048, 0, 0, 0.0f);
+    T.a[0] = B + x1 * 4; T.s[0] = F35_TS; T.a[1] = F35_MD + 2048 * 4; T.s[1] = 4096 * 4;
+    T.a[2] = B + F35_X * 4; T.s[2] = F35_TS;
+    f27_go(en, gpu_t27_elem, &T, sizeof T, 2048 / 256, nt, 256);
+    return;
+  }
+  // 3. the entries grouped by expert
+  memset(&Q, 0, sizeof Q);
+  Q.b = F35_MB; Q.g = F35_MT; Q.nt = nt;
+  f27_go(en, gpu_f35_group, &Q, sizeof Q, 1, 1, 256);
+  f35_again(en, "group", MTLSizeMake(1, 1, 1), MTLSizeMake(256, 1, 1));
+  // (diagnostic) LLB_F35_IDS=<file>: each layer's ids and its 8th / 9th probs (dumped by m24_flush)
+  if (f35_idsf() != NULL) {
+    memset(&Q, 0, sizeof Q);
+    Q.b = F35_MB; Q.w = F35_DBG + (u64)i * nt * 10 * 4; Q.nt = nt;
+    f27_go(en, gpu_f35_idcp, &Q, sizeof Q, (nt + 255) / 256, 1, 256);
+    f35_ids_nt = nt;
+  }
+  if (f35_mma()) {
+    // (lever L2 / L3, LLB_F35_MOE=mma) the routed experts on M26's MMA tile
+    // 4. routed gate / up: every expert's tiles, 2 segments x 8 row tiles
+    const u32 fg = moe_fg[i], fd = moe_fd[i];
+    const u32 sbg = fg == LLB_FM_Q5_K ? 176 : 144, sbd = fd == LLB_FM_Q6_K ? 210 : 176;
+    memset(&Mg, 0, sizeof Mg);
+    Mg.es = moe_eg[i]; Mg.x = B + h2 * 4; Mg.y0 = F35_MG; Mg.y1 = F35_MU; Mg.g = F35_MT;
+    Mg.rb = 8 * sbg; Mg.K = 2048; Mg.M = 512; Mg.xs = (u32)F35_TB; Mg.ys = 512; Mg.gather = 1;
+    [en setBuffer:gpu_scr offset:0 atIndex:1];
+    [en setBuffer:moe_b[i][0] offset:moe_o[i][0] atIndex:3];
+    [en setBuffer:moe_b[i][1] offset:moe_o[i][1] atIndex:4];
+    [en setComputePipelineState:gpu_f35_mm[fg == LLB_FM_Q5_K ? 1 : 0]];
+    [en setBytes:&Mg length:sizeof Mg atIndex:2];
+    [en dispatchThreadgroups:MTLSizeMake(ntl, 16, 1) threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
+    [en memoryBarrierWithScope:MTLBarrierScopeBuffers];
+    f35_again(en, "mgu", MTLSizeMake(ntl, 16, 1), MTLSizeMake(128, 1, 1));
+    // 5. SiLU-mul into the gate rows
+    memset(&Q, 0, sizeof Q);
+    Q.x = F35_MG; Q.y = F35_MU; Q.z = F35_MG; Q.n = n8; Q.xs = 512; Q.ys = 512;
+    f27_go(en, gpu_f35_silu, &Q, sizeof Q, 2, n8, 256);
+    // 6. routed down: every expert's tiles, 32 row tiles
+    memset(&Mg, 0, sizeof Mg);
+    Mg.es = moe_ed[i]; Mg.x = F35_MG; Mg.y0 = F35_MD; Mg.y1 = F35_MD; Mg.g = F35_MT;
+    Mg.rb = 2 * sbd; Mg.K = 512; Mg.M = 2048; Mg.xs = 512; Mg.ys = 2048; Mg.gather = 0;
+    [en setBuffer:gpu_scr offset:0 atIndex:1];
+    [en setBuffer:moe_b[i][2] offset:moe_o[i][2] atIndex:3];
+    [en setBuffer:moe_b[i][2] offset:moe_o[i][2] atIndex:4];
+    [en setComputePipelineState:gpu_f35_mm[fd == LLB_FM_Q6_K ? 2 : 1]];
+    [en setBytes:&Mg length:sizeof Mg atIndex:2];
+    [en dispatchThreadgroups:MTLSizeMake(ntl, 32, 1) threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
+    [en memoryBarrierWithScope:MTLBarrierScopeBuffers];
+    f35_again(en, "mdn", MTLSizeMake(ntl, 32, 1), MTLSizeMake(128, 1, 1));
+    [en setBuffer:gpu_buf offset:0 atIndex:3];
+    [en setBuffer:gpu_buf offset:0 atIndex:4];
+  } else {
+    // (lever X) the routed experts in the decode's arithmetic (f35_xgu / f35_xdn): gate / up / SiLU in 32 blocks of
+    // 16 rows, then the down rows in 64 blocks of 32; for the same h2 row and expert, the decode's bits
+    memset(&Mg, 0, sizeof Mg);
+    Mg.es = moe_eg[i]; Mg.x = B + h2 * 4; Mg.y0 = F35_MG; Mg.g = F35_MT; Mg.xs = (u32)F35_TB;
+    [en setBuffer:gpu_scr offset:0 atIndex:1];
+    [en setBuffer:moe_b[i][0] offset:moe_o[i][0] atIndex:3];
+    [en setBuffer:moe_b[i][1] offset:moe_o[i][1] atIndex:4];
+    [en setComputePipelineState:gpu_f35_xgu[fg0 == LLB_FM_Q5_K ? 1 : 0]];
+    [en setBytes:&Mg length:sizeof Mg atIndex:2];
+    [en dispatchThreadgroups:MTLSizeMake(ntl, 32, 1) threadsPerThreadgroup:MTLSizeMake(256, 1, 1)];
+    [en memoryBarrierWithScope:MTLBarrierScopeBuffers];
+    f35_again(en, "xgu", MTLSizeMake(ntl, 32, 1), MTLSizeMake(256, 1, 1));
+    memset(&Mg, 0, sizeof Mg);
+    Mg.es = moe_ed[i]; Mg.x = F35_MG; Mg.y0 = F35_MD; Mg.g = F35_MT;
+    [en setBuffer:moe_b[i][2] offset:moe_o[i][2] atIndex:3];
+    [en setComputePipelineState:gpu_f35_xdn[fd0 == LLB_FM_Q6_K ? 1 : 0]];
+    [en setBytes:&Mg length:sizeof Mg atIndex:2];
+    [en dispatchThreadgroups:MTLSizeMake(ntl, 64, 1) threadsPerThreadgroup:MTLSizeMake(256, 1, 1)];
+    [en memoryBarrierWithScope:MTLBarrierScopeBuffers];
+    f35_again(en, "xdn", MTLSizeMake(ntl, 64, 1), MTLSizeMake(256, 1, 1));
+    [en setBuffer:gpu_buf offset:0 atIndex:3];
+    [en setBuffer:gpu_buf offset:0 atIndex:4];
+  }
+  // 7. the shared expert (Q8_0): gate + up, SiLU-mul, down
+  if (f35_mma()) {
+    {
+      const u64 w2[2] = {b + p[2], b + p[3]};
+      const u64 y2[2] = {B + sgt * 4, B + sut * 4};
+      const u32 m2[2] = {512, 512};
+      f35_mms(en, 2, w2, y2, m2, 2176, B + h2 * 4, 2048, nt);
+    }
+    memset(&Q, 0, sizeof Q);
+    Q.x = B + sgt * 4; Q.y = B + sut * 4; Q.z = B + sat * 4; Q.n = nt;
+    Q.xs = (u32)F35_TB; Q.ys = (u32)F35_TB;
+    f27_go(en, gpu_f35_silu, &Q, sizeof Q, 2, nt, 256);
+    f35_mm1(en, b + p[4], 544, B + sat * 4, B + sdt * 4, 2048, 512, nt);
+  } else {
+    // (lever X) in the decode's arithmetic: f35_xsgu (moe_gu's slot 8), f35_xsdn (moe_dn's shared row)
+    F35SArgs X;
+    memset(&X, 0, sizeof X);
+    X.wg = b + p[2]; X.wu = b + p[3]; X.x = B + h2 * 4; X.y = B + sat * 4; X.nt = nt;
+    X.xs = (u32)F35_TB; X.ys = (u32)F35_TB;
+    f27_go(en, gpu_f35_xsgu, &X, sizeof X, (nt + 31) / 32, 32, 256);
+    f35_again(en, "xsgu", MTLSizeMake((nt + 31) / 32, 32, 1), MTLSizeMake(256, 1, 1));
+    memset(&X, 0, sizeof X);
+    X.wg = b + p[4]; X.x = B + sat * 4; X.y = B + sdt * 4; X.nt = nt;
+    X.xs = (u32)F35_TB; X.ys = (u32)F35_TB;
+    f27_go(en, gpu_f35_xsdn, &X, sizeof X, (nt + 31) / 32, 64, 256);
+    f35_again(en, "xsdn", MTLSizeMake((nt + 31) / 32, 64, 1), MTLSizeMake(256, 1, 1));
+  }
+  // 8. the combine and the residual: x := x1 + (moe + gs sd)
+  memset(&Q, 0, sizeof Q);
+  Q.b = F35_MB; Q.g = F35_MT; Q.w = F35_MD; Q.x = B + x1 * 4; Q.z = B + sdt * 4;
+  Q.y = B + F35_X * 4; Q.nt = nt; Q.xs = (u32)F35_TB; Q.ys = (u32)F35_TB;
+  f27_go(en, gpu_f35_comb, &Q, sizeof Q, 2048 / 256, nt, 256);
+  f35_again(en, "comb", MTLSizeMake(2048 / 256, nt, 1), MTLSizeMake(256, 1, 1));
+  // (diagnostic) LLB_F35_DBG=<file>: the decode's per-token MoE for the same h2 rows (act / out in the token blocks
+  // past the MoE scratch), then per token max |y - (x1 + ffn_t)| into the debug rows (dumped by m24_flush)
+  if (f35_dbgf() != NULL) {
+    M24MoeArgs ma = { moe_eg[i], moe_ed[i], 0, 0, 0, 0 };
+    for (u32 t = 0; t < nt; t += 1) {
+      const u64 act = B + (u64)t * F35_TS + 12288 * 4, out = B + (u64)t * F35_TS + 16896 * 4;
+      [en setComputePipelineState:gpu_moe_gu[fg0 == LLB_FM_Q5_K]];
+      [en setBuffer:moe_b[i][0] offset:moe_o[i][0] atIndex:0];
+      [en setBuffer:moe_b[i][1] offset:moe_o[i][1] atIndex:1];
+      m24_bind(en, b + p[2], 2);
+      m24_bind(en, b + p[3], 3);
+      m24_bind(en, B + (u64)t * F35_TS + h2 * 4, 4);
+      m24_bind(en, F35_MB + (u64)t * F35_MBS, 5);
+      m24_bind(en, act, 6);
+      [en setBytes:&ma length:sizeof ma atIndex:7];
+      [en dispatchThreadgroups:MTLSizeMake(9 * 512, 1, 1) threadsPerThreadgroup:MTLSizeMake(64, 1, 1)];
+      [en memoryBarrierWithScope:MTLBarrierScopeBuffers];
+      [en setComputePipelineState:gpu_moe_dn[fd0 == LLB_FM_Q6_K]];
+      [en setBuffer:moe_b[i][2] offset:moe_o[i][2] atIndex:0];
+      m24_bind(en, b + p[4], 1);
+      m24_bind(en, act, 2);
+      m24_bind(en, F35_MB + (u64)t * F35_MBS, 3);
