+    memset(&E, 0, sizeof E);
+    E.ep = ep; E.y = f35_base + (u64)j0 * F35_TS + F35_X * 4; E.erb = 2176; E.d = 2048;
+    E.ys = (u32)F35_TB; E.k4 = 0;
