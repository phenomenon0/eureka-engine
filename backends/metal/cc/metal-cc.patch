+// D3: 256 threads (a column each) a (head, chunk of CH = L / NC slots)
+kernel void llb_m_attn5vx(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant HybArgs& A [[buffer(2)]], uint gid [[threadgroup_position_in_grid]],
+  uint tx [[thread_position_in_threadgroup]]) {
+  device const float* vc = sa_f(C, S, A.a[2]);
+  device float* sc  = sa_f(C, S, A.a[4]);
+  device float* pr  = sa_f(C, S, A.a[5]);
+  const u32 c = A.c, dT = c & 31, pos = c >> 5, T = 1u << dT;
+  const u32 P = min(pos + 1, T), NC = A.n, h = gid / NC, ch = gid % NC;
+  const u32 lgL = P <= 1 ? 0 : 32 - clz(P - 1), L = 1u << lgL;
+  const u32 NB = L / 32, CH = L / NC, g = (h / A.k) * 256;
+  const float ninf = as_type<float>(0xFF800000u);
+  const u64 kvs = A.a[6];
+  device float* sh = sc + (u64)h * (1u << 17);
+  device float* ph = pr + (u64)h * (1u << 17);
+  device float* R = sh + 65536;
+  threadgroup float red[256];
+  threadgroup float pz[1024];
+  threadgroup float zz[1];
+  const float m = R[4096];
+  const float e0 = attn_exp(ninf - m);
+  const u32 NT = min(NB, 256u), BB = NB / NT;
+  if (tx < NT) {
+    float st[18];
+    u32   sp = 0;
+    for (u32 i = 0; i < BB; i++) {
+      float x = R[2048 + tx * BB + i];
+      for (u32 u = i; u & 1; u >>= 1) {
+        x = st[--sp] + x;
+      }
+      st[sp++] = x;
+    }
+    red[tx] = st[0];
+  }
+  for (u32 w = 1; w < NT; w <<= 1) {
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (tx < NT && (tx & (2 * w - 1)) == 0) {
+      red[tx] = red[tx] + red[tx + w];
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (tx == 0) {
+    float r = red[0], mj = e0;
+    for (u32 j = 0; j < dT; j++) {
+      if (j >= lgL) {
+        r = r + mj;
+      }
+      mj = mj + mj;
+    }
+    zz[0] = r;
+    if (ch == 0) {
+      R[4097] = r;
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  const float z = zz[0];
+  const float pm = e0 / z;
+  const u32 t0 = ch * CH;
+  for (u32 i = tx; i < CH; i += 256) {
+    const u32 t = t0 + i;
+    pz[i] = t < P ? ph[t] / z : pm;
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  float st[18];
+  u32   sp = 0;
+  for (u32 i = 0; i < CH; i++) {
+    float v = vc[(u64)(t0 + i) * kvs + g + tx] * pz[i];
+    for (u32 u = i; u & 1; u >>= 1) {
+      v = st[--sp] + v;
+    }
+    st[sp++] = v;
+  }
+  R[8192 + ch * 256 + tx] = st[0];
+}
