+// (METAL-ANYSHAPE) the generic attention: llb_m_attn5x's trees (scores, the max tree, the sum tree, the value
+// tree over the T = 2^dT leaves with the masked tail folded in) for any kv-head count (kv stride A.a[6] floats,
+// A.k q heads a kv head) and any dT. A head's score plane holds A.a[7] floats (m9_attn_ps): the T scores, then
+// the split's partials R = sh + T: block maxes [0, NBX), block sums [NBX, 2 NBX), m and z at 2 NBX, the chunk
+// values from 2 NBX + 8 (NC <= 64 chunks of 256), NBX = max(T / 32, 1). The probability plane has the same
+// stride. llb_m_attn6 is one threadgroup (short windows); a6s / a6m / a6p / a6z / a6v / a6c the split: the
+// max and the sum are joined once a head (a6m, a6z), not once a block, so the cost stays linear in the window.
+INLINE u32 a6_nbx(u32 dT) {
+  return dT >= 5 ? 1u << (dT - 5) : 1u;
+}
+
+kernel void llb_m_attn6(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant HybArgs& A [[buffer(2)]], uint h [[threadgroup_position_in_grid]],
+  uint tx [[thread_position_in_threadgroup]]) {
+  device const float* q  = sa_f(C, S, A.a[0]);
+  device const float* kc = sa_f(C, S, A.a[1]);
+  device const float* vc = sa_f(C, S, A.a[2]);
+  device float* att = sa_f(C, S, A.a[3]);
+  device float* sc  = sa_f(C, S, A.a[4]);
+  device float* pr  = sa_f(C, S, A.a[5]);
+  const u32 c = A.c, dT = c & 31, pos = c >> 5;
+  const u64 T = 1ull << dT;
+  const u32 P = (u32)min((u64)pos + 1, T);
+  const u32 lgL = P <= 1 ? 0 : 32 - clz(P - 1), L = 1u << lgL;
+  const u32 NT = min(L, 1024u), B = L / NT;
+  const u32 g = (h / A.k) * 256;
+  const float scale = 1.0f / sqrt(256.0f);
+  const float ninf = as_type<float>(0xFF800000u);
+  const u64 kvs = A.a[6], ps = A.a[7];
+  device float* sh = sc + (u64)h * ps;
+  device float* ph = pr + (u64)h * ps;
+  device const float* qh = q + (u64)h * 256;
+  threadgroup float red[1024];
+  threadgroup float mz[2];
+  {
+    const u32 l = tx & 31, sgi = tx >> 5;
+    const float4 qa = *(device const float4*)(qh + 8 * l);
+    const float4 qb = *(device const float4*)(qh + 8 * l + 4);
+    for (u32 t = sgi; t < P; t += 32) {
+      device const float* k = kc + (u64)t * kvs + g + 8 * l;
+      const float4 ka = *(device const float4*)k;
+      const float4 kb = *(device const float4*)(k + 4);
+      float v = ((ka.x * qa.x + ka.y * qa.y) + (ka.z * qa.z + ka.w * qa.w))
+        + ((kb.x * qb.x + kb.y * qb.y) + (kb.z * qb.z + kb.w * qb.w));
+      for (u32 m = 1; m < 32; m <<= 1) {
+        v = kq_bfly(v, l, m);
+      }
+      if (l == 0) {
+        sh[t] = v * scale;
+      }
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_device);
+  if (tx < NT) {
+    float st[32];
+    u32   sp = 0;
+    for (u32 i = 0; i < B; i++) {
+      const u32 t = tx * B + i;
+      float v = t < P ? sh[t] : ninf;
+      for (u32 u = i; u & 1; u >>= 1) {
+        v = m27_max(st[--sp], v);
+      }
+      st[sp++] = v;
+    }
+    red[tx] = st[0];
+  }
+  for (u32 w = 1; w < NT; w <<= 1) {
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (tx < NT && (tx & (2 * w - 1)) == 0) {
+      red[tx] = m27_max(red[tx], red[tx + w]);
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (tx == 0) {
+    float r = red[0];
+    for (u32 j = lgL; j < dT; j++) {
+      r = m27_max(r, ninf);
+    }
+    mz[0] = r;
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  const float m = mz[0];
+  const float e0 = attn_exp(ninf - m);
+  if (tx < NT) {
+    float st[32];
+    u32   sp = 0;
+    for (u32 i = 0; i < B; i++) {
+      const u32 t = tx * B + i;
+      float v = e0;
+      if (t < P) {
+        v = attn_exp(sh[t] - m);
+        ph[t] = v;
+      }
+      for (u32 u = i; u & 1; u >>= 1) {
+        v = st[--sp] + v;
+      }
+      st[sp++] = v;
+    }
+    red[tx] = st[0];
+  }
+  for (u32 w = 1; w < NT; w <<= 1) {
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (tx < NT && (tx & (2 * w - 1)) == 0) {
+      red[tx] = red[tx] + red[tx + w];
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (tx == 0) {
+    float r = red[0], mj = e0;
+    for (u32 j = 0; j < dT; j++) {
+      if (j >= lgL) {
+        r = r + mj;
+      }
+      mj = mj + mj;
+    }
+    mz[1] = r;
+  }
+  threadgroup_barrier(mem_flags::mem_device);
+  const float z = mz[1];
+  for (u32 t = tx; t < P; t += 1024) {
+    ph[t] = ph[t] / z;
+  }
+  threadgroup_barrier(mem_flags::mem_device);
+  const float pm = e0 / z;
+  const u32 NQ = min(L, 4u), CH = L / NQ, qt = tx >> 8, col = tx & 255;
+  if (qt < NQ) {
+    float st[32];
+    u32   sp = 0;
+    for (u32 i = 0; i < CH; i++) {
+      const u32 t = qt * CH + i;
+      float v = vc[(u64)t * kvs + g + col] * (t < P ? ph[t] : pm);
+      for (u32 u = i; u & 1; u >>= 1) {
+        v = st[--sp] + v;
+      }
+      st[sp++] = v;
+    }
+    red[tx] = st[0];
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (qt == 0) {
+    float r = NQ == 4 ? (red[col] + red[256 + col]) + (red[512 + col]
+      + red[768 + col]) : NQ == 2 ? red[col] + red[256 + col] : red[col];
+    float mv = 0.0f * pm;
+    for (u32 j = 0; j < dT; j++) {
+      if (j >= lgL) {
+        r = r + mv;
+      }
+      mv = mv + mv;
+    }
+    att[(u64)h * 256 + col] = r;
+  }
+}
+
+// D1: scores of block b (32 slots) and its max subtree into R[b]; 256 threads a (head, block)
+kernel void llb_m_a6s(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant HybArgs& A [[buffer(2)]], uint gid [[threadgroup_position_in_grid]],
+  uint tx [[thread_position_in_threadgroup]]) {
+  device const float* q  = sa_f(C, S, A.a[0]);
+  device const float* kc = sa_f(C, S, A.a[1]);
+  device float* sc  = sa_f(C, S, A.a[4]);
+  const u32 c = A.c, dT = c & 31, pos = c >> 5;
+  const u64 T = 1ull << dT;
+  const u32 P = (u32)min((u64)pos + 1, T), NB = A.n, h = gid / NB, b = gid % NB;
+  const u32 g = (h / A.k) * 256;
+  const float scale = 1.0f / sqrt(256.0f);
+  const float ninf = as_type<float>(0xFF800000u);
+  const u64 kvs = A.a[6], ps = A.a[7];
+  device float* sh = sc + (u64)h * ps;
+  device float* R = sh + T;
+  device const float* qh = q + (u64)h * 256;
+  const u32 l = tx & 31, sgi = tx >> 5;
+  const float4 qa = *(device const float4*)(qh + 8 * l);
+  const float4 qb = *(device const float4*)(qh + 8 * l + 4);
+  for (u32 i = 0; i < 4; i++) {
+    const u32 t = 32 * b + sgi + 8 * i;
+    if (t < P) {
+      device const float* k = kc + (u64)t * kvs + g + 8 * l;
+      const float4 ka = *(device const float4*)k;
+      const float4 kb = *(device const float4*)(k + 4);
+      float v = ((ka.x * qa.x + ka.y * qa.y) + (ka.z * qa.z + ka.w * qa.w))
+        + ((kb.x * qb.x + kb.y * qb.y) + (kb.z * qb.z + kb.w * qb.w));
+      for (u32 m = 1; m < 32; m <<= 1) {
+        v = kq_bfly(v, l, m);
+      }
+      if (l == 0) {
+        sh[t] = v * scale;
+      }
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_device);
+  if (sgi == 0) {
+    const u32 t = 32 * b + l;
+    float v = t < P ? sh[t] : ninf;
+    for (u32 m = 1; m < 32; m <<= 1) {
+      v = m27_bmax(v, l, m);
+    }
+    if (l == 0) {
+      R[b] = v;
+    }
+  }
+}
+
+// a6m / a6z: the tree over the NB block roots (aligned per-thread runs, then the level tree) and the masked
+// tail, once a head; 1024 threads. max (a6m) into R[2 NBX], sum (a6z) into R[2 NBX + 1]
+kernel void llb_m_a6m(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant HybArgs& A [[buffer(2)]], uint h [[threadgroup_position_in_grid]],
+  uint tx [[thread_position_in_threadgroup]]) {
+  device float* sc = sa_f(C, S, A.a[4]);
+  const u32 c = A.c, dT = c & 31, pos = c >> 5;
+  const u64 T = 1ull << dT;
+  const u32 P = (u32)min((u64)pos + 1, T), NB = A.n, NBX = a6_nbx(dT);
+  const u32 lgL = P <= 1 ? 0 : 32 - clz(P - 1);
+  const float ninf = as_type<float>(0xFF800000u);
+  device float* R = sc + (u64)h * A.a[7] + T;
+  const u32 NT = min(NB, 1024u), BB = NB / NT;
+  threadgroup float red[1024];
+  if (tx < NT) {
+    float st[32];
+    u32   sp = 0;
+    for (u32 i = 0; i < BB; i++) {
+      float x = R[tx * BB + i];
+      for (u32 u = i; u & 1; u >>= 1) {
+        x = m27_max(st[--sp], x);
+      }
+      st[sp++] = x;
+    }
+    red[tx] = st[0];
+  }
+  for (u32 w = 1; w < NT; w <<= 1) {
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (tx < NT && (tx & (2 * w - 1)) == 0) {
+      red[tx] = m27_max(red[tx], red[tx + w]);
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (tx == 0) {
+    float r = red[0];
+    for (u32 j = lgL; j < dT; j++) {
+      r = m27_max(r, ninf);
+    }
+    R[2 * NBX] = r;
+  }
+}
+
+// D2: one simdgroup a (head, block): the probabilities of its 32 slots and their sum subtree into R[NBX + b]
+kernel void llb_m_a6p(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant HybArgs& A [[buffer(2)]], uint gid [[threadgroup_position_in_grid]],
+  uint l [[thread_position_in_threadgroup]]) {
+  device float* sc = sa_f(C, S, A.a[4]);
+  device float* pr = sa_f(C, S, A.a[5]);
+  const u32 c = A.c, dT = c & 31, pos = c >> 5;
+  const u64 T = 1ull << dT;
+  const u32 P = (u32)min((u64)pos + 1, T), NB = A.n, NBX = a6_nbx(dT), h = gid / NB, b = gid % NB;
+  const float ninf = as_type<float>(0xFF800000u);
+  device float* sh = sc + (u64)h * A.a[7];
+  device float* ph = pr + (u64)h * A.a[7];
+  device float* R = sh + T;
+  const float m = R[2 * NBX];
+  const float e0 = attn_exp(ninf - m);
+  const u32 t = 32 * b + l;
+  float w = e0;
+  if (t < P) {
+    w = attn_exp(sh[t] - m);
+    ph[t] = w;
+  }
+  for (u32 k = 1; k < 32; k <<= 1) {
+    w = kq_bfly(w, l, k);
+  }
+  if (l == 0) {
+    R[NBX + b] = w;
+  }
+}
+
+kernel void llb_m_a6z(device u8* C [[buffer(0)]], device u8* S [[buffer(1)]],
+  constant HybArgs& A [[buffer(2)]], uint h [[threadgroup_position_in_grid]],
+  uint tx [[thread_position_in_threadgroup]]) {
+  device float* sc = sa_f(C, S, A.a[4]);
+  const u32 c = A.c, dT = c & 31, pos = c >> 5;
+  const u64 T = 1ull << dT;
+  const u32 P = (u32)min((u64)pos + 1, T), NB = A.n, NBX = a6_nbx(dT);
+  const u32 lgL = P <= 1 ? 0 : 32 - clz(P - 1);
+  const float ninf = as_type<float>(0xFF800000u);
+  device float* R = sc + (u64)h * A.a[7] + T;
+  const float e0 = attn_exp(ninf - R[2 * NBX]);
+  const u32 NT = min(NB, 1024u), BB = NB / NT;
+  threadgroup float red[1024];
+  if (tx < NT) {
+    float st[32];
