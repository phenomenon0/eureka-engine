-      const u32 a2 = pf_h2(sc[2 * s + 1][0], sc[2 * s + 1][1]);
-      const u32 a3 = pf_h2(sc[2 * s + 1][2], sc[2 * s + 1][3]);
-#pragma unroll
-      for (u32 n = 0; n < 32; n++) {
