+  }
+  if (heads != 3 || experts != (size_t)g->nl * 3) return gg_fail(err, "incomplete MoE heads/experts");
+  g->nt = kept;
+  qsort(g->t, g->nt, sizeof *g->t, gg_moe_order);
+  return 0;
