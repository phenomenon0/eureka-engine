+// MoE virtual layout: three heads, then each layer in source-offset order.
+// Routed experts stay in the existing mmap pool and have no heap pack offset.
+static int gg_moe_order(const void *a, const void *b) {
+  const GgT *x = a, *y = b;
+  if (x->layer != y->layer) return x->layer < y->layer ? -1 : 1;
+  if (x->layer < 0) return strcmp(x->name, y->name);
+  return x->src < y->src ? -1 : x->src > y->src;
+}
