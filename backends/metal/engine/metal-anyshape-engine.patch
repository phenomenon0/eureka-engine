+  Bool.and(Bool.or(U32.is_eq(nkv, 2), U32.is_eq(nkv, 4)),
+    Bool.or(U32.is_eq(nh, (nkv * 4 : U32)), U32.is_eq(nh, (nkv * 6 : U32))))
