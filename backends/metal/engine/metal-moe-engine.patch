+// ---------------------------------------------------------------- the routed experts (METAL-MOE)
+
+// llb_gg_moe_pool: the routed-expert tensors of a qwen35moe GGUF for layers 0 .. nl - 1, for the host's general
+// MoE path (it maps them read-only from the file and binds them as no-copy buffers). Per layer, 3 slots: gate
+// (or the fused gate_up, then *fused[L] = 1 and the up slot is 0), up, down; each the absolute file offset, the
+// ggml type, the bytes and the GGUF shape (columns, rows, experts). 0, or -1 with err (256 bytes).
+int llb_gg_moe_pool(const char *path, int nl, uint64_t *src, uint32_t *ty, uint64_t *bytes, uint64_t *shp,
+                    int *fused, char *err) {
+  GgFile g;
+  if (gg_open(&g, path, err)) return -1;
+  int rc = 0;
+  if (!g.x) rc = gg_fail(err, "%s: not a qwen35moe GGUF", path);
+  memset(src, 0, (size_t)nl * 3 * sizeof *src), memset(ty, 0, (size_t)nl * 3 * sizeof *ty);
+  memset(bytes, 0, (size_t)nl * 3 * sizeof *bytes), memset(shp, 0, (size_t)nl * 9 * sizeof *shp);
+  memset(fused, 0, (size_t)nl * sizeof *fused);
+  for (size_t i = 0; !rc && i < g.nx; i++) {
+    const GgT *t = &g.x[i];
+    if (t->layer >= nl) continue;  // a NextN (MTP) block past the decoder's layers
+    const char *s = strchr(t->name + 4, '.') + 1;
+    int k = !strcmp(s, "ffn_up_exps.weight") ? 1 : !strcmp(s, "ffn_down_exps.weight") ? 2 : 0;
+    if (!strcmp(s, "ffn_gate_up_exps.weight")) fused[t->layer] = 1;
+    if (t->nd != 3) { rc = gg_fail(err, "%s: %u dims, want 3 (cols, rows, experts)", t->name, t->nd); break; }
+    size_t j = (size_t)t->layer * 3 + (size_t)k;
+    src[j] = t->src, ty[j] = t->ty, bytes[j] = t->bytes;
+    for (int d = 0; d < 3; d++) shp[j * 3 + (size_t)d] = t->ne[d];
+  }
+  for (int L = 0; !rc && L < nl; L++)
+    if (!bytes[L * 3] || !bytes[L * 3 + 2] || (!fused[L] && !bytes[L * 3 + 1]))
+      rc = gg_fail(err, "layer %d: the routed experts are incomplete (gate, up or gate_up, down)", L);
+  if (g.fd > 0) close(g.fd);
+  for (size_t i = 0; i < g.nt; i++) free(g.t[i].name);
+  for (size_t i = 0; i < g.nx; i++) free(g.x[i].name);
+  free(g.t), free(g.x), free(g.lo), free(g.hi);
+  return rc;
+}
